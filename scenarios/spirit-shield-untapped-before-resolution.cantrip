# If the Shield untaps in response, its "for as long as" effect never starts (CR 611.2b).
[Bot1 Deck]
Spirit Shield
Black Lotus
Mox Pearl
Mox Ruby
Memnite
Island x20
[Bot2 Deck]
Voltaic Key
Mox Sapphire
Island x20
[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Hand.Spirit Shield.Cast
? Bot1.Mana =
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Sapphire.Cast
Bot2.Pass
Bot2.Hand.Island.Play
Bot2.Battlefield.Island.Activate
Bot2.Hand.Voltaic Key.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Spirit Shield.Activate(Bot1.Battlefield.Memnite)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
? Bot1.Mana =
Bot1.Pass
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Voltaic Key.Activate(Bot1.Battlefield.Spirit Shield)
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Pass
[Expect]
Bot1.Battlefield.Spirit Shield.Tapped = false
Bot1.Battlefield.Memnite.Power = 1
Bot1.Battlefield.Memnite.Toughness = 1
