# "At the beginning of each end step": Cerberus attacked on turn 3 and is tapped. On Bot2's turn 4 Bot1 kills the Memnite with Lightning Bolt in the second main phase,
# so at the beginning of Bot2's end step Cerberus untaps. (Had the Bolt been cast after the step began, nothing would have triggered.)

[Bot1 Deck]
Mox Ruby
Mox Ruby
Mox Ruby
Slumbering Cerberus
Lightning Bolt
Mountain
Mountain
Island x13

[Bot2 Deck]
Memnite
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Ruby#1.Activate
Bot1.Battlefield.Mox Ruby#2.Activate
Bot1.Hand.Slumbering Cerberus.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Attack(Slumbering Cerberus > Bot2)
[T4 Bot2.Main2]
Bot1.Battlefield.Mox Ruby#3.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Slumbering Cerberus.Tapped = true
[T4 Bot2.End]
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Slumbering Cerberus.Tapped = false

[Expect]
Bot2.Graveyard = Memnite
Bot1.Graveyard = Lightning Bolt
