# Barbarian Guides: {2}{R}, {T}: choose Island; Bot1's Memnite gains snow islandwalk until end of turn, so Bot2, who
# controls a Snow-Covered Island, can't block it with Ornithopter (CR 702.14c), and Memnite returns to its owner's hand at
# the beginning of the end step (CR 603.7a) while the Guides stays. The cost is pinned: with only white, black and blue
# sources left it is not offered (the {R}), and paid from exactly R, W and B the pool is empty after. Bot2's Ornithopter is
# refused as the target ("target creature you control").

[Bot1 Deck]
Mox Ruby
Mox Pearl
Mox Jet
Mox Sapphire
Barbarian Guides
Memnite
Mountain
Mountain x10

[Bot2 Deck]
Snow-Covered Island
Ornithopter
Island x12

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Barbarian Guides.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Snow-Covered Island.Play
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
[T3 Bot1.Upkeep]
Bot1.Battlefield.Mox Ruby.Activate
[T3 Bot1.Main1]
! Bot1.Battlefield.Barbarian Guides.Activate(Memnite; Mana: short)
Bot1.Hand.Mountain.Play
! Bot1.Battlefield.Barbarian Guides.Activate(Bot2.Battlefield.Ornithopter)
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Barbarian Guides.Activate(Memnite)
Bot1.Pass
Bot1.Modes(Island)
? Bot1.Mana =
? Bot1.Battlefield.Memnite.Keywords = SnowIslandwalk
Bot1.Attack(Memnite > Bot2)
! Bot2.Block(Ornithopter > Memnite)
[T3 Bot1.End]
Bot1.Pass

[Expect]
Bot2.Life = 19
Bot1.Battlefield.Memnite = (absent)
Bot1.Hand = Memnite; Mountain
Bot1.Battlefield.Barbarian Guides.Tapped = true
Bot2.Battlefield.Ornithopter.Tapped = false
