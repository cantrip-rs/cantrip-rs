Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Elvish Mystic.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Emerald.Cast
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Hand.Llanowar Elves.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Elvish Mystic.Activate
Bot1.Hand.Trystan's Command.Cast
! Bot1.Modes(1)
! Bot1.Modes(1; 4; 3)
Bot1.Modes(1; 4)
! Bot1.Target(Bot2.Battlefield.Llanowar Elves)
! Bot1.Target(Bot1.Battlefield.Ornithopter)
Bot1.Target(Bot1.Battlefield.Elvish Mystic)
Bot1.Target(Bot1)
Bot2.Pass

[Expect]
Bot1.Battlefield.Elvish Mystic#1.Tapped = false
Bot1.Battlefield.Elvish Mystic#1.Power = 4
Bot1.Battlefield.Elvish Mystic#2.Token = true
Bot1.Battlefield.Elvish Mystic#2.Power = 4
Bot1.Battlefield.Elvish Mystic#2.Toughness = 4
