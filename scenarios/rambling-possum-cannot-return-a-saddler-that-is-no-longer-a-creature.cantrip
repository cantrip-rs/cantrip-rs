# Rambling Possum may return only "creatures that saddled it" (CR 109.2: a permanent of that type). Memnite and Ornithopter
# saddle it, then Imprisoned in the Moon makes Memnite a land; it is no longer a creature, so only Ornithopter can be returned.

[Bot1 Deck]
Mox Emerald
Mox Jet
Mox Ruby
Mox Sapphire
Ornithopter
Rambling Possum
Memnite
Imprisoned in the Moon
Plains x17

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Rambling Possum.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Pass
Bot2.Pass
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Rambling Possum.Activate(Ability: Saddle)
Bot1.Choose(Memnite; Ornithopter)
Bot1.Pass
Bot2.Pass
Bot1.Hand.Imprisoned in the Moon.Cast(Target: Memnite)
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Memnite.Types = Land
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Rambling Possum > Bot2)
Bot1.Pass
Bot2.Pass
! Bot1.Choose(Memnite)
Bot1.Choose(Ornithopter)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 16
Bot1.Battlefield.Memnite.Types = Land
Bot1.Hand.Ornithopter.Power = 0
