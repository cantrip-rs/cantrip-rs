# Forum of Amity, a white-black surveil land: it enters tapped (so nothing is offered on turn 1), taps for {W} on turn 3 and for {B} on
# turn 5 and offers no {R}. On turn 7 its "{2}{W}{B}, {T}: Surveil 1." is refused with three Moxen that make neither {W} nor {B}, with
# {W} added but no {B}, and goes through once Mox Jet makes the {B}: the Mountain on top of the library goes to the graveyard.

[Bot1 Deck]
Forum of Amity
Mox Sapphire
Mox Ruby
Mox Emerald
Mox Pearl
Mox Jet
Island
Island x3
Mountain
Island x8

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Forum of Amity.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Emerald.Cast
? Bot1.Battlefield.Forum of Amity.Tapped = true
! Bot1.Battlefield.Forum of Amity.Activate(Color: White)
[T3 Bot1.Main1]
! Bot1.Battlefield.Forum of Amity.Activate(Color: Red)
Bot1.Battlefield.Forum of Amity.Activate(Color: White)
? Bot1.Mana = {W}
[T5 Bot1.Main1]
Bot1.Battlefield.Forum of Amity.Activate(Color: Black)
? Bot1.Mana = {B}
[T7 Bot1.Main1]
! Bot1.Battlefield.Forum of Amity.Activate(Ability: Surveil; Mana: short)
Bot1.Hand.Mox Pearl.Cast
! Bot1.Battlefield.Forum of Amity.Activate(Ability: Surveil; Mana: short)
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Forum of Amity.Activate(Ability: Surveil)
Bot1.Pass
Bot2.Pass
Bot1.Arrange( | Mountain)

