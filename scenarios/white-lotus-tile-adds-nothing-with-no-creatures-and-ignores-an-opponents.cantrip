# White Lotus Tile with no creature of Bot1's: X = 0 (the "greatest number" of an empty set), so the activation adds no mana; Bot2's Zephyr Sprite is not Bot1's creature and does not count.
# Bot1 casts the Tile on turn 1 (four Moxes) and activates it on turn 3.

[Bot1 Deck]
Mox Pearl
Mox Sapphire
Mox Jet
Mox Ruby
White Lotus Tile
Island x15

[Bot2 Deck]
Mox Sapphire
Zephyr Sprite
Island x18

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.White Lotus Tile.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Sapphire.Cast
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.Zephyr Sprite.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.White Lotus Tile.Activate(Color: Blue)
? Bot1.Mana =
? Bot1.Battlefield.White Lotus Tile.Tapped = true

