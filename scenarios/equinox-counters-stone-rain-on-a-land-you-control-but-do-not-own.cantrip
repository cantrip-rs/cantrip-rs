# Equinox reads "a land you control" by who controls it, not who owns it (CR 110.2, 608.2): Bot2 gives its Mountain to Bot1
# with Harmless Offering, then aims Stone Rain at it. The Mountain is Bot1's to control though Bot2 owns it, so Stone Rain
# would destroy a land Bot1 controls, and Bot1's enchanted Plains counters it.

[Bot1 Deck]
Plains
Mox Pearl
Equinox
Plains x12

[Bot2 Deck]
Mountain
Mox Ruby
Mox Jet
Black Lotus
Harmless Offering
Stone Rain
Mountain x10

[Actions]
Bot1.Hand.Plains.Play
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Equinox.Cast(Plains)
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Mox Jet.Cast
Bot2.Hand.Black Lotus.Cast
Bot2.Battlefield.Mountain.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Harmless Offering.Cast
Bot2.Target(Bot1)
Bot2.Target(Mountain)
Bot2.Pass
Bot1.Pass
? Bot1.Battlefield = Equinox; Mountain; Mox Pearl; Plains
Bot2.Battlefield.Black Lotus.Activate(Color: Red)
Bot2.Hand.Stone Rain.Cast(Bot1.Battlefield.Mountain)
Bot1.Battlefield.Plains.Activate(Stack.Stone Rain; Ability: Counter)
[T2 Bot2.Main2]

[Expect]
Bot1.Battlefield = Equinox; Mountain; Mox Pearl; Plains
Bot2.Graveyard = Stone Rain; Black Lotus; Harmless Offering
