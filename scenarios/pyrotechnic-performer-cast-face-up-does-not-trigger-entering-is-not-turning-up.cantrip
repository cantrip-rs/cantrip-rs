# Pyrotechnic Performer cast face up for {1}{R} (Mox Ruby and Mox Jet) enters without having been turned face up (CR 701.40b), so
# its trigger does not fire: the stack is empty and Bot2 is still at 20.

[Bot1 Deck]
Pyrotechnic Performer
Mox Ruby
Mox Jet
Island x17

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Pyrotechnic Performer.Cast
Bot1.Pass
Bot2.Pass
? Stack.Count = 0

[Expect]
Stack.Count = 0
Bot1.Battlefield.Pyrotechnic Performer.FaceDown = (absent)
Bot1.Battlefield.Pyrotechnic Performer.Power = 3
Bot2.Life = 20
