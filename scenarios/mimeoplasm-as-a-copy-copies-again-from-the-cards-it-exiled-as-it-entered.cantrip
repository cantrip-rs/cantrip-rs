Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Entomb.Cast
Bot1.Search(Grizzly Bears)
[T3 Bot1.Main1]
Bot1.Hand.Swamp.Play
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Entomb.Cast
Bot1.Search(Llanowar Elves)
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Mimeoplasm, Revered One.Cast(X: 2)
Bot1.Choose(Confirm X)
Bot1.Choose(Grizzly Bears; Llanowar Elves)
? Bot1.Battlefield.Mimeoplasm, Revered One.Power = 6
Bot1.Pass
Bot2.Pass
[T5 Bot1.Main1]
Bot1.Hand.Swamp.Play
Bot1.Battlefield.Swamp#1.Activate
Bot1.Battlefield.Swamp#2.Activate
Bot1.Battlefield.Mimeoplasm, Revered One.Activate(Exile.Grizzly Bears)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Grizzly Bears.Power = 6
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Grizzly Bears.Activate(Exile.Llanowar Elves)
Bot1.Pass
Bot2.Pass

[Expect]
Exile = Grizzly Bears; Llanowar Elves
Bot1.Battlefield.Grizzly Bears = (absent)
Bot1.Battlefield.Llanowar Elves.Power = 6
Bot1.Battlefield.Llanowar Elves.Toughness = 6
Bot1.Battlefield.Llanowar Elves.Counters.PlusOnePlusOne = 6
Bot1.Battlefield.Llanowar Elves.Subtypes = Druid; Elf
