# Feint can target an opponent's attacker before blocks; a creature later
# blocking it has its combat damage prevented too (CR 611.2c, 615.1).
[Bot1 Deck]
Mountain
Feint
Memnite
Ornithopter
Island x20
[Bot2 Deck]
Memnite
Island x20
[Actions]
Bot1.Hand.Mountain.Play
Bot1.Hand.Memnite.Cast
Bot1.Hand.Ornithopter.Cast
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
[T4 Bot2.DeclareAttackers]
Bot2.Attack(Memnite > Bot1)
Bot2.Pass
Bot1.Battlefield.Mountain.Activate
! Bot1.Hand.Feint.Cast(Bot1.Battlefield.Ornithopter)
Bot1.Hand.Feint.Cast(Bot2.Battlefield.Memnite)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
Bot1.Block(Memnite > Memnite)
[T4 Bot2.Main2]
? Bot1.Battlefield.Memnite.Damage = 0
? Bot2.Battlefield.Memnite.Damage = 0
[T6 Bot2.DeclareAttackers]
Bot2.Attack(Memnite > Bot1)
Bot1.Block(Memnite > Memnite)
[T6 Bot2.Main2]
[Expect]
Bot1.Graveyard.Memnite.Power = 1
Bot2.Graveyard.Memnite.Power = 1
Bot1.Life = 20
