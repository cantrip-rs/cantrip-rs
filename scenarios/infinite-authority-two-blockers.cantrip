# Two blockers survive combat damage, then are destroyed at end of combat; each yields a counter at end step (CR 603.2).
[Bot1 Deck]
Infinite Authority
Black Lotus
Memnite
Plains x20
[Bot2 Deck]
Ornithopter x2
Island x20
[Actions]
Bot1.Hand.Memnite.Cast
Bot1.Hand.Plains.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: White)
! Bot1.Hand.Infinite Authority.Cast(Bot1.Battlefield.Plains)
Bot1.Hand.Infinite Authority.Cast(Bot1.Battlefield.Memnite)
? Bot1.Mana =
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Memnite > Bot2)
Bot2.Block(Ornithopter#1 > Memnite; Ornithopter#2 > Memnite)
[T3 Bot1.Main2]
? Bot2.Graveyard.Count = 2
? Bot1.Battlefield.Memnite.Power = 1
[T4 Bot2.Main1]
[Expect]
Bot1.Battlefield.Memnite.Power = 3
Bot1.Battlefield.Memnite.Toughness = 3
Bot1.Battlefield.Infinite Authority.AttachedTo = Memnite
