# "Draw a card for each one they gained control of this way": Bot1 aims the trigger at Mox Ruby and a Lotus Petal, then sacrifices the Petal for mana in response, so only the Ruby is still a legal target
# when the ability resolves (CR 608.2b) and Bot2 gains just that one; Bot1 draws one card, not two (hand 1 -> 2).

[Bot1 Deck]
Coveted Falcon
Mox Ruby
Mox Jet
Mox Pearl
Mox Sapphire
Mox Emerald
Lotus Petal
Island x14

[Bot2 Deck]
Ornithopter
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Coveted Falcon.Cast(Ability: Disguise)
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Lotus Petal.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.#1.Activate(Ability: disguise cost)
Bot1.Target(Bot2)
? Bot1.Hand.Count = 1
Bot1.Target(Mox Ruby; Lotus Petal)
Bot1.Battlefield.Lotus Petal.Activate(Color: Black)
Bot1.Pass
Bot2.Pass
? Bot1.Hand.Count = 2

[Expect]
Bot2.Battlefield = Ornithopter; Mox Ruby
Bot1.Hand.Count = 2
