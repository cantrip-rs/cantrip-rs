# "Whenever you cast a spell during an opponent's turn, up to one target creature an opponent controls gets -1/-1 until end of turn" (CR 603.2, 611.2a).
# On Bot2's turn 2 Bot2's own Ornithopters (0/2) trigger nothing; Bot1's Shock, in response to the second, does, and the first Ornithopter is -1/1 until
# the turn ends, then 0/2 again. On Bot1's own turn 3 a second Shock triggers nothing. The Spoilers has flying; its own team is not a target.

[Bot1 Deck]
Black Lotus
Mox Jet
Mox Ruby
Dream Spoilers
Shock x2
Swamp x20

[Bot2 Deck]
Ornithopter x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Dream Spoilers.Cast
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Dream Spoilers.Keywords = Flying
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot1.Pass
? Bot2.Battlefield.Ornithopter.Power = 0
? Bot2.Battlefield.Ornithopter.Toughness = 2
Bot2.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Shock.Cast(Bot2)
! Bot1.Target(Dream Spoilers)
Bot1.Target(Bot2.Battlefield.Ornithopter)
? Stack.Count = 3
Bot1.Pass
Bot2.Pass
? Bot2.Battlefield.Ornithopter.Power = -1
? Bot2.Battlefield.Ornithopter.Toughness = 1
[T3 Bot1.Main1]
? Bot2.Battlefield.Ornithopter#1.Toughness = 2
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Shock.Cast(Bot2)
? Stack.Count = 1
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 16
Bot2.Battlefield.Ornithopter#1.Toughness = 2
Bot2.Battlefield.Ornithopter#2.Toughness = 2
