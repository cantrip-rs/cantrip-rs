# Ferrous Lake: "{1}, {T}: Add {U}{R}." Turn 1 it is the only land, so the ability is not offered - it needs one
# mana. Turn 3 an Island pays the {1} and the Lake adds one blue and one red: {U}{R}, the fixed pair, never two of
# one color.

[Bot1 Deck]
Ferrous Lake
Island x19

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Ferrous Lake.Play
! Bot1.Battlefield.Ferrous Lake.Activate(Ability: {1}, {T}; Mana: short)
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Ferrous Lake.Activate(Ability: {1}, {T})
Bot1.Choose(Close mana window)
Bot1.Choose(Pay mana)
? Bot1.Mana = {U}{R}
! Bot1.Battlefield.Ferrous Lake.Activate(Ability: {1}, {T})

[Expect]
Turn = 3
Bot1.Battlefield.Ferrous Lake.Tapped = true
