Stack.Count = 0
Bot1.Battlefield = Mox Emerald; Mox Jet; Mox Ruby; Varmint Token; Varmint Token
Bot1.Battlefield.Varmint Token#1.Power = 2
Bot1.Battlefield.Varmint Token#2.Power = 2
Bot1.Battlefield.Varmint Token#1.Toughness = 1
Bot1.Battlefield.Varmint Token#2.Toughness = 1
