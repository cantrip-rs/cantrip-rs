Bot1.Battlefield.Mox Ruby.Activate
Bot1.Pass
Bot2.Pass
Bot1.Hand.Fatal Push.Cast(Bot1.Battlefield.Ornithopter)
Bot1.Battlefield.Mox Jet.Activate
Bot1.Pass
Bot2.Pass
? Bot1.Graveyard.Count = 4
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Memnite.Cast
Bot2.Hand.Lightning Bolt.Cast(Memnite)
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Pass
Bot1.Pass
? Bot2.Graveyard.Count = 2
[T3 Bot1.Main1]
Bot1.Hand.Rise of the Varmints.Activate(Ability: Plot)
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
? Exile = Rise of the Varmints
[T5 Bot1.Main1]
Bot1.Exile.Rise of the Varmints.Cast
Bot1.Pass
Bot2.Pass

