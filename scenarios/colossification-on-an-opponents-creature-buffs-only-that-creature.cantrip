# Colossification on Bot2's Memnite: "enchanted creature" is whichever creature it is attached to, so the opponent's Memnite is
# tapped and 21/21 while Bot1's own Memnite, beside it, stays 1/1 and untapped. Bot2 casts its free Memnite on turn 2 and Bot1
# enchants it on turn 3 with Black Lotus's {G}{G}{G} and the four Moxen.

[Bot1 Deck]
Island
Mox Emerald
Mox Pearl
Mox Jet
Mox Ruby
Memnite
Colossification
Black Lotus
Island x14

[Bot2 Deck]
Memnite
Island x19

[Actions]
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Colossification.Cast(Bot2.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Battlefield.Colossification = (absent)
Bot1.Battlefield.Colossification.AttachedTo = Memnite
Bot2.Battlefield.Memnite.Tapped = true
Bot2.Battlefield.Memnite.Power = 21
Bot2.Battlefield.Memnite.Toughness = 21
Bot1.Battlefield.Memnite.Tapped = false
Bot1.Battlefield.Memnite.Power = 1
Bot1.Battlefield.Memnite.Toughness = 1
