# Life Matrix can target an opponent's creature; that creature's controller can activate its
# granted ability, removing its counter to regenerate (CR 602.2). The matrix itself remains under Bot1's control.
[Bot1 Deck]
Life Matrix
Black Lotus
Mox Pearl
Mox Ruby
Mox Jet
Mox Sapphire
Island
Island x20

[Bot2 Deck]
Ornithopter
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Life Matrix.Cast
Bot1.Choose(Close mana window)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Upkeep]
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Life Matrix.Activate(Bot2.Battlefield.Ornithopter)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
? Bot2.Battlefield.Ornithopter.Counters.Matrix = 1
Bot1.Pass
Bot2.Battlefield.Ornithopter.Activate(Ability: Remove a matrix counter)
? Bot2.Battlefield.Ornithopter.Counters.Matrix = (absent)
Bot2.Pass
Bot1.Pass

[Expect]
Bot2.Battlefield.Ornithopter.Counters.Matrix = (absent)
Bot1.Battlefield.Life Matrix.Tapped = true
