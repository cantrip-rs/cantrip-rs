# Paying exactly two mana creates a shield that replaces Lightning Bolt's lethal damage destruction, tapping the Statue
# and removing its damage; the ability is refused once both available sources have been spent.

[Bot1 Deck]
Black Lotus
Mox Pearl
Mox Ruby
Mox Sapphire
Clay Statue
Island x15

[Bot2 Deck]
Mountain
Lightning Bolt
Island x18

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Clay Statue.Cast
Bot1.Choose(Close mana window)
? Bot1.Mana =
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Clay Statue)
Bot2.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Clay Statue.Activate
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
! Bot1.Battlefield.Clay Statue.Activate(Mana: short)
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main2]

[Expect]
Bot1.Battlefield.Clay Statue.Tapped = true
Bot1.Battlefield.Clay Statue.Damage = 0
Bot2.Graveyard = Lightning Bolt
