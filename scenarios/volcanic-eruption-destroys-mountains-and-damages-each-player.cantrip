# Destroy both players' Mountains with X=2, then deal two damage to each player (CR 701.8a, 120.3).
[Bot1 Deck]
Mountain
Island
Black Lotus
Mox Sapphire
Volcanic Eruption
Ornithopter
Island
Island x10

[Bot2 Deck]
Mountain
Ornithopter
Island x10

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Island.Activate
Bot1.Hand.Volcanic Eruption.Cast(X: 2)
! Bot1.Target(Count: 1)
Bot1.Target(Bot1.Battlefield.Mountain; Bot2.Battlefield.Mountain)
Bot1.Choose(Close mana window)
? Bot1.Mana =
Bot1.Pass

[Expect]
Bot1.Life = 18
Bot2.Life = 18
Bot1.Graveyard = Ornithopter; Volcanic Eruption; Mountain; Black Lotus
Bot2.Graveyard = Ornithopter; Mountain
