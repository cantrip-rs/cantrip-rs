Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Echo, Perceptive Prodigy.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Memnite.Cast
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Felonious Rage.Cast(Memnite)
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Memnite)
Bot1.Pass
Bot2.Pass
? Stack.Count = 1
! Bot1.Battlefield.Echo, Perceptive Prodigy.Activate
Bot1.Pass
Bot2.Pass

