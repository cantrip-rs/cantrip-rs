Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Smuggler's Copter.Cast
Bot1.Hand.Rocky Roads.Play
? Bot1.Battlefield.Rocky Roads.Tapped = false
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
! Bot1.Battlefield.Rocky Roads.Activate(Ability: Sacrifice; Mana: short)
[T3 Bot1.Upkeep]
! Bot1.Battlefield.Rocky Roads.Activate(Ability: Sacrifice)
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Rocky Roads.Activate(Ability: Sacrifice)
Bot1.Pass
Bot2.Pass

