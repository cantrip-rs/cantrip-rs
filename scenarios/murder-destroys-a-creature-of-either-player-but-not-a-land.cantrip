! Bot1.Hand.Murder.Cast(Bot2.Battlefield.Island)
Bot1.Hand.Murder.Cast(Bot1.Battlefield.Ornithopter)
? Bot1.Mana =
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
