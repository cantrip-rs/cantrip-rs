# An illegal only target makes Enervate do nothing, including creating no delayed draw (CR 608.2b).
# A second Enervate resolves on a legal land and creates exactly one draw at the next upkeep.
[Bot1 Deck]
Mox Sapphire x2
Mox Pearl x2
Enervate x2
Island x20

[Bot2 Deck]
Mountain
Ornithopter
Lightning Bolt
Island x20

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Pearl.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Sapphire#1.Activate
Bot1.Battlefield.Mox Pearl#1.Activate
Bot1.Hand.Enervate.Cast(Bot2.Battlefield.Ornithopter)
? Bot1.Mana =
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Ornithopter)
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Pass
? Bot2.Graveyard = Ornithopter; Lightning Bolt
Bot1.Battlefield.Mox Sapphire#2.Activate
Bot1.Battlefield.Mox Pearl#2.Activate
Bot1.Hand.Enervate.Cast(Bot2.Battlefield.Mountain)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
? Bot1.Hand.Count = 1
[T3 Bot1.Main1]
[Expect]
Bot1.Hand.Count = 3
Bot1.Graveyard = Enervate; Enervate
