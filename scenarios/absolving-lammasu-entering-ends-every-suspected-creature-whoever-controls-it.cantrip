Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Case of the Stashed Skeleton.Cast
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Skeleton Token.Suspected = true
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.J. Jonah Jameson.Cast
Bot1.Pass
Bot2.Pass
Bot1.Target(Memnite)
Bot1.Pass
Bot2.Pass
? Bot2.Battlefield.Memnite.Suspected = true
? Bot2.Battlefield.Ornithopter.Suspected = (absent)
[T5 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Absolving Lammasu.Cast
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Skeleton Token.Suspected = (absent)
? Bot2.Battlefield.Memnite.Suspected = (absent)

