# Unfortunate Accident with both modes: Bot2 answers by Lightning Bolting its own Memnite, so the only target is gone. A spell
# with targets whose targets are all illegal does not resolve at all (CR 608.2b), even a mode that needs no target: no Mercenary
# token is created (the Spree ruling of 2024-04-12 says the same).

[Bot1 Deck]
Mox Jet
Mox Jet
Mox Ruby
Mox Pearl
Mox Emerald
Unfortunate Accident
Swamp x1
Swamp x15

[Bot2 Deck]
Mox Ruby
Memnite
Lightning Bolt
Island x20

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Memnite.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Jet#1.Activate
Bot1.Battlefield.Mox Jet#2.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Unfortunate Accident.Cast
Bot1.Modes(1; 2)
Bot1.Target(Bot2.Battlefield.Memnite)
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Memnite)
Bot2.Pass
Bot1.Pass
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Graveyard = Memnite; Lightning Bolt
Bot1.Battlefield.Count = 5
Bot1.Graveyard = Unfortunate Accident
