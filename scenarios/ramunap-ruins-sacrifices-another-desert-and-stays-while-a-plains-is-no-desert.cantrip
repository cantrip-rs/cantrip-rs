# The sacrifice is "a Desert": with two Ramunap Ruins and a Plains in play, the first Ruins activates and may sacrifice the
# second but not the Plains (refused), so the first stays on the battlefield tapped and Bot2 takes 2.

[Bot1 Deck]
Ramunap Ruins
Ramunap Ruins
Plains
Black Lotus
Mox Ruby
Plains x16

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Ramunap Ruins.Play
[T3 Bot1.Main1]
Bot1.Hand.Plains.Play
[T5 Bot1.Main1]
Bot1.Hand.Ramunap Ruins.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Ramunap Ruins#1.Activate(Ability: Sacrifice a Desert)
! Bot1.Choose(Plains)
Bot1.Choose(Tap Ramunap Ruins)
Bot1.Choose(Ramunap Ruins#2)
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Life = 18
Bot1.Battlefield.Ramunap Ruins.Tapped = true
Bot1.Battlefield.Plains.Tapped = false
