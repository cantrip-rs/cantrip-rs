# Destroying the original leaves its token; destroying that token then makes its Dance be sacrificed (CR 607.1).

[Bot1 Deck]
Ornithopter
Mox Sapphire x2
Dance of Many
Island x20

[Bot2 Deck]
Lightning Bolt x2
Mox Ruby x2
Island x20

[Actions]
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Sapphire#1.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Sapphire#1.Activate
Bot1.Battlefield.Mox Sapphire#2.Activate
Bot1.Hand.Dance of Many.Cast
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby#1.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot1.Pass
Bot2.Battlefield.Mox Ruby#1.Activate
Bot2.Hand.Lightning Bolt#1.Cast(Bot1.Battlefield.Ornithopter#1)
Bot2.Pass
Bot1.Pass
? Bot1.Battlefield.Ornithopter.Token = true
Bot2.Battlefield.Mox Ruby#2.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Ornithopter)
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Pass

[Expect]
Bot1.Graveyard = Dance of Many; Ornithopter
Bot1.Battlefield.Count = 2
