# Goblin Surprise, second mode: "Create two 1/1 red Goblin creature tokens." Cast at the end of Bot2's turn, it leaves two 1/1 red Goblins
# under Bot1's control, and Bot1's Memnite stays a 1/1 (the other mode's pump is not applied).

[Bot1 Deck]
Mox Ruby x3
Memnite
Goblin Surprise
Mountain x12

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.End]
Bot1.Battlefield.Mox Ruby#1.Activate
Bot1.Battlefield.Mox Ruby#2.Activate
Bot1.Battlefield.Mox Ruby#3.Activate
Bot1.Hand.Goblin Surprise.Cast
Bot1.Modes(Create two 1/1 red Goblin creature tokens)
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield = Goblin Token; Goblin Token; Memnite; Mox Ruby; Mox Ruby; Mox Ruby
Bot1.Battlefield.Goblin Token#1.Power = 1
Bot1.Battlefield.Goblin Token#1.Toughness = 1
Bot1.Battlefield.Goblin Token#1.Colors = Red
Bot1.Battlefield.Goblin Token#2.Power = 1
Bot1.Battlefield.Memnite.Power = 1
