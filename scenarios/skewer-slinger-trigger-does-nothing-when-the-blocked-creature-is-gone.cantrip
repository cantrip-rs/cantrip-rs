# Skewer Slinger blocks Bot2's attacking Llanowar Elves. With the trigger on the stack Bot2 Lightning Bolts its own Elves, so
# the creature is gone as the trigger resolves and it deals no damage (CR 400.7): the Slinger is undamaged and Bot1 takes
# no combat damage (the attacker is gone, CR 506.4).

[Bot1 Deck]
Mox Ruby
Mox Jet
Skewer Slinger
Mountain x17

[Bot2 Deck]
Forest
Mox Ruby
Llanowar Elves
Lightning Bolt
Forest x16

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Skewer Slinger.Cast
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Llanowar Elves.Cast
Bot2.Battlefield.Forest.Activate
[T4 Bot2.DeclareAttackers]
Bot2.Attack(Llanowar Elves > Bot1)
Bot1.Block(Skewer Slinger > Llanowar Elves)
? Stack.Count = 1
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Llanowar Elves)
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Pass
? Stack.Count = 0
[T4 Bot2.Main2]

[Expect]
Bot2.Graveyard = Llanowar Elves; Lightning Bolt
Bot1.Life = 20
Bot1.Battlefield.Skewer Slinger.Damage = 0
