Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Guarded Heir.Cast
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Knight Token = (absent)
? Stack.Count = 1
Bot1.Pass
Bot2.Pass
? Stack.Count = 0
? Bot1.Battlefield.Count = 6

