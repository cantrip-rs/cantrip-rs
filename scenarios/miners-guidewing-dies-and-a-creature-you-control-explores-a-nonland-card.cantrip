! Bot1.Target(Bot1.Battlefield.Mox Pearl)
Bot1.Target(Bot1.Battlefield.Memnite)
Bot1.Accept

[Expect]
Bot1.Graveyard = Memnite; Miner's Guidewing; Lightning Bolt
Bot1.Battlefield.Memnite.Counters.PlusOnePlusOne = 1
Bot1.Battlefield.Memnite.Power = 2
Bot1.Battlefield.Memnite.Toughness = 2
Bot1.Battlefield.Ornithopter.Power = 0
