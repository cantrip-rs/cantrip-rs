# Over the Edge, mode 2 with two lands on top: each explore reveals a land (CR 701.44a) and puts it into the hand, so the Elvish Mystic gets no
# counter and no question is asked.

[Bot1 Deck]
Forest
Mox Ruby
Elvish Mystic
Over the Edge
Island
Island
Island
Island
Mountain
Swamp
Island x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Elvish Mystic.Cast
[T2 Bot2.Main1]

[T3 Bot1.Main1]
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Over the Edge.Cast
Bot1.Modes(2)
Bot1.Target(Bot1.Battlefield.Elvish Mystic)
! Bot1.Accept

[Expect]
Turn = 3
Stack.Count = 0
Bot1.Mana =
Bot1.Battlefield.Elvish Mystic.Power = 1
Bot1.Battlefield.Elvish Mystic.Counters.PlusOnePlusOne = (absent)
Bot1.Hand = Island; Island; Island; Island; Mountain; Swamp
Bot1.Library.Count = 10
