Bot2.Hand.Mountain.Play
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Rendclaw Trow)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Rendclaw Trow.Counters.MinusOneMinusOne = 1
? Bot1.Battlefield.Rendclaw Trow.Power = 1
? Bot1.Battlefield.Rendclaw Trow.Toughness = 1
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Rendclaw Trow)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass

[Expect]
Stack.Count = 0
Bot1.Battlefield.Rendclaw Trow = (absent)
Bot1.Graveyard = Rendclaw Trow; Black Lotus
Bot2.Graveyard = Lightning Bolt; Lightning Bolt
