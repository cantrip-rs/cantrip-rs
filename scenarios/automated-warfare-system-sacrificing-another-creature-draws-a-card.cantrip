# Automated Warfare System: whenever it attacks, Bot1 may sacrifice another creature or artifact and draws if it does (CR 701.21a,
# 608.2c). Bot1 sacrifices its Aegis Turtle (a creature). The attacker itself, Bot2's Mox Ruby and Bot2's Dwarven Trader are
# not choices: "another" excludes the source and a player sacrifices only what they control (CR 701.21a). Bot1's Island is
# neither a creature nor an artifact, and the Turtle and Mox Sapphire can't both go: the sacrifice is of one.

[Bot1 Deck]
Mox Jet
Mox Jet
Mox Jet
Mox Sapphire
Automated Warfare System
Aegis Turtle
Island
Island x13

[Bot2 Deck]
Mox Ruby
Dwarven Trader
Island x18

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Jet#1.Activate
Bot1.Battlefield.Mox Jet#2.Activate
Bot1.Battlefield.Mox Jet#3.Activate
Bot1.Hand.Automated Warfare System.Cast
Bot1.Choose(Close mana window)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Aegis Turtle.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Dwarven Trader.Cast
[T3 Bot1.Main1]
Bot1.Attack(Automated Warfare System)
Bot1.Pass
! Bot1.Choose(Automated Warfare System)
! Bot1.Choose(Bot2.Battlefield.Mox Ruby)
! Bot1.Choose(Bot2.Battlefield.Dwarven Trader)
! Bot1.Choose(Island)
! Bot1.Choose(Aegis Turtle; Mox Sapphire)
Bot1.Choose(Aegis Turtle)
! Bot2.Block(Dwarven Trader > Automated Warfare System)
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield.Automated Warfare System.Tapped = true
Bot1.Battlefield.Aegis Turtle = (absent)
Bot1.Graveyard.Count = 1
Bot1.Hand.Count = 2
Bot1.Battlefield.Mox Sapphire.Tapped = false
Bot2.Life = 18
Bot2.Battlefield.Mox Ruby.Tapped = true
