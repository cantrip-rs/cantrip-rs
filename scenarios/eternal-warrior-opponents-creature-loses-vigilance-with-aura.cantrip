# The Aura grants vigilance to an opponent's enchanted creature, and removing the Aura ends the grant (CR 702.20b, 611.3b).

[Bot1 Deck]
Eternal Warrior
Mox Ruby
Mox Pearl
Disenchant
Plains x20

[Bot2 Deck]
Ornithopter
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Eternal Warrior.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Choose(Close mana window)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
[T4 Bot2.DeclareAttackers]
Bot2.Attack(Ornithopter > Bot1)
[T4 Bot2.Main2]
? Bot2.Battlefield.Ornithopter.Tapped = false
[T5 Bot1.Main1]
Bot1.Hand.Plains.Play
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Plains.Activate
Bot1.Hand.Disenchant.Cast(Bot1.Battlefield.Eternal Warrior)
Bot1.Pass
Bot2.Pass
[T6 Bot2.DeclareAttackers]
Bot2.Attack(Ornithopter > Bot1)
[T6 Bot2.Main2]

[Expect]
Bot2.Battlefield.Ornithopter.Tapped = true
Bot1.Graveyard = Disenchant; Eternal Warrior
