# Horizon Stone beside Ozai, the Phoenix King: two effects would replace the loss of Bot1's unspent mana as the main phase
# ends, one making it colorless and one red. The affected player chooses which applies (CR 616.1); once it has, the mana is
# not lost and the other has nothing to replace (CR 616.1f). Bot1 chooses Horizon Stone's: Black Lotus's {U}{U}{U} becomes
# {C}{C}{C}, not red. Bot2, with neither, loses its {G} as usual.

[Bot1 Deck]
Black Lotus x3
Mox Ruby x2
Ozai, the Phoenix King
Horizon Stone
Black Lotus
Mountain x15
[Bot2 Deck]
Mox Emerald x2
Mountain x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Ozai, the Phoenix King.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Hand.Mox Ruby#1.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Ruby#1.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Horizon Stone.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Emerald#1.Cast
Bot2.Battlefield.Mox Emerald#1.Activate
? Bot2.Mana = {G}
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
? Bot1.Mana = {U}{U}{U}
Bot1.Pass
Bot2.Pass
Bot1.Replace(Horizon Stone)

[Expect]
Bot1.Mana = {C}{C}{C}
Bot2.Mana =
