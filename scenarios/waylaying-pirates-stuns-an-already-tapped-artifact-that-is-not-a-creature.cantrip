# Waylaying Pirates: "target artifact or creature" - a noncreature artifact qualifies. Bot2's Mox Ruby, tapped for mana on Bot2's own turn,
# is chosen: it is already tapped so tapping does nothing, but the stun counter is put on it anyway (CR 122.1d). On turn 4 Bot2's untap
# step removes the counter instead of untapping the Mox, which stays tapped; Bot2's untouched Ornithopter has no counter.

[Bot1 Deck]
Island
Mox Sapphire
Mox Jet
Mox Ruby
Waylaying Pirates
Island
Island
Island x14

[Bot2 Deck]
Mox Ruby
Ornithopter
Island
Island x17

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Island.Play
[T3 Bot1.Main1]
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Waylaying Pirates.Cast
Bot1.Pass
? Bot2.Battlefield.Mox Ruby.Tapped = true
Bot1.Target(Bot2.Battlefield.Mox Ruby)
Bot1.Pass
Bot2.Pass
? Bot2.Battlefield.Mox Ruby.Tapped = true
? Bot2.Battlefield.Mox Ruby.Counters.Stun = 1
? Bot2.Battlefield.Ornithopter.Tapped = false
? Bot2.Battlefield.Ornithopter.Counters.Stun = (absent)
[T4 Bot2.Main1]

[Expect]
Bot2.Battlefield.Mox Ruby.Tapped = true
Bot2.Battlefield.Mox Ruby.Counters.Stun = (absent)
Bot2.Battlefield.Ornithopter.Tapped = false
