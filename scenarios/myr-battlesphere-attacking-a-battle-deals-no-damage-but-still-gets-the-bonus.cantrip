Bot1.Hand.Plains.Play
Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Sol Ring.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Hand.Myr Battlesphere.Cast
[T5 Bot1.Main1]
Bot1.Hand.Plains.Play
Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Sol Ring.Activate
Bot1.Hand.Invasion of Gobakhan.Cast
Bot1.Attack(Myr Battlesphere > Bot1.Battlefield.Invasion of Gobakhan)
Bot1.Choose(Myr Token#1; Myr Token#2)
? Bot1.Battlefield.Invasion of Gobakhan.Counters.Defense = 3
? Bot1.Battlefield.Myr Battlesphere.Power = 6
? Bot2.Life = 20
