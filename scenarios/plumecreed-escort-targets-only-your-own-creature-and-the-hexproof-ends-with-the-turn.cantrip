Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire#1.Activate
Bot1.Battlefield.Mox Sapphire#2.Activate
Bot1.Hand.Plumecreed Escort.Cast
Bot1.Pass
Bot2.Pass
! Bot1.Target(Bot2.Battlefield.Memnite)
? Bot1.Battlefield.Ornithopter.Keywords = Flying
Bot1.Target(Bot1.Battlefield.Plumecreed Escort)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Plumecreed Escort.Keywords = Flash; Flying; Hexproof
Bot2.Battlefield.Mox Ruby.Activate
! Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Plumecreed Escort)
[T4 Bot2.Main1]
? Bot1.Battlefield.Plumecreed Escort.Keywords = Flash; Flying
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Plumecreed Escort)
Bot2.Pass
Bot1.Pass

[Expect]
Bot1.Graveyard = Plumecreed Escort
