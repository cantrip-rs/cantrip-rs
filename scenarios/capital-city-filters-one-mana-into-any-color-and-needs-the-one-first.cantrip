# "{1}, {T}: Add one mana of any color": with no other mana the colored ability is refused (the City's own {T} cannot also pay
# its {1}); the plain colorless ability on turn 1 is the positive control. On turn 3 an Island's {U} pays the {1} and the City
# adds {R}: the pool is {R} alone, and both lands are tapped.

[Bot1 Deck]
Capital City
Island x6
Island x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Capital City.Play
! Bot1.Battlefield.Capital City.Activate(Ability: any color; Color: Red; Mana: short)
Bot1.Battlefield.Capital City.Activate(Ability: {T}: Add {C})
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Capital City.Activate(Ability: any color; Color: Red)
Bot1.Choose(Close mana window)
Bot1.Choose(Pay mana)
? Bot1.Mana = {R}
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield.Capital City.Tapped = true
Bot1.Battlefield.Island.Tapped = true
