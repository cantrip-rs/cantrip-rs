# Reach for the Sky: the enchanted Memnite (4/3, reach) can block Bot2's Ornithopter (0/2 flying) on turn 4 and kills it; without reach a Memnite
# could not block a flyer (CR 702.9b, 702.17b).

[Bot1 Deck]
Mox Jet
Mox Ruby
Mox Pearl
Mox Emerald
Memnite
Reach for the Sky
Plains
Plains x20

[Bot2 Deck]
Ornithopter
Island x21

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Reach for the Sky.Cast(Bot1.Battlefield.Memnite)
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Pass
Bot2.Pass
[T4 Bot2.DeclareAttackers]
Bot2.Attack(Ornithopter > Bot1)
[T4 Bot2.DeclareBlockers]
Bot1.Block(Memnite > Ornithopter)
[T4 Bot2.Main2]

[Expect]
Bot2.Graveyard = Ornithopter
Bot1.Life = 20
Bot1.Battlefield.Memnite.Power = 4
