# With a won coin flip, the Bottle is sacrificed for one mana and creates a 5/5 colorless flying artifact Djinn.
# The cost is paid while the ability is on the stack; the result happens on resolution.

[Bot1 Deck]
Black Lotus
Mox Pearl
Bottle of Suleiman
Island x17

[Bot2 Deck]
Memnite
Island x19

[Dice]
1

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Bottle of Suleiman.Cast
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
! Bot1.Battlefield.Bottle of Suleiman.Activate(Mana: short)
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Bottle of Suleiman.Activate
Bot1.Choose(Pay mana)
? Bot1.Mana =
? Bot1.Graveyard = Bottle of Suleiman; Black Lotus
? Stack.Count = 1
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Djinn Token.Tapped = false
[T5 Bot1.Main1]
Bot1.Attack(Djinn Token > Bot2)
! Bot2.Block(Memnite > Djinn Token)
[T5 Bot1.Main2]

[Expect]
Bot2.Life = 15
Bot1.Life = 20
Bot1.Battlefield.Djinn Token.Power = 5
Bot1.Battlefield.Djinn Token.Toughness = 5
Bot1.Battlefield.Djinn Token.Colors = (absent)
Bot1.Battlefield.Djinn Token.Types = Artifact; Creature
Bot1.Battlefield.Djinn Token.Subtypes = Djinn
Bot1.Battlefield.Djinn Token.Keywords = Flying
Bot1.Battlefield.Djinn Token.Token = true
