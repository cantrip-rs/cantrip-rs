# Spectral Interference: "target artifact or creature spell". Bot2's Lightning Bolt is neither, so with the mana there it is not
# offered against it (the refusal) and the Bolt resolves.

[Bot1 Deck]
Island
Mox Sapphire
Spectral Interference
Island x4
Island x13

[Bot2 Deck]
Mountain
Lightning Bolt
Mountain x18

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Sapphire.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1)
? Stack = Lightning Bolt
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Sapphire.Activate
! Bot1.Hand.Spectral Interference.Cast
Bot1.Pass

[Expect]
Turn = 2
Stack.Count = 0
Bot1.Life = 17
Bot2.Graveyard = Lightning Bolt
