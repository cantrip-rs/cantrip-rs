Bot1.Battlefield.Mox Ruby.Activate
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Ornithopter.Keywords = (absent)
? Bot2.Battlefield.Ornithopter.Keywords = (absent)
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Ornithopter#1.Keywords = (absent)
? Bot1.Battlefield.Ornithopter#2.Keywords = Flying
[T4 Bot2.Upkeep]
? Bot1.Battlefield.Ornithopter#1.Keywords = Flying
? Bot1.Battlefield.Ornithopter#2.Keywords = Flying
? Bot2.Battlefield.Ornithopter.Keywords = Flying

