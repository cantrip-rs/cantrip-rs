Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Bull Cerodon.Cast
Bot1.Pass
Bot1.Attack(Bull Cerodon > Bot2)
[T2 Bot2.End]
? Bot1.Battlefield.Bull Cerodon.Power = 5
? Bot1.Battlefield.Bull Cerodon.Toughness = 5
? Bot1.Battlefield.Bull Cerodon.Keywords = Haste; Vigilance
? Bot1.Battlefield.Bull Cerodon.Colors = Red; White
? Bot1.Battlefield.Bull Cerodon.Types = Creature
? Bot1.Battlefield.Bull Cerodon.Subtypes = Beast
