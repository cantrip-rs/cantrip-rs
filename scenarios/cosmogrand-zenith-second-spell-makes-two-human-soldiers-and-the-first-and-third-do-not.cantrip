# Cosmogrand Zenith: "Whenever you cast your second spell each turn, choose one - Create two 1/1 white Human Soldier
# creature tokens." Zenith comes down on turn 1 (the third spell of the turn, so it was not on the battlefield for the
# first two). On turn 3 the first spell, Mox Ruby, makes nothing; the second, Mox Sapphire, triggers and Bot1 takes the
# first mode: two Human Soldiers, white 1/1s, a name and creature types of their own. The third spell, Ornithopter,
# is a negative control: nothing more is made.

[Bot1 Deck]
Plains
Mox Pearl
Mox Jet
Cosmogrand Zenith
Mox Ruby
Mox Sapphire
Ornithopter
Plains x12

[Bot2 Deck]
Island x16

[Actions]
Bot1.Hand.Plains.Play
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Cosmogrand Zenith.Cast
[T3 Bot1.Main1]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Modes(Create two)
? Stack = Cosmogrand Zenith; Mox Sapphire
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
[T3 Bot1.Main2]

[Expect]
Turn = 3
Stack.Count = 0
Bot1.Battlefield.Human Soldier Token#1.Colors = White
Bot1.Battlefield.Human Soldier Token#1.Subtypes = Human; Soldier
Bot1.Battlefield.Human Soldier Token#2.Toughness = 1
Bot1.Battlefield.Human Soldier Token#1.Counters.PlusOnePlusOne = (absent)
Bot1.Battlefield.Human Soldier#3 = (absent)
Bot1.Battlefield.Cosmogrand Zenith.Power = 2
