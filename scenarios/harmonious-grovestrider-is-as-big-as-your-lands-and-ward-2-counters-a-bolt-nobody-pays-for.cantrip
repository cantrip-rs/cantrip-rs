? Bot1.Hand.Harmonious Grovestrider.Power = 0
Bot1.Hand.Forest.Play
? Bot1.Hand.Harmonious Grovestrider.Power = 1
? Bot1.Hand.Harmonious Grovestrider.Toughness = 1
