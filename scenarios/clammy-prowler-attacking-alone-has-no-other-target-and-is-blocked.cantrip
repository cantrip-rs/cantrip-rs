# Clammy Prowler's "another target attacking creature" can never be the Prowler itself: attacking alone on turn 3, its trigger
# has no legal target and is removed from the stack (CR 603.3d), so nothing is made unblockable. Bot2's Memnite blocks the
# Prowler (2/5) and dies, and Bot2 takes no damage.

[Bot1 Deck]
Mox Sapphire
Mox Pearl
Mox Jet
Mox Ruby
Clammy Prowler
Island x12

[Bot2 Deck]
Memnite
Island x16

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Clammy Prowler.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Clammy Prowler > Bot2)
Bot2.Block(Memnite > Clammy Prowler)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 20
Bot2.Battlefield.Memnite = (absent)
Bot2.Graveyard = Memnite
Bot1.Battlefield.Clammy Prowler.Damage = 1
