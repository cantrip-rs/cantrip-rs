# Gene Pollinator has two distinct tap costs: {T} and tap an untapped permanent you control.
# Pay the source tap first, then tap Ornithopter (CR 602.2b, 601.2h). These are two separate tap events,
# so Rewrite History triggers twice (CR 603.2c). The separate crew and convoke scenarios retain the
# one-trigger controls for multiple creatures tapped by a single instruction.

[Bot1 Deck]
Black Lotus
Rewrite History
Mox Emerald
Gene Pollinator
Ornithopter
Island x2
Island x15

[Bot2 Deck]
Forest x16

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Rewrite History.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Gene Pollinator.Cast
Bot1.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Gene Pollinator.Activate(Tap: Ornithopter; Color: Red)
Bot1.Choose(Tap Gene Pollinator)
Bot1.Choose(Ornithopter)
[Bot1.Main2]

[Expect]
Bot1.Battlefield.Gene Pollinator.Tapped = true
Bot1.Battlefield.Ornithopter.Tapped = true
Bot1.Battlefield.Rewrite History.Counters.Plan = 2
