# "Any target" includes the controller's own creatures (CR 115.1, 120.2b): Bot1 sacrifices one of its two Ornithopters and aims the
# reflexive trigger's 2 damage at the other, leaving Bot2's Ornithopter alone. Sacrificing both is refused: it is "a" permanent.

[Bot1 Deck]
Boilerbilges Ripper
Mox Ruby
Mox Pearl
Mox Sapphire
Mox Jet
Ornithopter
Ornithopter
Mountain x20

[Bot2 Deck]
Ornithopter
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Ornithopter.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Boilerbilges Ripper.Cast
? Bot1.Mana =
Bot1.Pass
Bot1.Pass
! Bot1.Choose(Ornithopter; Ornithopter)
Bot1.Choose(Ornithopter)
Bot1.Target(Bot1.Battlefield.Ornithopter)
Bot1.Pass

[Expect]
Bot1.Graveyard = Ornithopter; Ornithopter
Bot2.Battlefield = Ornithopter
Bot2.Life = 20
Bot1.Battlefield.Boilerbilges Ripper.Power = 4
