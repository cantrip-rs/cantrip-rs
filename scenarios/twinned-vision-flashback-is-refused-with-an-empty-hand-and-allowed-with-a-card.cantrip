Bot1.Pass
Bot1.Hand.Forest.Play
! Bot1.Graveyard.Twinned Vision.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Graveyard.Twinned Vision.Cast(Ability: Flashback)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Island)
