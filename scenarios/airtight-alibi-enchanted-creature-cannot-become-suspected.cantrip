# Airtight Alibi: "Enchanted creature ... can't become suspected." Bot1 enchants Memnite with the Alibi on turn 3 (3/3). On turn 5 J. Jonah Jameson's enters trigger
# targets that Memnite: the target is legal (the Alibi does not give hexproof past the turn it entered) but the suspect effect does nothing (CR 701.60, 101.2),
# so Memnite is not suspected and keeps its blocking ability.

[Bot1 Deck]
Mox Ruby
Mox Jet
Mox Emerald
Memnite
Airtight Alibi
J. Jonah Jameson
Island
Island x14

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Memnite.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Airtight Alibi.Cast(Bot1.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
[T5 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.J. Jonah Jameson.Cast
Bot1.Pass
Bot2.Pass
Bot1.Target(Memnite)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Memnite.Suspected = (absent)

[Expect]
Bot1.Battlefield.Memnite.Suspected = (absent)
Bot1.Battlefield.Memnite.Power = 3
Bot1.Battlefield.J. Jonah Jameson.Suspected = (absent)
