Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Mox Jet.Cast
Bot2.Hand.Mox Pearl.Cast
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Boosted Sloop.Cast
Bot2.Pass
Bot1.Pass
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Hand.Savannah Lions.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Savannah Lions > Bot2)
[T3 Bot1.Main2]
? Bot2.Graveyard.Count = 0
? Bot2.Life = 18
[T4 Bot2.DeclareAttackers]
Bot2.Attack(Savannah Lions > Bot1)
Bot2.Pass
Bot1.Pass
Bot2.Choose(Island)
[T4 Bot2.Main2]

[Expect]
Bot1.Life = 18
Bot2.Life = 18
Bot2.Hand = Forest; Mountain; Swamp
Bot2.Graveyard = Island
Bot2.Battlefield.Boosted Sloop.Types = Artifact
