# Gossip's Talent: the "whenever you attack" trigger is part of level 2 (CR 716.1): at level 1 there is no trigger, so Bot1's
# attacking Hill Giant can be blocked by Bot2's Ornithopter and Bot2 takes no damage.

[Bot1 Deck]
Black Lotus
Mox Ruby
Mox Sapphire
Mox Jet
Hill Giant
Gossip's Talent
Island
Island x14

[Bot2 Deck]
Island
Ornithopter
Island x20

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Hill Giant.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Island.Activate
Bot1.Hand.Gossip's Talent.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Hill Giant > Bot2)
Bot1.Pass
Bot2.Pass
? Stack.Count = 0
Bot2.Block(Bot2.Battlefield.Ornithopter > Bot1.Battlefield.Hill Giant)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 20
Bot2.Battlefield.Count = 0
