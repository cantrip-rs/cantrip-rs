# The Elemental's attack sets up its end-of-combat trigger: it survives through damage, then is
# sacrificed and deals 5 damage to its controller (CR 603.7, 701.21a).
[Bot1 Deck]
Time Elemental
Mox Sapphire
Mox Pearl
Mox Jet
Island x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Time Elemental.Cast
? Bot1.Mana =
Bot1.Pass
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Time Elemental)
[T3 Bot1.EndCombat]
? Bot1.Life = 20
? Bot1.Battlefield.Time Elemental.Power = 0
[T3 Bot1.Main2]
[Expect]
Bot1.Life = 15
Bot1.Graveyard = Time Elemental
Bot2.Life = 20
