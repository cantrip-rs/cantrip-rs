# Bolt Bend's own target must still be legal as it resolves (CR 608.2b). Bot1's Lightning Bolt at Bot2; Bot2 casts Bolt Bend
# on it and then Counterspell on the same Bolt. Counterspell resolves first and counters the Bolt (Bot1's graveyard), so
# Bolt Bend has no target left and does not resolve: it goes to the graveyard without changing anything. Nobody takes damage.

[Bot1 Deck]
Mox Ruby
Lightning Bolt
Island x18

[Bot2 Deck]
Mox Ruby
Mox Jet
Mox Pearl
Mox Emerald
Mox Sapphire
Island
Counterspell
Bolt Bend
Island x12

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Hand.Mox Jet.Cast
Bot2.Pass
Bot2.Hand.Mox Pearl.Cast
Bot2.Pass
Bot2.Hand.Mox Emerald.Cast
Bot2.Pass
Bot2.Hand.Mox Sapphire.Cast
Bot2.Pass
Bot2.Hand.Island.Play
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Hand.Bolt Bend.Cast(Stack.Lightning Bolt)
Bot2.Choose(Close mana window)
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Island.Activate
Bot2.Hand.Counterspell.Cast(Stack.Lightning Bolt)
Bot2.Pass
Bot1.Pass
Bot2.Pass
[Bot1.Main2]

[Expect]
Turn = 3
Stack.Count = 0
Bot1.Life = 20
Bot2.Life = 20
Bot1.Graveyard = Lightning Bolt
Bot2.Graveyard = Bolt Bend; Counterspell
