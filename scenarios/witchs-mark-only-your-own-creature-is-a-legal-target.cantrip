# Witch's Mark targets "up to one target creature you control" (CR 115.1, 601.2c): Bot2's Ornithopter is refused as the target while
# Bot1's own Ornithopter is accepted, so the Wicked Role ends on Bot1's creature and not on Bot2's.

[Bot1 Deck]
Mox Ruby
Mox Jet
Ornithopter
Witch's Mark
Mountain x16

[Bot2 Deck]
Ornithopter
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Ornithopter.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
! Bot1.Hand.Witch's Mark.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Hand.Witch's Mark.Cast(Bot1.Battlefield.Ornithopter)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Pass
Bot2.Pass
Bot1.Choose()

[Expect]
Bot1.Battlefield = Mox Jet; Mox Ruby; Ornithopter; Wicked
Bot1.Battlefield.Wicked.AttachedTo = Ornithopter
Bot2.Battlefield = Ornithopter
Bot2.Battlefield.Ornithopter.Power = 0
