# Thunderhead Gunner (4/5 reach, "Discard a card: Draw a card. Activate only as a sorcery and only once each turn"): cast on turn 1
# off five Moxen, Bot1 discards the Swamp to draw an Island in its main phase, and a second activation the same turn is not offered
# (once each turn). It is not offered on Bot2's turn with Bot2's spell on the stack, nor in Bot1's own declare-attackers step on turn 3
# (not a main phase). In the second main phase of turn 3 the ability works again (the limit is per turn): Island discarded, Island drawn,
# and then once more refused.

[Bot1 Deck]
Mox Ruby
Mox Jet
Mox Sapphire
Mox Pearl
Mox Emerald
Thunderhead Gunner
Swamp
Island
Island x20

[Bot2 Deck]
Mox Ruby
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Thunderhead Gunner.Cast
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Thunderhead Gunner.Keywords = Reach
Bot1.Battlefield.Thunderhead Gunner.Activate
Bot1.Choose(Swamp)
Bot1.Pass
Bot2.Pass
? Bot1.Hand = Island
? Bot1.Graveyard.Count = 1
! Bot1.Battlefield.Thunderhead Gunner.Activate
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
! Bot1.Battlefield.Thunderhead Gunner.Activate
[T3 Bot1.Main1]
Bot1.Attack(Thunderhead Gunner > Bot2)
! Bot1.Battlefield.Thunderhead Gunner.Activate
[T3 Bot1.Main2]
Bot1.Battlefield.Thunderhead Gunner.Activate
Bot1.Choose(Island)
Bot1.Pass
Bot2.Pass
? Bot1.Hand.Count = 2
? Bot1.Graveyard.Count = 2
! Bot1.Battlefield.Thunderhead Gunner.Activate

[Expect]
Bot2.Life = 16
Bot1.Hand = Island; Island
Bot1.Graveyard.Count = 2
