? Bot2.Battlefield.Mox Ruby.Tapped = false
? Bot2.Battlefield.Mox Ruby.Counters.Stun = (absent)
[T4 Bot2.Main1]

[Expect]
Bot2.Battlefield.Ornithopter.Tapped = true
Bot2.Battlefield.Ornithopter.Counters.Stun = (absent)
Bot2.Battlefield.Mox Ruby.Tapped = false
