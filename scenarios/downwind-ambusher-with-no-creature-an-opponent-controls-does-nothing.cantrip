# Downwind Ambusher: both modes target a creature an opponent controls. Bot2 controls none (Bot1's own Memnite is no target),
# so the enters trigger has no legal mode, is not put on the stack and nothing happens: Bot1's Memnite is unharmed.

[Bot1 Deck]
Mox Jet
Mox Pearl
Mox Ruby
Mox Sapphire
Memnite
Downwind Ambusher
Swamp x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Pass
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Downwind Ambusher.Cast
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield = Downwind Ambusher; Memnite; Mox Jet; Mox Pearl; Mox Ruby; Mox Sapphire
Bot1.Battlefield.Memnite.Toughness = 1
Stack.Count = 0
