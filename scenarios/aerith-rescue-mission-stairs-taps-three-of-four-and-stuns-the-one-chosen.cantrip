# Aerith Rescue Mission, Take 59 Flights of Stairs: up to three targets (a fourth is refused, CR 601.2c): all three Ornithopters tap together
# (CR 701.26a) and only the one Bot1 chooses as the spell resolves (CR 608.2d, the ruling) gets the stun counter (CR 122.1d).

[Bot1 Deck]
Mox Pearl
Mox Jet
Mox Ruby
Mox Sapphire
Aerith Rescue Mission
Island x15

[Bot2 Deck]
Ornithopter x4
Island x16

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Sapphire.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter#1.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Ornithopter#1.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Ornithopter#1.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Aerith Rescue Mission.Cast
Bot1.Modes(Take 59 Flights of Stairs)
! Bot1.Target(Ornithopter#1; Ornithopter#2; Ornithopter#3; Ornithopter#4)
Bot1.Target(Ornithopter#1; Ornithopter#2; Ornithopter#3)
Bot1.Pass
Bot2.Pass
Bot1.Choose(Ornithopter#3)

[Expect]
Bot2.Battlefield.Ornithopter#1.Tapped = true
Bot2.Battlefield.Ornithopter#2.Tapped = true
Bot2.Battlefield.Ornithopter#3.Tapped = true
Bot2.Battlefield.Ornithopter#4.Tapped = false
Bot2.Battlefield.Ornithopter#3.Counters.Stun = 1
