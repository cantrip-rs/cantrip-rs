Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Faithless Looting.Cast
Bot1.Pass
Bot1.Choose(Griselbrand; Swamp)
[T3 Bot1.Main1]
Bot1.Hand.Swamp.Play
Bot1.Hand.Deadly Cover-Up.Cast
Bot1.Modes(Collect evidence)
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Swamp.Activate
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Griselbrand)
Bot1.Pass
Bot1.Choose(Island)
Bot1.Choose(Island; Island)
Bot1.Search(Island; Island; Island)
[T3 Bot1.Main2]

[Expect]
Exile.Count = 7
Bot2.Graveyard.Count = 0
Bot2.Hand.Count = 7
Bot2.Library.Count = 7
