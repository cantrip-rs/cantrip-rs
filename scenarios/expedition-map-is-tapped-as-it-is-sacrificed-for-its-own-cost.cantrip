Island x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Hand.Expedition Map.Cast
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island#1.Activate
Bot1.Battlefield.Island#2.Activate
Bot1.Battlefield.Expedition Map.Activate
Bot1.Choose(Pay mana)
Bot1.Choose(Tap Expedition Map)
Bot1.Choose(Pay mana)
? LeftBattlefield = Expedition Map (tapped)
Bot1.Search(Mountain)

[Expect]
LeftBattlefield = Expedition Map (tapped)
Bot1.Graveyard = Expedition Map
Bot1.Battlefield = Island; Island
Bot1.Hand = Island; Island; Island; Island; Island; Mountain
