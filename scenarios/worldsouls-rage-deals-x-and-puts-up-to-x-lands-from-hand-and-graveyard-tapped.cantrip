Bot2.Pass
! Bot1.Choose(Mountain; Forest; Island)
Bot1.Choose(Mountain; Forest)
? Bot2.Life = 18
? Bot1.Battlefield.Mountain.Tapped = true
? Bot1.Battlefield.Forest.Tapped = true

[Expect]
