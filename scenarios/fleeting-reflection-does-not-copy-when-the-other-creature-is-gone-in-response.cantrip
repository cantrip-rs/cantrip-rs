# Fleeting Reflection with its second target gone (CR 608.2b): Bot1's tapped attacking Memnite and Bot2's Ornithopter are targeted, then
# Bot1's own Lightning Bolt kills the Ornithopter in response. The spell still resolves for the Memnite: it gains hexproof and untaps,
# but copies nothing, so it stays a 1/1 Memnite and deals 1 damage.

[Bot1 Deck]
Island
Memnite
Mox Jet
Mox Ruby
Fleeting Reflection
Lightning Bolt
Island x11

[Bot2 Deck]
Ornithopter
Island x15

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Memnite.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Attack(Memnite > Bot2)
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Fleeting Reflection.Cast
Bot1.Target(Memnite)
Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]
? Bot1.Battlefield.Memnite.Tapped = false
? Bot1.Battlefield.Memnite.Power = 1
? Bot1.Battlefield.Memnite.Keywords = Hexproof
? Bot2.Life = 19

[Expect]
Bot2.Graveyard = Ornithopter
Bot1.Graveyard = Fleeting Reflection; Lightning Bolt
Stack.Count = 0
