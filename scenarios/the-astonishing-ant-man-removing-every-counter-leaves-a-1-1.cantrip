Stack.Count = 0
Bot1.Battlefield = Insect Token; Mox Emerald; Mox Pearl; Mox Ruby; Mox Sapphire; The Astonishing Ant-Man
Bot1.Battlefield.The Astonishing Ant-Man.Power = 1
Bot1.Battlefield.The Astonishing Ant-Man.Tapped = true
