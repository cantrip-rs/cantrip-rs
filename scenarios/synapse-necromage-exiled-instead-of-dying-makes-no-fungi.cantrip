# Synapse Necromage: "When this creature dies" (CR 700.4): Bot2's Swords to Plowshares exiles it, so it does not die and Bot1 gets no
# Fungus tokens (only the 3 life from the Swords, 23).

[Bot1 Deck]
Mox Jet
Mox Pearl
Mox Ruby
Synapse Necromage
Swamp x20

[Bot2 Deck]
Mox Pearl
Swords to Plowshares
Plains x20

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Synapse Necromage.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Pearl.Cast
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Hand.Swords to Plowshares.Cast(Bot1.Battlefield.Synapse Necromage)
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Pass

[Expect]
Bot1.Battlefield.Count = 3
Bot1.Exile.Synapse Necromage.Power = 3
Bot1.Graveyard.Count = 0
Bot1.Life = 23
