# Aerial Responder, a french vanilla creature: cast with Black Lotus mana, its characteristics as printed (power, toughness,
# keywords, colors, types, protection), then attacking Bot2, who has no creatures.
# Lifelink (CR 702.15b): Bot1 gains as much life as it deals.
# Vigilance (CR 702.20b): attacking doesn't tap it.

[Bot1 Deck]
Black Lotus
Aerial Responder
Plains x22

[Bot2 Deck]
Island x24

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Hand.Aerial Responder.Cast
Bot1.Pass
[T2 Bot2.End]
? Bot1.Battlefield.Aerial Responder.Power = 2
? Bot1.Battlefield.Aerial Responder.Toughness = 3
? Bot1.Battlefield.Aerial Responder.Keywords = Flying; Lifelink; Vigilance
? Bot1.Battlefield.Aerial Responder.Colors = White
? Bot1.Battlefield.Aerial Responder.Types = Creature
? Bot1.Battlefield.Aerial Responder.Subtypes = Dwarf; Soldier
? Bot1.Battlefield.Aerial Responder.Supertypes = (absent)
? Bot1.Battlefield.Aerial Responder.ProtectionFrom = (absent)
[T3 Bot1.Main1]
Bot1.Attack(Aerial Responder > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 18
Bot1.Life = 22
Bot1.Battlefield.Aerial Responder.Tapped = false
