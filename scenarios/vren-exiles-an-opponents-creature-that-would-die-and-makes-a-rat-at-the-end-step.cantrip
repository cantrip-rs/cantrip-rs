Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Vren, the Relentless.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Llanowar Elves.Cast
[T3 Bot1.Main1]
? Bot2.Battlefield.Llanowar Elves.Power = 1
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Llanowar Elves)
Bot1.Pass
Bot2.Pass
? Bot2.Graveyard.Count = 0
? Exile = Llanowar Elves
? Bot1.Battlefield.Count = 4
[T3 Bot1.End]
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Rat Token.Power = 2
[T4 Bot2.End]
Bot2.Pass
Bot1.Pass

[Expect]
Exile = Llanowar Elves
Bot2.Graveyard.Count = 0
Bot1.Battlefield.Count = 5
Bot1.Battlefield.Rat Token.Power = 2
Bot1.Battlefield.Rat Token.Toughness = 2
Bot1.Battlefield.Rat Token.Token = true
Bot1.Battlefield.Vren, the Relentless.Power = 3
Bot1.Battlefield.Vren, the Relentless.Toughness = 4
