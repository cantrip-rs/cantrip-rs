# Sunblade Angel, a french vanilla creature: cast with Black Lotus mana, its characteristics as printed (power, toughness,
# keywords, colors, types, protection), then attacking Bot2, who has no creatures.
# Lifelink (CR 702.15b): Bot1 gains as much life as it deals.
# Vigilance (CR 702.20b): attacking doesn't tap it.

[Bot1 Deck]
Black Lotus x2
Sunblade Angel
Plains x21

[Bot2 Deck]
Island x24

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus#2.Activate(Color: White)
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Hand.Sunblade Angel.Cast
Bot1.Pass
[T2 Bot2.End]
? Bot1.Battlefield.Sunblade Angel.Power = 3
? Bot1.Battlefield.Sunblade Angel.Toughness = 3
? Bot1.Battlefield.Sunblade Angel.Keywords = FirstStrike; Flying; Lifelink; Vigilance
? Bot1.Battlefield.Sunblade Angel.Colors = White
? Bot1.Battlefield.Sunblade Angel.Types = Creature
? Bot1.Battlefield.Sunblade Angel.Subtypes = Angel
? Bot1.Battlefield.Sunblade Angel.Supertypes = (absent)
? Bot1.Battlefield.Sunblade Angel.ProtectionFrom = (absent)
[T3 Bot1.Main1]
Bot1.Attack(Sunblade Angel > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 17
Bot1.Life = 23
Bot1.Battlefield.Sunblade Angel.Tapped = false
