! Bot1.Battlefield.The Wandering Emperor.Activate
? Stack.Count = 0
? Bot1.Battlefield.The Wandering Emperor.Counters.Loyalty = 2
[T2 Bot2.End]
! Bot1.Battlefield.The Wandering Emperor.Activate
