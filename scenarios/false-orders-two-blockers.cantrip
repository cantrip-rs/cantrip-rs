# Removing one of two blockers leaves the attacker blocked (CR 509.1h).
[Bot1 Deck]
Mox Ruby
False Orders
Memnite
Island x20
[Bot2 Deck]
Memnite
Ornithopter
Island x20
[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Memnite.Cast
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Memnite > Bot2)
Bot2.Block(Memnite > Memnite; Ornithopter > Memnite)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.False Orders.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Decline
[T3 Bot1.Main2]
[Expect]
Bot2.Life = 20
Bot1.Graveyard = Memnite; False Orders
