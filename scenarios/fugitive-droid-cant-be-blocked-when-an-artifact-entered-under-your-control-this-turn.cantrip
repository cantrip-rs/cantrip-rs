# Fugitive Droid: "This creature can't be blocked if an artifact entered the battlefield under your control this turn." Bot1
# casts the Droid on turn 1; Bot2 casts Grizzly Bears on turn 2. On turn 3 Bot1 casts Mox Ruby before combat: the Bears may not
# block the Droid (Bot2 takes 1).

[Bot1 Deck]
Mox Sapphire
Mox Ruby
Fugitive Droid
Island x17

[Bot2 Deck]
Mox Emerald
Mox Ruby
Grizzly Bears
Island x17

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Fugitive Droid.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Emerald.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Grizzly Bears.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot1.Attack(Fugitive Droid > Bot2)
! Bot2.Block(Grizzly Bears > Fugitive Droid)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 19
Bot2.Battlefield.Grizzly Bears.Tapped = false
Bot1.Battlefield.Fugitive Droid.Tapped = true
