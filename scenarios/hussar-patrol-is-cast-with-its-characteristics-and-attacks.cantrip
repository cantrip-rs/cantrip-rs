# Hussar Patrol, a french vanilla creature: cast with Black Lotus mana, its characteristics as printed (power, toughness,
# keywords, colors, types, protection), then attacking Bot2, who has no creatures.
# Flash (CR 702.8a): it is cast in Bot2's main phase, with Bot2 the active player.
# Vigilance (CR 702.20b): attacking doesn't tap it.

[Bot1 Deck]
Black Lotus x2
Hussar Patrol
Plains x21

[Bot2 Deck]
Island x24

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
[T2 Bot2.Main1]
Bot1.Battlefield.Black Lotus#2.Activate(Color: Blue)
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Hand.Hussar Patrol.Cast
Bot1.Pass
[T2 Bot2.End]
? Bot1.Battlefield.Hussar Patrol.Power = 2
? Bot1.Battlefield.Hussar Patrol.Toughness = 4
? Bot1.Battlefield.Hussar Patrol.Keywords = Flash; Vigilance
? Bot1.Battlefield.Hussar Patrol.Colors = Blue; White
? Bot1.Battlefield.Hussar Patrol.Types = Creature
? Bot1.Battlefield.Hussar Patrol.Subtypes = Human; Knight
? Bot1.Battlefield.Hussar Patrol.Supertypes = (absent)
? Bot1.Battlefield.Hussar Patrol.ProtectionFrom = (absent)
[T3 Bot1.Main1]
Bot1.Attack(Hussar Patrol > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 18
Bot1.Battlefield.Hussar Patrol.Tapped = false
