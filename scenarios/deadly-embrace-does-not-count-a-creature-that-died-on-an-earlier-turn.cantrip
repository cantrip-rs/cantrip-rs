# Deadly Embrace counts creatures that died "this turn" only (CR 700.4): Bot1's Memnite died to Lightning Bolt on turn 1, not
# turn 3, so Embrace on Bot2's Ornithopter on turn 3 draws exactly one card, for its own target. Hand: Island after the draw for
# turn 3 plus one drawn by Embrace.

[Bot1 Deck]
Black Lotus
Mox Jet
Mox Ruby
Mox Pearl
Lightning Bolt
Deadly Embrace
Memnite
Island x20

[Bot2 Deck]
Ornithopter
Island x19

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Memnite.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Deadly Embrace.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Graveyard = Ornithopter
Bot1.Hand.Count = 2
