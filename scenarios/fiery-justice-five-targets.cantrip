# Five damage targets can each receive one; a sixth target is refused (CR 601.2d).

[Bot1 Deck]
Mox Ruby
Mox Emerald
Mox Pearl
Ornithopter x2
Fiery Justice
Island x20

[Bot2 Deck]
Ornithopter x2
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Ornithopter#1.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter#1.Cast
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Fiery Justice.Cast
! Bot1.Divide(Bot1: 1; Bot2: 1; Bot1.Battlefield.Ornithopter#1: 1; Bot1.Battlefield.Ornithopter#2: 1; Bot2.Battlefield.Ornithopter#1: 1; Bot2.Battlefield.Ornithopter#2: 1)
Bot1.Divide(Bot2: 1; Bot1.Battlefield.Ornithopter#1: 1; Bot1.Battlefield.Ornithopter#2: 1; Bot2.Battlefield.Ornithopter#1: 1; Bot2.Battlefield.Ornithopter#2: 1)
Bot1.Target(Bot2)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield.Ornithopter#1.Damage = 1
Bot1.Battlefield.Ornithopter#2.Damage = 1
Bot2.Battlefield.Ornithopter#1.Damage = 1
Bot2.Battlefield.Ornithopter#2.Damage = 1
Bot2.Life = 24
