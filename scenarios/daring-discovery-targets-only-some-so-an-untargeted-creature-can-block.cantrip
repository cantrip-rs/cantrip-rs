# Daring Discovery: "Up to three target creatures can't block this turn." Only the chosen creatures are affected.
# Turn 1 Bot1 casts a Memnite; turn 2 Bot2 casts a Memnite, an Ornithopter and a Phyrexian Walker. On turn 3 Bot1 casts Daring
# Discovery at the Memnite and the Walker only (two of up to three targets): the Ornithopter may still block Bot1's Memnite,
# while the other two may not. Discover 4 finds a Lightning Bolt and Bot1 casts it free at Bot2 (20 -> 17).

[Bot1 Deck]
Mox Ruby
Mox Jet
Black Lotus
Daring Discovery
Memnite
Plains
Plains
Plains
Lightning Bolt
Plains x10

[Bot2 Deck]
Memnite
Ornithopter
Phyrexian Walker
Island x17

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Memnite.Cast
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Phyrexian Walker.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Daring Discovery.Cast
Bot1.Target(Bot2.Battlefield.Memnite; Bot2.Battlefield.Phyrexian Walker)
Bot1.Pass
Bot2.Pass
Bot1.Accept
Bot1.Target(Bot2)
Bot1.Pass
Bot2.Pass
Bot1.Attack(Memnite > Bot2)
! Bot2.Block(Memnite > Memnite)
! Bot2.Block(Phyrexian Walker > Memnite)
Bot2.Block(Ornithopter > Memnite)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 17
Bot1.Graveyard = Lightning Bolt; Daring Discovery; Black Lotus
