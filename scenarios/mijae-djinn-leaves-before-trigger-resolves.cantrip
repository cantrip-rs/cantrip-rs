# The departed Djinn still flips: Mana Crypt's next flip wins only if the first coin was consumed (CR 113.7a, 400.7, 705.2).
[Bot1 Deck]
Mijae Djinn
Black Lotus
Mana Crypt
Mountain x20
[Bot2 Deck]
Lightning Bolt
Mox Ruby
Mountain x20
[Dice]
2; 1
[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Mijae Djinn.Cast
? Bot1.Mana =
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Mijae Djinn > Bot2)
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Mijae Djinn)
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main2]
Bot1.Hand.Mana Crypt.Cast
[T5 Bot1.Main1]
[Expect]
Bot1.Graveyard.Mijae Djinn.Power = 6
Bot1.Life = 20
Bot2.Life = 20
