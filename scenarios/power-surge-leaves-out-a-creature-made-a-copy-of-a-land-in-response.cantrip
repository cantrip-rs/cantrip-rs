Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Power Surge.Cast
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Black Lotus.Cast
[T3 Bot1.Upkeep]
? Stack.Count = 1
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mutavault.Activate(Ability: {1})
Bot1.Pass
Bot2.Pass
Bot2.Battlefield.Black Lotus.Activate(Color: Blue)
Bot2.Battlefield.Island.Activate
Bot2.Hand.Mirrorweave.Cast(Bot1.Battlefield.Mutavault)
Bot2.Pass
Bot1.Pass
? Bot1.Battlefield.Mutavault#2.Types = Land
? Bot1.Life = 20
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main1]

[Expect]
Bot1.Life = 19
Bot1.Battlefield = Mox Ruby; Mutavault; Mutavault; Power Surge
