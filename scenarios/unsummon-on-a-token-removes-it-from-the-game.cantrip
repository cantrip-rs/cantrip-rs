# Unsummon on a token: it is returned to its owner's hand only for a moment - a token that has left the battlefield
# ceases to exist (CR 111.7, 704.5d), so Bot1's hand does not grow and the other Spirit is untouched.

[Bot1 Deck]
Mox Pearl
Mox Jet
Mox Ruby
Mox Sapphire
Lingering Souls
Unsummon
Island
Island x13

[Bot2 Deck]
Island x16

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lingering Souls.Cast
Bot1.Pass
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Unsummon.Cast(Bot1.Battlefield.Spirit Token#1)
Bot1.Pass
[T1 Bot1.Main2]

[Expect]
Bot1.Battlefield = Mox Pearl; Mox Jet; Mox Ruby; Mox Sapphire; Spirit Token
Bot1.Hand = Island
Bot1.Graveyard = Unsummon; Lingering Souls
