Bot1.Block(Wall of Dust > Grizzly Bears; Bot1.Battlefield.Ornithopter > Bot2.Battlefield.Ornithopter)
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Wall of Dust)
[T4 Bot2.Main2]
? Bot1.Graveyard = Wall of Dust
