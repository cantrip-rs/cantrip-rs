! Bot2.Attack(Grizzly Bears > Bot1)
Bot2.Attack(Bot2.Battlefield.Memnite)
[T6 Bot2.Main2]
[T8 Bot2.DeclareAttackers]
Bot2.Attack(Grizzly Bears)
[T8 Bot2.Main2]
