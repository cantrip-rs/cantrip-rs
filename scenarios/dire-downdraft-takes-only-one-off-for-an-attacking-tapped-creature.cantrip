Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Dire Downdraft.Cast(Bot2.Battlefield.Llanowar Elves)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
Bot2.Decline

[Expect]
