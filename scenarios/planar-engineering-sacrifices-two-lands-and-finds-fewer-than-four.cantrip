# Planar Engineering with two lands: both are sacrificed, then the search finds up to four basic lands; the library holds only two,
# so Bot1 finds just those, tapped.

[Bot1 Deck]
Planar Engineering
Mox Emerald
Mox Ruby
Mox Jet
Mox Pearl
Island
Island
Ornithopter
Forest
Swamp
Ornithopter x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Island.Play
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Planar Engineering.Cast
Bot1.Pass
Bot2.Pass
Bot1.Search(Forest; Swamp)

[Expect]
Bot1.Graveyard = Planar Engineering; Island; Island
Bot1.Battlefield.Count = 6
Bot1.Battlefield.Forest.Tapped = true
Bot1.Battlefield.Swamp.Tapped = true
