# Goliath Daydreamer: the attack trigger's "you may cast" is optional (the positive control is
# goliath-daydreamer-exiles-a-bolt-cast-from-hand-with-a-dream-counter-and-recasts-it-when-attacking). Bot1 bolts Bot2 from the
# hand on turn 3, then attacks and chooses nothing: the Bolt stays in exile with its dream counter, and Bot2 takes only the
# Bolt and Goliath's combat damage.

[Bot1 Deck]
Mox Ruby
Mox Jet
Mox Emerald
Mountain
Goliath Daydreamer
Lightning Bolt
Lightning Bolt
Mountain x10

[Bot2 Deck]
Island x16

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Goliath Daydreamer.Cast
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Attack(Goliath Daydreamer)
Bot1.Choose()
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 13
Bot1.Graveyard.Count = 0
Exile = Lightning Bolt
Bot1.Exile.Lightning Bolt.Counters.Dream = 1
