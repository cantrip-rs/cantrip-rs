# Trick Shot (CR 608.2b): Bot1 kills its own Goblin token (the second target) with Lightning Bolt in response; as Trick Shot resolves that target is gone, so it is
# left out and the first target, Bot2's Memnite, still takes its 6 damage and dies.

[Bot1 Deck]
Mox Ruby
Mox Jet
Mox Pearl
Mox Sapphire
Black Lotus
Dragon Fodder
Trick Shot
Lightning Bolt
Island x12

[Bot2 Deck]
Memnite
Ornithopter
Island x18

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Dragon Fodder.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Trick Shot.Cast
Bot1.Target(Bot2.Battlefield.Memnite)
Bot1.Target(Bot1.Battlefield.Goblin Token#1)
Bot1.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Goblin Token#1)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Count = 5
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Graveyard = Memnite
Bot2.Battlefield.Ornithopter.Damage = 0
