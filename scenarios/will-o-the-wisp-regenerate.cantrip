# Flying prevents a ground creature from blocking, and a regeneration shield replaces destruction (CR 702.9b, 701.19a).

[Bot1 Deck]
Mox Jet
Mox Jet
Mox Sapphire
Will-o'-the-Wisp
Island x20

[Bot2 Deck]
Black Lotus
Mox Jet
Mox Jet
Grizzly Bears
Go for the Throat
Island x20

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Will-o'-the-Wisp.Cast
Bot1.Choose(Close mana window)
? Bot1.Mana =
Bot1.Pass
Bot1.Battlefield.Mox Sapphire.Activate
! Bot1.Battlefield.Will-o'-the-Wisp.Activate(Mana: short)
Bot1.Hand.Mox Jet.Cast
[T2 Bot2.Main1]
Bot2.Hand.Black Lotus.Cast
Bot2.Hand.Mox Jet.Cast
Bot2.Hand.Mox Jet.Cast
Bot2.Battlefield.Black Lotus.Activate(Color: Green)
Bot2.Hand.Grizzly Bears.Cast
Bot1.Battlefield.Mox Jet#2.Activate
Bot1.Battlefield.Will-o'-the-Wisp.Activate
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
Bot2.Battlefield.Mox Jet#1.Activate
Bot2.Battlefield.Mox Jet#2.Activate
Bot2.Hand.Go for the Throat.Cast(Bot1.Battlefield.Will-o'-the-Wisp)
Bot2.Pass
Bot1.Pass
? Bot1.Battlefield.Will-o'-the-Wisp.Tapped = true
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Will-o'-the-Wisp > Bot2)
! Bot2.Block(Grizzly Bears > Will-o'-the-Wisp)
[T3 Bot1.EndCombat]

[Expect]
Bot1.Battlefield.Will-o'-the-Wisp.Tapped = true
Bot2.Life = 20
