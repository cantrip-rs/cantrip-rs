# Wild Roads: "This land enters tapped unless you control a Mount or Vehicle" (CR 614.1d) and "{T}: Add {G}" (CR 605.1a). Bot1
# controls neither when it plays the land on turn 1, so it enters tapped and cannot be tapped for mana (refused). On turn 3 it
# is untapped and adds {G} and nothing else.

[Bot1 Deck]
Wild Roads
Island x19

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Wild Roads.Play
? Bot1.Battlefield.Wild Roads.Tapped = true
! Bot1.Battlefield.Wild Roads.Activate(Ability: Add)
[T3 Bot1.Main1]
? Bot1.Battlefield.Wild Roads.Tapped = false
Bot1.Battlefield.Wild Roads.Activate(Ability: Add)
? Bot1.Mana = {G}

[Expect]
Turn = 3
Bot1.Mana = {G}
Bot1.Battlefield.Wild Roads.Tapped = true
