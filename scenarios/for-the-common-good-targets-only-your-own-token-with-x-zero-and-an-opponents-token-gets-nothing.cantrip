Bot1.Battlefield.Mox Emerald.Activate
! Bot1.Hand.For the Common Good.Cast(Bot2.Battlefield.Treasure Token; X: 0)
Bot1.Hand.For the Common Good.Cast(Bot1.Battlefield.Treasure Token; X: 0)
Bot1.Pass
Bot2.Pass
? Bot1.Life = 21
? Bot1.Battlefield.Count = 5
[T4 Bot2.Main1]
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Disenchant.Cast(Bot1.Battlefield.Treasure Token)
Bot2.Pass
Bot1.Pass
? Bot1.Battlefield.Count = 5
Bot2.Battlefield.Plains.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Disenchant.Cast(Bot2.Battlefield.Treasure Token)
Bot2.Pass
Bot1.Pass

[Expect]
Bot1.Battlefield.Count = 5
Bot2.Battlefield.Count = 5
Bot1.Life = 21
