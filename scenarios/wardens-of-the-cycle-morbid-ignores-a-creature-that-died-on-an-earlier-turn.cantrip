# Wardens of the Cycle: "if a creature died this turn" looks at this turn only. Bot2 casts an Ornithopter on turn 2 and Bot1 kills it with
# Lightning Bolt during that same turn, which is not Bot1's end step; on turn 3 no creature has died, so the end step trigger is not
# put on the stack and the life total stays at 20.

[Bot1 Deck]
Mox Jet
Mox Emerald
Mox Pearl
Forest
Wardens of the Cycle
Mox Ruby
Lightning Bolt
Forest x13

[Bot2 Deck]
Ornithopter
Island x20

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Forest.Play
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Wardens of the Cycle.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
? Bot2.Graveyard = Ornithopter
[T2 Bot2.End]
? Stack.Count = 0
[T3 Bot1.End]
? Stack.Count = 0
? Bot1.Life = 20

[Expect]
Bot1.Life = 20
Bot1.Hand.Count = 1
