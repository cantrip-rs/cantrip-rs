# Diabolic Intent: the sacrifice is a cost (CR 118.8), paid as the spell is cast. Bot2 counters it with Counterspell: the
# Ornithopter is already in the graveyard, and the search never happens, so the Mox Pearl stays in the library
# (library and hand sizes are unchanged).

[Bot1 Deck]
Swamp
Mox Jet
Ornithopter
Diabolic Intent
Swamp x3
Swamp
Mox Pearl
Swamp x10

[Bot2 Deck]
Island
Mox Sapphire
Counterspell
Island x16

[Actions]
Bot1.Hand.Swamp.Play
Bot1.Hand.Mox Jet.Cast
Bot2.Hand.Island.Play
Bot2.Hand.Mox Sapphire.Cast
[T3 Bot1.Main1]
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Diabolic Intent.Cast
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Ornithopter)
Bot2.Battlefield.Island.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.Counterspell.Cast(Stack.Diabolic Intent)
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]

[Expect]
Bot1.Graveyard = Diabolic Intent; Ornithopter
Bot2.Graveyard = Counterspell
Bot1.Hand = Swamp; Swamp; Swamp; Swamp
Bot1.Library.Count = 11
