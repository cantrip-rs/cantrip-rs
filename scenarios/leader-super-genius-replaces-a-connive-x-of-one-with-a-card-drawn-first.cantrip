? Bot1.Hand = Hill Giant; Savannah Lions; Spymaster's Vault; Lightning Bolt
Bot1.Hand.Spymaster's Vault.Play
? Bot1.Battlefield.Spymaster's Vault.Tapped = false
Bot1.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Llanowar Elves)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Spymaster's Vault.Activate(Ability: connives; Bot1.Battlefield.Leader, Super-Genius)
Bot1.Pass
Bot2.Pass
Bot1.Choose(Savannah Lions)
? Bot1.Hand = Forest; Hill Giant; Runeclaw Bear
? Bot1.Battlefield.Leader, Super-Genius.Counters.PlusOnePlusOne = 1

[Expect]
Bot2.Graveyard = Llanowar Elves
