# Reluctant Role Model: "Whenever this creature or another creature you control dies, if it had counters on it, put those
# counters on up to one target creature." Role Model collects a flying counter (turn 3) and a +1/+1 counter (turn 5) and is a 3/3.
# Bot2's Lightning Bolt kills it on turn 6, and both counters go onto Bot2's Ornithopter (any creature may be the target): a
# 1/3 (a 0/2 with a +1/+1 counter) with a flying counter.

[Bot1 Deck]
Mox Pearl
Mox Ruby
Reluctant Role Model
Island x20

[Bot2 Deck]
Mox Ruby
Ornithopter
Lightning Bolt
Island x20

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Reluctant Role Model.Cast
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Attack(Reluctant Role Model > Bot2)
[T3 Bot1.Main2]
Bot1.Modes(Flying counter)
[T5 Bot1.Main1]
Bot1.Attack(Reluctant Role Model > Bot2)
[T5 Bot1.Main2]
Bot1.Modes(+1/+1 counter)
[T6 Bot2.Main1]
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Reluctant Role Model)
Bot2.Pass
Bot1.Pass
Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Graveyard = Reluctant Role Model
Bot2.Battlefield.Ornithopter.Counters.Flying = 1
Bot2.Battlefield.Ornithopter.Counters.PlusOnePlusOne = 1
Bot2.Battlefield.Ornithopter.Power = 1
Bot2.Battlefield.Ornithopter.Toughness = 3
