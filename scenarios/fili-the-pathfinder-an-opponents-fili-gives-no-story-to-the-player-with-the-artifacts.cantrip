[T6 Bot2.Main2]
? Bot1.EnduringStory = (absent)
? Bot2.EnduringStory = (absent)
? Bot2.Battlefield.Fíli the Pathfinder.Power = 2
Bot2.Hand.Mox Emerald.Cast
[T7 Bot1.Main1]

[Expect]
