# Cerodon Yearling, a french vanilla creature: cast with Black Lotus mana, its characteristics as printed (power, toughness,
# keywords, colors, types, protection), then attacking Bot2, who has no creatures.
# Haste (CR 702.10b): it attacks the turn it comes under Bot1's control.
# Vigilance (CR 702.20b): attacking doesn't tap it.

[Bot1 Deck]
Black Lotus x2
Cerodon Yearling
Plains x21

[Bot2 Deck]
Island x24

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus#2.Activate(Color: White)
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Cerodon Yearling.Cast
Bot1.Pass
Bot1.Attack(Cerodon Yearling > Bot2)
[T2 Bot2.End]
? Bot1.Battlefield.Cerodon Yearling.Power = 2
? Bot1.Battlefield.Cerodon Yearling.Toughness = 2
? Bot1.Battlefield.Cerodon Yearling.Keywords = Haste; Vigilance
? Bot1.Battlefield.Cerodon Yearling.Colors = Red; White
? Bot1.Battlefield.Cerodon Yearling.Types = Creature
? Bot1.Battlefield.Cerodon Yearling.Subtypes = Beast
? Bot1.Battlefield.Cerodon Yearling.Supertypes = (absent)
? Bot1.Battlefield.Cerodon Yearling.ProtectionFrom = (absent)

[Expect]
Bot2.Life = 18
Bot1.Battlefield.Cerodon Yearling.Tapped = false
