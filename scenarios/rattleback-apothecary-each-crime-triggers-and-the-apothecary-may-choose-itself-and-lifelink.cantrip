Bot1.Hand.Rattleback Apothecary.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Shock.Cast(Bot2)
Bot1.Hand.Shock.Cast(Bot2)
? Stack.Count = 4
Bot1.Pass
Bot2.Pass
Bot1.Modes(Lifelink)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Modes(Menace)
