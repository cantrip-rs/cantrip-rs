# Bumi, Unleashed: the trigger needs combat damage dealt to a player. On turn 5 Bot1 attacks with Bumi, the Forest creature and
# Memnite (a non-land creature may attack in the combat phase that is not the added one) and Bot2 casts Fog: nothing is dealt,
# so Forest#2 stays tapped and there is no additional combat phase: the game goes on to the second main phase with Bot2 at 20.

[Bot1 Deck]
Forest
Mox Jet
Mox Emerald
Black Lotus
Bumi, Unleashed
Memnite
Forest
Forest x18

[Bot2 Deck]
Mox Emerald
Fog
Mountain x20

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Hand.Memnite.Cast
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Forest.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Hand.Bumi, Unleashed.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Pass
Bot2.Pass
Bot1.Target(Forest#1)
Bot1.Pass
Bot2.Pass
[T4 Bot2.Main1]
Bot2.Hand.Mox Emerald.Cast
Bot2.Pass
Bot1.Pass
[T5 Bot1.Main1]
Bot1.Battlefield.Forest#2.Activate
[T5 Bot1.DeclareAttackers]
Bot1.Attack(Bumi, Unleashed > Bot2; Memnite > Bot2; Forest#1 > Bot2)
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Hand.Fog.Cast
Bot2.Pass
Bot1.Pass
? Bot2.Life = 20
[T5 Bot1.Main2]
? Stack.Count = 0
? Bot1.Battlefield.Forest#2.Tapped = true

[Expect]
Bot2.Life = 20
Bot1.Battlefield.Forest#1.Tapped = true
