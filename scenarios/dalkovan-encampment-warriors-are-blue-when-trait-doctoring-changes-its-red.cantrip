# The color word in the Encampment's text, "red Warrior", is changed like any other (CR 612.2a, 612.4): Trait Doctoring
# replaces the color word red with blue in it until end of turn, so the two Warriors the attack makes are blue
# Warriors, not red. Their creature type, which Trait Doctoring cannot change, is still Warrior.

[Bot1 Deck]
Mountain
Dalkovan Encampment
Mox Pearl
Mox Jet
Mox Ruby
Mox Sapphire
Ornithopter
Trait Doctoring
Plains x14

[Bot2 Deck]
Plains x16

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Dalkovan Encampment.Play
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Trait Doctoring.Cast(Dalkovan Encampment)
Bot1.Pass
Bot2.Pass
Bot1.Modes(Replace a color word)
Bot1.Colors(Red)
Bot1.Colors(Blue)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Dalkovan Encampment.Activate(Ability: Whenever you attack)
Bot1.Pass
Bot2.Pass
Bot1.Attack(Ornithopter > Bot2)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Warrior Token#1.Colors = Blue
? Bot1.Battlefield.Warrior Token#2.Colors = Blue
? Bot1.Battlefield.Warrior Token#1.Subtypes = Warrior
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 18
Bot1.Battlefield.Warrior Token#2.Colors = Blue
