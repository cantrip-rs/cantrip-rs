# "{T}, Pay 1 life: Add {R} or {W}" - white, the colour the existing scenario does not take, for 1 life (turn 1). The draw ability also needs {T}
# (CR 602.2), so a tapped Canyon cannot be sacrificed to draw even with {W} floating to pay the {1}: the refusal. On turn 3 the
# untapped Canyon is sacrificed with a Mox Ruby's mana (the positive control) and Bot1 draws.

[Bot1 Deck]
Sunbaked Canyon
Mox Ruby
Island x14

[Bot2 Deck]
Swamp x15

[Actions]
Bot1.Hand.Sunbaked Canyon.Play
Bot1.Battlefield.Sunbaked Canyon.Activate(Ability: Add; Color: White)
Bot1.Choose(Tap Sunbaked Canyon)
? Bot1.Mana = {W}
? Bot1.Life = 19
! Bot1.Battlefield.Sunbaked Canyon.Activate(Ability: Draw)
Bot1.Hand.Mox Ruby.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Sunbaked Canyon.Activate(Ability: Draw)

[Expect]
Turn = 3
Bot1.Graveyard = Sunbaked Canyon
Bot1.Life = 19
