[T4 Bot2.Main1]
? Bot2.Hand.Count = 5
Bot2.Attack(Hero of Bladehold > Bot1)
Bot2.Triggers(Hero of Bladehold; Hero of Bladehold)
Bot1.Triggers(Emberwilde Captain; Emberwilde Captain)
[T4 Bot2.DeclareBlockers]
? Bot2.Life = 10

[Expect]
Bot2.Battlefield = Plains; Mox Pearl; Hero of Bladehold; Soldier Token; Soldier Token
