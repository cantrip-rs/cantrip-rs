# Any number includes zero targets, so choosing none deals no damage (CR 107.1c).
[Bot1 Deck]
Mox Ruby
Meteor Shower
Mountain x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Meteor Shower.Cast(X: 0)
Bot1.Divide()
? Bot1.Mana =
Bot1.Pass

[Expect]
Bot1.Life = 20
Bot2.Life = 20
Bot1.Graveyard = Meteor Shower
