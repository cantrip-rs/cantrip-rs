# Treetop Sentinel, a french vanilla creature: cast with Black Lotus mana, its characteristics as printed (power, toughness,
# keywords, colors, types, protection), then attacking Bot2, who has no creatures.

[Bot1 Deck]
Black Lotus x2
Treetop Sentinel
Plains x21

[Bot2 Deck]
Island x24

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus#2.Activate(Color: Blue)
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Treetop Sentinel.Cast
Bot1.Pass
[T2 Bot2.End]
? Bot1.Battlefield.Treetop Sentinel.Power = 2
? Bot1.Battlefield.Treetop Sentinel.Toughness = 3
? Bot1.Battlefield.Treetop Sentinel.Keywords = Flying
? Bot1.Battlefield.Treetop Sentinel.Colors = Blue
? Bot1.Battlefield.Treetop Sentinel.Types = Creature
? Bot1.Battlefield.Treetop Sentinel.Subtypes = Bird; Soldier
? Bot1.Battlefield.Treetop Sentinel.Supertypes = (absent)
? Bot1.Battlefield.Treetop Sentinel.ProtectionFrom = Green
[T3 Bot1.Main1]
Bot1.Attack(Treetop Sentinel > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 18
Bot1.Battlefield.Treetop Sentinel.Tapped = true
