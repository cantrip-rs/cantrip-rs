# "Target creature an opponent controls": of the creatures on the battlefield when the reflexive ability goes on the stack,
# Bot1's own new Faeries (not an opponent's) and Bot2's Sylvan Caryatid (hexproof, CR 702.11b) are not legal targets
# (the refusals), while Bot2's Llanowar Elves and Ornithopter are, so the choice is asked and Bot1 taps the Ornithopter.
# The Elves and the Caryatid stay untapped. (Llanowar Elves are the positive control for the refusals.)

[Bot1 Deck]
Mox Sapphire
Mox Ruby
Mox Pearl
Faebloom Trick
Island x3
Island x13

[Bot2 Deck]
Forest
Mox Emerald
Mox Jet
Sylvan Caryatid
Llanowar Elves
Ornithopter
Forest x14

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Hand.Mox Emerald.Cast
Bot2.Hand.Mox Jet.Cast
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Sylvan Caryatid.Cast
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Llanowar Elves.Cast
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Faebloom Trick.Cast
Bot2.Pass
! Bot1.Target(Sylvan Caryatid)
! Bot1.Target(Faerie Token)
Bot1.Target(Ornithopter)
[T3 Bot1.Main2]

[Expect]
Bot2.Battlefield.Ornithopter.Tapped = true
Bot2.Battlefield.Llanowar Elves.Tapped = false
Bot2.Battlefield.Sylvan Caryatid.Tapped = false
Bot1.Battlefield.Faerie Token#1.Tapped = false
Bot1.Battlefield.Faerie Token#2.Tapped = false
Stack.Count = 0
