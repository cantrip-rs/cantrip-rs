# Web-slinging is offered while Birds of Paradise could still be tapped for mana as it is paid (CR 601.2g), but whether
# a tapped creature can be returned is judged once the mana is paid (CR 601.2h, 702.188a). Bot1 web-slings Spider-Sense
# and pays the {U} with an Island instead, leaving the Birds untapped: no tapped creature can pay, the cost can't be paid,
# and the cast is taken back (CR 601.2h, 729.1), the Island untapped again. Bot1 casts it again, this time tapping the
# Birds for the {U}, and returns them.

[Bot1 Deck]
Island
Birds of Paradise
Spider-Sense
Forest
Island x16

[Bot2 Deck]
Mountain
Lightning Bolt
Mountain x18

[Actions]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Birds of Paradise.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1)
Bot1.Hand.Spider-Sense.Cast(Stack.Lightning Bolt; Ability: Web-slinging)
Bot1.Battlefield.Island.Activate
Bot1.Choose(Close mana window)
? Stack = Lightning Bolt
? Bot1.Battlefield.Island.Tapped = false
? Bot1.Mana =
Bot1.Hand.Spider-Sense.Cast(Stack.Lightning Bolt; Ability: Web-slinging)
Bot1.Battlefield.Birds of Paradise.Activate(Color: Blue)
Bot1.Choose(Pay mana)
Bot1.Choose(Birds of Paradise)
[T3 Bot1.Main2]

[Expect]
Turn = 3
Stack.Count = 0
Bot1.Life = 20
Bot1.Battlefield = Forest; Island
Bot1.Battlefield.Island.Tapped = false
Bot1.Graveyard = Spider-Sense
Bot2.Graveyard = Lightning Bolt
