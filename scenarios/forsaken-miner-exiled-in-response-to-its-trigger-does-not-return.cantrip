# Once the Miner is exiled from the graveyard in response to its trigger, it is a new object (CR 400.7) and the trigger can't
# return it: when the trigger resolves nothing is asked and nothing returns, so Bot1's {B} stays unspent (the positive
# control is forsaken-miner-returns-from-the-graveyard-on-a-crime-when-b-is-paid). Bot2's Ghost Vacuum exiles it.

[Bot1 Deck]
Swamp
Forsaken Miner
Mox Ruby
Lightning Bolt
Swamp
Swamp
Swamp
Swamp x20

[Bot2 Deck]
Mountain
Mox Ruby
Lightning Bolt
Ghost Vacuum
Mountain x20

[Actions]
Bot1.Hand.Swamp.Play
Bot1.Battlefield.Swamp.Activate
Bot1.Hand.Forsaken Miner.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Forsaken Miner)
Bot2.Pass
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Ghost Vacuum.Cast
Bot2.Pass
[T3 Bot1.Main1]
? Bot1.Graveyard = Forsaken Miner
Bot1.Hand.Swamp.Play
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot1.Choose(Close mana window)
? Stack.Count = 2
Bot1.Pass
Bot2.Battlefield.Ghost Vacuum.Activate(Bot1.Graveyard.Forsaken Miner)
Bot2.Pass
Bot1.Pass
? Exile = Forsaken Miner
[T3 Bot1.Main2]

[Expect]
Exile = Forsaken Miner
Bot1.Battlefield = Mox Ruby; Swamp; Swamp
Bot1.Graveyard = Lightning Bolt
Bot2.Life = 17
Bot1.Battlefield.Swamp#1.Tapped = false
