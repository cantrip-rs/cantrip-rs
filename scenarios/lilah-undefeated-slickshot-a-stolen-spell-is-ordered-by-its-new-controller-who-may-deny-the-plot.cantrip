Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Lilah, Undefeated Slickshot.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Hand.Rest in Peace.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Black Lotus.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Lightning Helix.Cast(Bot2)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
? Stack = Lightning Helix
Bot1.Pass
Bot2.Battlefield.Black Lotus.Activate(Color: Blue)
Bot2.Battlefield.Island.Activate
Bot2.Hand.Sudden Substitution.Cast
Bot2.Target(Stack.Lightning Helix)
Bot2.Target(Bot2.Battlefield.Memnite)
Bot2.Pass
Bot1.Pass
Bot2.Target(Bot1)
? Stack = Lightning Helix
Bot1.Pass
Bot2.Pass
Bot2.Replace(Rest in Peace)
? Bot1.Life = 17
[T5 Bot1.Main1]
! Bot1.Exile.Lightning Helix.Cast(Bot2)

[Expect]
Bot1.Battlefield.Memnite.Power = 1
Bot2.Life = 23
Exile = Black Lotus; Black Lotus; Lightning Helix; Sudden Substitution
