# Sentinel Spider, a french vanilla creature: cast with Black Lotus mana, its characteristics as printed (power, toughness,
# keywords, colors, types, protection), then attacking Bot2, who has no creatures.
# Vigilance (CR 702.20b): attacking doesn't tap it.

[Bot1 Deck]
Black Lotus x2
Sentinel Spider
Plains x21

[Bot2 Deck]
Island x24

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus#2.Activate(Color: Green)
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Hand.Sentinel Spider.Cast
Bot1.Pass
[T2 Bot2.End]
? Bot1.Battlefield.Sentinel Spider.Power = 4
? Bot1.Battlefield.Sentinel Spider.Toughness = 4
? Bot1.Battlefield.Sentinel Spider.Keywords = Reach; Vigilance
? Bot1.Battlefield.Sentinel Spider.Colors = Green
? Bot1.Battlefield.Sentinel Spider.Types = Creature
? Bot1.Battlefield.Sentinel Spider.Subtypes = Spider
? Bot1.Battlefield.Sentinel Spider.Supertypes = (absent)
? Bot1.Battlefield.Sentinel Spider.ProtectionFrom = (absent)
[T3 Bot1.Main1]
Bot1.Attack(Sentinel Spider > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 16
Bot1.Battlefield.Sentinel Spider.Tapped = false
