# Each combat allows two attackers and two blockers, but not three of either (CR 508.1c, 509.1b).
[Bot1 Deck]
Caverns of Despair
Black Lotus
Mox Ruby
Ornithopter x3
Mountain x20
[Bot2 Deck]
Ornithopter x3
Island x20
[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Caverns of Despair.Cast
? Bot1.Mana =
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
[T4 Bot2.DeclareAttackers]
! Bot2.Attack(Ornithopter#1 > Bot1; Ornithopter#2 > Bot1; Ornithopter#3 > Bot1)
Bot2.Attack(Ornithopter#1 > Bot1; Ornithopter#2 > Bot1)
! Bot1.Block(Ornithopter#1 > Ornithopter#1; Ornithopter#2 > Ornithopter#1; Ornithopter#3 > Ornithopter#2)
Bot1.Block(Ornithopter#1 > Ornithopter#1; Ornithopter#2 > Ornithopter#2)
[T4 Bot2.Main2]
[Expect]
Bot1.Battlefield.Caverns of Despair.Types = Enchantment
Bot1.Life = 20
Bot2.Life = 20
