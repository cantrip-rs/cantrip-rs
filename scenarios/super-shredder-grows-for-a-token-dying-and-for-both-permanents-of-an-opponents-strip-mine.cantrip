Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Super Shredder.Cast
Bot1.Battlefield.Mox Pearl#1.Activate
Bot1.Battlefield.Mox Pearl#2.Activate
Bot1.Battlefield.Swamp.Activate
Bot1.Hand.Lingering Souls.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Spirit Token)
[T2 Bot2.Main2]
? Bot1.Battlefield.Super Shredder.Counters.PlusOnePlusOne = 1
[T4 Bot2.Main1]
Bot2.Hand.Strip Mine.Play
Bot2.Battlefield.Strip Mine.Activate(Bot1.Battlefield.Swamp; Ability: Destroy)
[T4 Bot2.Main2]

