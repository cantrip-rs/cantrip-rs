Bot1.Attack(Memnite#1 > Bot2; Memnite#2 > Bot2)
! Bot2.Block(Memnite#1 > Memnite#2; Memnite#2 > Memnite#2)
Bot2.Block(Memnite#1 > Memnite#1; Memnite#2 > Memnite#1; Memnite#3 > Memnite#2)
Bot1.AssignDamage(Memnite#1 > Memnite#1: 1)
