# The first strike is only "during your turn" (CR 611.3a): on Bot2's turn the Trainee has no keywords, so when it blocks Bot2's attacking
# Memnite (1/1) both deal damage at the same time and both die (the 2/1 Trainee takes lethal 1 damage).

[Bot1 Deck]
Mox Ruby
Mox Jet
Ratcatcher Trainee
Mountain x17

[Bot2 Deck]
Memnite
Island x19

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Ratcatcher Trainee.Cast
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
[T4 Bot2.DeclareAttackers]
Bot2.Attack(Memnite > Bot1)
? Bot1.Battlefield.Ratcatcher Trainee.Keywords = (absent)
Bot1.Block(Ratcatcher Trainee > Memnite)
[T4 Bot2.Main2]

[Expect]
Bot1.Graveyard = Ratcatcher Trainee
Bot2.Graveyard = Memnite
Bot1.Life = 20
