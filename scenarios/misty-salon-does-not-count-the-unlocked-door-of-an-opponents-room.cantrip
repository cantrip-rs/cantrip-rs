Turn = 3
Bot2.Battlefield.Smoky Lounge.Doors = Smoky Lounge
Bot1.Battlefield.Misty Salon.Doors = Misty Salon
Bot1.Battlefield.Spirit Token.Power = 1
Bot1.Battlefield.Spirit Token.Toughness = 1
