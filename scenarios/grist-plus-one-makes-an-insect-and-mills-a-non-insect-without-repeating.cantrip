# Grist's +1: "Create a 1/1 black and green Insect creature token, then mill a card. If an Insect card was milled this
# way, put a loyalty counter on Grist and repeat this process." A Llanowar Elves is no Insect: one token, one mill, and
# the +1's own loyalty is all Grist gains (3 + 1).

[Bot1 Deck]
Bayou x3
Grist, the Hunger Tide
Forest x5
Llanowar Elves
Forest x15

[Bot2 Deck]
Forest x22

[Actions]
Bot1.Hand.Bayou.Play
[T3 Bot1.Main1]
Bot1.Hand.Bayou.Play
[T5 Bot1.Main1]
Bot1.Hand.Bayou.Play
Bot1.Battlefield.Bayou#1.Activate(Ability: Add {B})
Bot1.Battlefield.Bayou#2.Activate(Ability: Add {G})
Bot1.Battlefield.Bayou#3.Activate(Ability: Add {G})
Bot1.Hand.Grist, the Hunger Tide.Cast
[T5 Bot1.Main2]
Bot1.Battlefield.Grist, the Hunger Tide.Activate(Ability: +1)
[T5 Bot1.End]

[Expect]
Bot1.Battlefield.Grist, the Hunger Tide.Counters.Loyalty = 4
Bot1.Battlefield.Insect Token.Types = Creature
Bot1.Battlefield.Insect Token.Power = 1
Bot1.Battlefield.Insect Token.Toughness = 1
Bot1.Graveyard = Llanowar Elves
