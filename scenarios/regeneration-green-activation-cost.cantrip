[T3 Bot1.Main1]
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Regeneration.Activate
Bot1.Choose(Close mana window)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Shock.Cast(Bot1.Battlefield.Grizzly Bears)
Bot1.Pass
Bot2.Pass

