# Siren's Call forces the active player's eligible creatures to attack, including a new hasty creature.
# A previously tapped creature is destroyed, while a Wall, the attackers, and the caster's creature survive;
# the attack requirement ends with the turn (CR 508.1d, 611.2c, 514.2).
[Bot1 Deck]
Siren's Call
Mox Sapphire
Memnite
Island x20

[Bot2 Deck]
Ornithopter
Mox Emerald
Llanowar Elves
Forest
Wall of Wood
Mountain
Raging Goblin
Island x20

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Memnite.Cast
Bot1.Pass
! Bot1.Hand.Siren's Call.Cast
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Hand.Ornithopter.Cast
Bot2.Hand.Mox Emerald.Cast
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Llanowar Elves.Cast
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Hand.Wall of Wood.Cast
[T4 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Battlefield.Llanowar Elves.Activate
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Raging Goblin.Cast
Bot2.Pass
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Siren's Call.Cast
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Memnite.LastingRules = (absent)
[T4 Bot2.DeclareAttackers]
! Bot2.Attack()
Bot2.Attack(Ornithopter > Bot1; Raging Goblin > Bot1)
[T5 Bot1.Main1]
? Bot2.Battlefield.Llanowar Elves = (absent)
? Bot2.Battlefield.Wall of Wood.Toughness = 3
? Bot1.Battlefield.Memnite.Power = 1
? Bot2.Battlefield.Ornithopter.LastingRules = (absent)
[T6 Bot2.DeclareAttackers]
Bot2.Attack()
[T6 Bot2.Main2]
[T7 Bot1.Main1]
[Expect]
Bot2.Battlefield.Ornithopter.Power = 0
Bot2.Battlefield.Raging Goblin.Power = 1
Bot2.Graveyard = Llanowar Elves
