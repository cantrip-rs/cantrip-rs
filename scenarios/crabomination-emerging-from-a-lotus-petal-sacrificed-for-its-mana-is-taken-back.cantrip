Bot1.Pass
Bot2.Pass
Bot1.Hand.Crabomination.Cast(Ability: Emerge)
Bot1.Choose(Lotus Petal)
Bot1.Battlefield.Black Lotus#1.Activate(Color: Black)
Bot1.Battlefield.Black Lotus#1.Activate(Color: Black)
Bot1.Battlefield.Lotus Petal.Activate(Color: Black)
? Stack.Count = 0
? Bot1.Mana =
? Bot1.Battlefield = Swamp; Black Lotus; Black Lotus; Lotus Petal
? Bot1.Graveyard.Count = 0
Bot1.Hand.Crabomination.Cast(Ability: Emerge)
Bot1.Choose(Lotus Petal)
Bot1.Battlefield.Black Lotus#1.Activate(Color: Black)
Bot1.Battlefield.Black Lotus#1.Activate(Color: Black)
Bot1.Battlefield.Swamp.Activate
Bot1.Choose(Sacrifice Lotus Petal)
? Bot1.Graveyard = Lotus Petal; Black Lotus; Black Lotus
Bot1.Pass
Bot2.Pass
[T1 Bot1.Main2]

[Expect]
Bot1.Battlefield = Swamp; Crabomination
