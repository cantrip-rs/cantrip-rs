Bot2.Hand.Black Lotus.Cast
Bot2.Pass
Bot1.Pass
Bot2.Battlefield.Black Lotus.Activate(Color: Red)
! Bot2.Hand.Dancing Scimitar.Cast(Mana: short)
[T3 Bot1.Main1]
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
! Bot1.Hand.Dancing Scimitar.Cast(Mana: short)
Bot1.Hand.Memnite.Cast
Bot1.Pass
