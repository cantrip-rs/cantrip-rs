# Fleetfoot Dancer, a french vanilla creature: cast with Black Lotus mana, its characteristics as printed (power, toughness,
# keywords, colors, types, protection), then attacking Bot2, who has no creatures.
# Haste (CR 702.10b): it attacks the turn it comes under Bot1's control.
# Lifelink (CR 702.15b): Bot1 gains as much life as it deals.

[Bot1 Deck]
Black Lotus x3
Fleetfoot Dancer
Plains x20

[Bot2 Deck]
Island x24

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus#3.Activate(Color: White)
Bot1.Battlefield.Black Lotus#2.Activate(Color: Green)
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Fleetfoot Dancer.Cast
Bot1.Pass
Bot1.Attack(Fleetfoot Dancer > Bot2)
[T2 Bot2.End]
? Bot1.Battlefield.Fleetfoot Dancer.Power = 4
? Bot1.Battlefield.Fleetfoot Dancer.Toughness = 4
? Bot1.Battlefield.Fleetfoot Dancer.Keywords = Haste; Lifelink; Trample
? Bot1.Battlefield.Fleetfoot Dancer.Colors = Green; Red; White
? Bot1.Battlefield.Fleetfoot Dancer.Types = Creature
? Bot1.Battlefield.Fleetfoot Dancer.Subtypes = Druid; Elf
? Bot1.Battlefield.Fleetfoot Dancer.Supertypes = (absent)
? Bot1.Battlefield.Fleetfoot Dancer.ProtectionFrom = (absent)

[Expect]
Bot2.Life = 16
Bot1.Life = 24
Bot1.Battlefield.Fleetfoot Dancer.Tapped = true
