Bot1.Hand.Entomb.Cast
Bot1.Search(Serra Angel)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Back for Seconds.Cast
Bot1.Modes(Bargain:)
Bot1.Target(Bot1.Graveyard.Memnite; Bot1.Graveyard.Serra Angel)
