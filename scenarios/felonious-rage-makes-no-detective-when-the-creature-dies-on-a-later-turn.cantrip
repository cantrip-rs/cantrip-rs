# The delayed trigger lasts only "this turn" (CR 603.7b): the Memnite lives through turn 1 with the Rage, back to 1/1 on turn 2,
# and Bot2's Lightning Bolt then kills it for no Detective.

[Bot1 Deck]
Mountain
Memnite
Felonious Rage
Plains x17

[Bot2 Deck]
Mox Ruby
Lightning Bolt
Island x18

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Felonious Rage.Cast(Memnite)
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
? Bot1.Battlefield.Memnite.Power = 1
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Memnite)
Bot2.Pass
Bot1.Pass
? Bot1.Graveyard = Memnite; Felonious Rage

[Expect]
Bot1.Battlefield.Count = 1
