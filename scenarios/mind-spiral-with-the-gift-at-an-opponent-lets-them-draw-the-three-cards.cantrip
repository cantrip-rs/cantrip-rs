# Mind Spiral with the gift, "target player" is Bot2: they draw the three cards (Bot1 draws none) and the Ornithopter Bot2 controls
# gets the one stun counter. The gift is a tapped Fish for the opponent chosen as the gift is promised, Bot2 here.

[Bot1 Deck]
Island
Mox Sapphire
Mox Jet
Mox Ruby
Mox Pearl
Mind Spiral
Island x17

[Bot2 Deck]
Ornithopter
Island x19

[Actions]
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Mind Spiral.Cast
Bot1.Accept
Bot1.Target(Bot2)
Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Hand.Count = 2
Bot2.Hand.Count = 10
Bot2.Battlefield.Ornithopter.Counters.Stun = 1
