# Woodland Patrol, a french vanilla creature: cast with Black Lotus mana, its characteristics as printed (power, toughness,
# keywords, colors, types, protection), then attacking Bot2, who has no creatures.
# Vigilance (CR 702.20b): attacking doesn't tap it.

[Bot1 Deck]
Black Lotus
Woodland Patrol
Plains x22

[Bot2 Deck]
Island x24

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Hand.Woodland Patrol.Cast
Bot1.Pass
[T2 Bot2.End]
? Bot1.Battlefield.Woodland Patrol.Power = 3
? Bot1.Battlefield.Woodland Patrol.Toughness = 2
? Bot1.Battlefield.Woodland Patrol.Keywords = Vigilance
? Bot1.Battlefield.Woodland Patrol.Colors = Green
? Bot1.Battlefield.Woodland Patrol.Types = Creature
? Bot1.Battlefield.Woodland Patrol.Subtypes = Human; Scout
? Bot1.Battlefield.Woodland Patrol.Supertypes = (absent)
? Bot1.Battlefield.Woodland Patrol.ProtectionFrom = (absent)
[T3 Bot1.Main1]
Bot1.Attack(Woodland Patrol > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 17
Bot1.Battlefield.Woodland Patrol.Tapped = false
