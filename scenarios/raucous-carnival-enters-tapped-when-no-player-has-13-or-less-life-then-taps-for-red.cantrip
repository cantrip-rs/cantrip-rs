# Raucous Carnival: "This land enters tapped unless a player has 13 or less life." Both players start at 20 life, so it enters tapped
# (CR 614.1d), untaps on turn 3 and taps for {R} (the first color it prints: the pool check pins it); it makes no
# other color, nor colorless.

[Bot1 Deck]
Raucous Carnival
Plains x19

[Bot2 Deck]
Plains x20

[Actions]
Bot1.Hand.Raucous Carnival.Play
? Bot1.Battlefield.Raucous Carnival.Tapped = true
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main1]
? Bot1.Battlefield.Raucous Carnival.Tapped = false
! Bot1.Battlefield.Raucous Carnival.Activate(Color: Blue)
! Bot1.Battlefield.Raucous Carnival.Activate(Color: Black)
! Bot1.Battlefield.Raucous Carnival.Activate(Color: Green)
! Bot1.Battlefield.Raucous Carnival.Activate(Color: Colorless)
Bot1.Battlefield.Raucous Carnival.Activate(Color: Red)
? Bot1.Mana = {R}

[Expect]
Bot1.Life = 20
Bot2.Life = 20
Bot1.Battlefield.Raucous Carnival.Tapped = true
