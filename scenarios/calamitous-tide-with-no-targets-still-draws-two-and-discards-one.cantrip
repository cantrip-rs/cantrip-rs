# Calamitous Tide with no targets: "up to two" (CR 601.2c) allows none, and the spell still resolves (a spell with only
# "up to" targets is not countered for having none, CR 608.2b): nothing returns, then Bot1 draws Plains and Mountain and discards
# Forest. Both Memnite and Bot2's Ornithopter stay on the battlefield.

[Bot1 Deck]
Black Lotus
Mox Sapphire
Mox Ruby
Mox Jet
Memnite
Calamitous Tide
Island
Forest
Plains
Mountain
Island x10

[Bot2 Deck]
Ornithopter
Island x20

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Memnite.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Calamitous Tide.Cast
Bot1.Target()
Bot1.Pass
Bot2.Pass
Bot1.Choose(Forest)

[Expect]
Bot1.Hand = Plains; Mountain
Bot1.Battlefield = Island; Mox Sapphire; Mox Ruby; Mox Jet; Memnite
Bot2.Battlefield = Ornithopter
Bot2.Hand.Count = 7
