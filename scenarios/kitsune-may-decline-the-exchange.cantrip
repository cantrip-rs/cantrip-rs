# Kitsune: the exchange is a "may" (CR 117.3): Bot1 targets its Ornithopter and Bot2's Llanowar Elves and then declines as the
# ability resolves, so each player keeps their own creature.

[Bot1 Deck]
Black Lotus
Mox Sapphire
Mox Jet
Mox Ruby
Ornithopter
Memnite
Kitsune, Dragon's Daughter
Island x14

[Bot2 Deck]
Forest
Llanowar Elves
Forest x18

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Memnite.Cast
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Llanowar Elves.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Kitsune, Dragon's Daughter.Cast
Bot1.Pass
Bot2.Pass
! Bot1.Target(Bot1.Battlefield.Kitsune, Dragon's Daughter)
! Bot1.Target(Bot1.Battlefield.Ornithopter; Bot1.Battlefield.Memnite)
Bot1.Target(Bot1.Battlefield.Ornithopter; Bot2.Battlefield.Llanowar Elves)
Bot1.Pass
Bot2.Pass
Bot1.Decline

[Expect]
Bot1.Battlefield = Kitsune, Dragon's Daughter; Memnite; Mox Jet; Mox Ruby; Mox Sapphire; Ornithopter
Bot2.Battlefield = Forest; Llanowar Elves
