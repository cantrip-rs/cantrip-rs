# Additive Evolution ({3}{G}{G}): when it enters, a 0/0 Fractal gets three +1/+1 counters (3/3). At the beginning of combat on
# Bot1's turn 3 it puts a +1/+1 counter on target creature Bot1 controls, the Fractal (5/5), which gains vigilance until end of turn:
# it attacks and stays untapped. (The same trigger already gave the Fractal its fourth counter in turn 1's combat.)

[Bot1 Deck]
Additive Evolution
Black Lotus
Mox Emerald
Mox Ruby
Island x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Additive Evolution.Cast
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Fractal Token.Power = 3
[T1 Bot1.Main2]
? Bot1.Battlefield.Fractal Token.Power = 4
[T3 Bot1.BeginCombat]
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Fractal Token.Power = 5
Bot1.Attack(Fractal Token > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 15
Bot1.Battlefield.Fractal Token.Counters.PlusOnePlusOne = 5
Bot1.Battlefield.Fractal Token.Keywords = Vigilance
Bot1.Battlefield.Fractal Token.Tapped = false
