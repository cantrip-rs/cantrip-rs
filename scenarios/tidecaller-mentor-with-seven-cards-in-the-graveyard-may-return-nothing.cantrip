# Tidecaller Mentor: the target is "up to one" (CR 601.2c, 115.1), so with seven cards in the graveyard its controller may choose none
# and nothing is returned. Bot1 reaches seven on turn 1 (Faithless Looting, its two discarded Islands, Black Lotus, and Thought Scour
# with the two Islands it mills) and casts the Mentor on turn 3 while Bot2 controls a Memnite; it declines to target it.

[Bot1 Deck]
Mox Ruby
Mox Sapphire
Mox Jet
Black Lotus
Faithless Looting
Thought Scour
Tidecaller Mentor
Island x20

[Bot2 Deck]
Memnite
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Faithless Looting.Cast
Bot1.Pass
Bot1.Choose(Island; Island)
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Thought Scour.Cast(Bot1)
Bot1.Pass
Bot2.Pass
? Bot1.Graveyard.Count = 7
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
? Bot2.Hand.Count = 6
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Tidecaller Mentor.Cast
Bot1.Pass
Bot2.Pass
Bot1.Target()
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Battlefield = Island; Memnite
Bot2.Hand.Count = 6
Bot1.Battlefield = Mox Ruby; Mox Sapphire; Mox Jet; Tidecaller Mentor
