Bot2.Hand.Island.Play
[T4 Bot2.Main1]
Bot2.Hand.Strip Mine.Play
[T5 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Ticket Tortoise.Cast
Bot1.Pass
Bot2.Pass
? Stack.Count = 1
Bot1.Pass
Bot2.Battlefield.Strip Mine.Activate(Bot2.Battlefield.Island; Ability: Destroy)
Bot2.Pass
Bot1.Pass
? Bot2.Battlefield = 
Bot2.Pass
Bot1.Pass

