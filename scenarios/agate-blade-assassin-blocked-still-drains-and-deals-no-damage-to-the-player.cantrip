# Agate-Blade Assassin: the trigger happens on attacking, before blockers (CR 508.2a, 509.1a): Bot2 blocks the 1/3 with Memnite, so Bot2 loses
# only the 1 life of the trigger and Bot1 still gains 1.

[Bot1 Deck]
Mox Jet
Mox Ruby
Agate-Blade Assassin
Swamp x17

[Bot2 Deck]
Memnite
Island x20

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Agate-Blade Assassin.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Agate-Blade Assassin > Bot2)
Bot1.Pass
Bot2.Pass
? Bot2.Life = 19
[T3 Bot1.DeclareBlockers]
Bot2.Block(Memnite > Agate-Blade Assassin)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 19
Bot1.Life = 21
