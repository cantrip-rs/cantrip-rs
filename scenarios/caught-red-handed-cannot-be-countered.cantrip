# Caught Red-Handed can't be countered (CR 101.2): Bot2's Counterspell, cast in response with an Island and a Mox Sapphire,
# resolves and counters nothing, and the spell steals Bot2's Memnite all the same, suspected.

[Bot1 Deck]
Mountain
Mountain
Black Lotus
Mox Ruby
Caught Red-Handed
Mountain x15

[Bot2 Deck]
Island
Mox Sapphire
Memnite
Counterspell
Island x16

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Ruby.Cast
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Memnite.Cast
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Caught Red-Handed.Cast(Bot2.Battlefield.Memnite)
? Stack = Caught Red-Handed
Bot2.Battlefield.Island.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.Counterspell.Cast(Caught Red-Handed)
? Stack = Counterspell; Caught Red-Handed
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Memnite.Suspected = true

[Expect]
Stack.Count = 0
Bot1.Graveyard = Caught Red-Handed; Black Lotus
Bot2.Graveyard = Counterspell
Bot2.Battlefield = Island; Mox Sapphire
