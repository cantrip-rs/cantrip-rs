# {1}{U}, {T}, Sacrifice a Desert with Ipnu Rivulet the only Desert (a ruling: it may sacrifice itself to pay): Mox
# Sapphire and Mox Ruby pay exactly {1}{U} (pool empty right after; with Sapphire alone the activation is not offered),
# the Rivulet goes to the graveyard and Bot2, the target, mills exactly four; Bot1's library is untouched.

[Bot1 Deck]
Ipnu Rivulet
Mox Sapphire
Mox Ruby
Plains x17

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Ipnu Rivulet.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot2.Pass
! Bot1.Battlefield.Ipnu Rivulet.Activate(Ability: Sacrifice a Desert; Mana: short)
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Ipnu Rivulet.Activate(Ability: Sacrifice a Desert; Bot2)
Bot1.Choose(Tap Ipnu Rivulet)
Bot1.Pass
? Bot1.Mana = 
Bot2.Pass

[Expect]
Bot2.Library.Count = 9
Bot2.Graveyard.Count = 4
Bot1.Graveyard.Count = 1
Bot1.Library.Count = 13
