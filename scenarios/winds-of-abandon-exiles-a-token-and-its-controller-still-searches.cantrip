# "For each creature exiled this way" counts a token (it is exiled, then ceases to exist): Bot2's Drone, made by Pinnacle
# Emissary when it cast Mox Pearl, is exiled and Bot2 still fetches a tapped Forest. Nothing is left in exile.

[Bot1 Deck]
Plains
Mox Jet
Winds of Abandon
Plains x12

[Bot2 Deck]
Mox Sapphire
Mox Ruby
Mox Jet
Pinnacle Emissary
Mox Pearl
Forest
Forest x10

[Actions]
[T2 Bot2.Main1]
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Mox Jet.Cast
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Pinnacle Emissary.Cast
Bot2.Pass
Bot2.Hand.Mox Pearl.Cast
Bot2.Pass
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Hand.Plains.Play
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Winds of Abandon.Cast(Bot2.Battlefield.Drone Token)
Bot2.Search(Forest)
[T3 Bot1.Main2]

[Expect]
Exile.Count = 0
Bot2.Battlefield = Mox Sapphire; Mox Ruby; Mox Jet; Pinnacle Emissary; Mox Pearl; Forest
Bot2.Battlefield.Forest.Tapped = true
