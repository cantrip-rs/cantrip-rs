Bot1.Attack(Clamorous Ironclad > Bot2)
Bot1.Pass
! Bot2.Block(Ornithopter#1 > Clamorous Ironclad)
Bot2.Block(Ornithopter#1 > Clamorous Ironclad; Ornithopter#2 > Clamorous Ironclad)
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 20
Bot2.Graveyard.Count = 2
Bot2.Battlefield.Ornithopter = (absent)
Bot1.Battlefield.Clamorous Ironclad.Damage = 0
