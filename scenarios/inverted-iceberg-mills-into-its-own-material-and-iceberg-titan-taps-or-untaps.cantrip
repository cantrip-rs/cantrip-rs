# Inverted Iceberg // Iceberg Titan. As the Iceberg enters Bot1 mills a card - an Ornithopter - then draws one. On turn
# three it crafts with that artifact card from the graveyard (Craft with artifact {4}{U}{U}) into Iceberg Titan, a 6/6.
# "Whenever this creature attacks, you may tap or untap target artifact or creature": on turn five it taps Bot2's
# Ornithopter, on turn seven it untaps Bot1's own Mox Jet, tapped for mana in the main phase, and on turn nine it does
# nothing to Bot2's Ornithopter.

[Bot1 Deck]
Island
Inverted Iceberg
Mox Sapphire
Black Lotus
Mox Jet
Mox Ruby
Island
Ornithopter
Island
Island x10

[Bot2 Deck]
Ornithopter
Island x20

[Actions]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Inverted Iceberg.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
? Bot1.Graveyard = Ornithopter
? Bot1.Hand = Island; Island
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Inverted Iceberg.Activate(Ability: Craft)
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Island#1.Activate
Bot1.Battlefield.Island#2.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Graveyard.Ornithopter)
[T5 Bot1.DeclareAttackers]
? Bot1.Battlefield.Iceberg Titan.Power = 6
Bot1.Attack(Iceberg Titan > Bot2)
Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Modes(Tap)
[T5 Bot1.Main2]
? Bot2.Battlefield.Ornithopter.Tapped = true
? Bot2.Life = 14
[T7 Bot1.Main1]
Bot1.Battlefield.Mox Jet.Activate
[T7 Bot1.DeclareAttackers]
? Bot1.Battlefield.Mox Jet.Tapped = true
Bot1.Attack(Iceberg Titan > Bot2)
Bot1.Target(Mox Jet)
Bot1.Modes(Untap)
[T7 Bot1.Main2]
? Bot1.Battlefield.Mox Jet.Tapped = false
[T9 Bot1.DeclareAttackers]
Bot1.Attack(Iceberg Titan > Bot2)
Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Modes(Do nothing)
[T9 Bot1.Main2]

[Expect]
Bot2.Battlefield.Ornithopter.Tapped = false
Bot2.Life = 2
Exile = Ornithopter
