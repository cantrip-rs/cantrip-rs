# Bot2 takes Bot1's Firestorm Phoenix with Control Magic and kills it with Lightning Bolt on their own turn. It returns to
# its owner's hand, Bot1's, not its controller's (CR 614.1a), and "that player" is its owner: Bot1 plays with it revealed
# until Bot1's next turn - the very next one, turn 3 - when it is hidden again and may be cast (CR 611.2a). Had the effect
# lasted until its controller's next turn, it would still bar the card on turn 3.

[Bot1 Deck]
Firestorm Phoenix
Black Lotus
Mox Pearl
Mox Sapphire
Mox Jet
Mountain
Mountain
Mountain x20

[Bot2 Deck]
Black Lotus
Mox Pearl
Mox Ruby
Control Magic
Lightning Bolt
Island
Island
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Firestorm Phoenix.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Black Lotus.Cast
Bot2.Pass
Bot2.Hand.Mox Pearl.Cast
Bot2.Pass
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Battlefield.Black Lotus.Activate(Color: Blue)
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Hand.Control Magic.Cast(Firestorm Phoenix)
Bot2.Pass
Bot1.Pass
? Bot2.Battlefield.Firestorm Phoenix.Tapped = false
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Firestorm Phoenix)
Bot2.Pass
Bot1.Pass
? Bot1.Hand = Firestorm Phoenix; Mountain; Mountain
? Bot2.Hand.Firestorm Phoenix = (absent)
? Bot2.Sees.Bot1.Hand = Firestorm Phoenix
[T3 Bot1.Main1]
! Bot1.Hand.Firestorm Phoenix.Cast(Mana: short)

[Expect]
Bot2.Sees.Bot1.Hand.Count = 0
