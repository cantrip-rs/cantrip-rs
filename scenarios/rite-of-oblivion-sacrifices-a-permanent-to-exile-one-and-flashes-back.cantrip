# Rite of Oblivion: "as an additional cost, sacrifice a nonland permanent", for the front and for the flashback too
# (CR 118.8). On turn 3 Bot1 sacrifices a Mox Sapphire to exile Bot2's Mox Ruby; on turn 5 it flashes the Rite back for
# {2}{W}{B}, sacrificing the (already tapped) Mox Pearl to exile Bot2's Mox Emerald, and the Rite is exiled.

[Bot1 Deck]
Mox Pearl
Mox Jet
Mox Ruby
Mox Emerald
Mox Sapphire
Rite of Oblivion
Island x14

[Bot2 Deck]
Island
Mox Ruby
Mox Emerald
Island x17

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot2.Hand.Island.Play
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Mox Emerald.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Rite of Oblivion.Cast(Bot2.Battlefield.Mox Ruby)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Mox Sapphire)
[T3 Bot1.Main2]
? Bot2.Battlefield.Count = 2
? Bot1.Graveyard = Rite of Oblivion; Mox Sapphire
[T5 Bot1.Main1]
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Graveyard.Rite of Oblivion.Cast(Bot2.Battlefield.Mox Emerald; Ability: Flashback)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Mox Pearl)

[Expect]
Bot1.Graveyard.Count = 2
Bot1.Battlefield.Count = 3
Bot2.Battlefield = Island
Exile.Count = 3
