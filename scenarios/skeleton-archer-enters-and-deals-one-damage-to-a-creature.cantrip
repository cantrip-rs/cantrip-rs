# The same trigger aimed at Bot2's Memnite (1/1): the one damage kills it and Bot2 keeps all 20 life.

[Bot1 Deck]
Black Lotus
Mox Jet
Skeleton Archer
Island x17

[Bot2 Deck]
Memnite
Island x19

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Skeleton Archer.Cast
Bot1.Pass
Bot2.Pass
Bot1.Target(Bot2.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Life = 20
Bot2.Graveyard = Memnite
