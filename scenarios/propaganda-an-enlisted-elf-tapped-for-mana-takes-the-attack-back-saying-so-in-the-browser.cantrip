# Browser
# Under Bot2's Propaganda, Bot1 attacks with Coalition Skyknight, enlisting Llanowar Elves (CR 702.154a), then pays the
# {2} with the Elves' own mana and Mox Emerald (CR 508.1i). The Elves, tapped for mana, can no longer be tapped for the
# enlist, so the costs can't all be paid and the declaration is taken back (CR 508.1j, 733.1): the Elves untap, and the
# attackers dock asked again says the attack was taken back. Bot1 then declares no attack.

[Bot1 Deck]
Forest
Black Lotus
Black Lotus
Llanowar Elves
Coalition Skyknight
Mox Emerald
Forest x10

[Bot2 Deck]
Island
Black Lotus
Propaganda
Island x10

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus#2.Activate(Color: White)
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Hand.Llanowar Elves.Cast
Bot1.Hand.Coalition Skyknight.Cast
Bot1.Hand.Mox Emerald.Cast
[T2 Bot2.Main1]
Bot2.Hand.Black Lotus.Cast
Bot2.Battlefield.Black Lotus.Activate(Color: Blue)
Bot2.Hand.Propaganda.Cast
[T3 Bot1.BeginCombat]
Bot1.Pass
? Client.Bot1.Prompt.Title = Declare attackers
Bot1.Attack(Coalition Skyknight > Bot2)
Bot1.Choose(Llanowar Elves)
? Combat.AttackCost = {2}
Bot1.Battlefield.Llanowar Elves.Activate
Bot1.Battlefield.Mox Emerald.Activate
? Bot1.Battlefield.Llanowar Elves.Tapped = false
? Client.Bot1.Prompt.Title = Declare attackers
? Client.Bot1.Prompt.Detail = The attack was taken back: its costs weren't all paid  ·  2 can attack  ·  attacking Bot2 costs {2} a creature (you can make up to 3 mana)
Bot1.Attack()
[T3 Bot1.Main2]

[Expect]
Turn = 3
Bot2.Life = 20
Bot1.Battlefield.Llanowar Elves.Tapped = false
Bot1.Battlefield.Coalition Skyknight.Tapped = false
