# Simic Guildgate: once it has untapped it taps for {G} on one turn and {U} on the next (the color is chosen as the ability is
# activated, CR 605.1a), never for another color or for colorless.

[Bot1 Deck]
Simic Guildgate
Island x19

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Simic Guildgate.Play
[T3 Bot1.Main1]
! Bot1.Battlefield.Simic Guildgate.Activate(Color: Red)
! Bot1.Battlefield.Simic Guildgate.Activate(Color: Colorless)
Bot1.Battlefield.Simic Guildgate.Activate(Color: Green)
? Bot1.Mana = {G}
[T5 Bot1.Main1]
Bot1.Battlefield.Simic Guildgate.Activate(Color: Blue)
? Bot1.Mana = {U}

[Expect]
Bot1.Battlefield.Simic Guildgate.Tapped = true
