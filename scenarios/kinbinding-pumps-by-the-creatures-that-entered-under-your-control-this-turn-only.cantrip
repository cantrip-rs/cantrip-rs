# Kinbinding (CR 613.4c, 603.6a): cast on turn 1 with Plains and four Moxen for {3}{W}{W}. At the beginning of combat its
# Kithkin token enters, so X is 1 and the token is a 2/2 for the rest of the turn. On turn 2 Bot2's Llanowar Elves enters,
# which is not under Bot1's control, and Bot1's turn-1 creatures no longer count: the token is a 1/1 again. On turn 3 the
# new beginning of combat makes a second token and X is 1 once more, so both are 2/2; Bot2 bolts the second one, and since it did enter
# under Bot1's control this turn the first stays a 2/2 (CR 603.6a).

[Bot1 Deck]
Plains
Mox Pearl
Mox Jet
Mox Ruby
Mox Sapphire
Mox Emerald
Kinbinding
Plains x13

[Bot2 Deck]
Forest
Llanowar Elves
Mox Ruby
Lightning Bolt
Forest x16

[Actions]
Bot1.Hand.Plains.Play
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Kinbinding.Cast
Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Sapphire.Activate
[T1 Bot1.Main2]
? Bot1.Battlefield.Kithkin Token.Power = 2
? Bot1.Battlefield.Kithkin Token.Toughness = 2
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Llanowar Elves.Cast
Bot2.Hand.Mox Ruby.Cast
[T2 Bot2.Main2]
? Bot1.Battlefield.Kithkin Token.Power = 1
? Bot2.Battlefield.Llanowar Elves.Power = 1
[T3 Bot1.BeginCombat]
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Kithkin Token#1.Power = 2
? Bot1.Battlefield.Kithkin Token#2.Power = 2
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Kithkin Token#2)
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield.Kithkin Token.Power = 2
Bot1.Battlefield.Kithkin Token.Toughness = 2
Bot1.Graveyard.Count = 0
