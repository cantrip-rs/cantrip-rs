# "Destroy up to one target artifact" has no controller restriction: Bot1 destroys its own Memnite, and the Orangutan gets no
# counters (the destroy mode does not sacrifice anything).

[Bot1 Deck]
Mox Ruby
Mox Pearl
Mox Jet
Gearbane Orangutan
Memnite
Plains x15

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Memnite.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Gearbane Orangutan.Cast
Bot1.Pass
Bot2.Pass
Bot1.Modes(Destroy up to one target artifact)
Bot1.Target(Bot1.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
? Bot1.Graveyard = Memnite
? Bot1.Battlefield.Gearbane Orangutan.Power = 2

[Expect]
Bot1.Battlefield.Count = 4
