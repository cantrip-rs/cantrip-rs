Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Aang, at the Crossroads.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
? Bot1.Battlefield.Memnite.Power = 1
[T4 Bot2.Main1]
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Ornithopter)
Bot2.Pass
Bot1.Pass
? Stack.Count = 1
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Island.Activate
Bot1.Hand.Mirrorweave.Cast(Memnite)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Memnite#2.Power = 1
Bot1.Pass
Bot2.Pass
[T4 Bot2.End]
? Bot1.Battlefield.Memnite#2.Power = 1
[T5 Bot1.Main1]

[Expect]
Turn = 5
Bot1.Battlefield.Aang, Destined Savior.Power = 4
