Bot1.Attack(Air Response Unit > Bot2)
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]
? Bot2.Life = 14
[T4 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Battlefield.Black Lotus.Activate(Color: Blue)
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Hand.Air Response Unit.Cast
Bot2.Pass
Bot1.Pass
Bot2.Battlefield.Air Response Unit.Activate(Ability: Crew)
Bot2.Choose(Memnite#2)
Bot2.Pass
Bot1.Pass
