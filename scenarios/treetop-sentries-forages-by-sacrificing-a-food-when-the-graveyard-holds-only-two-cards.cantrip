? Bot1.Graveyard = City Pigeon; Lightning Bolt
? Bot1.Battlefield.Food Token.Token = true
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Treetop Sentries.Cast
Bot1.Pass
Bot2.Pass
Bot1.Accept
Bot1.Pass
Bot2.Pass

