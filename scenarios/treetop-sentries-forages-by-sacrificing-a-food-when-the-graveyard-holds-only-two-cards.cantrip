Stack.Count = 0
Bot1.Graveyard = City Pigeon; Lightning Bolt
Bot1.Battlefield = Mox Pearl; Mox Emerald; Mox Jet; Mox Ruby; Treetop Sentries
Bot1.Hand.Count = 2
