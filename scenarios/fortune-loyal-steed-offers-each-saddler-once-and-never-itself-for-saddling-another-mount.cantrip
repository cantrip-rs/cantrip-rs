? Bot1.Battlefield.Savannah Lions.Tapped = false
Bot1.Battlefield.Fortune, Loyal Steed.Activate
Bot1.Choose(Savannah Lions)
Bot1.Pass
Bot2.Pass
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Fortune, Loyal Steed > Bot2)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
