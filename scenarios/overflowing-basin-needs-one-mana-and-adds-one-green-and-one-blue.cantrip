# Overflowing Basin: "{1}, {T}: Add {G}{U}." Turn 1 it is the only land, so the ability is not offered - it needs one
# mana. Turn 3 an Island pays the {1} and the Basin adds one green and one blue: {G}{U}, the fixed pair, never two of
# one color.

[Bot1 Deck]
Overflowing Basin
Island x19

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Overflowing Basin.Play
! Bot1.Battlefield.Overflowing Basin.Activate(Ability: {1}, {T}; Mana: short)
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Overflowing Basin.Activate(Ability: {1}, {T})
Bot1.Choose(Close mana window)
Bot1.Choose(Pay mana)
? Bot1.Mana = {U}{G}
! Bot1.Battlefield.Overflowing Basin.Activate(Ability: {1}, {T})

[Expect]
Turn = 3
Bot1.Battlefield.Overflowing Basin.Tapped = true
