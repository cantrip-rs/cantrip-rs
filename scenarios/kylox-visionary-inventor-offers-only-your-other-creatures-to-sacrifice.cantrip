# Kylox, Visionary Inventor: "sacrifice any number of other creatures" is your own, and not Kylox. Kylox came down on turn 1
# with Memnite; Bot2 has an Ornithopter. Attacking in turn 3 neither Kylox itself nor Bot2's Ornithopter may be chosen; the
# Memnite (the positive control) may, so X = 1 and the top card, an Island, is exiled and stays there. Bot2's lone Ornithopter
# cannot block the menace Kylox.

[Bot1 Deck]
Black Lotus
Black Lotus
Mox Ruby
Kylox, Visionary Inventor
Memnite
Plains x3
Island
Plains x5

[Bot2 Deck]
Ornithopter
Island x10

[Actions]
[T1 Bot1.Main1]
Bot1.Hand.Memnite.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Kylox, Visionary Inventor.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Kylox, Visionary Inventor > Bot2)
Bot1.Pass
Bot2.Pass
! Bot1.Choose(Kylox, Visionary Inventor)
! Bot1.Choose(Ornithopter)
Bot1.Choose(Memnite)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 16
Exile = Island
Exile.Count = 1
Bot2.Battlefield.Ornithopter.Damage = 0
Bot1.Graveyard = Memnite; Black Lotus; Black Lotus
