# Bot1's library is empty when Winds resolves. Shuffling the five cards in hand
# before drawing them prevents a failed draw (CR 608.2c, 704.5b).

[Bot1 Deck]
Winds of Change
Mox Ruby
Mountain x5

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Winds of Change.Cast
? Bot1.Mana =
Bot1.Pass

[Expect]
Bot1.Hand.Count = 5
Bot1.Library.Count = 0
Bot2.Hand.Count = 7
