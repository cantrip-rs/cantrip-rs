# Over the Edge, mode 2: the first explore reveals the Lightning Bolt (a counter) and Bot1 declines to put it into the graveyard, so the second reveals
# the same Bolt again (a second counter): the Elvish Mystic is a 3/3 and the Bolt, put into the graveyard by the second, leaves the Mountain on top.

[Bot1 Deck]
Forest
Mox Ruby
Elvish Mystic
Over the Edge
Island
Island
Island
Island
Lightning Bolt
Mountain
Island x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Elvish Mystic.Cast
[T2 Bot2.Main1]

[T3 Bot1.Main1]
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Over the Edge.Cast
Bot1.Modes(2)
Bot1.Target(Bot1.Battlefield.Elvish Mystic)
Bot1.Decline
Bot1.Accept

[Expect]
Turn = 3
Stack.Count = 0
Bot1.Mana =
Bot1.Battlefield.Elvish Mystic.Power = 3
Bot1.Battlefield.Elvish Mystic.Toughness = 3
Bot1.Battlefield.Elvish Mystic.Counters.PlusOnePlusOne = 2
Bot1.Graveyard = Over the Edge; Lightning Bolt
Bot1.Library = Mountain; Island; Island; Island; Island; Island; Island; Island; Island; Island; Island
Bot1.Library.Count = 11
