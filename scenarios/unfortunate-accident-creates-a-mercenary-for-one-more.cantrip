# Unfortunate Accident, the {1} mode alone (CR 702.172a, 111.1): Bot1 pays {B} plus {1} (two mana) with no creature on the
# battlefield at all (the destroy mode is not offered: it needs a target, CR 702.172a), and gets a 1/1 red Mercenary token.

[Bot1 Deck]
Mox Jet
Mox Ruby
Unfortunate Accident
Swamp x4
Swamp x15

[Bot2 Deck]
Island x22

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Unfortunate Accident.Cast
! Bot1.Modes(1)
! Bot1.Modes(1; 2)
Bot1.Modes(2)
? Bot1.Mana = 
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield.Mercenary Token.Power = 1
Bot1.Battlefield.Mercenary Token.Toughness = 1
Bot1.Battlefield.Mercenary Token.Colors = Red
Bot1.Graveyard = Unfortunate Accident
