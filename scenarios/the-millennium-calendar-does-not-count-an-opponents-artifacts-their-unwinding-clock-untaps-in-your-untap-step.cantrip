# The Millennium Calendar: "Whenever you untap one or more permanents during your untap step, put that many time counters on The
# Millennium Calendar." Bot2's Unwinding Clock ("Untap all artifacts you control during each other player's untap step") untaps
# Bot2's four tapped Moxes in Bot1's untap step on turn 3: Bot2 untaps them, not Bot1 (CR 502.3), so they are not counted. Bot1's
# own tapped Mox Jet untaps in the same step: one time counter.

[Bot1 Deck]
The Millennium Calendar
Mox Jet
Plains x10

[Bot2 Deck]
Mox Sapphire
Mox Emerald
Mox Ruby
Mox Pearl
Unwinding Clock
Plains x10

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.The Millennium Calendar.Cast
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Mox Jet.Tapped = true
[T2 Bot2.Main1]
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Emerald.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Mox Pearl.Cast
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Hand.Unwinding Clock.Cast
Bot2.Pass
Bot1.Pass
? Bot2.Battlefield.Unwinding Clock.Tapped = false
? Bot2.Battlefield.Mox Pearl.Tapped = true
[T3 Bot1.Main1]
? Bot2.Battlefield.Mox Sapphire.Tapped = false
? Bot2.Battlefield.Mox Pearl.Tapped = false
? Bot1.Battlefield.Mox Jet.Tapped = false

[Expect]
Bot1.Battlefield.The Millennium Calendar.Counters.Time = 1
