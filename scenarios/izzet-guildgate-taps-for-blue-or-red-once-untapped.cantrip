# Izzet Guildgate: once it has untapped it taps for {U} on one turn and {R} on the next (the color is chosen as the ability is
# activated, CR 605.1a), never for another color or for colorless.

[Bot1 Deck]
Izzet Guildgate
Island x19

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Izzet Guildgate.Play
[T3 Bot1.Main1]
! Bot1.Battlefield.Izzet Guildgate.Activate(Color: Green)
! Bot1.Battlefield.Izzet Guildgate.Activate(Color: Colorless)
Bot1.Battlefield.Izzet Guildgate.Activate(Color: Blue)
? Bot1.Mana = {U}
[T5 Bot1.Main1]
Bot1.Battlefield.Izzet Guildgate.Activate(Color: Red)
? Bot1.Mana = {R}

[Expect]
Bot1.Battlefield.Izzet Guildgate.Tapped = true
