# Hedge Shredder: a player can't choose to mill two cards with only one in the library (the ruling, CR 701.17b), so Bot1 is not asked,
# and the Forest stays in the library and does not enter.

[Bot1 Deck]
Black Lotus
Mox Emerald
Hedge Shredder
Memnite
Island
Island
Island
Island
Forest

[Bot2 Deck]
Island x24

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Memnite.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Hedge Shredder.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Hedge Shredder.Activate(Ability: Crew)
Bot1.Choose(Memnite)
Bot1.Pass
Bot2.Pass
Bot1.Attack(Hedge Shredder > Bot2)
! Bot1.Accept
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 15
Bot1.Battlefield = Hedge Shredder; Memnite; Mox Emerald
Bot1.Library = Forest
