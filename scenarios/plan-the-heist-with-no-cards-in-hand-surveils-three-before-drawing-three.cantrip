Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Plan the Heist.Cast
Bot1.Pass
Bot2.Pass
Bot1.Arrange(Counterspell; Island | Lightning Bolt)

[Expect]
Bot1.Graveyard = Plan the Heist; Lightning Bolt; Black Lotus
Bot1.Hand = Counterspell; Island; Ornithopter
