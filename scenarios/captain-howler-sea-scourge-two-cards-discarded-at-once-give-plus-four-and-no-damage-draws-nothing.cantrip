Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Captain Howler, Sea Scourge.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Jet.Cast
Bot2.Hand.Swamp.Play
Bot2.Hand.Chain of Smog.Cast(Bot1)
Bot2.Battlefield.Swamp.Activate
Bot2.Battlefield.Mox Jet.Activate
