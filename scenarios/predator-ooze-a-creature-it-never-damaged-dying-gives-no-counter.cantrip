# Predator Ooze: only a creature "dealt damage by this creature" counts (CR 603.2). Bot1's Ooze attacks on turn 3 (one counter, Bot2 takes
# 2) while Bot2's Grizzly Bears do not block; Bot1 then Shocks the Bears (Mox Ruby): the Bears die but the Ooze never damaged them, so it
# stays at its one counter.

[Bot1 Deck]
Black Lotus
Predator Ooze
Mox Ruby
Shock
Forest x20

[Bot2 Deck]
Mox Emerald
Forest
Grizzly Bears
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Hand.Predator Ooze.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Emerald.Cast
Bot2.Hand.Forest.Play
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Grizzly Bears.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.BeginCombat]
Bot1.Attack(Predator Ooze > Bot2)
Bot1.Pass
Bot2.Pass
Bot2.Block(Count: 0)
[T3 Bot1.Main2]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Shock.Cast(Bot2.Battlefield.Grizzly Bears)
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Graveyard = Grizzly Bears
Bot1.Battlefield.Predator Ooze.Counters.PlusOnePlusOne = 1
Bot2.Life = 18
