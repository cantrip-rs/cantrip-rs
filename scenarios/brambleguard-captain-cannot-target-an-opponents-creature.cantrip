# Brambleguard Captain's target is "creature you control": at the beginning of combat Bot1 may not choose Bot2's Ornithopter, and
# the Captain itself is the only legal choice (CR 115.1).

[Bot1 Deck]
Mox Ruby
Mox Jet
Mox Emerald
Mox Sapphire
Memnite
Brambleguard Captain
Mountain x14

[Bot2 Deck]
Ornithopter
Mountain x14

[Actions]
Bot1.Hand.Memnite.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Brambleguard Captain.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.BeginCombat]
! Bot1.Target(Ornithopter)
Bot1.Target(Memnite)
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield.Memnite.Power = 3
Bot2.Battlefield.Ornithopter.Power = 0
