Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Esoteric Duplicator.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Hand.Prismatic Vista.Play
Bot1.Battlefield.Prismatic Vista.Activate
? Stack.Count = 1
Bot1.Search()
? Stack.Count = 0
