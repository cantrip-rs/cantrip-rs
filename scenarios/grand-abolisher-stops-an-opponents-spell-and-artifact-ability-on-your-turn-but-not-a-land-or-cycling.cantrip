Bot1.Hand.Plains.Play
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Grand Abolisher.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Mox Ruby.Cast
[T3 Bot1.Main1]
! Bot2.Battlefield.Mox Ruby.Activate
! Bot2.Hand.Lightning Bolt.Cast(Bot1)
Bot2.Battlefield.Mountain.Activate
? Bot2.Mana = {R}
Bot2.Hand.Footfall Crater.Activate(Ability: Cycling)
? Bot2.Graveyard = Footfall Crater
[T4 Bot2.Main1]
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1)
Bot2.Pass
Bot1.Pass

[Expect]
Turn = 4
Bot1.Life = 17
Bot2.Graveyard = Lightning Bolt; Footfall Crater
