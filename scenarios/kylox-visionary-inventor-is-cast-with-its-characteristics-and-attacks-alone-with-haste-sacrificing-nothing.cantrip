Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Kylox, Visionary Inventor.Cast
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Kylox, Visionary Inventor.Power = 4
? Bot1.Battlefield.Kylox, Visionary Inventor.Toughness = 4
