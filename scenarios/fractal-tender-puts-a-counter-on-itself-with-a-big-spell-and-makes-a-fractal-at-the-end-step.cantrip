Bot1.Battlefield.Fractal Tender.Toughness = 4
Bot1.Battlefield.Fractal Token.Counters.PlusOnePlusOne = 3
Bot1.Battlefield.Fractal Token.Toughness = 3
Bot1.Battlefield.Fractal Token.Colors = Blue; Green
