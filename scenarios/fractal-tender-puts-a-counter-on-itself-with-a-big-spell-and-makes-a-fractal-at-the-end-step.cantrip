Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Fractal Tender.Cast
Bot1.Pass
Bot2.Pass
[T1 Bot1.End]
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
? Bot1.Battlefield.Count = 3
? Bot1.Battlefield.Fractal Tender.Counters.PlusOnePlusOne = (absent)
[T3 Bot1.Main1]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
