Bot1.Battlefield.Barbed Bloodletter.AttachedTo = Memnite
Bot1.Battlefield.Memnite.Power = 2
Bot1.Battlefield.Memnite.Toughness = 3
Bot1.Battlefield.Ornithopter.Power = 0
