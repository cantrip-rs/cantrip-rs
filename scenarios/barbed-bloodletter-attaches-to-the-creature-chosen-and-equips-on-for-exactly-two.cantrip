Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Barbed Bloodletter.Cast
Bot1.Pass
Bot2.Pass
! Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Target(Ornithopter)
