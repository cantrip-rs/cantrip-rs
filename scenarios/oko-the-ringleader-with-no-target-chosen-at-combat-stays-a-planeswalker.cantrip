# "...up to one target creature you control": with an Ornithopter to copy, Bot1 chooses no target at the beginning of combat on
# turn 3, so Oko stays a planeswalker (with his loyalty) through the turn and is not a creature.

[Bot1 Deck]
Mox Emerald
Mox Sapphire
Mox Ruby
Mox Pearl
Oko, the Ringleader
Ornithopter
Forest
Island x20

[Bot2 Deck]
Island x27

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Oko, the Ringleader.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.BeginCombat]
Bot1.Target()
Bot1.Pass
Bot2.Pass
? Stack.Count = 0
? Bot1.Battlefield.Oko, the Ringleader.Types = Planeswalker
? Bot1.Battlefield.Ornithopter.Types = Artifact; Creature
