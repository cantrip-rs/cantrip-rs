# Caught Red-Handed on a creature its caster already controls (the Act of Treason ruling): Bot1 taps its own Llanowar Elves
# for mana to cast it, and the Elves comes back untapped with haste, suspected (menace, can't block), still Bot1's.

[Bot1 Deck]
Forest
Mountain
Black Lotus
Mox Ruby
Llanowar Elves
Caught Red-Handed
Mountain x14

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Llanowar Elves.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Llanowar Elves.Activate
? Bot1.Battlefield.Llanowar Elves.Tapped = true
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Caught Red-Handed.Cast(Bot1.Battlefield.Llanowar Elves)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Llanowar Elves.Tapped = false
? Bot1.Battlefield.Llanowar Elves.Keywords = CantBlock; Haste; Menace
Bot1.Attack(Llanowar Elves > Bot2)
[T3 Bot1.Main2]
? Bot2.Life = 19

[Expect]
Bot1.Battlefield.Llanowar Elves.Suspected = true
Bot2.Life = 19
