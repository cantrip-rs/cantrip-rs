Bot1.Hand.Swamp.Play
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Cut Down.Cast(Ornithopter)
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Mox Sapphire.Cast
[T3 Bot1.Main1]
Bot1.Hand.Swamp.Play
Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Swamp.Activate
Bot1.Hand.Dance of the Dead.Cast(Bot1.Graveyard.Ornithopter)
Bot1.Pass
Bot1.Pass
Bot2.Battlefield.Island.Activate
Bot2.Hand.Stifle.Cast(Stack.Dance of the Dead)
[T3 Bot1.Main2]
? Bot1.Battlefield.Dance of the Dead.AttachedTo = Ornithopter
? Bot1.Graveyard.Ornithopter.Power = 0
[T5 Bot1.Upkeep]
? Stack.Count = 0

[Expect]
