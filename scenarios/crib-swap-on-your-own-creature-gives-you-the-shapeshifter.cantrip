# Crib Swap on its caster's own creature: Bot1 targets its own Ornithopter, so Bot1, its controller, gets the 1/1 Shapeshifter.

[Bot1 Deck]
Mox Pearl
Mox Ruby
Mox Jet
Ornithopter
Crib Swap
Island x15

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Crib Swap.Cast(Bot1.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield = Mox Pearl; Mox Ruby; Mox Jet; Shapeshifter Token
Bot1.Exile.Ornithopter.Toughness = 2
