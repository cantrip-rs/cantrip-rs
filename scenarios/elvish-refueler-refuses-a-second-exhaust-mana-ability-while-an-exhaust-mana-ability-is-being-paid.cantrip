Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Elvish Refueler.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Loot, the Pathfinder.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Loot, the Pathfinder.Activate(Ability: Add three mana; Color: Red)
? Bot1.Mana = {R}{R}{R}
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Elvish Refueler.Activate
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Elvish Refueler.Power = 3
[T5 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Spark Double.Cast
Bot1.Pass
Bot2.Pass
Bot1.Accept
Bot1.Target(Bot1.Battlefield.Loot, the Pathfinder)
? Bot1.Battlefield.Loot, the Pathfinder#2.Power = 3
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Loot, the Pathfinder#2.Activate(Ability: Add three mana; Color: Red)
? Bot1.Mana = {R}{R}{R}
[T7 Bot1.Upkeep]
Bot1.Battlefield.Mox Emerald.Activate
[T7 Bot1.Main1]
? Bot1.Mana =
Bot1.Battlefield.Loot, the Pathfinder#1.Activate(Ability: Add three mana; Color: Red)
! Bot1.Battlefield.Loot, the Pathfinder#2.Activate(Ability: Add three mana; Color: Green)
! Bot1.Battlefield.Loot, the Pathfinder#1.Activate(Ability: Add three mana; Color: Green)
Bot1.Battlefield.Forest.Activate

[Expect]
Bot1.Mana = {R}{R}{R}
