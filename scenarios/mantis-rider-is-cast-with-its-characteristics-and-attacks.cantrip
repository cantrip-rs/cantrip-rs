# Mantis Rider, a french vanilla creature: cast with Black Lotus mana, its characteristics as printed (power, toughness,
# keywords, colors, types, protection), then attacking Bot2, who has no creatures.
# Haste (CR 702.10b): it attacks the turn it comes under Bot1's control.
# Vigilance (CR 702.20b): attacking doesn't tap it.

[Bot1 Deck]
Black Lotus x3
Mantis Rider
Plains x20

[Bot2 Deck]
Island x24

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus#3.Activate(Color: White)
Bot1.Battlefield.Black Lotus#2.Activate(Color: Red)
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Mantis Rider.Cast
Bot1.Pass
Bot1.Attack(Mantis Rider > Bot2)
[T2 Bot2.End]
? Bot1.Battlefield.Mantis Rider.Power = 3
? Bot1.Battlefield.Mantis Rider.Toughness = 3
? Bot1.Battlefield.Mantis Rider.Keywords = Flying; Haste; Vigilance
? Bot1.Battlefield.Mantis Rider.Colors = Blue; Red; White
? Bot1.Battlefield.Mantis Rider.Types = Creature
? Bot1.Battlefield.Mantis Rider.Subtypes = Human; Monk
? Bot1.Battlefield.Mantis Rider.Supertypes = (absent)
? Bot1.Battlefield.Mantis Rider.ProtectionFrom = (absent)

[Expect]
Bot2.Life = 17
Bot1.Battlefield.Mantis Rider.Tapped = false
