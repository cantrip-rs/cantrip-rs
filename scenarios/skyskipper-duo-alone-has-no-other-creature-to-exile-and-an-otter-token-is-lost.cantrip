Bot1.Battlefield.Mox Sapphire#1.Activate
Bot1.Battlefield.Mox Sapphire#2.Activate
Bot1.Hand.Skyskipper Duo.Cast
Bot1.Pass
Bot2.Pass
? Exile.Count = 0
? Bot1.Battlefield.Count = 4
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Mox Sapphire#1.Activate
Bot1.Battlefield.Mox Sapphire#2.Activate
Bot1.Hand.Otterball Antics.Cast
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Otter Token.Power = 1
[T5 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Mox Sapphire#1.Activate
Bot1.Battlefield.Mox Sapphire#2.Activate
Bot1.Battlefield.Mox Sapphire#3.Activate
Bot1.Battlefield.Island#1.Activate
Bot1.Battlefield.Island#2.Activate
Bot1.Hand.Skyskipper Duo.Cast
Bot1.Pass
Bot2.Pass
! Bot1.Target(Bot1.Battlefield.Skyskipper Duo#2)
Bot1.Target(Bot1.Battlefield.Otter Token)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Otter Token = (absent)
[T5 Bot1.End]
Bot1.Pass
Bot2.Pass

