# Neglected Manor: a player at 13 life - exactly the limit - lets it enter untapped, and the player may be its own controller (a
# player is any player, CR 614.1d); Bot1 starts at 13 and Bot2 at 20. It taps at once for {B}, the second color it
# prints, and makes no other color, nor colorless.

[Life]
Bot1: 13

[Bot1 Deck]
Neglected Manor
Plains x19

[Bot2 Deck]
Plains x20

[Actions]
Bot1.Hand.Neglected Manor.Play
? Bot1.Battlefield.Neglected Manor.Tapped = false
! Bot1.Battlefield.Neglected Manor.Activate(Color: Blue)
! Bot1.Battlefield.Neglected Manor.Activate(Color: Red)
! Bot1.Battlefield.Neglected Manor.Activate(Color: Green)
! Bot1.Battlefield.Neglected Manor.Activate(Color: Colorless)
Bot1.Battlefield.Neglected Manor.Activate(Color: Black)
? Bot1.Mana = {B}

[Expect]
Bot1.Life = 13
Bot2.Life = 20
Bot1.Battlefield.Neglected Manor.Tapped = true
