# Provoke (CR 702.39a): Bot2's Barbary Apes attacked on turn 4 and are still tapped on turn 5. Bot1 attacks with Goblin Grappler and Bear
# Cub, provoking the Apes: accepted, the Apes untap and must block the Grappler (CR 509.1c) - not declining to block, and not blocking the Bear
# Cub instead, both refused. Bot2's Cylian Elf, untapped, is under no requirement. The target must be a creature defending
# player controls: Bot2's Mox Emerald and Bot1's own Bear Cub are refused. The Apes (2/2) kill the Grappler; the Bear Cub is unblocked.

[Bot1 Deck]
Mox Ruby
Mox Emerald
Mox Jet
Goblin Grappler
Bear Cub
Swamp
Swamp
Swamp x12

[Bot2 Deck]
Mox Emerald
Mox Ruby
Barbary Apes
Swamp
Swamp
Swamp
Swamp
Cylian Elf
Swamp x12

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Goblin Grappler.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Bear Cub.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Emerald.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Barbary Apes.Cast
[T4 Bot2.Main1]
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Cylian Elf.Cast
Bot2.Attack(Barbary Apes > Bot1)
[T5 Bot1.Main1]
Bot1.Attack(Goblin Grappler > Bot2; Bear Cub > Bot2)
! Bot1.Target(Bot2.Battlefield.Mox Emerald)
! Bot1.Target(Bot1.Battlefield.Bear Cub)
Bot1.Target(Bot2.Battlefield.Barbary Apes)
Bot1.Accept
? Bot2.Battlefield.Barbary Apes.Tapped = false
! Bot2.Block(Count: 0)
! Bot2.Block(Barbary Apes > Bear Cub)
Bot2.Block(Barbary Apes > Goblin Grappler)
[T5 Bot1.Main2]

[Expect]
Bot1.Graveyard = Goblin Grappler
Bot2.Life = 18
Bot2.Battlefield.Barbary Apes.Damage = 1
