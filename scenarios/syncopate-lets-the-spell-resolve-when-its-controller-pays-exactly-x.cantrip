# Syncopate ({X}{U}) with X = 2 on Bot1's Lightning Bolt: Bot1 taps two Moxen for exactly {2} and pays, so nothing is countered. The Bolt
# resolves (Bot2 takes 3) and goes to Bot1's graveyard, not into exile.

[Bot1 Deck]
Mountain
Mox Ruby
Mox Emerald
Mox Jet
Lightning Bolt
Mountain x12

[Bot2 Deck]
Mox Pearl
Mox Sapphire
Mox Jet
Syncopate
Island x12

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Jet.Cast
Bot2.Hand.Mox Pearl.Cast
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Jet.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Syncopate.Cast(Lightning Bolt; X: 2)
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.PayCost

[Expect]
Stack.Count = 0
Exile.Count = 0
Bot1.Graveyard = Lightning Bolt
Bot2.Life = 17
Bot2.Graveyard = Syncopate
Bot1.Battlefield.Mox Jet.Tapped = false
