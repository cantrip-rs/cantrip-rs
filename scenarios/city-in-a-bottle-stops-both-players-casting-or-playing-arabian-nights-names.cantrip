Bot1.Hand = Kird Ape; Desert
Bot2.Battlefield = Mox Pearl; Plains
Bot2.Battlefield.Mox Pearl.Tapped = false
Bot2.Battlefield.Plains.Tapped = false
Bot2.Hand = Camel; City in a Bottle; Island; Island; Island; Oasis
