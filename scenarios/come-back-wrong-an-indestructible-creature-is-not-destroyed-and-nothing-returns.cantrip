# Come Back Wrong targets Bot2's Darksteel Myr, which is indestructible (CR 702.12b): the destroy does nothing, so no card is put
# into a graveyard and nothing returns under Bot1's control; Bot1 controls nothing at the end step.

[Bot1 Deck]
Black Lotus
Come Back Wrong
Island x18

[Bot2 Deck]
Black Lotus
Darksteel Myr
Island x18

[Actions]
[T2 Bot2.Main1]
Bot2.Hand.Black Lotus.Cast
Bot2.Battlefield.Black Lotus.Activate(Color: Blue)
Bot2.Hand.Darksteel Myr.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Hand.Come Back Wrong.Cast(Target: Darksteel Myr)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Count = 0
[T4 Bot2.Upkeep]

[Expect]
Bot2.Battlefield = Darksteel Myr
Bot2.Graveyard = Black Lotus
Bot1.Battlefield.Count = 0
