Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Crown of the Ages.Activate(Bot1.Battlefield.Holy Strength)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
? Bot1.Mana = 
Bot1.Pass
Bot2.Pass
! Bot1.Choose(Bot1.Battlefield.Ornithopter)
! Bot1.Choose(Bot2.Battlefield.Black Knight)
Bot1.Choose(Bot2.Battlefield.Ornithopter)
? Bot1.Battlefield.Ornithopter.Power = 0
? Bot2.Battlefield.Ornithopter.Power = 1
[T5 Bot1.Main1]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Crown of the Ages.Activate(Bot1.Battlefield.Holy Strength)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
! Bot1.Choose(Bot2.Battlefield.Ornithopter)
Bot1.Choose(Bot1.Battlefield.Ornithopter)
