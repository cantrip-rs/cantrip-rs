# Illegal destinations are refused before a legal destination is chosen (CR 608.2d, 702.16c).
# A later activation moves the Aura back between legal hosts.
[Bot1 Deck]
Black Lotus x2
Mox Pearl
Mox Sapphire
Crown of the Ages
Holy Strength
Ornithopter
Black Lotus
Island x20

[Bot2 Deck]
Black Lotus
Black Knight
Ornithopter
Island x20

[Actions]
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus#1.Activate(Color: White)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Crown of the Ages.Cast
? Bot1.Mana = {W}{W}
Bot1.Hand.Holy Strength.Cast(Bot1.Battlefield.Ornithopter)
? Bot1.Mana = {W}
