Bot1.Modes(Keep Out deals 4 damage)
Bot1.Target(Bot2.Battlefield.Aegis Turtle)
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Battlefield.Aegis Turtle.Damage = 4
