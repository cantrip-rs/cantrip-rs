# Savior of the Small: the target is judged again as the ability resolves (CR 608.2b). Bot2 exiles Bot1's graveyard in response
# with Tormod's Crypt, so Memnite, the target, is gone and the ability does nothing: no card is returned, though Savior is
# still tapped and on the battlefield.

[Bot1 Deck]
Mox Pearl
Mox Jet
Mox Emerald
Mox Ruby
Savior of the Small
Faithless Looting
Memnite
Island x20

[Bot2 Deck]
Tormod's Crypt
Swamp x20

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Savior of the Small.Cast
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Tormod's Crypt.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Faithless Looting.Cast
Bot1.Pass
Bot1.Choose(Memnite; Island)
Bot1.Attack(Savior of the Small > Bot2)
[T3 Bot1.Main2]
Bot1.Pass
Bot2.Battlefield.Tormod's Crypt.Activate(Bot1)
Bot1.Pass
Bot2.Pass
[T3 Bot1.End]

[Expect]
Bot1.Hand = Island; Island
Bot1.Graveyard.Count = 0
Bot1.Battlefield.Savior of the Small.Tapped = true
Bot2.Graveyard = Tormod's Crypt
