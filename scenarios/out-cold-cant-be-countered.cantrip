# Out Cold: "This spell can't be countered." On Bot2's turn 2 Bot1 (four Moxen open) casts it at Bot2's Ornithopter and Bot2 answers with Counterspell (two Mox Sapphires): the Counterspell resolves
# and does nothing to Out Cold (CR 101.2, 701.6a), so the Ornithopter is still tapped and stunned and Bot1 still investigates.

[Bot1 Deck]
Mox Pearl
Mox Sapphire
Mox Jet
Mox Ruby
Out Cold
Island x15

[Bot2 Deck]
Mox Sapphire
Mox Sapphire
Ornithopter
Counterspell
Island x16

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Out Cold.Cast
Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot2.Battlefield.Mox Sapphire#1.Activate
Bot2.Battlefield.Mox Sapphire#2.Activate
Bot2.Hand.Counterspell.Cast(Stack.Out Cold)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
? Bot2.Battlefield.Ornithopter.Tapped = true
? Bot2.Battlefield.Ornithopter.Counters.Stun = 1
? Bot2.Graveyard = Counterspell
? Bot1.Graveyard = Out Cold

[Expect]
Bot1.Battlefield = Mox Pearl; Mox Sapphire; Mox Jet; Mox Ruby; Clue Token
