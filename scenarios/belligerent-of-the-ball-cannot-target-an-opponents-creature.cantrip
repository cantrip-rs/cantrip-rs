# Belligerent of the Ball: "Celebration — ... target creature you control gets +1/+0 and gains menace until end of turn." (CR 603.4,
# 115.1.) The Belligerent comes down after combat on turn 1, so it does not celebrate then. Bot2 casts an Ornithopter on turn 2. On
# turn 3 a Memnite and a Mox Ruby enter under Bot1's control (two nonland permanents): at the beginning of combat the trigger may not
# target Bot2's Ornithopter, a creature Bot1 does not control, and targets Bot1's Memnite, which becomes 2/1 with menace.

[Bot1 Deck]
Black Lotus
Belligerent of the Ball
Memnite
Mox Ruby
Mountain x20

[Bot2 Deck]
Ornithopter
Island x20

[Actions]
[T1 Bot1.Main2]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Belligerent of the Ball.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
! Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Target(Bot1.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Memnite.Power = 2
? Bot1.Battlefield.Memnite.Keywords = Menace
? Bot2.Battlefield.Ornithopter.Power = 0
? Bot2.Battlefield.Ornithopter.Keywords = Flying

[Expect]
Bot1.Battlefield.Memnite.Toughness = 1
