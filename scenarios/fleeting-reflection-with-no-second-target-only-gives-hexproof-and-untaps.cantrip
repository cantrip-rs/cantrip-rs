# Fleeting Reflection with "up to one other target creature" left empty: Bot1's tapped attacking Memnite gains hexproof and untaps but
# stays a 1/1 Memnite (so it deals 1 damage). Bot2's Lightning Bolt cannot target it (CR 702.11b), while the same Bolt can target Bot1's
# other Memnite, which has none (the positive control).

[Bot1 Deck]
Island
Memnite
Memnite
Island
Mox Jet
Fleeting Reflection
Island x12

[Bot2 Deck]
Mountain
Lightning Bolt
Mountain x13

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Memnite.Cast
Bot1.Hand.Memnite.Cast
Bot1.Hand.Mox Jet.Cast
Bot2.Hand.Mountain.Play
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Attack(Memnite#1 > Bot2)
? Bot1.Battlefield.Memnite#1.Tapped = true
Bot1.Battlefield.Island#1.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Fleeting Reflection.Cast
Bot1.Target(Memnite#1)
Bot1.Target()
Bot1.Pass
Bot2.Pass
Bot2.Battlefield.Mountain.Activate
! Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Memnite#1)
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Memnite#2)
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]
? Bot1.Battlefield.Memnite.Tapped = false
? Bot1.Battlefield.Memnite.Keywords = Hexproof
? Bot2.Life = 19

[Expect]
Bot2.Graveyard = Lightning Bolt
Bot1.Graveyard = Memnite; Fleeting Reflection
Bot1.Battlefield.Memnite.Power = 1
