# Myriad (CR 702.116a) with Draconic Visitor (CR 614.1a): the artifact token copy of Dalek Squadron meant for Bot3 is replaced by a 5/5
# Dragon. The Dragon is the token "created this way" (the Divine Visitation ruling), so it enters tapped and attacking Bot3, who takes 5,
# and is exiled at end of combat. Black Lotus pays for Dalek Squadron, the other Lotus and the two Mox Rubies for Draconic Visitor.
[Bot1 Deck]
Black Lotus
Black Lotus
Dalek Squadron
Draconic Visitor
Mox Ruby
Mox Ruby
Island x14

[Bot2 Deck]
Island x20

[Bot3 Deck]
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot3.Pass
Bot1.Battlefield.Black Lotus#1.Activate(Color: Black)
Bot1.Hand.Dalek Squadron.Cast
Bot1.Pass
Bot2.Pass
Bot3.Pass
Bot1.Battlefield.Black Lotus#1.Activate(Color: Red)
Bot1.Hand.Draconic Visitor.Cast
Bot1.Battlefield.Mox Ruby#1.Activate
Bot1.Battlefield.Mox Ruby#2.Activate
Bot1.Pass
Bot2.Pass
Bot3.Pass
[T4 Bot1.DeclareAttackers]
Bot1.Attack(Dalek Squadron > Bot2)
Bot1.Target(Bot3)
Bot1.Pass
Bot2.Pass
Bot3.Pass
? Bot1.Battlefield.Dragon Token.Tapped = true
? Combat.Attackers = Dalek Squadron > Bot2; Dragon Token > Bot3
[T4 Bot1.Main2]
? Bot3.Life = 15

[Expect]
Bot1.Battlefield.Dragon Token = (absent)
