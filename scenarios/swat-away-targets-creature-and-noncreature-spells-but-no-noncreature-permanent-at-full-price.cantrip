# Swat Away {2}{U}{U}: "The owner of target spell or creature puts it on their choice of the top or bottom of their library" - at its full price {2}{U}{U}, with nobody
# attacking. A Mox Ruby (a permanent, not a creature) is no legal target (refused). Bot1 swats Bot2's Memnite spell on turn 2 (Black Lotus and a Mox Sapphire pay the four) and
# Bot2 accepts the top; then Bot2's Lightning Bolt spell on turn 4 (two Mox Sapphires and two Islands pay) and Bot2 declines: the bottom. Neither spell is countered, so neither
# is in a graveyard, and the Bolt never deals its damage.

[Bot1 Deck]
Black Lotus
Mox Sapphire
Mox Sapphire
Swat Away
Swat Away
Island
Island
Island x13

[Bot2 Deck]
Mox Ruby
Memnite
Lightning Bolt
Island x17

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Island.Play
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Memnite.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: U)
Bot1.Battlefield.Mox Sapphire#1.Activate
! Bot1.Hand.Swat Away.Cast(Bot2.Battlefield.Mox Ruby)
Bot1.Hand.Swat Away.Cast(Stack.Memnite)
Bot2.Accept
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
[T4 Bot2.Main1]
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1)
Bot1.Battlefield.Mox Sapphire#1.Activate
Bot1.Battlefield.Mox Sapphire#2.Activate
Bot1.Battlefield.Island#1.Activate
Bot1.Battlefield.Island#2.Activate
Bot1.Hand.Swat Away.Cast(Stack.Lightning Bolt)
Bot2.Decline

[Expect]
Bot1.Life = 20
Bot2.Graveyard =
Bot1.Graveyard = Swat Away; Swat Away; Black Lotus
Bot2.Hand = Island; Island; Island; Island; Island; Memnite
Bot2.Library = Island; Island; Island; Island; Island; Island; Island; Island; Island; Island; Island; Island; Lightning Bolt
