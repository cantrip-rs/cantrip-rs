# Mudbutton Cursetosser with no Goblin to behold can only pay {2}, so it costs {B}{2} (CR 601.2b, 601.2f): Bot1's Mox Jet and Mox
# Ruby make two mana, one short, and the cast is refused though {B} is there. The positive control is
# mudbutton-cursetosser-beholds-a-goblin-card-and-then-a-goblin-permanent-for-b-alone.

[Bot1 Deck]
Mox Jet
Mox Ruby
Mudbutton Cursetosser
Island x17

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
! Bot1.Hand.Mudbutton Cursetosser.Cast(Mana: short)

[Expect]
Bot1.Battlefield = Mox Jet; Mox Ruby
Bot1.Hand.Count = 5
