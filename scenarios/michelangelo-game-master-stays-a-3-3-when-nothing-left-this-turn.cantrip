# Disappear's intervening "if" (CR 603.4): Michelangelo, Game Master is cast with three Moxen ({2}{G}), nothing leaves the battlefield under Bot1's control, so the end step
# trigger never happens and he stays a 3/3.

[Bot1 Deck]
Mox Emerald
Mox Jet
Mox Pearl
Michelangelo, Game Master
Island x16

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Michelangelo, Game Master.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Pass
Bot2.Pass
[T1 Bot1.End]

[Expect]
Bot1.Battlefield.Michelangelo, Game Master.Power = 3
Bot1.Battlefield.Michelangelo, Game Master.Toughness = 3
