# Conscripts cannot block alone or with one other creature, but can block alongside two others (CR 509.1b).
[Bot1 Deck]
Orcish Conscripts
Mox Ruby
Memnite x2
Mountain x20
[Bot2 Deck]
Memnite x3
Island x20
[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Orcish Conscripts.Cast
? Bot1.Mana =
Bot1.Pass
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot1.Hand.Memnite.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot2.Hand.Memnite.Cast
Bot2.Pass
[T4 Bot2.DeclareAttackers]
Bot2.Attack(Memnite#1 > Bot1; Memnite#2 > Bot1; Memnite#3 > Bot1)
! Bot1.Block(Orcish Conscripts > Memnite#1)
! Bot1.Block(Orcish Conscripts > Memnite#1; Bot1.Battlefield.Memnite#1 > Bot2.Battlefield.Memnite#2)
Bot1.Block(Orcish Conscripts > Bot2.Battlefield.Memnite#1; Bot1.Battlefield.Memnite#1 > Bot2.Battlefield.Memnite#2; Bot1.Battlefield.Memnite#2 > Bot2.Battlefield.Memnite#3)
[T4 Bot2.Main2]
[Expect]
Bot1.Life = 20
Bot1.Battlefield.Orcish Conscripts.Types = Creature
Bot1.Graveyard = Memnite; Memnite
Bot2.Graveyard = Memnite; Memnite; Memnite
