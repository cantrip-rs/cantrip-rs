# Rustler Rampage, Spree mode "+ {1} — Untap all creatures target player controls." ({W} + {1} = Mox Pearl + Mox Ruby). Bot1's Ornithopter attacked on turn 3 and is still tapped on
# turn 4, when Bot2 attacks with its Memnite. Bot1 targets itself in response to the attack: its Ornithopter untaps, the attacking Memnite stays tapped (the other player's
# creatures are not touched). The scenario beside this one targets Bot2 instead.

[Bot1 Deck]
Mox Pearl
Mox Ruby
Ornithopter
Rustler Rampage
Plains x3
Plains x13

[Bot2 Deck]
Memnite
Island x6
Island x13

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Ornithopter.Cast
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
[T3 Bot1.Main1]
Bot1.Attack(Ornithopter > Bot2)
[T3 Bot1.Main2]
? Bot1.Battlefield.Ornithopter.Tapped = true
[T4 Bot2.Main1]
Bot2.Attack(Memnite > Bot1)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Rustler Rampage.Cast
Bot1.Modes(1)
Bot1.Target(Bot1)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Ornithopter.Tapped = false
? Bot2.Battlefield.Memnite.Tapped = true

[Expect]
Bot1.Graveyard = Rustler Rampage
