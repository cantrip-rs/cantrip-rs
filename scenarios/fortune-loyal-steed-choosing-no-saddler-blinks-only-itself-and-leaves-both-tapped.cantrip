# Fortune, Loyal Steed's end-of-combat trigger exiles Fortune "and up to one creature that saddled it": Bot1 may choose none. Then
# only Fortune is exiled and returned (untapped, scrying 2 as it enters) while both saddlers stay tapped and no second Clue is made.

[Bot1 Deck]
Mox Pearl
Mox Ruby
Mox Emerald
Fortune, Loyal Steed
Plains
Thraben Inspector
Savannah Lions
Plains x12

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Plains.Play
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Hand.Fortune, Loyal Steed.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Arrange(Plains; Plains | )
Bot1.Hand.Thraben Inspector.Cast
Bot1.Battlefield.Plains.Activate
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Savannah Lions.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Fortune, Loyal Steed.Activate
Bot1.Choose(Thraben Inspector; Savannah Lions)
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Fortune, Loyal Steed > Bot2)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
[T3 Bot1.EndOfCombat]
Bot1.Pass
Bot2.Pass
Bot1.Choose()
Bot1.Pass
Bot2.Pass
Bot1.Arrange(Plains; Plains | )

[Expect]
Turn = 3
Stack.Count = 0
Bot1.Battlefield = Clue Token; Fortune, Loyal Steed; Mox Emerald; Mox Pearl; Mox Ruby; Plains; Savannah Lions; Thraben Inspector
Bot1.Battlefield.Thraben Inspector.Tapped = true
Bot1.Battlefield.Savannah Lions.Tapped = true
Bot1.Battlefield.Fortune, Loyal Steed.Tapped = false
Bot2.Life = 18
