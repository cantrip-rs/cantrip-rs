[T3 Bot1.DeclareAttackers]
Bot1.Attack(Mocking Sprite > Bot2; Runeclaw Bear > Bot2)
? Bot2.Battlefield.Kitesail Corsair.Keywords = (absent)
! Bot2.Block(Kitesail Corsair > Mocking Sprite)
Bot2.Block(Kitesail Corsair > Runeclaw Bear)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 18
Bot2.Graveyard = Kitesail Corsair
Bot1.Graveyard = Runeclaw Bear; Black Lotus
