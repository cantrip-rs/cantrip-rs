# Oviya, Automech Artisan's ability says "you may": turn 3 chooses nothing, so the Grizzly Bears stay in hand and the {T} is
# still spent (the cost is paid, CR 602.2). Turn 5 puts Grizzly Bears onto the battlefield: it is a creature but not an artifact,
# so it gets no counters and stays 2/2. Bot2's Memnite in the opponent's graveyard or hand is never an option: only the
# controller's hand is looked at.

[Bot1 Deck]
Black Lotus
Mox Ruby
Mox Emerald
Oviya, Automech Artisan
Grizzly Bears
Mox Jet
Swamp x14

[Bot2 Deck]
Memnite
Island x19

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Oviya, Automech Artisan.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Oviya, Automech Artisan.Activate
Bot1.Pass
Bot2.Pass
Bot1.Choose()
? Bot1.Battlefield.Oviya, Automech Artisan.Tapped = true
? Bot1.Hand.Grizzly Bears.Power = 2
[T5 Bot1.Main1]
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Oviya, Automech Artisan.Activate
Bot1.Pass
Bot2.Pass
Bot1.Choose(Grizzly Bears)

[Expect]
Bot1.Battlefield.Grizzly Bears.Power = 2
Bot1.Battlefield.Grizzly Bears.Toughness = 2
Bot1.Battlefield.Grizzly Bears.Counters.PlusOnePlusOne = (absent)
Bot1.Hand.Grizzly Bears = (absent)
Bot1.Battlefield.Oviya, Automech Artisan.Tapped = true
