# "Whenever you draw your third card each turn": the Hero's controller is Bot1, so Bot2's draw step and Brainstorm on
# turn 4 (Bot2's second, third and fourth cards of the turn) put no counter on it - nor does Brainstorm's cast.

[Bot1 Deck]
Island
Island
Astrologian's Planisphere
Island x12

[Bot2 Deck]
Island
Island
Brainstorm
Island x12

[Actions]
Bot1.Hand.Island.Play
Bot2.Hand.Island.Play
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Island#2.Activate
Bot1.Hand.Astrologian's Planisphere.Cast
[T4 Bot2.Main1]
Bot2.Battlefield.Island.Activate
Bot2.Hand.Brainstorm.Cast
[T4 Bot2.Main2]

[Expect]
Turn = 4
Bot2.Graveyard = Brainstorm
Bot1.Battlefield.Hero Token.Power = 1
Stack.Count = 0
