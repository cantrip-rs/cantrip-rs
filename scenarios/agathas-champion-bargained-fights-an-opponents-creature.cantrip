Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Hill Giant.Cast
[T3 Bot1.Main1]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Hand.Agatha's Champion.Cast
Bot1.Modes(Bargain:)
Bot1.Choose(Mox Ruby)
Bot1.Target(Bot2.Battlefield.Hill Giant)
[Bot1.Main2]

