# Goldfury Strider: "Activate only as a sorcery." (CR 307.1, 602.5d)
# Turn 1 Bot1 casts the Strider with Black Lotus and two Moxen and keeps two more Moxen untapped. On turn 2 Bot2 casts a Memnite and
# Bot1 holds priority with it on the stack, and would be able to pay the cost: the activation is refused, because it is not Bot1's
# main phase with an empty stack, and the Strider stays a 3/5.

[Bot1 Deck]
Black Lotus
Mox Ruby
Mox Jet
Mox Sapphire
Mox Pearl
Goldfury Strider
Plains x14

[Bot2 Deck]
Memnite
Island x19

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Goldfury Strider.Cast
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
! Bot1.Battlefield.Goldfury Strider.Activate(Tap: Mox Sapphire; Tap: Mox Pearl; Goldfury Strider)
? Bot1.Battlefield.Mox Sapphire.Tapped = false

[Expect]
Bot1.Battlefield.Goldfury Strider.Power = 3
