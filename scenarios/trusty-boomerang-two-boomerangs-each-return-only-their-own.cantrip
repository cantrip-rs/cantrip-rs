# Each granted ability refers to the Equipment that gave it (CR 113.10, 613.1f), not to any permanent of that name. Bot1 equips the
# first Trusty Boomerang to a Memnite and the second to an Ornithopter, then activates only the Ornithopter's ability, the one the
# second Boomerang gave: that Boomerang returns to hand, and the first, which a "first Trusty Boomerang found" reading would have
# returned, stays on the battlefield attached to the Memnite.

[Bot1 Deck]
Memnite
Ornithopter
Mox Jet
Mox Pearl
Mox Ruby
Trusty Boomerang
Trusty Boomerang
Plains x14

[Bot2 Deck]
Ornithopter
Plains x19

[Actions]
Bot1.Hand.Memnite.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Trusty Boomerang.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Trusty Boomerang.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Plains.Play
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Trusty Boomerang#1.Activate(Ability: Equip; Memnite)
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Trusty Boomerang#2.Activate(Ability: Equip; Bot1.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Trusty Boomerang#1.AttachedTo = Memnite
? Bot1.Battlefield.Trusty Boomerang#2.AttachedTo = Ornithopter
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Ornithopter.Activate(Ability: Tap target; Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass

[Expect]
Stack.Count = 0
Bot2.Battlefield.Ornithopter.Tapped = true
Bot1.Battlefield.Ornithopter.Tapped = true
Bot1.Battlefield.Trusty Boomerang.AttachedTo = Memnite
Bot1.Hand.Trusty Boomerang.Colors.Count = 0
