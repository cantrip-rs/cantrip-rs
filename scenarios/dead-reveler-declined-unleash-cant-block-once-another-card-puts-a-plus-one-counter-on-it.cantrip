Bot1.Pass
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Hand.Dead Reveler.Cast
Bot1.Pass
Bot1.Decline
? Bot1.Battlefield.Dead Reveler.Keywords = (absent)
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Snakeskin Veil.Cast(Bot1.Battlefield.Dead Reveler)
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Mountain Bandit.Cast
