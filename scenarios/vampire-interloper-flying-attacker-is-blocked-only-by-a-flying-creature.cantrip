# Vampire Interloper: "Flying" (CR 702.9b). Bot1 attacks with it on turn 3: Bot2's Memnite can't block it (no flying, refused) while its Ornithopter can (the positive control), so the
# Interloper's 2 damage kills the Ornithopter and Bot2 takes none.

[Bot1 Deck]
Mox Jet
Mox Ruby
Vampire Interloper
Island x4
Island x20

[Bot2 Deck]
Memnite
Ornithopter
Island x5
Island x20

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Vampire Interloper.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Attack(Vampire Interloper > Bot2)
! Bot2.Block(Memnite > Vampire Interloper)
Bot2.Block(Ornithopter > Vampire Interloper)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 20
Bot2.Graveyard = Ornithopter
Bot1.Battlefield = Mox Jet; Mox Ruby; Vampire Interloper
