Turn = 3
Stack.Count = 0
Bot1.Battlefield = Swamp; Mox Jet; Basking Rootwalla
Bot1.Graveyard = Dauthi Voidwalker
Bot2.Graveyard.Count = 0
Exile = Faithless Looting; Mountain
