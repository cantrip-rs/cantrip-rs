# Safe Haven exiles its controller's creature for two mana and returns it when sacrificed on a later upkeep.
[Bot1 Deck]
Safe Haven
Mox Pearl
Mox Ruby
Ornithopter
Plains x3
Plains x20
[Bot2 Deck]
Ornithopter
Plains x20
[Actions]
Bot1.Hand.Safe Haven.Play
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Safe Haven.Activate(Bot1.Battlefield.Ornithopter)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
? Exile = Ornithopter
[T3 Bot1.Upkeep]
Bot1.Decline
[T3 Bot1.Main1]
? Exile = Ornithopter
[T5 Bot1.Upkeep]
Bot1.Accept
Bot1.Pass
Bot2.Pass
[Expect]
Bot1.Battlefield.Ornithopter.Power = 0
Bot1.Graveyard = Safe Haven
Exile.Count = 0
Bot1.Battlefield.Ornithopter.Tapped = false
