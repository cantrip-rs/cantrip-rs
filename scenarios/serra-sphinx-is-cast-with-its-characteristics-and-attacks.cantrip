# Serra Sphinx, a french vanilla creature: cast with Black Lotus mana, its characteristics as printed (power, toughness,
# keywords, colors, types, protection), then attacking Bot2, who has no creatures.
# Vigilance (CR 702.20b): attacking doesn't tap it.

[Bot1 Deck]
Black Lotus x2
Serra Sphinx
Plains x21

[Bot2 Deck]
Island x24

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus#2.Activate(Color: Blue)
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Serra Sphinx.Cast
Bot1.Pass
[T2 Bot2.End]
? Bot1.Battlefield.Serra Sphinx.Power = 4
? Bot1.Battlefield.Serra Sphinx.Toughness = 4
? Bot1.Battlefield.Serra Sphinx.Keywords = Flying; Vigilance
? Bot1.Battlefield.Serra Sphinx.Colors = Blue
? Bot1.Battlefield.Serra Sphinx.Types = Creature
? Bot1.Battlefield.Serra Sphinx.Subtypes = Sphinx
? Bot1.Battlefield.Serra Sphinx.Supertypes = (absent)
? Bot1.Battlefield.Serra Sphinx.ProtectionFrom = (absent)
[T3 Bot1.Main1]
Bot1.Attack(Serra Sphinx > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 16
Bot1.Battlefield.Serra Sphinx.Tapped = false
