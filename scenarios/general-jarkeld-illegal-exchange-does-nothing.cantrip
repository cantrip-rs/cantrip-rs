# A nonflying blocker cannot be moved to a flying attacker, so neither block changes.
[Bot1 Deck]
General Jarkeld
Mox Pearl
Mox Sapphire
Mox Jet
Mox Ruby
Ornithopter
Memnite
Plains x20

[Bot2 Deck]
Ornithopter
Memnite
Island x20

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.General Jarkeld.Cast
? Bot1.Mana =
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot1.Hand.Memnite.Cast
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot2.Hand.Memnite.Cast
[T3 Bot1.Main1]
! Bot1.Battlefield.General Jarkeld.Activate
[T3 Bot1.BeginCombat]
Bot1.Attack(Ornithopter; Memnite)
Bot2.Block(Ornithopter > Ornithopter; Memnite > Memnite)
Bot1.Battlefield.General Jarkeld.Activate
! Bot1.Target(Count: 1)
! Bot1.Target(Bot2.Battlefield.Memnite)
Bot1.Target(Bot1.Battlefield.Ornithopter; Bot1.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
? Combat.Blocks = Memnite > Memnite; Ornithopter > Ornithopter
? Bot1.Battlefield.General Jarkeld.Tapped = true

[Expect]
