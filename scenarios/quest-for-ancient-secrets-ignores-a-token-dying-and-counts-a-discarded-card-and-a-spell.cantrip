Bot1.Pass
Bot1.Pass
! Bot1.Accept
[T4 Bot2.Main2]
Bot2.Battlefield.Swamp#2.Activate
Bot2.Hand.Duress.Cast(Bot1)
Bot2.Choose(Dark Ritual)
Bot1.Accept
[T4 Bot2.Main2]

[Expect]
Bot1.Battlefield.Quest for Ancient Secrets.Counters.Quest = 2
Bot1.Battlefield = Island; Plains; Mox Sapphire; Mox Pearl; Quest for Ancient Secrets; Spirit Token
Bot1.Graveyard = Dark Ritual; Lingering Souls
Bot2.Graveyard = Duress; Cut Down
