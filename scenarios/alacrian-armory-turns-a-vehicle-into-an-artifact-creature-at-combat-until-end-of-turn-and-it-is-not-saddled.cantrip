? Bot1.Battlefield.Reckoner Bankbuster.Subtypes = Vehicle
? Bot1.Battlefield.Reckoner Bankbuster.Power = 4
? Bot1.Battlefield.Reckoner Bankbuster.Toughness = 5
? Bot1.Battlefield.Reckoner Bankbuster.Keywords = Vigilance
? Bot1.Battlefield.Caustic Bronco.Saddled = (absent)
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Reckoner Bankbuster > Bot2)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Reckoner Bankbuster.Tapped = false
[T5 Bot1.Main1]
? Bot1.Battlefield.Reckoner Bankbuster.Types = Artifact

