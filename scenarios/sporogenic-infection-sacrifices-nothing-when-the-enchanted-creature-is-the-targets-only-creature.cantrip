# The enchanted Memnite is the only creature Bot2 controls, so Bot2 has no creature "other than enchanted creature" to sacrifice: the
# enters trigger does nothing (CR 701.21a), although Bot1 has a Memnite of its own.

[Bot1 Deck]
Mox Jet
Mox Ruby
Sporogenic Infection
Memnite
Swamp x20

[Bot2 Deck]
Memnite
Island x20

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Hand.Memnite.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Sporogenic Infection.Cast(Bot2.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
Bot1.Target(Bot2)
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Battlefield = Memnite
Bot1.Battlefield = Memnite; Mox Jet; Mox Ruby; Sporogenic Infection
Bot1.Graveyard.Count = 0
Bot2.Graveyard.Count = 0
Stack.Count = 0
