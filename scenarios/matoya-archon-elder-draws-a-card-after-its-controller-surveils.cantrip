Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Dreams of Laguna.Cast
Bot1.Pass
Bot2.Pass
Bot1.Arrange( | Island)
? Stack.Count = 1
? Bot1.Library.Count = 31
Bot1.Pass
