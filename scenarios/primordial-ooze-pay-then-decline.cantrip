# The upkeep counter sets the payment, and declining on the next upkeep taps the Ooze and deals two damage (CR 608.2c).
[Bot1 Deck]
Primordial Ooze
Mox Ruby
Mountain x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Primordial Ooze.Cast
? Bot1.Mana =
[T3 Bot1.Upkeep]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.PayCost
? Bot1.Mana =
[T3 Bot1.DeclareAttackers]
! Bot1.Attack()
Bot1.Attack(Primordial Ooze > Bot2)
[T5 Bot1.Upkeep]
Bot1.Decline
[T5 Bot1.Main1]

[Expect]
Bot1.Life = 18
Bot1.Battlefield.Primordial Ooze.Tapped = true
Bot1.Battlefield.Primordial Ooze.Counters.PlusOnePlusOne = 2
Bot2.Life = 18
