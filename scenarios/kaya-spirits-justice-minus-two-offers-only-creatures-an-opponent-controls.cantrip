# Kaya, Spirits' Justice's -2 has a slot "up to one target creature that player controls" for each other player (CR 601.2c, 115.1): in it
# only the creatures that opponent controls. Bot1 has Memnite and Ornithopter; Bot2 has a Mox Ruby and no creature. After Memnite is the first
# target there is nothing legal for Bot2's slot (not Bot2's Mox, which is no creature; not Bot1's own Ornithopter, which Bot2 does not control),
# so Bot1 is asked nothing more, and the -2 resolves at once: Memnite is exiled, the Mox and the Ornithopter stay.

[Bot1 Deck]
Kaya, Spirits' Justice
Black Lotus
Mox Pearl
Memnite
Ornithopter
Island x2
Island x13

[Bot2 Deck]
Mox Ruby
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Kaya, Spirits' Justice.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Kaya, Spirits' Justice.Activate(Ability: Exile target creature you control)
Bot1.Target(Bot1.Battlefield.Memnite)
! Bot1.Target
Bot1.Pass
Bot2.Pass

[Expect]
Exile = Memnite
Bot1.Battlefield.Ornithopter.Power = 0
Bot2.Battlefield = Mox Ruby
Bot1.Battlefield.Kaya, Spirits' Justice.Counters.Loyalty = 1
Stack.Count = 0
