# General Jarkeld can target two blocked attackers controlled by an opponent.
[Bot1 Deck]
General Jarkeld
Mox Pearl
Mox Sapphire
Mox Jet
Mox Ruby
Phyrexian Walker
Memnite
Plains x20

[Bot2 Deck]
Phyrexian Walker
Memnite
Island x20

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.General Jarkeld.Cast
? Bot1.Mana =
Bot1.Pass
Bot1.Hand.Phyrexian Walker.Cast
Bot1.Pass
Bot1.Hand.Memnite.Cast
Bot2.Hand.Phyrexian Walker.Cast
Bot2.Pass
Bot2.Hand.Memnite.Cast
[T4 Bot2.Main1]
[T4 Bot2.BeginCombat]
Bot2.Attack(Phyrexian Walker; Memnite)
Bot1.Block(Phyrexian Walker > Phyrexian Walker; Memnite > Memnite)
Bot1.Battlefield.General Jarkeld.Activate
! Bot1.Target(Count: 1)
! Bot1.Target(Bot1.Battlefield.Memnite)
Bot1.Target(Bot2.Battlefield.Phyrexian Walker; Bot2.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
? Combat.Blocks = Memnite > Phyrexian Walker; Phyrexian Walker > Memnite
? Bot1.Battlefield.General Jarkeld.Tapped = true

[Expect]
