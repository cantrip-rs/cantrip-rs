# Hawkeye, Clint Barton, a french vanilla creature: cast with Black Lotus mana, its characteristics as printed (power, toughness,
# keywords, colors, types, protection), then attacking Bot2, who has no creatures.
# Vigilance (CR 702.20b): attacking doesn't tap it.

[Bot1 Deck]
Black Lotus x2
Hawkeye, Clint Barton
Plains x21

[Bot2 Deck]
Island x24

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus#2.Activate(Color: White)
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Hand.Hawkeye, Clint Barton.Cast
Bot1.Pass
[T2 Bot2.End]
? Bot1.Battlefield.Hawkeye, Clint Barton.Power = 3
? Bot1.Battlefield.Hawkeye, Clint Barton.Toughness = 5
? Bot1.Battlefield.Hawkeye, Clint Barton.Keywords = Vigilance
? Bot1.Battlefield.Hawkeye, Clint Barton.Colors = White
? Bot1.Battlefield.Hawkeye, Clint Barton.Types = Creature
? Bot1.Battlefield.Hawkeye, Clint Barton.Subtypes = Archer; Hero; Human
? Bot1.Battlefield.Hawkeye, Clint Barton.Supertypes = Legendary
? Bot1.Battlefield.Hawkeye, Clint Barton.ProtectionFrom = (absent)
[T3 Bot1.Main1]
Bot1.Attack(Hawkeye, Clint Barton > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 17
Bot1.Battlefield.Hawkeye, Clint Barton.Tapped = false
