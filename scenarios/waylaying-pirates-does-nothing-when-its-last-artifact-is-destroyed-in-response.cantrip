# The intervening "if" is checked again as the ability resolves (CR 603.4): Bot1's Mox Sapphire is its only artifact once the sacrificed Black
# Lotus has paid for the Pirates, so the ability triggers (targeting Bot2's Ornithopter); Bot2 destroys the Mox with Disenchant in response
# and the ability does nothing: the Ornithopter stays untapped with no stun counter.

[Bot1 Deck]
Island
Black Lotus
Mox Sapphire
Waylaying Pirates
Island x3
Island x13

[Bot2 Deck]
Mox Pearl
Plains
Disenchant
Ornithopter
Island x16

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Pearl.Cast
Bot2.Pass
Bot2.Hand.Plains.Play
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Waylaying Pirates.Cast
Bot1.Pass
Bot2.Pass
Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Pass
? Stack.Count = 1
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Battlefield.Plains.Activate
Bot2.Hand.Disenchant.Cast(Bot1.Battlefield.Mox Sapphire)
Bot2.Pass
Bot1.Pass
Bot1.Pass
Bot2.Pass

[Expect]
Stack.Count = 0
Bot1.Graveyard = Mox Sapphire; Black Lotus
Bot2.Battlefield.Ornithopter.Tapped = false
Bot2.Battlefield.Ornithopter.Counters.Stun = (absent)
