# CR 701.26a, 301.5c, 602.2b: Bot2 takes Bot1's equipped Memnite with Act of Treason. The Pole stays Bot1's and stays
# attached, so Bot2 controls the Memnite and its granted ability. Tapping has no "you control" limit (unlike a sacrifice,
# CR 701.21a), so Bot2 pays "{1}, {T}, Tap Fishing Pole" with Bot1's Pole, and the bait counter goes on that Pole.

[Bot1 Deck]
Memnite
Mox Jet
Mox Pearl
Mox Ruby
Fishing Pole
Plains x16

[Bot2 Deck]
Mox Ruby
Mox Jet
Mox Pearl
Mox Emerald
Act of Treason
Mountain x16

[Actions]
Bot1.Hand.Memnite.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Fishing Pole.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Fishing Pole.Activate(Ability: Equip; Memnite)
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Mox Jet.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Mox Pearl.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Mox Emerald.Cast
Bot2.Pass
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Hand.Act of Treason.Cast(Bot1.Battlefield.Memnite)
Bot2.Pass
Bot1.Pass
? Bot2.Battlefield.Memnite.Tapped = false
? Bot1.Battlefield.Fishing Pole.Tapped = false
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Battlefield.Memnite.Activate
Bot2.Pass
Bot1.Pass
[T2 Bot2.Main2]

[Expect]
Bot1.Battlefield.Fishing Pole.Counters.Bait = 1
Bot1.Battlefield.Fishing Pole.Tapped = true
Bot2.Battlefield.Memnite.Tapped = true
