# Pugnacious Hammerskull: the stun counter from attacking alone (CR 122.1d) replaces its next untap: at turn 5's untap step the counter is removed
# and the Hammerskull stays tapped, so it cannot attack on turn 5.

[Bot1 Deck]
Mox Emerald
Mox Ruby
Mox Jet
Pugnacious Hammerskull
Forest
Forest
Forest
Forest x30

[Bot2 Deck]
Island x30

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Pugnacious Hammerskull.Cast
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Attack(Pugnacious Hammerskull > Bot2)
[T3 Bot1.Main2]
? Bot1.Battlefield.Pugnacious Hammerskull.Counters.Stun = 1
[T5 Bot1.DeclareAttackers]
? Bot1.Battlefield.Pugnacious Hammerskull.Counters.Stun = (absent)
? Bot1.Battlefield.Pugnacious Hammerskull.Tapped = true

[Expect]
Bot2.Life = 14
Bot1.Battlefield.Pugnacious Hammerskull.Counters.Stun = (absent)
Bot1.Battlefield.Pugnacious Hammerskull.Tapped = true
