# Bleeding Woods: a player at 13 life - exactly the limit - lets it enter untapped, and the player may be its own controller (a
# player is any player, CR 614.1d); Bot1 starts at 13 and Bot2 at 20. It taps at once for {G}, the second color it
# prints, and makes no other color, nor colorless.

[Life]
Bot1: 13

[Bot1 Deck]
Bleeding Woods
Plains x19

[Bot2 Deck]
Plains x20

[Actions]
Bot1.Hand.Bleeding Woods.Play
? Bot1.Battlefield.Bleeding Woods.Tapped = false
! Bot1.Battlefield.Bleeding Woods.Activate(Color: White)
! Bot1.Battlefield.Bleeding Woods.Activate(Color: Blue)
! Bot1.Battlefield.Bleeding Woods.Activate(Color: Black)
! Bot1.Battlefield.Bleeding Woods.Activate(Color: Colorless)
Bot1.Battlefield.Bleeding Woods.Activate(Color: Green)
? Bot1.Mana = {G}

[Expect]
Bot1.Life = 13
Bot2.Life = 20
Bot1.Battlefield.Bleeding Woods.Tapped = true
