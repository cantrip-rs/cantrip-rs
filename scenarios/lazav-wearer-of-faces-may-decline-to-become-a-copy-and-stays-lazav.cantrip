# Lazav, Wearer of Faces: "you may have Lazav become a copy". Lazav exiles the Ornithopter and investigates; Bot1 sacrifices the
# Clue and declines the copy. Lazav stays a 2/3 Lazav, the Ornithopter stays exiled, and the Clue's draw still happens.

[Bot1 Deck]
Mox Sapphire
Mox Jet
Mox Ruby
Lazav, Wearer of Faces
Ornithopter
Lightning Bolt
Island
Island x10

[Bot2 Deck]
Island x12

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Lazav, Wearer of Faces.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Lazav, Wearer of Faces > Bot2)
Bot1.Target(Bot1.Graveyard.Ornithopter)
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Clue Token.Activate
Bot1.Pass
Bot2.Pass
Bot1.Choose()
Bot1.Pass
Bot2.Pass

[Expect]
Exile = Ornithopter
Bot1.Battlefield.Lazav, Wearer of Faces.Power = 2
Bot1.Battlefield.Lazav, Wearer of Faces.Toughness = 3
Bot1.Battlefield.Ornithopter = (absent)
Bot1.Battlefield.Clue Token = (absent)
Bot1.Hand.Count = 3
