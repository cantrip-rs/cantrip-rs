Bot2.Hand.Swords to Plowshares.Cast(Bot1.Battlefield.Alpine Grizzly)
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield.Alpine Grizzly = (absent)
Bot1.Battlefield.Picnic Ruiner.Keywords = DoubleStrike
Bot2.Life = 16
Bot1.Life = 24
