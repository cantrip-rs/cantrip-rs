Bot2.Attack(Ornithopter > Bot1; Memnite > Bot1)
[T5 Bot1.Upkeep]
? Bot1.Battlefield.Ornithopter.Tapped = true
? Bot1.Battlefield.Memnite.Tapped = false
Bot1.Pass
Bot2.Pass
