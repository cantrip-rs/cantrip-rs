# Piggy Bank: "When this creature dies, create a Treasure token." Dies means put into a graveyard from the battlefield (CR 700.4):
# on turn 2 Bot2's Swords to Plowshares exiles it, so the ability does not trigger and no Treasure is made; Bot1 gains 3 life
# (its power).

[Bot1 Deck]
Mox Ruby
Mox Jet
Piggy Bank
Island x17

[Bot2 Deck]
Plains
Swords to Plowshares
Island x18

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Piggy Bank.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Plains.Play
Bot2.Battlefield.Plains.Activate
Bot2.Hand.Swords to Plowshares.Cast(Bot1.Battlefield.Piggy Bank)
Bot2.Pass
Bot1.Pass
? Bot1.Exile.Piggy Bank.Power = 3

[Expect]
Bot1.Life = 23
Bot1.Exile.Piggy Bank.Power = 3
Bot1.Battlefield = Mox Ruby; Mox Jet
