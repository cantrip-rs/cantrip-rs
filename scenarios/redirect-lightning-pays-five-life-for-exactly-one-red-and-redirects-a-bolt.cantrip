# Redirect Lightning, the "pay 5 life" branch (CR 601.2b, 119.4): Bot2 has a single Mox Ruby, so {R} is all it can
# pay. Bot2 pays 5 life (20 to 15), the pool is empty right after the cast, and the opponent's Bolt at Bot2 is
# redirected: its only other legal target is Bot1 (no creatures), so Bot1 takes 3 (17) and Bot2 keeps the rest.

[Bot1 Deck]
Mox Ruby
Lightning Bolt
Island x18

[Bot2 Deck]
Mox Ruby
Redirect Lightning
Island x15

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Redirect Lightning.Cast(Stack.Lightning Bolt)
Bot2.Modes(Pay 5 life)
Bot2.Choose(Pay mana)
? Bot2.Mana = 
? Bot2.Life = 15
Bot2.Pass
Bot1.Pass
[Bot1.Main2]

[Expect]
Turn = 3
Stack.Count = 0
Bot1.Life = 17
Bot2.Life = 15
Bot2.Graveyard = Redirect Lightning
Bot1.Graveyard = Lightning Bolt
