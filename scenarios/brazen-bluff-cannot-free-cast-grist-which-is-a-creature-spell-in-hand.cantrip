Bot2.Hand.Shock.Cast(Bot1)
Bot2.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Gleemox.Activate(Color: Red)
Bot1.Hand.Brazen Bluff.Cast(Shock)
Bot1.Pass
Bot2.Pass
Bot2.Decline
! Bot1.Choose(Grist, the Hunger Tide)
Bot1.Choose(Shock)
Bot1.Target(Bot2)
