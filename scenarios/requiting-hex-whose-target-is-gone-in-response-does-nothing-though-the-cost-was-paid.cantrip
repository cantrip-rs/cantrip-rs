# Bot2 removes the Hex's only target in response (a Lightning Bolt at its own Llanowar Elves): the Hex is not resolved (CR 608.2b), so
# "you gain 2 life" does not happen although the additional cost was paid - the blight counter stays on Bot1's Ornithopter.

[Bot1 Deck]
Mox Jet
Ornithopter
Requiting Hex
Island x4
Island x14

[Bot2 Deck]
Mox Emerald
Mox Ruby
Llanowar Elves
Lightning Bolt
Island x3
Island x13

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Ornithopter.Cast
Bot2.Hand.Mox Emerald.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Hand.Llanowar Elves.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Requiting Hex.Cast
Bot1.Modes(Blight 1)
Bot1.Target(Bot2.Battlefield.Llanowar Elves)
Bot1.Choose(Pay mana)
Bot1.Choose(Ornithopter)
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Llanowar Elves)
Bot1.Pass
[T3 Bot1.Main2]

[Expect]
Bot1.Life = 20
Bot1.Battlefield.Ornithopter.Counters.MinusOneMinusOne = 1
