# Salvation Swan's target is "up to one" (CR 601.2c, 115.1b): with a Memnite it could exile, Bot1 chooses no target, so nothing is
# exiled and nothing returns with a flying counter at the end step.

[Bot1 Deck]
Black Lotus
Mox Pearl
Memnite
Salvation Swan
Plains x16

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Salvation Swan.Cast
Bot1.Pass
Bot2.Pass
Bot1.Target()
Bot1.Pass
Bot2.Pass
? Exile.Count = 0
? Bot1.Battlefield = Mox Pearl; Memnite; Salvation Swan
[T1 Bot1.End]
Bot1.Pass
Bot2.Pass

[Expect]
Exile.Count = 0
Bot1.Battlefield.Memnite.Counters.Flying = (absent)
