# Ride the Rails whose only target is gone does not resolve (CR 608.2b), so the Adventure never sends the card to exile
# (CR 715.4): Bot1 casts it on Bot2's Ornithopter on turn 3, and in response Bot2 Lightning Bolts its own Ornithopter. The
# Minecart Daredevil card ends in Bot1's graveyard and cannot be cast from exile.

[Bot1 Deck]
Black Lotus
Minecart Daredevil
Mountain x5
Mountain x14

[Bot2 Deck]
Mox Ruby
Ornithopter
Lightning Bolt
Island x17

[Actions]
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Minecart Daredevil.Cast(Bot2.Battlefield.Ornithopter; Ability: Ride the Rails)
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Ornithopter)
Bot2.Pass
Bot1.Pass
Bot1.Pass

[Expect]
Bot1.Graveyard = Minecart Daredevil; Black Lotus
Bot2.Graveyard = Ornithopter; Lightning Bolt
Exile.Count = 0
