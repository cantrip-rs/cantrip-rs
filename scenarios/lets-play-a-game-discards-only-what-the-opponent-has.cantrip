# Let's Play a Game, second mode: "Each opponent discards two cards". An opponent holding a single card discards just that one
# (CR 701.9b). Bot2 casts four Moxen, a Memnite and an Ornithopter for free and plays an Island on turn 2, leaving one Island in hand
# (seven in the opening hand, one drawn); the discard empties its hand and does not touch life.

[Bot1 Deck]
Black Lotus
Mox Jet
Let's Play a Game
Swamp x20

[Bot2 Deck]
Mox Pearl
Mox Sapphire
Mox Jet
Mox Ruby
Memnite
Ornithopter
Island
Island
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Jet.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Pearl.Cast
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Jet.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Memnite.Cast
Bot2.Hand.Ornithopter.Cast
Bot2.Hand.Island.Play
? Bot2.Hand.Count = 1
[T3 Bot1.Main1]
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Let's Play a Game.Cast
Bot1.Modes(2)
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Hand.Count = 0
Bot2.Graveyard.Count = 1
Bot2.Life = 20
