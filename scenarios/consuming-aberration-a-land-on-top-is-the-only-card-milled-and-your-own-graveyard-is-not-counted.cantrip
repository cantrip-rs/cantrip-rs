# Consuming Aberration: with a land on top of Bot2's library the reveal stops at once and only that land is put into the graveyard.
# Bot1's own Lightning Bolt, cast on turn 5 to trigger it, goes to Bot1's graveyard afterwards and is not counted: with Bot2's
# Lightning Bolt and the milled Island the Aberration is a 2/2 (the Bolt in Bot1's graveyard would make it a 3/3).

[Bot1 Deck]
Mox Ruby
Mox Jet
Mox Sapphire
Mox Pearl
Mox Emerald
Consuming Aberration
Ornithopter
Lightning Bolt
Plains x15

[Bot2 Deck]
Mox Ruby
Lightning Bolt
Island x5
Island
Island
Island
Lightning Bolt
Island x10

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Hand.Lightning Bolt.Cast(Bot1)
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Consuming Aberration.Cast
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Consuming Aberration.Power = 1
[T5 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot1.Pass
Bot2.Pass
? Stack.Count = 1
? Bot2.Graveyard = Island; Lightning Bolt
? Bot1.Battlefield.Consuming Aberration.Power = 2
Bot1.Pass
Bot2.Pass

[Expect]
Stack.Count = 0
Bot1.Graveyard = Lightning Bolt
Bot2.Graveyard = Island; Lightning Bolt
Bot2.Library.Count = 11
Bot1.Battlefield.Consuming Aberration.Power = 2
Bot1.Battlefield.Consuming Aberration.Toughness = 2
