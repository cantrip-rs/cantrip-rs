# "Whenever Fíli or another nontoken Dwarf you control enters, create a 2/2 red Dwarf creature token" (CR 603.6a). Fíli
# entering makes one; Magda, a nontoken Dwarf of Bot1's, another; the Dwarf tokens Fíli makes do not trigger it (nontoken),
# nor does Elvish Mystic (no Dwarf), nor Bot2's own Magda (not Bot1's). Three Moxes and Fíli give Bot1 an enduring story, so
# Fíli pumps every creature Bot1 controls - Elvish Mystic is 2/2 - and none of Bot2's: Bot2's Magda stays 2/1.

[Bot1 Deck]
Plains
Mox Pearl
Mox Ruby
Mox Emerald
Fíli the Pathfinder
Magda, Brazen Outlaw
Elvish Mystic
Mountain
Island x10

[Bot2 Deck]
Mountain
Mountain
Magda, Brazen Outlaw
Island x20

[Actions]
Bot1.Hand.Plains.Play
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Fíli the Pathfinder.Cast
Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
[T1 Bot1.Main2]
? Bot1.Battlefield = Plains; Mox Pearl; Mox Ruby; Mox Emerald; Fíli the Pathfinder; Dwarf Token
Bot2.Hand.Mountain.Play
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Hand.Magda, Brazen Outlaw.Cast
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Plains.Activate
[T3 Bot1.Main2]
? Bot1.Battlefield = Plains; Mountain; Mox Pearl; Mox Ruby; Mox Emerald; Fíli the Pathfinder; Magda, Brazen Outlaw; Dwarf Token; Dwarf Token
Bot1.Hand.Elvish Mystic.Cast
Bot1.Battlefield.Mox Emerald.Activate
[T4 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Magda, Brazen Outlaw.Cast
Bot2.Battlefield.Mountain.Activate
Bot2.Battlefield.Mountain.Activate
[T4 Bot2.Main2]

[Expect]
Bot1.EnduringStory = true
Bot1.Battlefield = Plains; Mountain; Mox Pearl; Mox Ruby; Mox Emerald; Fíli the Pathfinder; Magda, Brazen Outlaw; Elvish Mystic; Dwarf Token; Dwarf Token
Bot1.Battlefield.Elvish Mystic.Power = 2
Bot1.Battlefield.Elvish Mystic.Toughness = 2
Bot2.Battlefield = Mountain; Mountain; Magda, Brazen Outlaw
Bot2.Battlefield.Magda, Brazen Outlaw.Power = 2
Bot2.Battlefield.Magda, Brazen Outlaw.Toughness = 1
