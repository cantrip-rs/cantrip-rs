# Desert can damage an opponent's attacker only at end of combat, after it dealt combat damage.
[Bot1 Deck]
Desert
Island x18

[Bot2 Deck]
Forest x2
Grizzly Bears
Island x18

[Actions]
Bot1.Hand.Desert.Play
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
[T4 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Battlefield.Forest.Activate
Bot2.Battlefield.Forest#2.Activate
Bot2.Hand.Grizzly Bears.Cast
[T6 Bot2.Main1]
Bot2.Attack(Grizzly Bears > Bot1)
[T6 Bot2.EndCombat]
? Bot1.Life = 18
Bot1.Battlefield.Desert.Activate(Grizzly Bears; Ability: deals 1 damage)
? Bot1.Mana =
[T6 Bot2.Main2]

[Expect]
Bot1.Battlefield.Desert.Tapped = true
Bot2.Battlefield.Grizzly Bears.Damage = 1
Bot1.Life = 18
