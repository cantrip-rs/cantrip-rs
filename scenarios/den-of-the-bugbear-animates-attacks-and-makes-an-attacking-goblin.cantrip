? Bot1.Battlefield.Den of the Bugbear.Toughness = 2
[T3 Bot1.Main2]
? Bot2.Life = 16
? Bot1.Battlefield.Goblin Token.Power = 1
? Bot1.Battlefield.Goblin Token.Tapped = true
