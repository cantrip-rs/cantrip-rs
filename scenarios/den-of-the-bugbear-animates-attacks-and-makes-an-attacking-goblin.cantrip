Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Den of the Bugbear.Activate(Ability: Until end of turn)
Bot1.Attack(Den of the Bugbear > Bot2)
? Bot1.Battlefield.Den of the Bugbear.Types = Land; Creature
? Bot1.Battlefield.Den of the Bugbear.Subtypes = Goblin
? Bot1.Battlefield.Den of the Bugbear.Colors = Red
