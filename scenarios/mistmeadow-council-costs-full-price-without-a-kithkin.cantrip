# "This spell costs {1} less to cast if you control a Kithkin": with no Kithkin the four Moxen are one short of {4}{G}. Bot2's Crossroads Watcher, a
# Kithkin, is not one Bot1 controls, so it reduces nothing.

[Bot1 Deck]
Mox Ruby
Mox Jet
Mox Sapphire
Mox Emerald
Mistmeadow Council
Island x10

[Bot2 Deck]
Black Lotus
Crossroads Watcher
Island x20

[Actions]
[T2 Bot2.Main1]
Bot2.Hand.Black Lotus.Cast
Bot2.Pass
Bot1.Pass
Bot2.Battlefield.Black Lotus.Activate(Color: Green)
Bot2.Hand.Crossroads Watcher.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Emerald.Activate
! Bot1.Hand.Mistmeadow Council.Cast(Mana: short)

[Expect]
Bot2.Battlefield.Crossroads Watcher.Power = 3
Bot1.Hand.Count = 4
