? Bot1.Graveyard.Count = 5
? Bot1.Battlefield.Grave Researcher.Prepared = true
? Exile = Reanimate
[T5 Bot1.Main1]
Bot1.Battlefield.Mox Jet.Activate
Bot1.Exile.Reanimate.Cast(Bot1.Graveyard.Grizzly Bears)
Bot1.Pass
Bot2.Pass

