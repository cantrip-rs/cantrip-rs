# Raph & Leo, Sibling Rivals: "untap one or two target attacking creatures" (CR 601.2c). On turn 3 Bot1 attacks with Raph & Leo, Memnite and Ornithopter: choosing no target is refused
# and so is choosing all three, but one is enough. Only Memnite untaps; Raph & Leo and Ornithopter stay tapped.

[Bot1 Deck]
Mox Ruby
Mox Pearl
Mox Jet
Raph & Leo, Sibling Rivals
Memnite
Ornithopter
Island x14

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Raph & Leo, Sibling Rivals.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Raph & Leo, Sibling Rivals; Memnite; Ornithopter)
! Bot1.Target(Count: 0)
! Bot1.Target(Raph & Leo, Sibling Rivals; Memnite; Ornithopter)
Bot1.Target(Memnite)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Memnite.Tapped = false
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield.Memnite.Tapped = false
Bot1.Battlefield.Raph & Leo, Sibling Rivals.Tapped = true
Bot1.Battlefield.Ornithopter.Tapped = true
