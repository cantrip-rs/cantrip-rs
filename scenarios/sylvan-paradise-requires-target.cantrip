# With no creatures, Sylvan Paradise cannot be cast; after Ornithopter enters, it can be targeted and becomes green (CR 601.2c).
[Bot1 Deck]
Sylvan Paradise
Forest
Ornithopter
Forest x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest.Activate
! Bot1.Hand.Sylvan Paradise.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Sylvan Paradise.Cast
! Bot1.Target(Count: 0)
Bot1.Target(Bot1.Battlefield.Ornithopter)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
[Expect]
Bot1.Battlefield.Ornithopter.Colors = Green
