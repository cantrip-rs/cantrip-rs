# An unused shield expires at end of turn, even for a multicolored black source (CR 611.2a).

[Bot1 Deck]
Mox Pearl
Mox Ruby
Circle of Protection: Black
Ornithopter
Island x20

[Bot2 Deck]
Mox Jet
Mox Ruby
Goblin Deathraiders
Island x20

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Circle of Protection: Black.Cast
? Bot1.Mana =
[T2 Bot2.Main1]
Bot2.Hand.Mox Jet.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Goblin Deathraiders.Cast
Bot2.Pass
Bot1.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Circle of Protection: Black.Activate
Bot1.Choose(Close mana window)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
! Bot1.Choose(Ornithopter)
Bot1.Choose(Goblin Deathraiders)
[T4 Bot2.DeclareAttackers]
Bot2.Attack(Goblin Deathraiders > Bot1)
[T4 Bot2.Main2]

[Expect]
Bot1.Life = 17
