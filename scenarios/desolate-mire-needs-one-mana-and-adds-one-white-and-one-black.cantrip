# Desolate Mire: "{1}, {T}: Add {W}{B}." Turn 1 it is the only land, so the ability is not offered - it needs one
# mana. Turn 3 an Island pays the {1} and the Mire adds one white and one black: {W}{B}, the fixed pair, never two of
# one color.

[Bot1 Deck]
Desolate Mire
Island x19

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Desolate Mire.Play
! Bot1.Battlefield.Desolate Mire.Activate(Ability: {1}, {T}; Mana: short)
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Desolate Mire.Activate(Ability: {1}, {T})
Bot1.Choose(Close mana window)
Bot1.Choose(Pay mana)
? Bot1.Mana = {W}{B}
! Bot1.Battlefield.Desolate Mire.Activate(Ability: {1}, {T})

[Expect]
Turn = 3
Bot1.Battlefield.Desolate Mire.Tapped = true
