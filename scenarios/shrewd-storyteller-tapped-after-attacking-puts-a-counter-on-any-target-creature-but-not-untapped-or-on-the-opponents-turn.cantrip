! Bot1.Target(Mox Jet)
Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
? Bot2.Battlefield.Ornithopter.Power = 1
[T6 Bot2.Main2]
? Bot1.Battlefield.Shrewd Storyteller.Tapped = true
? Stack.Count = 0

[Expect]
Bot2.Battlefield.Ornithopter.Power = 1
Bot2.Battlefield.Ornithopter.Toughness = 3
Bot1.Battlefield.Shrewd Storyteller.Power = 3
Bot2.Life = 17
