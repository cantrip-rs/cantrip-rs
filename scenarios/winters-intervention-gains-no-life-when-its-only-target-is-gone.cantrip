# Its only target is illegal on resolution (CR 608.2b), so the spell does nothing at all - no life either: Bot2 bolts its own
# Ornithopter in response to Winter's Intervention.

[Bot1 Deck]
Mox Jet
Mox Jet
Winter's Intervention
Swamp x16

[Bot2 Deck]
Mox Ruby
Ornithopter
Lightning Bolt
Island x16

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Jet.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Winter's Intervention.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Ornithopter)
[T3 Bot1.Main2]

[Expect]
Bot2.Graveyard = Ornithopter; Lightning Bolt
Bot1.Graveyard = Winter's Intervention
Bot1.Life = 20
Bot2.Life = 20
