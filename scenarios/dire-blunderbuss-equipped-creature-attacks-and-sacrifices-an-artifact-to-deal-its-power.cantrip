Bot1.Choose(Ornithopter#1)
Bot1.Battlefield.Dire Blunderbuss.Activate(Bot1.Battlefield.Ornithopter; Ability: Equip)
? Bot1.Battlefield.Ornithopter.Power = 0
? Bot1.Battlefield.Dire Blunderbuss.AttachedTo = (absent)
