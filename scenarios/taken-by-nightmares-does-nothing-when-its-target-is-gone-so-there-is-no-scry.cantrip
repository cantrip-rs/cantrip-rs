# Taken by Nightmares with a Flood in play: if its only target is gone as it resolves, the spell does nothing at all (CR 608.2b), the
# scry included. Bot2 answers by Lightning Bolting its own Ornithopter; Bot1 is never asked to scry and its library is untouched (Forest on top after the Island draw).

[Bot1 Deck]
Mox Jet
Mox Pearl
Mox Ruby
Mox Sapphire
Flood
Taken by Nightmares
Swamp
Island
Forest
Mountain x20

[Bot2 Deck]
Mox Ruby
Ornithopter
Lightning Bolt
Island x20

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot2.Pass
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Hand.Swamp.Play
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Flood.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Taken by Nightmares.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Ornithopter)
Bot2.Pass
Bot1.Pass
Bot2.Pass
! Bot1.Arrange
Bot1.Pass
Bot2.Pass

[Expect]
Exile.Count = 0
Bot2.Graveyard = Ornithopter; Lightning Bolt
Bot1.Graveyard = Taken by Nightmares
Bot1.Library.Top = Forest
