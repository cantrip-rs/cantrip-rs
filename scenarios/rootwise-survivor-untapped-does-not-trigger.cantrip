# Rootwise Survivor, Survival's "if this creature is tapped" (CR 603.4): Rootwise is cast on turn 3 and does not attack, so it is
# untapped at the beginning of the second main phase: no target is asked (the refusal) and the Forest is still a plain land with
# no counter. The control is the scenario where Rootwise attacks first.

[Bot1 Deck]
Mox Emerald
Mox Jet
Mox Ruby
Mox Pearl
Forest
Island
Rootwise Survivor
Island x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Forest.Play
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Rootwise Survivor.Cast
Bot1.Pass
[T3 Bot1.Main2]
! Bot1.Target
[T3 Bot1.End]

[Expect]
Bot1.Battlefield.Forest.Types = Land
Bot1.Battlefield.Forest.Counters.PlusOnePlusOne = (absent)
Bot1.Battlefield.Rootwise Survivor.Tapped = false
Bot2.Life = 20
