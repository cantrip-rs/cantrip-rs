# The upkeep trigger is on the stack independent of its source (CR 113.7a): Bot2 exiles the Dracosaur with Swords to
# Plowshares in response, and the trigger still resolves. It exiles Mountain and Lightning Bolt, grants the play of
# both, and makes the Dinosaur and the Treasure. Bot1 then plays the Mountain from exile and casts the Bolt from exile at Bot2: a grant lost with the source would fail here.

[Bot1 Deck]
Mox Ruby
Mox Jet
Black Lotus
Bonehoard Dracosaur
Island x3
Mountain
Lightning Bolt
Island x14

[Bot2 Deck]
Plains
Swords to Plowshares
Island x18

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Bonehoard Dracosaur.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Plains.Play
[T3 Bot1.Upkeep]
Bot1.Pass
Bot2.Battlefield.Plains.Activate
Bot2.Hand.Swords to Plowshares.Cast(Bot1.Battlefield.Bonehoard Dracosaur)
[T3 Bot1.Main1]
Bot1.Exile.Mountain.Play
? Bot1.Battlefield.Dinosaur Token.Power = 3
? Bot1.Battlefield.Treasure Token.Tapped = false
Bot1.Exile.Lightning Bolt.Cast(Bot2)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Pass

[Expect]
Turn = 3
Bot1.Life = 25
Bot2.Life = 17
Exile.Count = 1
Bot1.Battlefield.Mountain.Tapped = false
Bot1.Battlefield.Bonehoard Dracosaur = (absent)
