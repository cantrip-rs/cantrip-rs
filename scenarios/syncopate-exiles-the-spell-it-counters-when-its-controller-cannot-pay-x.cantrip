# Syncopate ({X}{U}): Bot2 casts it with X = 2 (Mox Sapphire, Mox Pearl, Mox Jet) on Bot1's Lightning Bolt. Bot1 has one Mox Ruby left after
# the Mountain pays for the Bolt, so it cannot pay {2}: the Bolt is countered and exiled instead of going to the graveyard.

[Bot1 Deck]
Mountain
Mox Ruby
Lightning Bolt
Mountain x12

[Bot2 Deck]
Mox Pearl
Mox Sapphire
Mox Jet
Syncopate
Island x12

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Hand.Mox Ruby.Cast
Bot2.Hand.Mox Pearl.Cast
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Jet.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Syncopate.Cast(Lightning Bolt; X: 2)
Bot1.Battlefield.Mox Ruby.Activate
! Bot1.PayCost
Bot1.Decline

[Expect]
Stack.Count = 0
Exile = Lightning Bolt
Bot1.Graveyard.Count = 0
Bot2.Life = 20
Bot2.Graveyard = Syncopate
