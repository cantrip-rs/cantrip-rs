# Long Feng, Grand Secretariat: only "another creature you control or a land you control" counts. Nothing triggers it when Bot2's Shatter
# destroys Bot1's Mox Jet (an artifact, turn 2), when Bot1's own Lightning Bolt kills Bot2's Memnite (an opponent's creature, turn 3), or when
# Bot2's Lightning Bolt kills the Long Feng itself (not "another" creature, turn 4): Bot1's Memnite never gets a counter.

[Bot1 Deck]
Long Feng, Grand Secretariat
Memnite
Mox Emerald
Mox Jet
Mox Ruby
Plains
Lightning Bolt
Plains x13

[Bot2 Deck]
Memnite
Mox Ruby
Mox Ruby
Shatter
Lightning Bolt
Mountain x15

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Plains.Play
Bot1.Battlefield.Plains.Activate
Bot1.Hand.Long Feng, Grand Secretariat.Cast
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mox Ruby#2.Activate
Bot2.Hand.Shatter.Cast(Bot1.Battlefield.Mox Jet)
Bot2.Pass
Bot1.Pass
? Bot1.Graveyard = Mox Jet
? Bot1.Battlefield.Long Feng, Grand Secretariat.Power = 2
? Bot1.Battlefield.Memnite.Power = 1
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
? Bot2.Graveyard = Memnite; Shatter
? Bot1.Battlefield.Long Feng, Grand Secretariat.Power = 2
? Bot1.Battlefield.Memnite.Power = 1
[T4 Bot2.Main1]
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Long Feng, Grand Secretariat)
Bot2.Pass
Bot1.Pass
[T4 Bot2.Main2]

[Expect]
Bot1.Graveyard = Long Feng, Grand Secretariat; Lightning Bolt; Mox Jet
Bot1.Battlefield.Memnite.Power = 1
