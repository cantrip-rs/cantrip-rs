# Taking back mana abilities (cantrip_engine::undo): an Island's {U} pays Crystal Grotto's "{1}, {T}: Add one mana of any
# color", which spends mana from the pool (recorded as mana spent, CR 106.3) and adds {R}. Both are only mana abilities, so
# Bot1 takes back the Grotto (the {U} is back in the pool) and then the Island (the pool is empty), and nothing more is
# offered to take back.

[Bot1 Deck]
Crystal Grotto
Island x6
Lightning Bolt
Island x8

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Crystal Grotto.Play
Bot1.Arrange(Lightning Bolt | )
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Crystal Grotto.Activate(Ability: any color; Color: Red)
Bot1.Choose(Pay mana)
? Bot1.Mana = {R}
Bot1.Undo
? Bot1.Mana = {U}
? Bot1.Battlefield.Crystal Grotto.Tapped = false
Bot1.Undo
? Bot1.Mana =
! Bot1.Undo
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield.Crystal Grotto.Tapped = false
Bot1.Battlefield.Island.Tapped = false
