Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Aquatic Alchemist.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Sapphire#2.Activate
Bot1.Hand.Preordain.Cast
Bot1.Pass
Bot2.Pass
Bot1.Arrange(Island; Island | )
? Bot1.Battlefield.Aquatic Alchemist.Power = 3
