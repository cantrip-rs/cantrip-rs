[T3 Bot1.Main1]
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.The Mycosynth Gardens.Activate(Ability: {1}; Color: Red)
Bot1.Choose(Close mana window)
Bot1.Choose(Pay mana)
? Bot1.Mana = {R}
