# Foraging Wickermaw "becomes that color": the color is the mana's, chosen as the ability resolves, not a color word in its text,
# so a text-changing effect does not touch it (CR 612.2, 612.1). Bot1's Sleight of Mind changes "red" to "green" in the
# Wickermaw's text, which has no color word; Bot1 then adds {R} with it, and it is red.

[Bot1 Deck]
Mox Ruby
Mox Jet
Mox Sapphire
Foraging Wickermaw
Sleight of Mind
Island x15

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Foraging Wickermaw.Cast
Bot1.Arrange(Island | )
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Sleight of Mind.Cast(Bot1.Battlefield.Foraging Wickermaw)
Bot1.Pass
Bot1.Colors(Red)
Bot1.Colors(Green)
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Foraging Wickermaw.Activate(Color: Red)
? Bot1.Mana = {R}

[Expect]
Bot1.Battlefield.Foraging Wickermaw.Colors = Red
