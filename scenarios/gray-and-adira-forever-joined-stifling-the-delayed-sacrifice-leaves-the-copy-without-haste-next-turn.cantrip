Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Emerald.Activate
[T3 Bot1.BeginCombat]
! Bot1.Target
[T5 Bot1.Main1]
Bot1.Hand.Opt.Cast
Bot1.Battlefield.Mox Sapphire.Activate
[T5 Bot1.BeginCombat]
[T5 Bot1.Main2]
? Bot1.Battlefield.Gray and Adira, Forever Joined#2.Token = true
? Bot1.Battlefield.Gray and Adira, Forever Joined#2.Supertypes = (absent)
? Bot1.Battlefield.Gray and Adira, Forever Joined#2.Keywords = Haste
Bot1.Pass
Bot2.Pass
[T5 Bot1.End]
Bot2.Battlefield.Island.Activate
Bot2.Hand.Stifle.Cast(Stack.Gray and Adira, Forever Joined)
[T7 Bot1.Main1]

