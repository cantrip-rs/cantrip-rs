# Word of Command (CR 723.2, 723.7; owner ruling 2026-11-27): while Bot2 plays the chosen Steel Wall it may activate mana
# abilities only of lands it controls, so its Ancient Tomb pays and its Mox Ruby is not offered. The Tomb makes {C}{C} for
# a {1} cost: some of it is spent on the Wall, which is all the ruling asks, and the {C} left over is ordinary mana. Once
# Word of Command has resolved, Bot2, with priority, spends it with the Mox's {R} on Manamorphose ({1}{R/G}). The Tomb's 2
# damage is dealt to Bot2 (723.5a).

[Bot1 Deck]
Black Lotus
Word of Command
Swamp x18

[Bot2 Deck]
Ancient Tomb
Mox Ruby
Steel Wall
Manamorphose
Island x16

[Actions]
[T2 Bot2.Main1]
Bot2.Hand.Ancient Tomb.Play
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Hand.Word of Command.Cast(Bot2)
Bot1.Pass
Bot2.Pass
Bot1.Choose(Steel Wall)
! Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Ancient Tomb.Activate
? Bot2.Mana = {C}
? Stack = Steel Wall
Bot1.Pass
Bot2.Pass
? Bot2.Battlefield.Steel Wall.Tapped = false
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Manamorphose.Cast
Bot2.Pass

[Expect]
Bot2.Life = 18
Bot2.Graveyard = Manamorphose
