# Lotus Ring equips an Ornithopter on turn 3. Bot2's Shatter aimed at the Ring on turn 4 does nothing (the Ring is
# indestructible); a second Shatter aimed at the equipped Ornithopter on turn 6 destroys it (the control: the
# artifact-destroying spell does work on the creature, which has no indestructible of its own), and the Ring is left
# unattached on the battlefield.

[Bot1 Deck]
Island
Mox Emerald
Mox Ruby
Mox Pearl
Ornithopter
Lotus Ring
Island
Island x13

[Bot2 Deck]
Mountain
Mountain
Shatter
Mountain
Shatter
Mountain x11

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Lotus Ring.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Lotus Ring.Activate(Ability: Equip; Ornithopter)
Bot1.Pass
Bot2.Pass
[T4 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Battlefield.Mountain#1.Activate
Bot2.Battlefield.Mountain#2.Activate
Bot2.Hand.Shatter.Cast(Bot1.Battlefield.Lotus Ring)
Bot2.Pass
Bot1.Pass
? Bot1.Battlefield.Lotus Ring.AttachedTo = Ornithopter
? Bot1.Battlefield.Lotus Ring.Keywords = Indestructible
[T6 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Battlefield.Mountain#1.Activate
Bot2.Battlefield.Mountain#2.Activate
Bot2.Hand.Shatter.Cast(Bot1.Battlefield.Ornithopter)
Bot2.Pass
Bot1.Pass

[Expect]
Bot1.Battlefield.Ornithopter = (absent)
Bot1.Battlefield.Lotus Ring.AttachedTo = (absent)
Bot2.Graveyard.Count = 2
