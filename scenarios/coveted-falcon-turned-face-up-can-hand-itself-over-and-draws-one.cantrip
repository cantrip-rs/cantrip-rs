# "Permanents you control" includes the Falcon itself: turned face up, it targets only itself, so Bot2 gains control of the Falcon (it stays face up, CR 613.1b) and Bot1 draws exactly one card
# for the one permanent they gained (hand 2 -> 3).

[Bot1 Deck]
Coveted Falcon
Mox Ruby
Mox Jet
Mox Pearl
Mox Sapphire
Mox Emerald
Island
Island x14

[Bot2 Deck]
Ornithopter
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Coveted Falcon.Cast(Ability: Disguise)
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Emerald.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.#1.Activate(Ability: disguise cost)
Bot1.Target(Bot2)
Bot1.Target(Coveted Falcon)
Bot1.Pass
Bot2.Pass
? Bot1.Hand.Count = 3

[Expect]
Bot2.Battlefield = Ornithopter; Coveted Falcon
Bot1.Battlefield = Mox Ruby; Mox Jet; Mox Pearl; Mox Sapphire; Mox Emerald
Bot1.Hand.Count = 3
