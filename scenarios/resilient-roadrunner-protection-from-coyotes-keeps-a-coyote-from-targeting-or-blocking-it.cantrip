Bot2.Battlefield.Sol Ring.Activate
Bot2.Hand.Driftgloom Coyote.Cast
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Pass
? Exile = Memnite
? Bot2.Battlefield.Driftgloom Coyote.Power = 4
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Resilient Roadrunner > Bot2)
! Bot2.Block(Driftgloom Coyote > Resilient Roadrunner)
Bot2.Block(Ornithopter > Resilient Roadrunner)
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield = Mox Jet; Mox Ruby; Resilient Roadrunner
Bot1.Battlefield.Resilient Roadrunner.Damage = 0
Bot2.Graveyard = Ornithopter; Black Lotus
Bot2.Life = 20
