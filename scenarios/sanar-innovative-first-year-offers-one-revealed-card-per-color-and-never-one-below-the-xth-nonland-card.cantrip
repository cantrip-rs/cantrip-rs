Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Sanar, Innovative First-Year.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main1]
! Bot1.Choose(Lightning Bolt; Burst Lightning)
! Bot1.Choose(Chain Lightning)
! Bot1.Choose(Island)
Bot1.Choose(Burst Lightning)
? Bot1.Shuffles = 1
? Bot1.Library.Count = 5
? Exile = Burst Lightning
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Exile.Burst Lightning.Cast(Bot2)
Bot1.Pass
