# Rite of the Dragoncaller: "Whenever you cast an instant or sorcery spell, create a 5/5 red Dragon creature token with flying." Bot1 casts
# the Rite itself (an enchantment: no Dragon), then a Lightning Bolt: the trigger goes on the stack above the Bolt, and the 5/5 red flying
# Dragon exists before the Bolt resolves. A Mox Ruby is no instant or sorcery. On turn 2 Bot2's own Lightning Bolt makes no Dragon for Bot1.

[Bot1 Deck]
Black Lotus
Mox Ruby x4
Rite of the Dragoncaller
Lightning Bolt
Mountain x12

[Bot2 Deck]
Lightning Bolt
Mountain x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Dragon Token = (absent)
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Battlefield.Mox Ruby#1.Activate
Bot1.Battlefield.Mox Ruby#2.Activate
Bot1.Battlefield.Mox Ruby#3.Activate
Bot1.Hand.Rite of the Dragoncaller.Cast
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Dragon Token = (absent)
Bot1.Battlefield.Mox Ruby#4.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
? Stack.Count = 2
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Dragon Token.Power = 5
? Bot2.Life = 20
Bot1.Pass
Bot2.Pass
? Bot2.Life = 17
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1)
Bot2.Pass
Bot1.Pass
? Bot1.Life = 17
[T2 Bot2.Main2]

[Expect]
Bot1.Battlefield = Dragon Token; Mox Ruby; Mox Ruby; Mox Ruby; Mox Ruby; Rite of the Dragoncaller
Bot1.Battlefield.Dragon Token.Power = 5
Bot1.Battlefield.Dragon Token.Toughness = 5
Bot1.Battlefield.Dragon Token.Colors = Red
Bot1.Battlefield.Dragon Token.Keywords = Flying
Bot2.Battlefield.Dragon Token = (absent)
