# Foot Headquarters enters tapped, so it cannot produce mana then. After Bot1's next untap, it taps for exactly one white mana;
# its enters trigger gains 1 life (CR 614.1d, 605.1a, 605.3b, 118.3, 106.4, 119.3, 603.6a).

[Bot1 Deck]
Foot Headquarters
Plains x20

[Bot2 Deck]
Plains x20

[Actions]
Bot1.Hand.Foot Headquarters.Play
? Bot1.Battlefield.Foot Headquarters.Tapped = true
Bot1.Pass
Bot2.Pass
? Bot1.Life = 21
! Bot1.Battlefield.Foot Headquarters.Activate(Color: White)
[T3 Bot1.Main1]
Bot1.Battlefield.Foot Headquarters.Activate(Color: White)
? Bot1.Mana = {W}
? Bot1.Battlefield.Foot Headquarters.Tapped = true

[Expect]
Bot1.Life = 21
Bot1.Mana = {W}
Bot1.Battlefield.Foot Headquarters.Tapped = true
Stack.Count = 0
