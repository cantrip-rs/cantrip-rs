# Eaten Alive (CR 601.2f, 118.8): with no creature to sacrifice, the additional cost is {3}{B}, so the whole is {B} plus {3}{B}:
# two black mana among five. Bot1 has five mana but only one black (Black Lotus for red, Mox Jet, Mox Ruby), so the spell is
# refused at Bot2's Ornithopter for want of the second {B}, and the Ornithopter stays.

[Bot1 Deck]
Black Lotus
Mox Jet
Mox Ruby
Eaten Alive
Island x20

[Bot2 Deck]
Island
Island
Island
Island
Island
Island
Ornithopter
Island x10

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
! Bot1.Hand.Eaten Alive.Cast(Bot2.Battlefield.Ornithopter; Mana: short)

[Expect]
Bot1.Hand.Count = 5
Bot2.Battlefield = Ornithopter
