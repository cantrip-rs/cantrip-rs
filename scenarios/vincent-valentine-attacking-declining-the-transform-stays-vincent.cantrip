# Vincent Valentine (CR 608.2d): the transform is a "may". Bot1 declines on turn 3, so Vincent Valentine stays a 2/2 with no lifelink: Bot2 takes
# 2 and Bot1 gains nothing.

[Bot1 Deck]
Black Lotus
Mox Jet
Vincent Valentine
Swamp x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Vincent Valentine.Cast
Bot1.Pass
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Vincent Valentine > Bot2)
Bot1.Pass
Bot1.Decline
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 18
Bot1.Life = 20
Bot1.Battlefield.Vincent Valentine.Power = 2
