# Tunnel Tipster: "this turn" (CR 603.4). On Bot2's turn 2 Bot1 manifests dread at instant speed - Turn Inside Out on its own
# Llanowar Elves, then Lightning Bolt on them (Mox Ruby and Mountain pay) - so a face-down creature enters under Bot1's control, but
# not on Bot1's own turn: the Tipster does nothing at Bot2's end step (it is not "your end step"), and nothing at Bot1's end step of
# turn 3 either (the creature entered on an earlier turn).

[Bot1 Deck]
Black Lotus
Mox Ruby
Mountain
Llanowar Elves
Tunnel Tipster
Turn Inside Out
Lightning Bolt
Snapcaster Mage
Island
Island x10

[Bot2 Deck]
Swamp x14

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Hand.Llanowar Elves.Cast
Bot1.Hand.Tunnel Tipster.Cast
[T2 Bot2.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Turn Inside Out.Cast(Bot1.Battlefield.Llanowar Elves)
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Llanowar Elves)
Bot1.Pass
Bot2.Pass
Bot1.Arrange(Snapcaster Mage | Island)
? Bot1.Battlefield..FaceDown = true
[T2 Bot2.End]
? Stack.Count = 0
[T3 Bot1.End]
? Stack.Count = 0
[Expect]
Turn = 3
Stack.Count = 0
Bot1.Battlefield.Tunnel Tipster.Power = 1
Bot1.Battlefield.Tunnel Tipster.Counters.PlusOnePlusOne = (absent)
Bot1.Battlefield..FaceDownName = Snapcaster Mage
