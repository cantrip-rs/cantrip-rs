? Bot1.Battlefield.Zul Ashur, Lich Lord.Subtypes = Nightmare; Warlock; Zombie
! Bot1.Battlefield.Abyssal Harvester.Activate(Bot1.Graveyard.Lightning Bolt)

[Expect]
Bot1.Graveyard = Lightning Bolt
Bot1.Battlefield = Swamp; Mox Jet; Mox Pearl; Mox Ruby; Abyssal Harvester; Zul Ashur, Lich Lord
