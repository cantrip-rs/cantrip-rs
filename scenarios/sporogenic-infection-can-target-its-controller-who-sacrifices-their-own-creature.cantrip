# The enters trigger targets any player (2024-09-20 ruling), the Aura's controller included: Bot1 targets itself with Bot2's Memnite
# enchanted. Bot1's own Memnite is a creature other than the enchanted one, so it is sacrificed; Bot2's creatures are untouched.

[Bot1 Deck]
Mox Jet
Mox Ruby
Sporogenic Infection
Memnite
Swamp x20

[Bot2 Deck]
Memnite
Ornithopter
Island x20

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Hand.Memnite.Cast
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Sporogenic Infection.Cast(Bot2.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
Bot1.Target(Bot1)
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield = Mox Jet; Mox Ruby; Sporogenic Infection
Bot1.Graveyard = Memnite
Bot2.Battlefield = Memnite; Ornithopter
Stack.Count = 0
