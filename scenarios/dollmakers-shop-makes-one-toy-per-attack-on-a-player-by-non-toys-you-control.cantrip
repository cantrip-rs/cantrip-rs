Bot2.Attack(Memnite > Bot1)
[T4 Bot2.Main2]
? Bot1.Battlefield.Count = 6
[T5 Bot1.Main1]
Bot1.Attack(Toy Token > Bot2)
[T5 Bot1.Main2]

[Expect]
Bot1.Battlefield.Count = 6
Bot1.Battlefield.Toy Token.Power = 1
Bot1.Battlefield.Toy Token.Toughness = 1
Bot1.Battlefield.Toy Token.Colors = White
Bot1.Battlefield.Toy Token.Types = Artifact; Creature
Bot1.Battlefield.Toy Token.Subtypes = Toy
Bot2.Life = 18
