# cryotheory adept freezes from graveyard (CR 608.2).

[Bot1 Deck]
Black Lotus
Black Lotus
Cryotheory Adept
Mox Ruby
Lightning Bolt
Ornithopter
Island x30

[Bot2 Deck]
Island x30

[Actions]
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus#1.Activate(Color: Blue)
Bot1.Battlefield.Black Lotus#1.Activate(Color: Blue)
Bot1.Hand.Cryotheory Adept.Cast
Bot1.Choose(Close mana window)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Cryotheory Adept)
Bot1.Graveyard.Cryotheory Adept.Activate(Bot1.Battlefield.Ornithopter)

[T3 Bot1.Main1]
? Bot1.Battlefield.Ornithopter.Tapped = true
? Bot1.Battlefield.Ornithopter.Counters.Stun = (absent)
[T5 Bot1.Main1]

[Expect]
Bot1.Battlefield.Ornithopter.Tapped = false
Bot1.Battlefield.Ornithopter.Counters.Stun = (absent)
Exile = Cryotheory Adept
