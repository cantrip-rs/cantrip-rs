# Goblin Glasswright enters prepared (CR 722.3a); the copy of Craft with Pride makes an untapped Treasure token (CR 111.10a) and casting
# it unprepares the Glasswright (CR 722.3c). It is a sorcery, so it is refused on Bot2's turn.

[Bot1 Deck]
Mox Ruby
Mox Jet
Goblin Glasswright
Mountain
Mountain x15

[Bot2 Deck]
Mountain x15

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Goblin Glasswright.Cast
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Goblin Glasswright.Prepared = true
[T2 Bot2.Main1]
Bot2.Pass
? Bot1.Battlefield.Mountain.Tapped = false
! Bot1.Exile.Craft with Pride.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mountain.Activate
Bot1.Exile.Craft with Pride.Cast
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield.Treasure Token.Token = true
Bot1.Battlefield.Treasure Token.Tapped = false
Bot1.Battlefield.Goblin Glasswright.Prepared = (absent)
Bot1.Graveyard.Count = 0
Exile.Count = 0
