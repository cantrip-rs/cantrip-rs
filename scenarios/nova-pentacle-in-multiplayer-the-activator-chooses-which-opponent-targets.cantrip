Bot1.ChoosePlayer(Bot3)
Bot3.Target(Bot1.Battlefield.Sanctuary Cat)
Bot1.Pass
Bot2.Pass
Bot3.Pass
Bot1.Choose(Stack.Lightning Bolt)
[T4 Bot1.Main2]

[Expect]
Bot1.Life = 20
Bot1.Battlefield.Sanctuary Cat = (absent)
Bot2.Graveyard = Lightning Bolt
