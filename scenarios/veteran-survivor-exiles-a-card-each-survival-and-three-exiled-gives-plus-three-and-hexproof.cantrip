[T5 Bot1.End]
? Exile.Count = 2
? Bot1.Battlefield.Veteran Survivor.Power = 2
? Bot1.Battlefield.Veteran Survivor.Keywords = (absent)
[T7 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Faithless Looting.Cast
Bot1.Pass
