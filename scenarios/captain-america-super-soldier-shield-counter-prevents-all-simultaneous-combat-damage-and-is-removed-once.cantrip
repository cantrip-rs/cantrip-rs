[T3 Bot1.Main1]
Bot1.Attack(Captain America, Super-Soldier > Bot2)
Bot2.Block(Dune Beetle#1 > Captain America, Super-Soldier; Dune Beetle#2 > Captain America, Super-Soldier)
[T3 Bot1.Main2]
? Bot1.Battlefield.Captain America, Super-Soldier.Counters.Shield = (absent)
? Bot1.Battlefield.Captain America, Super-Soldier.Damage = 0

[Expect]
Bot1.Battlefield.Captain America, Super-Soldier.Counters.Shield = (absent)
Bot1.Battlefield.Captain America, Super-Soldier.Damage = 0
Bot2.Battlefield.Dune Beetle#1.Damage = 3
