# Mardu Siegebreaker's enters ability targets Bot1's Ornithopter; in response Bot1 bounces the Siegebreaker with Unsummon. It has
# left the battlefield before the ability resolves, so the Ornithopter is not exiled at all (CR 610.3b, the ruling).

[Bot1 Deck]
Mox Jet
Mox Ruby
Mox Pearl
Mox Emerald
Mox Sapphire
Ornithopter
Mardu Siegebreaker
Unsummon
Island x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Mardu Siegebreaker.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Pass
Bot2.Pass
Bot1.Target(Ornithopter)
Bot1.Hand.Unsummon.Cast(Bot1.Battlefield.Mardu Siegebreaker)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield.Ornithopter.Tapped = false
Bot1.Hand.Mardu Siegebreaker.Power = 4
Exile.Count = 0
