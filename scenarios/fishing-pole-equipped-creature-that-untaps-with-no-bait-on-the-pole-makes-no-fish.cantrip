# "Remove a bait counter from this Equipment. If you do, create a Fish" (CR 608.2c, 122.1): the Fish only if a counter came off.
# Bot1's Memnite wears the Pole but the Pole never baited anything. The Memnite attacks on turn 3 (tapped) and untaps on
# turn 5: the trigger resolves with no counter to remove, so there is no Fish (and no counter appears).

[Bot1 Deck]
Memnite
Mox Jet
Mox Pearl
Mox Ruby
Fishing Pole
Plains x15

[Bot2 Deck]
Plains x20

[Actions]
Bot1.Hand.Memnite.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Fishing Pole.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Fishing Pole.Activate(Ability: Equip; Memnite)
Bot1.Pass
Bot2.Pass
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Memnite > Bot2)
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]
? Bot1.Battlefield.Memnite.Tapped = true
[T5 Bot1.Main1]

[Expect]
Bot2.Life = 19
Bot1.Battlefield.Memnite.Tapped = false
Bot1.Battlefield.Fishing Pole.Counters.Bait = (absent)
Bot1.Battlefield.Fish Token = (absent)
