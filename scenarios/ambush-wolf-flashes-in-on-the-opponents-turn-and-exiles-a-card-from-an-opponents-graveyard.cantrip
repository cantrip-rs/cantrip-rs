Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Black Lotus.Cast
Bot2.Pass
Bot1.Pass
Bot2.Battlefield.Black Lotus.Activate(Color: Blue)
[T2 Bot2.End]
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Ambush Wolf.Cast
Bot1.Pass
Bot2.Pass
Bot1.Target(Bot2.Graveyard.Black Lotus)

