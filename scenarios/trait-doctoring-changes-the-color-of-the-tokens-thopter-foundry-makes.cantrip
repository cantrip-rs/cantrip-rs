# Trait Doctoring replaces the color word blue with red in Thopter Foundry's text until end of turn, so the token it
# makes that turn is a red Thopter (CR 612.4); its mana cost has no words and its colors stay. On the next turn the text
# is as printed again and the Thopter it makes is blue.

[Bot1 Deck]
Island
Mox Jet
Mox Sapphire
Thopter Foundry
Mox Pearl
Trait Doctoring
Mox Ruby
Island
Island x12

[Bot2 Deck]
Island x16

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Thopter Foundry.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Island.Activate
Bot1.Hand.Trait Doctoring.Cast(Thopter Foundry)
Bot1.Pass
Bot2.Pass
Bot1.Modes(Replace a color word)
Bot1.Colors(Blue)
Bot1.Colors(Red)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Thopter Foundry.Activate(Sacrifice: Mox Pearl)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Thopter Token.Colors = Red
? Bot1.Battlefield.Thopter Foundry.Colors = Black; Blue; White
[T5 Bot1.Main1]
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Thopter Foundry.Activate(Sacrifice: Mox Ruby)
Bot1.Pass
Bot2.Pass

[Expect]
Turn = 5
Bot1.Battlefield.Thopter Token#1.Colors = Red
Bot1.Battlefield.Thopter Token#2.Colors = Blue
