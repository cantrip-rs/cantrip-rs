# Finale of Revelation exiles itself only as it resolves (its last instruction): Bot2 counters it with Counterspell, so it is
# put into its owner's graveyard (CR 701.6a) with nothing drawn, whatever X was (2 here, paid with the Black Lotus and an
# Island).

[Bot1 Deck]
Black Lotus
Finale of Revelation
Island x18

[Bot2 Deck]
Island
Mox Sapphire
Counterspell
Island x17

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Black Lotus.Cast
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Mox Sapphire.Cast
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Hand.Finale of Revelation.Cast(X: 2)
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Island#1.Activate
Bot2.Battlefield.Island.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.Counterspell.Cast(Finale of Revelation)
Bot1.Pass

[Expect]
Stack.Count = 0
Exile.Count = 0
Bot1.Graveyard = Finale of Revelation; Black Lotus
Bot2.Graveyard = Counterspell
Bot1.Hand.Count = 4
