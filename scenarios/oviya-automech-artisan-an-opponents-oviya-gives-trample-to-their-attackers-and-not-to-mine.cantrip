# Oviya, Automech Artisan: "your opponents" is relative to the controller (CR 109.5, 508.5). Bot2 controls it: Bot2's Memnite
# attacking Bot1 has trample, while Bot1's Memnite attacking Bot2 (Oviya's controller) has none.

[Bot1 Deck]
Memnite
Island x19

[Bot2 Deck]
Black Lotus
Mox Emerald
Mox Ruby
Oviya, Automech Artisan
Memnite
Swamp x15

[Actions]
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Black Lotus.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Black Lotus.Activate(Color: Green)
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Oviya, Automech Artisan.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Attack(Memnite > Bot2)
? Bot1.Battlefield.Memnite.Keywords = (absent)
[T4 Bot2.Main1]
Bot2.Attack(Memnite > Bot1)
? Bot2.Battlefield.Memnite.Keywords = Trample
[T4 Bot2.Main2]

[Expect]
Bot2.Life = 19
Bot1.Life = 19
