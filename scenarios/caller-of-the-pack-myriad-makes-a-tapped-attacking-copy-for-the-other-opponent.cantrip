# Myriad (CR 702.116a): Caller of the Pack (8/6) attacks Bot2 in a three-player game. For Bot3, the other opponent, Bot1 may create a token copy
# tapped and attacking: it does, so Bot3 takes the copy's power as Bot2 takes the original's, and the token is exiled at end of
# combat. The card's other keywords (Trample) are on it. Black Lotus and the Moxen pay for it with exactly its cost.

[Bot1 Deck]
Black Lotus
Mox Emerald
Mox Pearl
Mox Jet
Mox Ruby
Caller of the Pack
Island x16

[Bot2 Deck]
Island x20

[Bot3 Deck]
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot2.Pass
Bot3.Pass
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot2.Pass
Bot3.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot2.Pass
Bot3.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot2.Pass
Bot3.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot3.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Caller of the Pack.Cast
Bot1.Pass
Bot2.Pass
Bot3.Pass
? Bot1.Mana =
[T4 Bot1.DeclareAttackers]
Bot1.Attack(Caller of the Pack > Bot2)
Bot1.Target(Bot3)
Bot1.Pass
Bot2.Pass
Bot3.Pass
? Combat.Attackers = Caller of the Pack > Bot2; Caller of the Pack > Bot3
? Bot1.Battlefield.Caller of the Pack#2.Tapped = true
? Bot1.Battlefield.Caller of the Pack#2.Token = true
[T4 Bot1.Main2]
? Bot2.Life = 12
? Bot3.Life = 12
? Delayed.Count = 0

[Expect]
Bot1.Battlefield.Caller of the Pack.Keywords = Trample
Bot1.Battlefield.Caller of the Pack#2 = (absent)
Exile.Count = 0
