Bot1.Hand.Webstrike Elite.Activate(Ability: Cycling; X: 1)
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Target(Bot1.Battlefield.Sol Ring)
Bot1.Pass
