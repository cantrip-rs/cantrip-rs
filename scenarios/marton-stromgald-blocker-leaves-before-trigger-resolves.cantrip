[T4 Bot2.DeclareAttackers]
Bot2.Attack(Grizzly Bears#1 > Bot1; Grizzly Bears#2 > Bot1)
Bot1.Block(Márton Stromgald > Grizzly Bears#1; Ornithopter#1 > Grizzly Bears#2; Ornithopter#2 > Grizzly Bears#2)
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Ornithopter#1)
Bot2.Pass
Bot1.Pass
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Ornithopter#1.Power = 1
? Bot1.Battlefield.Ornithopter#1.Toughness = 3
? Bot1.Battlefield.Márton Stromgald.Power = 1
