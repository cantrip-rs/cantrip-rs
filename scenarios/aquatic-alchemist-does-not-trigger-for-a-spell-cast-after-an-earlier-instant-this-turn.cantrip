# Aquatic Alchemist: "first instant or sorcery spell each turn" counts spells cast before the Alchemist was on the battlefield.
# Turn 1: Bot1 casts Lightning Bolt first, then the Alchemist, then Shock. Shock is the second instant or sorcery this turn,
# so the Alchemist stays a 1/3.

[Bot1 Deck]
Mox Sapphire
Mox Jet
Mox Ruby
Mox Ruby
Aquatic Alchemist
Lightning Bolt
Shock
Island x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Aquatic Alchemist.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Ruby#2.Activate
Bot1.Hand.Shock.Cast(Bot2)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Aquatic Alchemist.Power = 1

[Expect]
Bot2.Life = 15
Bot1.Battlefield.Aquatic Alchemist.Power = 1
Bot1.Battlefield.Aquatic Alchemist.Toughness = 3
