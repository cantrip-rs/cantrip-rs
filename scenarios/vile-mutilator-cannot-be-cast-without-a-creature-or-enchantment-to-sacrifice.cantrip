Bot1.Hand.Vile Mutilator.Cast
Bot1.Choose(Memnite)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield = Mox Emerald; Mox Pearl; Mox Ruby; Swamp; Vile Mutilator
Bot1.Graveyard = Memnite; Black Lotus
