Bot1.Attack(Dyadrine, Synthesis Amalgam > Bot2)
Bot1.Accept
! Bot1.RemoveCounters(Boommobile: 1; Dyadrine, Synthesis Amalgam: 1)
! Bot1.RemoveCounters(Bot2.Battlefield.Walking Ballista: 1; Dyadrine, Synthesis Amalgam: 1)
! Bot1.RemoveCounters(Dyadrine, Synthesis Amalgam: 2)
Bot1.RemoveCounters(Dyadrine, Synthesis Amalgam: 1; Bot1.Battlefield.Walking Ballista: 1)
Bot1.Pass
