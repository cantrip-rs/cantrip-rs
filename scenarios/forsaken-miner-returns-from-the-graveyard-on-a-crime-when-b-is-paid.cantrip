Bot1.Battlefield = Forsaken Miner; Mox Ruby; Swamp; Swamp
Bot1.Graveyard = Lightning Bolt
Bot2.Life = 17
Bot1.Battlefield.Swamp#1.Tapped = true
Bot1.Battlefield.Swamp#2.Tapped = false
