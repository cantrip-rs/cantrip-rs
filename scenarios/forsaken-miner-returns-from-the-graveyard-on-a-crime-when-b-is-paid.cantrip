? Bot1.Graveyard = Forsaken Miner
Bot1.Battlefield.Swamp.Activate
Bot1.Pass
Bot2.Pass
Bot1.PayCost
? Stack = Lightning Bolt
? Bot1.Graveyard.Count = 0
? Bot1.Battlefield.Forsaken Miner.Tapped = false
[T3 Bot1.Main2]

