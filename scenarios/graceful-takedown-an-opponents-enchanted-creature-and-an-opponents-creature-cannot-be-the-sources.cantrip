# Graceful Takedown: both groups of sources are creatures "you control". Bot1 enchants Bot2's Wall of Mist with its Escape Velocity; the
# Wall is an enchanted creature but not one Bot1 controls, so it is refused as a source, and Bot2's Memnite is refused as the other
# creature. Bot1's own Memnite (power 1) is accepted as the other creature and deals 1 to Bot2's Memnite, a 1/1, which dies (CR 704.5g).

[Bot1 Deck]
Mox Ruby
Mox Emerald
Mox Jet
Memnite
Escape Velocity
Graceful Takedown
Island x2
Island x12

[Bot2 Deck]
Mox Sapphire
Mox Jet
Wall of Mist
Memnite
Island x3
Island x12

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Jet.Cast
Bot2.Hand.Memnite.Cast
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Wall of Mist.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Escape Velocity.Cast(Bot2.Battlefield.Wall of Mist)
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Graceful Takedown.Cast
! Bot1.Target(Bot2.Battlefield.Wall of Mist)
! Bot1.Target(Bot2.Battlefield.Memnite)
Bot1.Target(Bot1.Battlefield.Memnite)
Bot1.Target(Bot2.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass

[Expect]
Stack.Count = 0
Bot2.Graveyard = Memnite
Bot2.Battlefield.Wall of Mist.Damage = 0
Bot1.Battlefield.Memnite.Damage = 0
Bot1.Graveyard = Graceful Takedown
