# "Whenever this creature enters or attacks, you may sacrifice an artifact. If you do, draw a card." (CR 701.21a, 508.1m).
# On turn 3 Bot1 declines the sacrifice as it enters (nothing is sacrificed, nothing drawn). On turn 5 it attacks and the second
# half of the trigger fires: it sacrifices Mox Pearl and draws a card; the attack still deals 4.

[Bot1 Deck]
Mox Sapphire
Mox Jet
Mox Pearl
Black Lotus
Benthic Criminologists
Island x2
Forest
Island x2
Plains
Island x11

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Benthic Criminologists.Cast
Bot1.Pass
Bot1.Pass
Bot1.Choose()
? Stack.Count = 0
? Bot1.Battlefield.Mox Pearl.Tapped = false
? Bot1.Hand.Count = 3
? Bot1.Graveyard.Count = 1
[T5 Bot1.Main1]
Bot1.Attack(Benthic Criminologists > Bot2)
Bot1.Pass
! Bot1.Choose(Benthic Criminologists)
Bot1.Choose(Mox Pearl)
[T5 Bot1.Main2]

[Expect]
Bot2.Life = 16
Bot1.Hand.Count = 5
Bot1.Graveyard.Count = 2
Bot1.Battlefield.Mox Pearl = (absent)
Stack.Count = 0
