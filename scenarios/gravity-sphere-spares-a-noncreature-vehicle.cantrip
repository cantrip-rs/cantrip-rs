# "All creatures lose flying": an uncrewed Smuggler's Copter is no creature and keeps flying; crewed, it is a creature and
# loses it (CR 301.7b, 613.1f).

[Bot1 Deck]
Black Lotus
Gravity Sphere
Smuggler's Copter
Mox Ruby
Mox Pearl
Grizzly Bears
Forest x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Gravity Sphere.Cast
Bot1.Hand.Forest.Play
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Smuggler's Copter.Cast
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Smuggler's Copter.Keywords = Flying
[T3 Bot1.Main1]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest#1.Activate
Bot1.Battlefield.Forest#2.Activate
Bot1.Hand.Grizzly Bears.Cast
[T5 Bot1.Main1]
Bot1.Battlefield.Smuggler's Copter.Activate(Ability: Crew)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Smuggler's Copter.Keywords = (absent)

[Expect]
Bot1.Battlefield.Smuggler's Copter.Keywords = (absent)
