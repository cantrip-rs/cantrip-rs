# Cautious Survivor, Survival: the intervening "if this creature is tapped" (CR 603.4) is false when it stays home on turn 3, so nothing
# triggers at Bot1's second main phase and no life is gained (the ruling: an untapped creature's survival ability doesn't trigger at all).

[Bot1 Deck]
Mox Emerald
Mox Jet
Mox Pearl
Mox Ruby
Cautious Survivor
Island x20

[Bot2 Deck]
Swamp x14

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Cautious Survivor.Cast
Bot2.Pass
[T3 Bot1.Main2]
? Bot1.Battlefield.Cautious Survivor.Tapped = false
? Stack.Count = 0
[T3 Bot1.End]

[Expect]
Bot1.Life = 20
Bot2.Life = 20
Stack.Count = 0
