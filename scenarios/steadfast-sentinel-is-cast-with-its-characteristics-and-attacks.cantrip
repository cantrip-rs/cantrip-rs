# Steadfast Sentinel, a french vanilla creature: cast with Black Lotus mana, its characteristics as printed (power, toughness,
# keywords, colors, types, protection), then attacking Bot2, who has no creatures.
# Vigilance (CR 702.20b): attacking doesn't tap it.

[Bot1 Deck]
Black Lotus x2
Steadfast Sentinel
Plains x21

[Bot2 Deck]
Island x24

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus#2.Activate(Color: White)
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Hand.Steadfast Sentinel.Cast
Bot1.Pass
[T2 Bot2.End]
? Bot1.Battlefield.Steadfast Sentinel.Power = 2
? Bot1.Battlefield.Steadfast Sentinel.Toughness = 3
? Bot1.Battlefield.Steadfast Sentinel.Keywords = Vigilance
? Bot1.Battlefield.Steadfast Sentinel.Colors = White
? Bot1.Battlefield.Steadfast Sentinel.Types = Creature
? Bot1.Battlefield.Steadfast Sentinel.Subtypes = Cleric; Human
? Bot1.Battlefield.Steadfast Sentinel.Supertypes = (absent)
? Bot1.Battlefield.Steadfast Sentinel.ProtectionFrom = (absent)
[T3 Bot1.Main1]
Bot1.Attack(Steadfast Sentinel > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 18
Bot1.Battlefield.Steadfast Sentinel.Tapped = false
