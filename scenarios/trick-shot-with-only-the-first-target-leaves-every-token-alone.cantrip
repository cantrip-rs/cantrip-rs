# Trick Shot (CR 601.2c "up to one"): the second target may be skipped. Bot2's Ornithopter takes 6 and dies; Bot1's Goblin tokens are untouched.

[Bot1 Deck]
Mox Ruby
Mox Jet
Mox Pearl
Mox Sapphire
Mox Emerald
Dragon Fodder
Trick Shot
Island x13

[Bot2 Deck]
Memnite
Ornithopter
Island x18

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Dragon Fodder.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Trick Shot.Cast
Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Target()
Bot1.Pass
Bot2.Pass
? Bot2.Graveyard = Ornithopter

[Expect]
Bot2.Battlefield.Memnite.Damage = 0
Bot1.Battlefield.Goblin Token#1.Damage = 0
Bot1.Battlefield.Goblin Token#2.Damage = 0
Bot1.Battlefield.Count = 7
