# Stalactite Stalker: with no permanent card put into Bot1's graveyard this turn there is no counter at the end step. Bot1's
# Lightning Bolt is an instant, so it is a card in the graveyard but not a descent (CR 700.11), and Bot2's Ornithopter dying in Bot2's
# graveyard is not Bot1's either. The Stalker stays a 1/1.

[Bot1 Deck]
Mox Jet
Mox Ruby
Stalactite Stalker
Lightning Bolt
Swamp x20

[Bot2 Deck]
Ornithopter x20

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Stalactite Stalker.Cast
Bot1.Hand.Lightning Bolt.Cast(Bot2)
[T2 Bot2.Main1]
? Bot1.Graveyard.Count = 1
? Bot1.Battlefield.Stalactite Stalker.Power = 1

[Expect]
Bot1.Battlefield.Stalactite Stalker.Counters.PlusOnePlusOne = (absent)
Bot2.Life = 17
