# Meathook Massacre II cast for X = 0 ({B}{B}{B}{B}: a Black Lotus and a Mox Jet): "each player sacrifices X creatures" is
# nothing, and both Memnites stay (CR 107.3a, 701.21a). The deaths that follow still trigger it. A Lightning Bolt kills Bot1's own
# Memnite: Bot1 pays 3 life (17) and it returns under its control with a finality counter. A second Bolt kills Bot2's Memnite: Bot2
# is asked, declines to pay (20), and Bot1 gets that Memnite with a finality counter too: two Memnites on Bot1's side, none left
# for Bot2, and nothing but the Bolts and the Lotuses in a graveyard.

[Bot1 Deck]
Black Lotus
Black Lotus
Mox Jet
Mox Ruby
Memnite
Meathook Massacre II
Lightning Bolt
Lightning Bolt
Swamp x20

[Bot2 Deck]
Memnite
Island x25

[Actions]
Bot1.Hand.Memnite.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Meathook Massacre II.Cast(X: 0)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Memnite.Power = 1
? Bot2.Battlefield.Memnite.Power = 1
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Accept
? Bot1.Life = 17
? Bot1.Battlefield.Memnite.Counters.Finality = 1
Bot1.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot2.Decline

[Expect]
Bot1.Life = 17
Bot2.Life = 20
Bot1.Battlefield = Meathook Massacre II; Memnite; Memnite; Mox Jet; Mox Ruby
Bot1.Graveyard = Lightning Bolt; Lightning Bolt; Black Lotus; Black Lotus
Bot2.Battlefield.Count = 0
Bot2.Graveyard.Count = 0
