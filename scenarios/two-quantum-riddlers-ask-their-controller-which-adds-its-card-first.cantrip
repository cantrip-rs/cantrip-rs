Stack.Count = 0
Bot1.Hand = Mountain; Forest; Swamp; Plains
Bot1.Battlefield = Island; Mox Sapphire; Quantum Riddler; Quantum Riddler
Bot1.Graveyard = Three Steps Ahead; Black Lotus; Black Lotus; Black Lotus
