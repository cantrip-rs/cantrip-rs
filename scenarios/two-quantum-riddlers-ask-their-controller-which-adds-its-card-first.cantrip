Bot1.Pass
Bot2.Pass
? Stack.Count = 2
? Bot1.Hand.Count = 0
Bot1.Pass
Bot2.Pass
Bot1.Replace(Quantum Riddler)
? Bot1.Hand = Mountain; Forest; Swamp
? Stack.Count = 1

[Expect]
