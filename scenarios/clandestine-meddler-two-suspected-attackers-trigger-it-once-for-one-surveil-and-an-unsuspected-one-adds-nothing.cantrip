? Bot1.Battlefield.Memnite.Suspected = true
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Memnite > Bot2; Clandestine Meddler#1 > Bot2; Clandestine Meddler#2 > Bot2)
Bot1.Pass
Bot2.Pass
Bot1.Arrange( | Island)
[T3 Bot1.Main2]

[Expect]
Bot1.Graveyard = Island; Black Lotus
Bot2.Life = 13
