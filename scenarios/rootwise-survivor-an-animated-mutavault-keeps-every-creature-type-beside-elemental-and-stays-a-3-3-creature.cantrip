? Bot1.Battlefield.Mutavault.Subtypes = (every creature type)
? Bot1.Battlefield.Mutavault.Power = 3
[T4 Bot2.Main1]

[Expect]
Bot1.Battlefield.Mutavault.Types = Land; Creature
Bot1.Battlefield.Mutavault.Subtypes = Elemental
Bot1.Battlefield.Mutavault.Power = 3
Bot1.Battlefield.Mutavault.Toughness = 3
