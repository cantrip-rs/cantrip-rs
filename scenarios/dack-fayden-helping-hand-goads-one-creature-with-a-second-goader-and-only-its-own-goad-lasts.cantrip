[T4 Bot2.Upkeep]
Bot2.Modes(Lost Well)
[T6 Bot2.Upkeep]
Bot2.Modes(Arena)
Bot2.Target(Bot2.Battlefield.Llanowar Elves)
[T6 Bot2.Main1]
? Bot2.Battlefield.Llanowar Elves.GoadedBy = Bot1; Bot2
[T8 Bot2.Main1]
? Bot2.Battlefield.Llanowar Elves.GoadedBy = Bot1

[Expect]
Turn = 8
Bot2.Battlefield.Llanowar Elves.GoadedBy = Bot1
Bot2.Battlefield = Caves of Chaos Adventurer; Llanowar Elves; Mountain; Mox Jet; Mox Ruby; Mox Sapphire
