# Choreographed Sparks, mode 2 only (CR 707.10, 707.10f, 707.9a): Bot1 casts Memnite, and Sparks copies the creature spell. The
# copy resolves as a token with haste (it attacks the turn it arrives; the Memnite card, summoning sick, cannot) and "At the
# beginning of the end step, sacrifice this token." At the end step only the token is gone.

[Bot1 Deck]
Black Lotus
Mox Ruby
Memnite
Choreographed Sparks
Island x14

[Bot2 Deck]
Island x12

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Memnite.Cast
Bot1.Hand.Choreographed Sparks.Cast
Bot1.Modes(2)
Bot1.Target(Stack.Memnite)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield = Memnite; Memnite; Mox Ruby
? Bot1.Battlefield.Memnite#1.Keywords = Haste
! Bot1.Attack(Memnite#2 > Bot2)
Bot1.Attack(Memnite#1 > Bot2)
[T1 Bot1.Main2]
? Bot2.Life = 19
[T1 Bot1.End]
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield = Memnite; Mox Ruby
