# Without red mana, the Flotilla's combat ability gives each blocker first strike until end of turn (CR 603.2, 611.2a).
[Bot1 Deck]
Goblin Flotilla
Black Lotus
Ornithopter
Mountain x20
[Bot2 Deck]
Ornithopter x3
Plains x20
[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Goblin Flotilla.Cast
? Bot1.Mana =
Bot1.Hand.Ornithopter.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Hand.Ornithopter.Cast
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.BeginCombat]
Bot1.Pass
Bot2.Pass
! Bot1.PayCost
Bot1.Decline
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Goblin Flotilla > Bot2; Ornithopter > Bot2)
Bot2.Block(Ornithopter#1 > Goblin Flotilla; Ornithopter#2 > Goblin Flotilla; Ornithopter#3 > Bot1.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
? Bot2.Battlefield.Ornithopter#1.Keywords = FirstStrike; Flying
? Bot2.Battlefield.Ornithopter#2.Keywords = FirstStrike; Flying
? Bot2.Battlefield.Ornithopter#3.Keywords = Flying
[T4 Bot2.Main1]
[Expect]
Bot2.Battlefield.Ornithopter#1.Keywords = Flying
