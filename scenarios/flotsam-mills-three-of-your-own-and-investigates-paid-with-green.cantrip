# Flotsam {1}{G/U} (CR 107.4e): "Mill three cards. Investigate." The hybrid symbol is paid with green or blue, not with red or white:
# Mox Ruby and Mox Pearl pay only the generic part, so the cast is refused until Mox Emerald is on the table. Cast with Emerald and Ruby
# (the Pearl stays untapped), Bot1 mills its own top three (Forest, Lightning Bolt, Grizzly Bears -- library 13 to 10), not Bot2's
# (library untouched), and creates one Clue token.

[Bot1 Deck]
Flotsam // Jetsam
Mox Ruby
Mox Pearl
Mox Emerald
Island x3
Forest
Lightning Bolt
Grizzly Bears
Island x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
! Bot1.Hand.Flotsam // Jetsam.Cast(Ability: Flotsam; Mana: short)
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Flotsam // Jetsam.Cast(Ability: Flotsam)
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Library.Count = 10
Bot1.Graveyard.Count = 4
Bot2.Library.Count = 13
Bot2.Graveyard.Count = 0
Bot1.Battlefield.Count = 4
Stack.Count = 0
