# Savior of the Small: the "if this creature is tapped" of Survival (CR 603.4; the ruling: tapping it after the second main phase
# begins is too late). Savior does not attack on turn 3, so it is untapped when the second main phase begins: nothing is
# targeted or asked (the refusal), and Memnite stays in the graveyard. Bot2 is the other player's turn: on turn 4 Savior is
# still untapped and it is not Bot1's second main phase.

[Bot1 Deck]
Mox Pearl
Mox Jet
Mox Emerald
Mox Ruby
Savior of the Small
Faithless Looting
Memnite
Island x20

[Bot2 Deck]
Swamp x14

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Savior of the Small.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Faithless Looting.Cast
Bot1.Pass
Bot1.Choose(Memnite; Island)
[T3 Bot1.Main2]
Bot1.Pass
! Bot1.Target
[T3 Bot1.End]

[Expect]
Bot1.Hand = Island; Island
Bot1.Graveyard = Faithless Looting; Island; Memnite
Bot1.Battlefield.Savior of the Small.Tapped = false
