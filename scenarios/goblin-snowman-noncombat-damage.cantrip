# The blocking trigger prevents only combat damage; Lightning Bolt still destroys Snowman during combat (CR 615.1).
[Bot1 Deck]
Black Lotus
Mox Ruby
Goblin Snowman
Island x20
[Bot2 Deck]
Black Lotus
Mox Ruby
Grizzly Bears
Lightning Bolt
Island x20
[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Goblin Snowman.Cast
? Bot1.Mana =
[T2 Bot2.Main1]
Bot2.Hand.Black Lotus.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Black Lotus.Activate(Color: Green)
Bot2.Hand.Grizzly Bears.Cast
[T4 Bot2.DeclareAttackers]
Bot2.Attack(Grizzly Bears > Bot1)
Bot1.Block(Goblin Snowman > Grizzly Bears)
[T4 Bot2.Blockers]
Bot2.Pass
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Goblin Snowman)
[T4 Bot2.Main2]
[Expect]
Bot1.Graveyard = Goblin Snowman; Black Lotus
Bot2.Life = 20
