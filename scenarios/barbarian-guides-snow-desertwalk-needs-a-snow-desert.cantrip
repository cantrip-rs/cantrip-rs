# Barbarian Guides offers every land type, not only the basic ones (the 2014-02-01 ruling: "you choose a land subtype").
# Choosing Desert gives Memnite snow desertwalk (CR 702.14c): Bot2 controls a Desert that is not snow and a snow land that
# is no Desert (Snow-Covered Island), so neither lets it walk and Ornithopter blocks it. Memnite is then returned by
# Unsummon and cast again before the end step: the delayed ability names the object the Guides targeted, and the Memnite
# on the battlefield now is a new object it leaves alone (CR 603.7c, 400.7).

[Bot1 Deck]
Mox Ruby
Mox Pearl
Mox Jet
Mox Sapphire
Barbarian Guides
Memnite
Unsummon
Mountain x10

[Bot2 Deck]
Snow-Covered Island
Ornithopter
Desert
Island x12

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Barbarian Guides.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Snow-Covered Island.Play
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
[T4 Bot2.Main1]
Bot2.Hand.Desert.Play
[T5 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Barbarian Guides.Activate(Memnite)
Bot1.Pass
Bot1.Modes(Desert)
? Bot1.Battlefield.Memnite.Keywords = SnowDesertwalk
Bot1.Attack(Memnite > Bot2)
Bot2.Block(Ornithopter > Memnite)
[T5 Bot1.Main2]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Unsummon.Cast(Memnite)
Bot1.Pass
Bot1.Hand.Memnite.Cast
Bot1.Pass
[T5 Bot1.End]
Bot1.Pass

[Expect]
Bot2.Life = 20
Bot1.Battlefield.Memnite.Tapped = false
Bot1.Battlefield.Memnite.Keywords = (absent)
Bot1.Graveyard = Unsummon
