# Trusty Boomerang: "Equipped creature has '{1}, {T}: Tap target creature. Return Trusty Boomerang to its owner's hand.'" (CR 613.1f,
# 113.8). Bot1's equipped Memnite taps Bot2's Ornithopter for {1}; the ability's second sentence returns the Equipment that gave it,
# so Trusty Boomerang is in Bot1's hand and the Memnite, no longer equipped, is a plain creature again.

[Bot1 Deck]
Memnite
Mox Jet
Mox Pearl
Mox Ruby
Trusty Boomerang
Plains x16

[Bot2 Deck]
Ornithopter
Plains x19

[Actions]
Bot1.Hand.Memnite.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Trusty Boomerang.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Trusty Boomerang.Activate(Ability: Equip; Memnite)
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Plains.Play
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Memnite.Activate(Ability: Tap target; Bot2.Battlefield.Ornithopter)
? Stack.Count = 1
? Bot1.Battlefield.Trusty Boomerang.Tapped = false
Bot1.Pass
Bot2.Pass
? Stack.Count = 0

[Expect]
Bot2.Battlefield.Ornithopter.Tapped = true
Bot1.Battlefield.Memnite.Tapped = true
Bot1.Battlefield.Trusty Boomerang = (absent)
Bot1.Hand.Trusty Boomerang.Colors.Count = 0
