# Rootwise Survivor, Survival's "up to one target land you control": Bot1 chooses no target (Target() chooses none for "up to
# one"), so no counters are put and nothing becomes a creature; the Forest and the Island stay plain lands (CR 115.1b, 608.2b).

[Bot1 Deck]
Mox Emerald
Mox Jet
Mox Ruby
Mox Pearl
Forest
Island
Rootwise Survivor
Island x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Forest.Play
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Rootwise Survivor.Cast
Bot1.Pass
Bot1.Attack(Rootwise Survivor > Bot2)
[T3 Bot1.Main2]
Bot1.Target()
Bot1.Pass
[T3 Bot1.End]

[Expect]
Bot1.Battlefield.Forest.Types = Land
Bot1.Battlefield.Forest.Counters.PlusOnePlusOne = (absent)
Bot1.Battlefield.Island.Types = Land
Bot1.Battlefield.Forest.Keywords = (absent)
Bot2.Life = 17
