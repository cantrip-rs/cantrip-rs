! Bot1.Target(Bot1.Graveyard.Memnite; Bot1.Graveyard.Ornithopter#1; Bot1.Graveyard.Ornithopter#2)
Bot1.Target(Bot1.Graveyard.Memnite; Bot1.Graveyard.Ornithopter#1)
