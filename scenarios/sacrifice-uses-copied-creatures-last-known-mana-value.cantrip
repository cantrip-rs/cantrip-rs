# Clone copying Ornithopter has mana value zero as it leaves, although Clone in the graveyard has mana value four (CR 608.2h, 707.2).
# Sacrifice therefore adds no mana.
[Bot1 Deck]
Ornithopter
Black Lotus
Mox Sapphire
Clone
Mox Jet
Sacrifice
Island x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
