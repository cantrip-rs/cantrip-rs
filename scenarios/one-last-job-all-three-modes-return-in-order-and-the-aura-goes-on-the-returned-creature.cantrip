# One Last Job with all three spree modes (CR 702.172, 608.2c): {2}{W} + {2} + {1} + {1} = seven mana, paid exactly by Black Lotus
# (three white) and four Moxen. Each mode has its own target in its own graveyard: only Bot1's own cards qualify, never Bot2's
# Savannah Lions, Passenger Ferry and Pacifism (both players have one of each in a graveyard, put there with Otherworldly Gaze's
# surveil), and a card outside a mode's filter is refused at that mode's slot (Pacifism is no creature, Lions is neither a Mount nor
# a Vehicle nor an Aura nor an Equipment, Ferry is no creature). The modes run in printed order: the Lions come back first, so they
# are the creature the Pacifism returns to, attached to it though nothing but the card was ever targeted (CR 303.4f).

[Bot1 Deck]
Black Lotus
Mox Pearl
Mox Sapphire
Mox Ruby
Mox Jet
Otherworldly Gaze
One Last Job
Savannah Lions
Passenger Ferry
Pacifism
Island x10

[Bot2 Deck]
Mox Sapphire
Otherworldly Gaze
Island x6
Savannah Lions
Passenger Ferry
Pacifism
Island x10

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Otherworldly Gaze.Cast
Bot1.Arrange(| Savannah Lions; Passenger Ferry; Pacifism)
[T2 Bot2.Main1]
Bot2.Hand.Mox Sapphire.Cast
Bot2.Pass
Bot1.Pass
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.Otherworldly Gaze.Cast
Bot2.Arrange(| Savannah Lions; Passenger Ferry; Pacifism)
[T3 Bot1.Main1]
Bot1.Hand.One Last Job.Cast
Bot1.Modes(1; 2; 3)
! Bot1.Target(Bot2.Graveyard.Savannah Lions)
! Bot1.Target(Bot1.Graveyard.Pacifism)
Bot1.Target(Bot1.Graveyard.Savannah Lions)
! Bot1.Target(Bot1.Graveyard.Savannah Lions)
! Bot1.Target(Bot2.Graveyard.Passenger Ferry)
Bot1.Target(Bot1.Graveyard.Passenger Ferry)
! Bot1.Target(Bot1.Graveyard.Savannah Lions)
! Bot1.Target(Bot1.Graveyard.Passenger Ferry)
! Bot1.Target(Bot2.Graveyard.Pacifism)
Bot1.Target(Bot1.Graveyard.Pacifism)
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
? Bot1.Mana =
Bot1.Choose(Savannah Lions)
[Bot1.Main2]

[Expect]
Stack.Count = 0
Bot1.Graveyard = One Last Job; Black Lotus; Otherworldly Gaze
Bot2.Graveyard = Otherworldly Gaze; Pacifism; Passenger Ferry; Savannah Lions
Bot1.Battlefield = Mox Jet; Mox Pearl; Mox Ruby; Mox Sapphire; Pacifism; Passenger Ferry; Savannah Lions
Bot1.Battlefield.Pacifism.AttachedTo = Savannah Lions
Bot1.Battlefield.Savannah Lions.Tapped = false
