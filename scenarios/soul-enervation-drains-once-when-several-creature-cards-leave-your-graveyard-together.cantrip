Bot1.Pass
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Soul Enervation.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Faithless Looting.Cast
Bot1.Pass
Bot2.Pass
Bot1.Choose(Memnite; Ornithopter)
? Bot1.Graveyard = Faithless Looting; Ornithopter; Memnite
? Bot1.Life = 20
? Bot2.Life = 20
[T2 Bot2.Main1]
Bot2.Hand.Tormod's Crypt.Cast
Bot1.Pass
Bot2.Battlefield.Tormod's Crypt.Activate(Bot1)
Bot1.Pass

[Expect]
Bot1.Graveyard.Count = 0
Bot2.Life = 19
Bot1.Life = 21
