# If the Ooze dies in response to its upkeep ability, its last known counter count determines the damage (CR 608.2h).
[Bot1 Deck]
Primordial Ooze
Mox Ruby
Mountain x20

[Bot2 Deck]
Mox Ruby
Lightning Bolt
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Primordial Ooze.Cast
? Bot1.Mana =
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
[T3 Bot1.Upkeep]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.PayCost
[T3 Bot1.DeclareAttackers]
! Bot1.Attack()
Bot1.Attack(Primordial Ooze > Bot2)
[T5 Bot1.Upkeep]
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Primordial Ooze)
Bot2.Pass
Bot1.Decline
[T5 Bot1.Main1]

[Expect]
Bot1.Life = 19
Bot1.Graveyard.Primordial Ooze.Colors = Red
Bot2.Life = 18
