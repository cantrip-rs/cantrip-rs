# Affectionate Indrik (CR 701.14a, 603.3d): the target is chosen when the enters trigger goes on the stack and the fight is accepted as it
# resolves. Indrik (4 power) kills the 1/1 Memnite and takes its 1 damage; the Ornithopter that was not chosen is untouched, and the
# refusal shows a creature Bot1 controls (the Indrik itself) is not a legal target.

[Bot1 Deck]
Black Lotus
Mox Emerald
Mox Jet
Mox Ruby
Affectionate Indrik
Island x20

[Bot2 Deck]
Memnite
Ornithopter
Island x20

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Affectionate Indrik.Cast
! Bot1.Target(Bot1.Battlefield.Affectionate Indrik)
Bot1.Target(Bot2.Battlefield.Memnite)
Bot1.Accept
[Bot1.Main2]

[Expect]
Stack.Count = 0
Bot1.Battlefield.Affectionate Indrik.Damage = 1
Bot2.Graveyard = Memnite
Bot2.Battlefield.Ornithopter.Damage = 0
