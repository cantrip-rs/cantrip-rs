# Mouse Trapper's valiant counts only what ITS CONTROLLER controls (CR 603.2): Bot2's Lightning Bolt aimed at it triggers nothing (only the Bolt is on the stack), and
# Bot1's Giant Growth in response is still the first time, so Bot2's Dwarven Trader (the one legal target) is tapped. The Growth resolves first (6/5), so the Trapper
# survives the 3 damage.

[Bot1 Deck]
Mox Pearl
Mox Jet
Mox Ruby
Black Lotus
Mouse Trapper
Giant Growth
Giant Growth
Plains x20

[Bot2 Deck]
Mox Ruby
Mountain
Dwarven Trader
Lightning Bolt
Island x20

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Mouse Trapper.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Hand.Mountain.Play
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Dwarven Trader.Cast
Bot2.Pass
[T4 Bot2.Main1]
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Mouse Trapper)
? Stack.Count = 1
? Bot2.Battlefield.Dwarven Trader.Tapped = false
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Hand.Giant Growth.Cast(Mouse Trapper)
Bot1.Pass
Bot2.Pass
? Bot2.Battlefield.Dwarven Trader.Tapped = true
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Mouse Trapper.Power = 6
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Graveyard = Lightning Bolt
Bot1.Battlefield.Mouse Trapper.Power = 6
Bot1.Battlefield.Mouse Trapper.Toughness = 5
