# Defender prevents attacking, and a paid regeneration shield replaces destruction (CR 702.3b, 701.19a).

[Bot1 Deck]
Black Lotus
Mox Jet
Mox Sapphire
Wall of Bone
Ornithopter
Island x20

[Bot2 Deck]
Black Lotus
Go for the Throat
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Hand.Wall of Bone.Cast
? Bot1.Mana =
Bot1.Pass
Bot1.Battlefield.Mox Sapphire.Activate
! Bot1.Battlefield.Wall of Bone.Activate(Mana: short)
Bot1.Hand.Mox Jet.Cast
[T2 Bot2.Main1]
Bot2.Hand.Black Lotus.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Wall of Bone.Activate
? Bot1.Mana =
Bot1.Pass
Bot2.Battlefield.Black Lotus.Activate(Color: Black)
Bot2.Hand.Go for the Throat.Cast(Bot1.Battlefield.Wall of Bone)
Bot2.Pass
Bot1.Pass
? Bot1.Battlefield.Wall of Bone.Tapped = true
[T3 Bot1.DeclareAttackers]
! Bot1.Attack(Wall of Bone > Bot2)
Bot1.Attack(Ornithopter > Bot2)

[Expect]
Bot1.Battlefield.Wall of Bone.Tapped = false
Bot2.Graveyard = Go for the Throat; Black Lotus
