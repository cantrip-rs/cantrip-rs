# Dwarven Mauler's "cost {2} less" takes off generic mana only (CR 118.7a; Helitrooper's ruling: "it will have no
# effect on an equip cost of {G}"). Greatsword of Tyr's Equip {W} targeting the Mauler still costs {W}: on turn 3,
# with only red mana left, it is not offered; on turn 5 the {W} in the pool pays it and is gone. Then the Mauler
# attacks: "Whenever equipped creature attacks, put a +1/+1 counter on it and tap up to one target creature defending
# player controls" - Bot1's own Mother of Runes is not a candidate (CR 508.5: the defending player is the one the
# Mauler attacks), Bot2's Ornithopter is, and it is tapped, so it cannot block the 3/2 Mauler.

[Bot1 Deck]
Mountain
Dwarven Mauler
Mox Pearl
Mox Ruby
Greatsword of Tyr
Mother of Runes
Island
Island x10

[Bot2 Deck]
Ornithopter
Island x14

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Dwarven Mauler.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Greatsword of Tyr.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Mother of Runes.Cast
Bot1.Pass
! Bot1.Battlefield.Greatsword of Tyr.Activate(Dwarven Mauler; Mana: short)
[T5 Bot1.Main1]
Bot1.Battlefield.Mox Pearl.Activate
? Bot1.Mana = {W}
Bot1.Battlefield.Greatsword of Tyr.Activate(Dwarven Mauler)
Bot1.Choose(Close mana window)
? Bot1.Mana =
Bot1.Pass
Bot1.Attack(Dwarven Mauler > Bot2)
! Bot1.Target(Mother of Runes)
Bot1.Target(Bot2.Battlefield.Ornithopter)
[T5 Bot1.Main2]
? Bot2.Battlefield.Ornithopter.Tapped = true

[Expect]
Turn = 5
Bot1.Battlefield.Greatsword of Tyr.AttachedTo = Dwarven Mauler
Bot1.Battlefield.Dwarven Mauler.Counters.PlusOnePlusOne = 1
Bot1.Battlefield.Dwarven Mauler.Power = 3
Bot2.Life = 17
