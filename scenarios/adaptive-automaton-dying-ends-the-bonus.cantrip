# Adaptive Automaton choosing Thopter pumps Bot1's Ornithopter to 1/3 only while it is on the battlefield: Bot2's Lightning
# Bolt kills the 2/2 Automaton on turn two and the Ornithopter is a 0/2 again.

[Bot1 Deck]
Mox Jet
Mox Pearl
Mox Sapphire
Adaptive Automaton
Ornithopter
Island x15

[Bot2 Deck]
Mox Ruby
Lightning Bolt
Island x18

[Actions]
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Adaptive Automaton.Cast
Bot1.Pass
Bot1.Modes(Thopter)
? Bot1.Battlefield.Ornithopter.Power = 1
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Adaptive Automaton)

[Expect]
Bot1.Graveyard = Adaptive Automaton
Bot1.Battlefield.Ornithopter.Power = 0
Bot1.Battlefield.Ornithopter.Toughness = 2
