Bot1.Pass
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Faithless Looting.Cast
Bot1.Pass
Bot1.Choose(Island; Island)
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Thought Scour.Cast(Bot1)
Bot1.Pass
Bot2.Pass
? Bot1.Graveyard.Count = 7
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
? Bot2.Hand.Count = 6
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Tidecaller Mentor.Cast
Bot1.Pass
Bot2.Pass
! Bot1.Target(Bot2.Battlefield.Island)
Bot1.Target(Bot2.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Battlefield = Island
Bot2.Hand.Count = 7
Bot1.Battlefield = Mox Ruby; Mox Sapphire; Mox Jet; Tidecaller Mentor
