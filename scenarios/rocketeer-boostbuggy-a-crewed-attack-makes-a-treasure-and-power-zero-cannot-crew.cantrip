Bot1.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
! Bot1.Battlefield.Rocketeer Boostbuggy.Activate(Ability: Crew)
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Llanowar Elves.Cast
Bot1.Battlefield.Rocketeer Boostbuggy.Activate(Ability: Crew)
Bot1.Choose(Llanowar Elves)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Count = 6
Bot1.Pass
Bot1.Attack(Rocketeer Boostbuggy > Bot2)
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]
? Bot1.Battlefield.Count = 7
[T5 Bot1.Main1]
Bot1.Pass
Bot1.Attack(Ornithopter > Bot2)
Bot1.Pass
Bot2.Pass
[T5 Bot1.Main2]

