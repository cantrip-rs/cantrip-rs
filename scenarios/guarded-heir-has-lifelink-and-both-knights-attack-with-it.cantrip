# Guarded Heir: lifelink (CR 702.15b). On turn 3 Bot1 attacks Bot2 with the Heir and both Knight tokens: 1 + 3 + 3 = 7 combat
# damage takes Bot2 from 20 to 13, and only the Heir's 1 damage gains life, so Bot1 goes from 20 to 21 (a positive control that
# the Knights, which have no lifelink, gain nothing: 7 life would be 27).

[Bot1 Deck]
Guarded Heir
Black Lotus
Mox Pearl
Mox Sapphire
Mox Ruby
Plains x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Guarded Heir.Cast
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Guarded Heir > Bot2; Knight Token#1 > Bot2; Knight Token#2 > Bot2)
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]

[Expect]
Bot1.Life = 21
Bot2.Life = 13
