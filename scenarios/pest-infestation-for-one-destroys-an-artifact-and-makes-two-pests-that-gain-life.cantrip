# Pest Infestation cast for X=1 destroys Bot2's Mox Pearl and creates twice X, two, 1/1 black and green Pest tokens. When
# Bot2 then kills one of them with Lightning Bolt, its "when this token dies" gains Bot1 1 life.

[Bot1 Deck]
Mox Emerald
Mox Ruby
Mox Jet
Pest Infestation
Swamp x3
Swamp x10

[Bot2 Deck]
Mox Pearl
Mox Ruby
Lightning Bolt
Island x4
Island x10

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot2.Hand.Mox Pearl.Cast
Bot2.Hand.Mox Ruby.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Pest Infestation.Cast(X: 1)
Bot1.Target(Mox Pearl)
[T4 Bot2.Main1]
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Pest Token#1)
[T4 Bot2.Main2]

