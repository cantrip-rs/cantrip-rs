# The Turtle's power 0 and the opponent's Lions do not add up to a crew of 1.
! Bot1.Battlefield.Air Response Unit.Activate(Ability: Crew)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Zephyr Sprite.Cast
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Air Response Unit.Types = Artifact
Bot1.Battlefield.Air Response Unit.Activate(Ability: Crew)
Bot1.Choose(Zephyr Sprite)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Air Response Unit.Types = Artifact; Creature
Bot1.Attack(Air Response Unit > Bot2)
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]

