[T3 Bot1.Main1]
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: B)
Bot1.Hand.Graveshifter.Cast
Bot1.Pass
Bot2.Pass
Bot1.Accept
