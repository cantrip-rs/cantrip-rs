# CR 400.7, 113.7a: Bot1 activates the Pole's granted ability (the Memnite and the Pole are tapped as the cost, CR 602.2b);
# Bot2 destroys the Pole in response with Shatter. The ability is independent of its source and still resolves, but "Fishing
# Pole" is the object that gave it and that is gone (a new object in the graveyard): no counter goes anywhere, and no Fish
# follows when the Memnite untaps.

[Bot1 Deck]
Memnite
Mox Jet
Mox Pearl
Mox Ruby
Fishing Pole
Plains x16

[Bot2 Deck]
Mox Ruby
Mox Jet
Shatter
Plains x17

[Actions]
Bot1.Hand.Memnite.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Fishing Pole.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Fishing Pole.Activate(Ability: Equip; Memnite)
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Mox Jet.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Memnite.Activate
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Shatter.Cast(Bot1.Battlefield.Fishing Pole)
Bot2.Pass
Bot1.Pass
? Bot1.Battlefield.Fishing Pole = (absent)
? Stack.Count = 1
Bot2.Pass
Bot1.Pass
? Stack.Count = 0
? Bot1.Graveyard.Fishing Pole.Counters.Bait = (absent)
[T5 Bot1.Main1]

[Expect]
Bot1.Graveyard.Fishing Pole.Counters.Bait = (absent)
Bot1.Battlefield.Memnite.Tapped = false
Bot1.Battlefield.Fish Token = (absent)
