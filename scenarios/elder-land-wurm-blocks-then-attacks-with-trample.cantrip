# Defender prevents an attack until the Wurm blocks; its trigger removes defender, and trample carries excess damage to the defending player (CR 702.3, 702.19, 603.2).
[Bot1 Deck]
Elder Land Wurm
Black Lotus
Mox Pearl
Mox Sapphire
Mox Jet
Mox Ruby
Ornithopter
Plains x20

[Bot2 Deck]
Memnite x2
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Elder Land Wurm.Cast
? Bot1.Mana =
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot2.Hand.Memnite.Cast
Bot2.Pass
[T3 Bot1.Attackers]
! Bot1.Attack(Elder Land Wurm > Bot2)
[T4 Bot2.Attackers]
Bot2.Attack(Memnite > Bot1)
Bot1.Block(Elder Land Wurm > Memnite)
[T5 Bot1.BeginCombat]
? Bot1.Battlefield.Elder Land Wurm.Keywords = Trample
[T5 Bot1.Attackers]
Bot1.Attack(Elder Land Wurm > Bot2)
Bot2.Block(Memnite > Elder Land Wurm)
[T5 Bot1.Main2]
[Expect]
Bot2.Life = 16
