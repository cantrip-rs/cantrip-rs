# Eject: "Return target nonland permanent to its owner's hand. Draw a card" (CR 400.3, 121.1). On turn 3 Bot1 aims it at Bot2's
# Ornithopter - Bot2's Island, a land, is refused as a target - and the Ornithopter goes back to Bot2's hand while Bot1 draws exactly
# one card.

[Bot1 Deck]
Mox Sapphire
Mox Ruby
Mox Jet
Mox Pearl
Eject
Island x16

[Bot2 Deck]
Ornithopter
Island x19

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
! Bot1.Hand.Eject.Cast(Bot2.Battlefield.Island)
Bot1.Hand.Eject.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Battlefield = Island
Bot2.Hand.Count = 7
Bot1.Graveyard = Eject
Bot1.Hand.Count = 4
