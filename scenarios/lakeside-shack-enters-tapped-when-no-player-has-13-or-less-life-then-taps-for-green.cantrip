# Lakeside Shack: "This land enters tapped unless a player has 13 or less life." Both players start at 20 life, so it enters tapped
# (CR 614.1d), untaps on turn 3 and taps for {G} (the first color it prints: the pool check pins it); it makes no
# other color, nor colorless.

[Bot1 Deck]
Lakeside Shack
Plains x19

[Bot2 Deck]
Plains x20

[Actions]
Bot1.Hand.Lakeside Shack.Play
? Bot1.Battlefield.Lakeside Shack.Tapped = true
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main1]
? Bot1.Battlefield.Lakeside Shack.Tapped = false
! Bot1.Battlefield.Lakeside Shack.Activate(Color: White)
! Bot1.Battlefield.Lakeside Shack.Activate(Color: Black)
! Bot1.Battlefield.Lakeside Shack.Activate(Color: Red)
! Bot1.Battlefield.Lakeside Shack.Activate(Color: Colorless)
Bot1.Battlefield.Lakeside Shack.Activate(Color: Green)
? Bot1.Mana = {G}

[Expect]
Bot1.Life = 20
Bot2.Life = 20
Bot1.Battlefield.Lakeside Shack.Tapped = true
