# With Forests controlled by both players, Gorilla Pack remains in play and may attack the defending player (CR 508.1c).
[Bot1 Deck]
Forest
Gorilla Pack
Black Lotus
Island x20
[Bot2 Deck]
Forest
Island x20
[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Hand.Gorilla Pack.Cast
? Bot1.Mana =
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Gorilla Pack > Bot2)
[T3 Bot1.Main2]
[Expect]
Bot2.Life = 17
Bot1.Battlefield.Gorilla Pack.Tapped = true
