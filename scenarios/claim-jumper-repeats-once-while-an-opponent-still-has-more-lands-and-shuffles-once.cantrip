Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
[T4 Bot2.Main1]
Bot2.Hand.Island.Play
[T5 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Claim Jumper.Cast
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Accept
Bot1.Search(Plains)
? Bot1.Battlefield = Mox Ruby; Mox Pearl; Mox Emerald; Claim Jumper; Plains
? Bot1.Shuffles = 0
Bot1.Accept
Bot1.Search(Plateau)

[Expect]
Turn = 5
Stack.Count = 0
Bot1.Battlefield = Mox Ruby; Mox Pearl; Mox Emerald; Claim Jumper; Plains; Plateau
Bot1.Battlefield.Plains.Tapped = true
Bot1.Battlefield.Plateau.Tapped = true
Bot1.Shuffles = 1
Bot2.Battlefield = Island; Island
