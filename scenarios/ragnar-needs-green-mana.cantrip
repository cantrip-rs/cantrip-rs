# Ragnar requires green mana even with three other mana available; adding that color
# permits the same activation (CR 602.2b).
[Bot1 Deck]
Black Lotus
Mox Pearl
Mox Sapphire
Mox Pearl
Ragnar
Forest
Swamp
Swamp x20

[Bot2 Deck]
Swamp x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Battlefield.Mox Pearl#1.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Ragnar.Cast
? Bot1.Mana = {G}{G}
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Pearl#1.Activate
Bot1.Battlefield.Mox Pearl#2.Activate
Bot1.Battlefield.Mox Sapphire.Activate
! Bot1.Battlefield.Ragnar.Activate(Bot1.Battlefield.Ragnar; Mana: short)
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Ragnar.Activate(Bot1.Battlefield.Ragnar)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
? Bot1.Battlefield.Ragnar.Tapped = true

[Expect]
Bot1.Battlefield.Ragnar.Tapped = true
