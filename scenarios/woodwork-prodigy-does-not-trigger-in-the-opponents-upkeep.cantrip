# "At the beginning of your upkeep": Woodwork Prodigy, cast on turn 1, is unprepared through Bot2's turn 2 upkeep (CR 603.2),
# so there is nothing in exile until Bot1's own turn 3 upkeep.

[Bot1 Deck]
Mox Ruby
Mox Ruby
Mox Ruby
Woodwork Prodigy
Island x3
Island x16

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Ruby#1.Activate
Bot1.Battlefield.Mox Ruby#2.Activate
Bot1.Battlefield.Mox Ruby#3.Activate
Bot1.Hand.Woodwork Prodigy.Cast
[T2 Bot2.Upkeep]
? Stack.Count = 0
[T2 Bot2.Main1]
? Exile.Count = 0
? Bot1.Battlefield.Woodwork Prodigy.Prepared = (absent)
[T3 Bot1.Upkeep]
? Stack.Count = 1

[Expect]
Bot1.Battlefield.Woodwork Prodigy.Prepared = true
Exile = Soul Tether
