# A card exiled by something else (Swords to Plowshares on Memnite) is not "exiled with Azula" (CR 607.2a): Azula's controller may
# cast the Ornithopter Bot2 exiled for Azula, not the Memnite.

[Bot1 Deck]
Mox Sapphire
Mox Jet
Mox Pearl
Mox Emerald
Azula, Cunning Usurper
Swamp
Swords to Plowshares
Island x14

[Bot2 Deck]
Ornithopter
Memnite
Island x18

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Swamp.Play
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Azula, Cunning Usurper.Cast
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot2.Choose(Ornithopter)
[T5 Bot1.Main1]
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Swords to Plowshares.Cast(Bot2.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
! Bot1.Exile.Memnite.Cast(Ability: Cast from exile)
Bot1.Exile.Ornithopter.Cast(Ability: Cast from exile)
Bot1.Pass
Bot2.Pass

[Expect]
Exile = Memnite
Bot1.Battlefield = Azula, Cunning Usurper; Mox Emerald; Mox Jet; Mox Pearl; Mox Sapphire; Ornithopter; Swamp
