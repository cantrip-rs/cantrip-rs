# Word of Command (CR 723.5, 709.3): which half of a split card the player casts is the player's choice as it is cast, and so
# the controller's. Bot2 can pay for Wear ({1}{R}) and for Tear ({W}) with its Mountain and Plains, but not for both fused
# ({1}{R}{W}), so Bot1 is offered the two halves alone and has Bot2 cast Tear, destroying Bot1's own Pacifism (its only
# enchantment) rather than Wear on the Memnite it enchants. Tear is paid with the Plains; the Mountain stays untapped.

[Bot1 Deck]
Memnite
Black Lotus
Pacifism
Word of Command
Swamp
Swamp
Swamp x14

[Bot2 Deck]
Mountain
Plains
Wear // Tear
Island x17

[Actions]
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Hand.Pacifism.Cast(Memnite)
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
[T3 Bot1.Main1]
Bot1.Hand.Swamp.Play
[T4 Bot2.Main1]
Bot2.Hand.Plains.Play
[T5 Bot1.Main1]
Bot1.Hand.Swamp.Play
Bot1.Battlefield.Swamp#1.Activate
Bot1.Battlefield.Swamp#2.Activate
Bot1.Hand.Word of Command.Cast(Bot2)
Bot1.Pass
Bot2.Pass
Bot1.Choose(Wear // Tear)
Bot2.Modes(Tear)
Bot2.Target(Pacifism)
Bot2.Battlefield.Plains.Activate
? Stack = Tear
Bot1.Pass
Bot2.Pass
[T5 Bot1.Main2]

[Expect]
Bot1.Graveyard = Pacifism; Word of Command; Black Lotus
Bot1.Battlefield = Memnite; Swamp; Swamp
Bot2.Graveyard = Wear // Tear
Bot2.Battlefield.Mountain.Tapped = false
Bot2.Battlefield.Plains.Tapped = true
