# Browser
# What Blood of the Martyr's controller sees as Pyroclasm damages two Ornithopters, one of each player's (CR 614.1a, 616.1):
# a question for each creature, each naming the damage it is about and whose creature it would be dealt to. Bot1 takes the
# damage for Bot2's Ornithopter and leaves it on their own.
[Bot1 Deck]
Black Lotus
Mox Ruby
Mox Ruby
Blood of the Martyr
Pyroclasm
Ornithopter
Plains x20
[Bot2 Deck]
Ornithopter
Island x20
[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Ruby.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Hand.Blood of the Martyr.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Ruby#1.Activate
Bot1.Battlefield.Mox Ruby#2.Activate
Bot1.Hand.Pyroclasm.Cast
Bot1.Pass
? Client.Bot1.Prompt.Title = Blood of the Martyr: have that damage dealt to you instead?
? Client.Bot1.Prompt.Detail = 2 damage from Pyroclasm to your opponent's Ornithopter
Bot1.Accept
? Client.Bot1.Prompt.Title = Blood of the Martyr: have that damage dealt to you instead?
? Client.Bot1.Prompt.Detail = 2 damage from Pyroclasm to your Ornithopter
Bot1.Decline
[Expect]
Bot1.Life = 18
Bot1.Graveyard = Ornithopter; Pyroclasm; Blood of the Martyr; Black Lotus
Bot2.Battlefield.Ornithopter.Damage = 0
