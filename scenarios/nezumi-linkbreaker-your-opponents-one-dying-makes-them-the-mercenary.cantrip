# Nezumi Linkbreaker's token goes to the controller of the creature that died, not the player whose spell killed it: Bot1 bolts
# Bot2's Linkbreaker and Bot2 gets the Mercenary while Bot1 gets none.

[Bot1 Deck]
Mox Ruby
Lightning Bolt
Mountain x22

[Bot2 Deck]
Nezumi Linkbreaker
Swamp x22

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Swamp.Play
Bot2.Battlefield.Swamp.Activate
Bot2.Hand.Nezumi Linkbreaker.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Nezumi Linkbreaker)
Bot1.Pass
Bot2.Pass

[Expect]
Stack.Count = 0
Bot2.Graveyard = Nezumi Linkbreaker
Bot2.Battlefield.Mercenary Token.Power = 1
Bot2.Battlefield.Mercenary Token.Colors = Red
Bot2.Battlefield.Count = 2
Bot1.Battlefield.Count = 1
