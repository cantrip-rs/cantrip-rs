# Kylox's Voltstrider: the cast is optional ("you may cast"). Bot1 exiles Hill Giant, Lightning Bolt and Faithless Looting with the
# evidence cost, attacks, and declines to cast anything. All three stay in exile for good (nothing returns them), Bot2 takes only
# the Vehicle's 4, and the Bolt is not put on the library.

[Bot1 Deck]
Mox Sapphire
Mox Ruby
Black Lotus
Kylox's Voltstrider
Faithless Looting
Lightning Bolt
Island
Hill Giant
Grizzly Bears
Island x5

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Kylox's Voltstrider.Cast
Bot1.Hand.Faithless Looting.Cast
Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Choose(Hill Giant; Grizzly Bears)
? Bot1.Graveyard = Faithless Looting; Grizzly Bears; Hill Giant; Lightning Bolt; Black Lotus
[T3 Bot1.Main1]
Bot1.Battlefield.Kylox's Voltstrider.Activate(Ability: evidence)
Bot1.Choose(Hill Giant; Lightning Bolt; Faithless Looting)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Kylox's Voltstrider.Types = Artifact; Creature
? Exile = Faithless Looting; Hill Giant; Lightning Bolt
Bot1.Attack(Kylox's Voltstrider > Bot2)
Bot1.Choose()
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 13
Exile = Faithless Looting; Hill Giant; Lightning Bolt
Bot1.Graveyard = Grizzly Bears; Black Lotus
Bot1.Library = Island; Island; Island; Island
