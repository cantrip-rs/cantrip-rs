# Bargain (CR 702.166a) is an additional cost: sacrificing an artifact, enchantment or token, and a Mountain is refused.
# Sacrificing Mox Ruby makes the spell bargained, so it deals 3 damage, not 2, to Keen-Eyed Curator (a 3/3), which would die
# and is exiled instead; Bot1 scries 1 and puts Lightning Bolt on the bottom, so Black Lotus is on top.

[Bot1 Deck]
Mox Ruby
Torch the Tower
Mountain x6
Lightning Bolt
Black Lotus
Mountain x10

[Bot2 Deck]
Mox Emerald
Forest
Keen-Eyed Curator
Forest x17

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Hand.Mox Ruby.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Emerald.Cast
Bot2.Hand.Forest.Play
Bot2.Hand.Keen-Eyed Curator.Cast
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Battlefield.Forest.Activate
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Hand.Torch the Tower.Cast(Bot2.Battlefield.Keen-Eyed Curator)
Bot1.Modes(Bargain:)
Bot1.Battlefield.Mountain.Activate
! Bot1.Choose(Mountain)
Bot1.Choose(Pay mana)
Bot1.Choose(Mox Ruby)
Bot1.Arrange( | Lightning Bolt)
[T3 Bot1.Main2]

[Expect]
Exile = Keen-Eyed Curator
Bot2.Graveyard.Count = 0
Bot1.Graveyard = Torch the Tower; Mox Ruby
Bot1.Library = Black Lotus; Mountain; Mountain; Mountain; Mountain; Mountain; Mountain; Mountain; Mountain; Mountain; Mountain; Lightning Bolt
