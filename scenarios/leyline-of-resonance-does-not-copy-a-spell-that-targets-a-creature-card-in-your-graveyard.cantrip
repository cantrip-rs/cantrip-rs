Bot1.Target(Bot2)
Bot1.Pass
Bot1.Pass
[T5 Bot1.Main1]
Bot1.Hand.Swamp.Play
Bot1.Battlefield.Swamp.Activate
Bot1.Hand.Reanimate.Cast(Llanowar Elves)
? Stack.Count = 1
