# Boom Box's slots are all "up to one". Bot2's Ornithopter is an artifact creature: Bot1 chooses it for the artifact slot and
# again for the creature slot (they are two instances of "target", CR 115.3) and no land. It is destroyed once, by one
# action: Bot2's graveyard holds it once. Bot2's Forest, which was not chosen, stays.

[Bot1 Deck]
Island
Mox Emerald
Mox Ruby
Mox Pearl
Mox Jet
Mox Sapphire
Boom Box
Island x14

[Bot2 Deck]
Forest
Ornithopter
Forest x14

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Boom Box.Cast
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Boom Box.Activate
Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Target()
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield.Boom Box = (absent)
Bot2.Battlefield.Ornithopter = (absent)
Bot2.Battlefield.Forest.Tapped = false
Bot2.Graveyard = Ornithopter
