# Both mana abilities of Ramunap Ruins: on turn 1 {T}: Add {C} costs no life (Bot1 stays at 20); on turn 3 the same land
# taps with {T}, Pay 1 life for {R} (Bot1 at 19). The pool is checked right after each tap.

[Bot1 Deck]
Ramunap Ruins
Plains x19

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Ramunap Ruins.Play
Bot1.Battlefield.Ramunap Ruins.Activate(Ability: {T}: Add {C})
? Bot1.Mana = {C}
? Bot1.Life = 20
[T3 Bot1.Main1]
Bot1.Battlefield.Ramunap Ruins.Activate(Ability: Pay 1 life)
Bot1.Choose(Tap Ramunap Ruins)
? Bot1.Mana = {R}
? Bot1.Life = 19

[Expect]
Bot1.Life = 19
