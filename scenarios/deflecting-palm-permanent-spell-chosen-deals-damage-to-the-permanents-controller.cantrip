# Deflecting Palm (CR 609.7a, 615.5): Bot1 chooses its own Snapcaster Mage spell; it resolves; Bot2 steals it with Act of
# Treason and attacks Bot1. The permanent the spell became deals the damage; its controller, Bot2, is dealt the 2.

[Bot1 Deck]
Mox Ruby
Mox Pearl
Mox Sapphire
Mox Jet
Snapcaster Mage
Deflecting Palm
Island x25

[Bot2 Deck]
Mountain
Mox Jet
Mox Sapphire
Act of Treason
Island x25

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Mox Jet.Cast
Bot2.Pass
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Snapcaster Mage.Cast
Bot1.Choose(Close mana window)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Deflecting Palm.Cast
Bot1.Pass
Bot2.Pass
Bot1.Choose(Stack.Snapcaster Mage)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Snapcaster Mage.Tapped = false
Bot1.Pass
Bot2.Pass
Bot2.Hand.Mox Sapphire.Cast
Bot2.Pass
Bot1.Pass
Bot2.Battlefield.Mountain.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.Act of Treason.Cast(Bot1.Battlefield.Snapcaster Mage)
Bot2.Pass
Bot1.Pass
? Bot2.Battlefield.Snapcaster Mage.Tapped = false
[T2 Bot2.DeclareAttackers]
Bot2.Attack(Snapcaster Mage > Bot1)
[T2 Bot2.Main2]

[Expect]
Bot1.Life = 20
Bot2.Life = 18
Prevented = 2 Snapcaster Mage > Bot1 by Deflecting Palm
