# Dandân cannot attack an opponent without an Island, but can once that opponent controls one; Memnite is a positive control (CR 508.1c).
[Bot1 Deck]
Dandân
Island
Mox Sapphire
Memnite
Island x20
[Bot2 Deck]
Mountain
Island
Mountain x20
[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Memnite.Cast
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Dandân.Cast
? Bot1.Mana =
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
[T3 Bot1.Attackers]
! Bot1.Attack(Dandân > Bot2)
Bot1.Attack(Memnite > Bot2)
[T4 Bot2.Main1]
Bot2.Hand.Island.Play
[T5 Bot1.Attackers]
Bot1.Attack(Dandân > Bot2)
[T5 Bot1.Main2]
[Expect]
Bot2.Life = 15
Bot1.Battlefield.Dandân.Power = 4
