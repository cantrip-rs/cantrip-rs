Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Unscrupulous Contractor.Cast
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
! Bot1.Choose(Unscrupulous Contractor; Memnite)
Bot1.Choose(Memnite)
Bot1.Target(Bot2)
? Bot1.Graveyard = Memnite
? Bot2.Life = 20
Bot1.Pass
Bot2.Pass

