# False Orders removes a blocker, unblocking its original attacker, then assigns it to another attacker (CR 509.1h).
[Bot1 Deck]
Mox Ruby
False Orders
Memnite
Ornithopter
Island x20
[Bot2 Deck]
Memnite
Island x20
[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Memnite.Cast
Bot1.Hand.Ornithopter.Cast
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Memnite > Bot2; Ornithopter > Bot2)
Bot2.Block(Memnite > Memnite)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.False Orders.Cast(Bot2.Battlefield.Memnite)
? Bot1.Mana =
Bot1.Accept
Bot1.Target(Ornithopter)
[T3 Bot1.Main2]
[Expect]
Bot2.Life = 19
Bot1.Battlefield.Ornithopter.Damage = 1
