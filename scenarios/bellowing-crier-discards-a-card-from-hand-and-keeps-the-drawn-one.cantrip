# Same trigger, but the discard is a card that was already in hand: the drawn Forest stays. Nothing but the trigger moves
# cards, so the hand is still four cards and the graveyard holds only the discarded Island (the Moxen are on the battlefield).

[Bot1 Deck]
Bellowing Crier
Mox Sapphire
Mox Pearl
Island x4
Forest
Plains x13

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Bellowing Crier.Cast
Bot1.Pass
Bot2.Pass
Bot1.Choose(Island)

[Expect]
Bot1.Graveyard = Island
Bot1.Hand = Forest; Island; Island; Island
Bot1.Library.Count = 13
Bot2.Hand.Count = 7
Bot2.Graveyard.Count = 0
