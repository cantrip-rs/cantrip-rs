# Web-slinging returns "a tapped creature you control" (CR 702.188a), judged as the cost is paid. Bot1 web-slings
# Spider-Sense at Bot2's Lightning Bolt and taps Birds of Paradise for the {U}; its Ornithopter is still untapped then, so
# it is not among the creatures it may return, and the Birds, tapped for the mana, is returned instead.

[Bot1 Deck]
Forest
Birds of Paradise
Ornithopter
Spider-Sense
Forest x16

[Bot2 Deck]
Mountain
Lightning Bolt
Mountain x18

[Actions]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Birds of Paradise.Cast
Bot1.Hand.Ornithopter.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
[T3 Bot1.Main1]
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1)
Bot1.Hand.Spider-Sense.Cast(Stack.Lightning Bolt; Ability: Web-slinging)
Bot1.Battlefield.Birds of Paradise.Activate(Color: Blue)
! Bot1.Choose(Ornithopter)
Bot1.Choose(Pay mana)
Bot1.Choose(Birds of Paradise)
[T3 Bot1.Main2]

[Expect]
Turn = 3
Stack.Count = 0
Bot1.Life = 20
Bot1.Battlefield = Forest; Ornithopter
Bot1.Battlefield.Ornithopter.Tapped = false
Bot1.Graveyard = Spider-Sense
Bot2.Graveyard = Lightning Bolt
