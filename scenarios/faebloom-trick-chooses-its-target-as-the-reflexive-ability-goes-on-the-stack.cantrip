# No target is chosen when Faebloom Trick is cast (ruling): the tap is a reflexive ability that picks its target as it goes on
# the stack. Bot2 controls no creature when the Trick is cast, yet flashes in Hired Blade in response; after the Faeries
# are created the Blade is the only creature an opponent controls, so it is the one tapped. (Chosen at cast, there would
# have been no target, and the Blade would stay untapped.)

[Bot1 Deck]
Mox Sapphire
Mox Ruby
Mox Pearl
Faebloom Trick
Island x3
Island x13

[Bot2 Deck]
Swamp
Mox Jet
Mox Ruby
Hired Blade
Swamp x12

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
[T2 Bot2.Main1]
Bot2.Hand.Swamp.Play
Bot2.Hand.Mox Jet.Cast
Bot2.Hand.Mox Ruby.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Faebloom Trick.Cast
Bot2.Battlefield.Swamp.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Hired Blade.Cast
[T3 Bot1.Main2]

[Expect]
Bot2.Battlefield = Swamp; Mox Jet; Mox Ruby; Hired Blade
Bot2.Battlefield.Hired Blade.Tapped = true
Bot1.Battlefield = Mox Sapphire; Mox Ruby; Mox Pearl; Faerie Token; Faerie Token
Bot1.Graveyard = Faebloom Trick
Stack.Count = 0
