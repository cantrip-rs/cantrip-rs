# {3}{B}, {T}: Create a 1/1 colorless Spirit creature token with "This token can't block or be blocked by non-Spirit
# creatures." Bot1 pays {3}{B} with its Swamp and three Moxes and taps the Realm itself (the Realm entered untapped
# beside the Swamp). The token is a colorless 1/1 Spirit. On turn 5 it attacks with Embereth Shieldbreaker: Bot2's
# Ornithopter cannot block the Spirit (CR 509.1b) but can block the Shieldbreaker (the positive control, and it dies to
# the Shieldbreaker's 2 damage); the unblocked Spirit deals 1.

[Bot1 Deck]
Swamp
Mox Jet
Mox Ruby
Mox Pearl
Mox Emerald
Embereth Shieldbreaker
Realm of Koh
Island x20

[Bot2 Deck]
Ornithopter
Island x20

[Actions]
Bot1.Hand.Swamp.Play
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Embereth Shieldbreaker.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Hand.Realm of Koh.Play
Bot1.Battlefield.Realm of Koh.Activate(Ability: Create)
Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Emerald.Activate
[T3 Bot1.Main2]
? Bot1.Battlefield.Spirit Token.Token = true
? Bot1.Battlefield.Spirit Token.Power = 1
? Bot1.Battlefield.Spirit Token.Toughness = 1
? Bot1.Battlefield.Spirit Token.Subtypes = Spirit
? Bot1.Battlefield.Spirit Token.Colors = (absent)
? Bot1.Battlefield.Realm of Koh.Tapped = true
[T5 Bot1.Main1]
Bot1.Attack(Spirit Token; Embereth Shieldbreaker > Bot2)
! Bot2.Block(Ornithopter > Spirit Token)
Bot2.Block(Ornithopter > Embereth Shieldbreaker)
[T5 Bot1.Main2]

[Expect]
Bot2.Life = 19
Bot2.Battlefield.Count = 0
Bot1.Battlefield.Spirit Token.Token = true
Bot1.Battlefield.Embereth Shieldbreaker.Damage = 0
