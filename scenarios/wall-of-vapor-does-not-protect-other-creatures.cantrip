[T4 Bot2.DeclareAttackers]
Bot2.Attack(Prodigal Sorcerer > Bot1)
Bot1.Block(Wall of Vapor > Prodigal Sorcerer)
Bot2.Battlefield.Quirion Ranger.Activate(Bot2.Battlefield.Prodigal Sorcerer)
Bot2.Choose(Forest)
Bot2.Pass
Bot1.Pass
Bot2.Battlefield.Prodigal Sorcerer.Activate(Bot1.Battlefield.Memnite)
Bot2.Pass
Bot1.Pass
