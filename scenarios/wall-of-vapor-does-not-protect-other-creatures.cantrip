[T4 Bot2.Main2]
[Expect]
Bot1.Battlefield.Wall of Vapor.Damage = 0
Bot1.Graveyard = Memnite
Prevented = 1 Prodigal Sorcerer > Wall of Vapor by Wall of Vapor
