# Enchant only an artifact. Activating its tap ability triggers once, and tapping it with Skateboard triggers again.

[Bot1 Deck]
Mox Jet
Mox Pearl
Mox Sapphire
Artifact Possession
Skateboard
Swamp x15

[Bot2 Deck]
Mox Ruby
Island x19

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Island.Play
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
! Bot1.Hand.Artifact Possession.Cast(Bot2.Battlefield.Island)
Bot1.Hand.Artifact Possession.Cast(Bot2.Battlefield.Mox Ruby)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
? Attached = Artifact Possession > Mox Ruby
[T4 Bot2.Main1]
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Pass
Bot1.Pass
? Bot2.Life = 18
[T7 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Skateboard.Cast
Bot1.Target(Bot2.Battlefield.Mox Ruby)
Bot1.Pass
Bot2.Pass
[T7 Bot1.Main2]

[Expect]
Bot2.Life = 16
Bot1.Life = 20
