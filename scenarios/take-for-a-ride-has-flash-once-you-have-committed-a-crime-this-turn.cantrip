# Take for a Ride (CR 702.8a, 700.13): on Bot2's turn Bot1 can't cast it, as a sorcery, until it has committed a crime; Lightning Bolt aimed at Bot2's face is one, and then
# Take for a Ride steals Bot2's Memnite at instant speed. It is untapped, has haste and is Bot1's, and goes back to Bot2 at the end of the turn.

[Bot1 Deck]
Mox Ruby
Mox Jet
Mox Pearl
Mox Sapphire
Mox Ruby
Lightning Bolt
Take for a Ride
Island x13

[Bot2 Deck]
Memnite
Island x19

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
? Bot2.Battlefield.Memnite.Types = Artifact; Creature
! Bot1.Hand.Take for a Ride.Cast(Bot2.Battlefield.Memnite)
Bot1.Battlefield.Mox Ruby#1.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot1.Battlefield.Mox Ruby#2.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Take for a Ride.Cast(Bot2.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Memnite.Power = 1
? Bot1.Battlefield.Memnite.Keywords = Haste
? Bot2.Battlefield.Count = 0
? Bot1.Battlefield.Count = 6
[T3 Bot1.Main1]
? Bot2.Battlefield.Count = 1
? Bot1.Battlefield.Count = 5

[Expect]
Bot2.Battlefield.Memnite.Types = Artifact; Creature
