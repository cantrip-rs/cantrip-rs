# Flood costs two blue to tap either player's creature without flying;
# a flyer and a noncreature permanent are not legal targets (CR 115.1c, 701.26a).
[Bot1 Deck]
Flood
Mox Sapphire
Mox Sapphire
Mox Ruby
Memnite
Ornithopter
Island x20
[Bot2 Deck]
Memnite
Ornithopter
Island x20
[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Memnite.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Flood.Cast
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Ruby.Activate
! Bot1.Battlefield.Flood.Activate(Bot1.Battlefield.Memnite; Mana: short)
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Sapphire#2.Activate
? Bot1.Mana = {U}{R}
! Bot1.Battlefield.Flood.Activate(Bot1.Battlefield.Memnite; Mana: short)
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire#1.Activate
Bot1.Battlefield.Mox Sapphire#2.Activate
! Bot1.Battlefield.Flood.Activate(Bot2.Battlefield.Ornithopter)
! Bot1.Battlefield.Flood.Activate(Bot1.Battlefield.Mox Ruby)
Bot1.Battlefield.Flood.Activate(Bot1.Battlefield.Memnite)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Memnite.Tapped = true
[T5 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire#1.Activate
Bot1.Battlefield.Mox Sapphire#2.Activate
Bot1.Battlefield.Flood.Activate(Bot2.Battlefield.Memnite)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
[Expect]
Bot2.Battlefield.Memnite.Tapped = true
Bot2.Battlefield.Ornithopter.Tapped = false
Bot1.Battlefield.Flood.Tapped = false
