# The choice is made as the ability resolves (CR 608.2d), and a target that is no longer legal gets nothing (CR 608.2b). Turn 3
# beginning of combat: the ability targets the lone Mouse; Bot2 Lightning Bolts it in response (the Mouse is a 1/2) and it dies. The
# ability then does nothing and Bot1 is not asked to choose a keyword: the game moves on with an empty stack and no question left.

[Bot1 Deck]
Mox Ruby
Mox Jet
Manifold Mouse
Mountain x14

[Bot2 Deck]
Mox Ruby
Lightning Bolt
Mountain x13

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Manifold Mouse.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
[T3 Bot1.BeginCombat]
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Manifold Mouse)
Bot1.Pass
Bot2.Pass
? Bot1.Graveyard = Manifold Mouse
Bot1.Pass
Bot2.Pass
? Stack.Count = 0
[T3 Bot1.Main2]

[Expect]
Bot1.Graveyard = Manifold Mouse
Stack.Count = 0
