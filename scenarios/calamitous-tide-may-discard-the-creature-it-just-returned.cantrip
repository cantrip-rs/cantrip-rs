# Calamitous Tide returns a creature only Bot1 owns and the discard follows the return (CR 608.2c): the Memnite just returned is
# in Bot1's hand when the discard is chosen, so it may be the card discarded - sent to the graveyard, not back to the battlefield.
# One target of "up to two" is enough. Refusal: a Mox is not a creature, so it is no target.

[Bot1 Deck]
Black Lotus
Mox Sapphire
Mox Ruby
Mox Jet
Memnite
Calamitous Tide
Island
Forest
Plains
Mountain
Island x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Memnite.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Calamitous Tide.Cast
! Bot1.Target(Bot1.Battlefield.Mox Jet)
Bot1.Target(Bot1.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
Bot1.Choose(Memnite)

[Expect]
Bot1.Hand = Forest; Plains; Mountain
Bot1.Graveyard = Calamitous Tide; Memnite; Black Lotus
Bot1.Battlefield = Island; Mox Sapphire; Mox Ruby; Mox Jet
