# Star Charter: "if you gained or lost life this turn" is an intervening "if" (CR 603.4). Bot1's life does not change on its turn (Bot2's
# Lightning Bolt that hit Bot1 was on Bot2's own turn), so the ability does not trigger and Bot1 is asked nothing at its end step.

[Bot1 Deck]
Black Lotus
Mox Pearl
Star Charter
Plains x17

[Bot2 Deck]
Mox Ruby
Lightning Bolt
Island x18

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Star Charter.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1)
[T3 Bot1.End]
Bot1.Pass
! Bot1.Arrange
[T4 Bot2.Main1]

[Expect]
Bot1.Life = 17
