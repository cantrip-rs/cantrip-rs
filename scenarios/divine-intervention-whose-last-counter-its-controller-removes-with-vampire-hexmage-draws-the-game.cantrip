Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Vampire Hexmage.Cast
Bot1.Pass
? Bot1.Battlefield.Divine Intervention.Counters.Intervention = 1
? Result = InProgress
Bot1.Battlefield.Vampire Hexmage.Activate(Bot1.Battlefield.Divine Intervention)

[Expect]
Result = Draw
DrawReason = Effect
Turn = 3
Step = Main1
Bot1.Battlefield.Divine Intervention.Counters.Intervention = (absent)
Bot1.Graveyard = Vampire Hexmage; Black Lotus
Bot1.Status = (absent)
