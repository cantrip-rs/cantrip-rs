Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield.Treasure Token.Token = true
Bot1.Battlefield.Treasure Token.Types = Artifact
Bot1.Hand = Forest; Memnite; Memnite; Memnite
Bot1.Graveyard.Count = 5
Bot1.Library.Top = Island
