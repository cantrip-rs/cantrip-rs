# Friendly Teddy: "When this creature dies, each player draws a card." Bot2's library ran out with its turn-two draw; when its
# Lightning Bolt kills the Teddy, Bot2 is made to draw from an empty library and loses the next time state-based actions are
# checked (CR 121.4, 704.5b), while Bot1 draws its Ornithopter.

[Bot1 Deck]
Mox Ruby
Mox Jet
Friendly Teddy
Plains x4
Ornithopter
Plains x12

[Bot2 Deck]
Mox Ruby
Lightning Bolt
Swamp x6

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Friendly Teddy.Cast
[T2 Bot2.Main1]
? Bot2.Library.Count = 0
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Friendly Teddy)
Bot1.Pass
Bot2.Pass

[Expect]
Result = Bot1 won
Bot2.LostTo = EmptyLibrary
Bot1.Hand = Plains; Plains; Plains; Plains; Ornithopter
