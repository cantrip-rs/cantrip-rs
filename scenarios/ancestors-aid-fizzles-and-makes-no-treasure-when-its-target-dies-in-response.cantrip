# Ancestors' Aid with its one target gone: Bot2 kills its own Ornithopter in response with Lightning Bolt, so the spell does not resolve
# and none of its effects happen, the Treasure included (CR 608.2b, the ruling).

[Bot1 Deck]
Ancestors' Aid
Mox Ruby
Mountain x20

[Bot2 Deck]
Ornithopter
Mox Ruby
Lightning Bolt
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Ancestors' Aid.Cast(Bot2.Battlefield.Ornithopter)
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Pass

[Expect]
Bot1.Battlefield.Treasure Token = (absent)
Bot2.Battlefield.Ornithopter = (absent)
Bot1.Graveyard = Ancestors' Aid
