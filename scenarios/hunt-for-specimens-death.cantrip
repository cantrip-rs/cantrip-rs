# A Pest's death triggers its controller to gain exactly 1 life (CR 603.6c, 119.3).
[Bot1 Deck]
Mox Jet
Mox Ruby
Island
Hunt for Specimens
Shock
Island x20
[Bot2 Deck]
Island x20
[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Hunt for Specimens.Cast
Bot1.Choose(Close mana window)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
Bot1.Choose(Island)
? Bot1.Battlefield.Pest Token.Power = 1
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Shock.Cast(Bot1.Battlefield.Pest Token)
Bot1.Pass
[Expect]
Bot1.Life = 21
Bot2.Life = 20
Bot1.Battlefield.Pest Token = (absent)
