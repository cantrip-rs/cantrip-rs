Bot2.Hand.Jeweled Amulet.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Jeweled Amulet.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Territory Forge.Cast
Bot1.Pass
Bot2.Pass
Bot1.Target(Jeweled Amulet#1)
Bot1.Target(Jeweled Amulet#2)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
? Exile = Jeweled Amulet; Jeweled Amulet
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Territory Forge.Activate(Ability: #2)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Territory Forge.Counters.Charge = 1
