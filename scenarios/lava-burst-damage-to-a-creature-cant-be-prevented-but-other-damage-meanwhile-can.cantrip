# Lava Burst's damage to a creature can't be prevented (its ruling; CR 615.12), and only Lava Burst's. Bot1 casts Lava Burst
# with X 1 at Bot2's Ornithopter, a 0/2, paying exactly {1}{R}. Bot2 answers with Healing Salve's "prevent the next 3 damage"
# on the Ornithopter; with Lava Burst still on the stack, Bot1's Lightning Bolt at the Ornithopter is prevented in full by it,
# so the rule is about Lava Burst's damage alone. Bot2 then shields the Ornithopter again with a second Healing Salve, and Lava
# Burst is dealt anyway: 1 damage marked - one more would kill the Ornithopter, one less leave it unhurt.

[Bot1 Deck]
Mox Ruby
Mox Ruby
Mox Jet
Lava Burst
Lightning Bolt
Island x10

[Bot2 Deck]
Mox Pearl
Mox Pearl
Ornithopter
Healing Salve
Healing Salve
Island x12

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Pearl.Cast
Bot2.Hand.Mox Pearl.Cast
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby#1.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Lava Burst.Cast(Bot2.Battlefield.Ornithopter; X: 1)
Bot1.Pass
? Bot1.Mana =
Bot2.Battlefield.Mox Pearl#1.Activate
Bot2.Hand.Healing Salve.Cast
Bot2.Modes(Prevent the next 3 damage)
Bot2.Target(Bot2.Battlefield.Ornithopter)
Bot2.Pass
Bot1.Pass
? Stack.Count = 1
Bot1.Battlefield.Mox Ruby#2.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
? Stack.Count = 1
? Bot2.Battlefield.Ornithopter.Damage = 0
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Hand.Healing Salve.Cast
Bot2.Modes(Prevent the next 3 damage)
Bot2.Target(Bot2.Battlefield.Ornithopter)
Bot2.Pass
Bot1.Pass
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]

[Expect]
Bot2.Battlefield.Ornithopter.Damage = 1
Bot2.Graveyard = Healing Salve; Healing Salve
Bot1.Graveyard = Lava Burst; Lightning Bolt
