# Fractal Anomaly counts cards drawn this turn, and the draw step's is one: on turn 3 Bot1 casts it with only that draw behind
# it, so the 0/0 Fractal token gets one +1/+1 counter and survives as a 1/1 (CR 704.5f is not met), where on turn 1, on the play,
# it would have died with none.

[Bot1 Deck]
Mox Sapphire
Fractal Anomaly
Island
Island
Island
Island
Island x15

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Fractal Anomaly.Cast
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield.Fractal Token.Power = 1
Bot1.Battlefield.Fractal Token.Toughness = 1
