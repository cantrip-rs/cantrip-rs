# Secret Invasion's trigger exiles "until this Aura leaves the battlefield": if the Aura is gone before the trigger resolves,
# nothing is exiled (CR 610.3b) and nothing becomes a copy of anything. Bot2 answers the trigger, aimed at its Grizzly Bears,
# with Disenchant on the Aura: when the trigger resolves the Bears are still on Bot2's battlefield and Bot1's Ornithopter is
# still an Ornithopter.

[Bot1 Deck]
Ornithopter
Black Lotus
Secret Invasion
Island x4
Island x14

[Bot2 Deck]
Forest
Mox Jet
Mox Pearl
Mox Ruby
Grizzly Bears
Disenchant
Island x2
Island x13

[Actions]
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Hand.Mox Jet.Cast
Bot2.Pass
Bot2.Hand.Mox Pearl.Cast
Bot2.Pass
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Battlefield.Forest.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Grizzly Bears.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Secret Invasion.Cast(Bot1.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
Bot1.Target(Bot2.Battlefield.Grizzly Bears)
Bot1.Pass
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Disenchant.Cast(Bot1.Battlefield.Secret Invasion)
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Pass

[Expect]
Exile.Count = 0
Bot2.Battlefield.Grizzly Bears.Power = 2
Bot1.Battlefield.Ornithopter.Power = 0
Bot1.Graveyard = Secret Invasion; Black Lotus
