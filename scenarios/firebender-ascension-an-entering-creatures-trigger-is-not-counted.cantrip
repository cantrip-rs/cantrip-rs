Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Firebender Ascension.Cast
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
