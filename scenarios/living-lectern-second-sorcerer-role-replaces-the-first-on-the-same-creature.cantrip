# Two Living Lecterns each give the Ornithopter a Sorcerer Role. A creature can't be enchanted by two Roles controlled by the
# same player (CR 303.7): when the second Role enters the first is put into the graveyard as a state-based action (CR 704.5y),
# so the Ornithopter is a 1/3, not a 2/4, and one Sorcerer is left on the battlefield.

[Bot1 Deck]
Mox Sapphire
Mox Ruby
Mox Jet
Living Lectern
Living Lectern
Ornithopter
Island
Island x14

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Living Lectern.Cast
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Living Lectern.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Living Lectern.Activate(Bot1.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Ornithopter.Power = 1
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Living Lectern.Activate(Bot1.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Ornithopter.Power = 1
? Bot1.Battlefield.Ornithopter.Toughness = 3
? Bot1.Battlefield.Sorcerer.AttachedTo = Ornithopter
Bot1.Pass

[Expect]
Bot1.Graveyard = Living Lectern; Living Lectern
