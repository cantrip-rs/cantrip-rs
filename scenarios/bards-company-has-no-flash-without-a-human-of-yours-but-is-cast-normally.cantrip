# Bard's Company: the permission to cast it as though it had flash needs a Human the caster controls. Bot2 controls an Eager Cadet (a
# Human) but Bot1 controls no Human - an Ornithopter is no Human - so at the end of Bot2's turn 2 Bot1, with the mana for it, may not
# cast the Company (refused). On Bot1's own turn 3 it casts it at sorcery speed all the same, and recruits.

[Bot1 Deck]
Mox Pearl
Mox Sapphire
Mox Jet
Mox Ruby
Bard's Company
Ornithopter
Plains
Plains
Ornithopter
Plains x10

[Bot2 Deck]
Plains
Eager Cadet
Island x20

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Plains.Play
Bot2.Battlefield.Plains.Activate
Bot2.Hand.Eager Cadet.Cast
Bot2.Pass
Bot1.Pass
[T2 Bot2.End]
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
! Bot1.Hand.Bard's Company.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Bard's Company.Cast
Bot1.Pass
Bot2.Pass
Bot1.Choose(Ornithopter)
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield.Bard's Company.Power = 2
Bot1.Battlefield.Human Soldier Token.Power = 2
Bot1.Battlefield.Ornithopter.Power = 1
Bot1.Graveyard = Ornithopter
