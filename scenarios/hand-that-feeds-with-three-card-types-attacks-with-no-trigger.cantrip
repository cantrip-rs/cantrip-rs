? Bot1.Graveyard.Count = 3
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Hand That Feeds > Bot2)
? Stack.Count = 0
Bot2.Block(Ornithopter > Hand That Feeds)
[T3 Bot1.Main2]

