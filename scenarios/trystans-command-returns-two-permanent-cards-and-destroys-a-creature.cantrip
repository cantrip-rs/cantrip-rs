Bot1.Modes(2; 3)
! Bot1.Target(Bot2.Graveyard.Lightning Bolt)
Bot1.Target(Bot1.Graveyard.Black Lotus; Bot1.Graveyard.Llanowar Elves)
Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot2.Pass

