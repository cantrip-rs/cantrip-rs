# Season of Loss with {P} three times and {P}{P} (five pawprints, CR 700.2d, 700.2i): the chosen modes run in printed order,
# so each player sacrifices a creature of their choice three times over - the opponent all three of theirs, its caster both
# Memnites and then nothing - and only then does {P}{P} count the creatures that died under its caster's control this
# turn: two, so two cards drawn. The opponent's three are not counted.

[Bot1 Deck]
Swamp
Swamp
Black Lotus
Season of Loss
Memnite
Memnite
Island
Island x20

[Bot2 Deck]
Mountain
Black Lotus
Hill Giant
Memnite
Ornithopter
Island x20

[Actions]
Bot1.Hand.Swamp.Play
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot1.Hand.Memnite.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Black Lotus.Cast
Bot2.Battlefield.Black Lotus.Activate(Color: Red)
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Hill Giant.Cast
Bot2.Pass
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
[T3 Bot1.Main1]
? Bot2.Battlefield = Mountain; Hill Giant; Memnite; Ornithopter
Bot1.Hand.Swamp.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Battlefield.Swamp#1.Activate
Bot1.Battlefield.Swamp#2.Activate
Bot1.Hand.Season of Loss.Cast
! Bot1.Modes(2; 2; 2)
Bot1.Modes(1; 1; 1; 2)
Bot1.Pass
[T3 Bot1.Main2]
? Bot1.Battlefield = Swamp; Swamp
? Bot2.Battlefield = Mountain
? Bot1.Hand.Count = 4

[Expect]
Bot1.Graveyard = Season of Loss; Memnite; Memnite; Black Lotus
Bot2.Graveyard.Count = 4
