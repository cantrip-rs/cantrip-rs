Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Hand.Lingering Tormentor.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Lingering Tormentor)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Lingering Tormentor.Counters.MinusOneMinusOne = 1
? Bot1.Battlefield.Lingering Tormentor.Power = 1
? Bot1.Battlefield.Lingering Tormentor.Toughness = 1
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Lingering Tormentor)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass

[Expect]
Stack.Count = 0
Bot1.Battlefield.Lingering Tormentor = (absent)
Bot1.Graveyard = Lingering Tormentor; Black Lotus; Black Lotus
Bot2.Graveyard = Lightning Bolt; Lightning Bolt
