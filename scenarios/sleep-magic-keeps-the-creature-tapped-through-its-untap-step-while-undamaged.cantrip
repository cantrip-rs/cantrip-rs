# Sleep Magic {U}: the enchanted creature is tapped as the Aura enters and "doesn't untap during its controller's untap step". Bot1 puts it on Bot2's Ravenhill
# Flock on turn 5 and Shocks its own Memnite, not the Flock: no damage is dealt to the enchanted creature, so the Aura stays and the Flock is still tapped after
# Bot2's turn-6 untap step.

[Bot1 Deck]
Mox Sapphire
Mox Ruby
Sleep Magic
Shock
Memnite
Island x20

[Bot2 Deck]
Mox Ruby
Mox Emerald
Mox Jet
Mox Sapphire
Ravenhill Flock
Island x20

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Hand.Mox Emerald.Cast
Bot2.Pass
Bot2.Hand.Mox Jet.Cast
Bot2.Pass
Bot2.Hand.Mox Sapphire.Cast
Bot2.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.Ravenhill Flock.Cast
Bot2.Pass
Bot1.Pass
[T5 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Sleep Magic.Cast(Bot2.Battlefield.Ravenhill Flock)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Shock.Cast(Bot1.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
[T6 Bot2.Main1]
? Bot2.Battlefield.Ravenhill Flock.Tapped = true

[Expect]
Bot2.Battlefield.Ravenhill Flock.Tapped = true
Bot1.Graveyard = Memnite; Shock
Bot1.Battlefield.Sleep Magic.Types = Enchantment
