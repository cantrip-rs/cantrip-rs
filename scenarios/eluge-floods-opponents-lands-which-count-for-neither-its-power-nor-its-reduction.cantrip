Bot1.Battlefield.Eluge, the Shoreless Sea.Power = 2
Bot1.Battlefield.Eluge, the Shoreless Sea.Toughness = 2
Bot2.Battlefield.Mountain#1.Subtypes = Island; Mountain
Bot2.Battlefield.Mountain#2.Subtypes = Island; Mountain
Bot2.Battlefield.Mountain#2.Counters.Flood = 1
Bot2.Life = 18
Bot1.Graveyard = Opt; Black Lotus
Bot2.Graveyard = Mana Leak
