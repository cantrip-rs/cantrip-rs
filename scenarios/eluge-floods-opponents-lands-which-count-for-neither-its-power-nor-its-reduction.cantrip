Bot1.Hand.Island.Play
Bot1.Hand.Black Lotus.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Island#1.Activate
Bot1.Hand.Eluge, the Shoreless Sea.Cast
Bot1.Pass
Bot2.Pass
Bot1.Target(Bot2.Battlefield.Mountain)
Bot1.Pass
Bot2.Pass
? Bot2.Battlefield.Mountain.Subtypes = Island; Mountain
[T4 Bot2.Main1]
Bot2.Hand.Mountain.Play
[T5 Bot1.DeclareAttackers]
Bot1.Attack(Eluge, the Shoreless Sea > Bot2)
Bot1.Target(Bot2.Battlefield.Mountain#2)
[T5 Bot1.Main2]
? Bot2.Life = 18
Bot1.Battlefield.Island#1.Activate
Bot1.Hand.Opt.Cast
Bot1.Choose(Close mana window)
? Bot1.Mana =
Bot1.Pass
Bot2.Battlefield.Mountain#1.Activate(Ability: {U})
Bot2.Battlefield.Mountain#2.Activate(Ability: {U})
Bot2.Hand.Mana Leak.Cast(Stack.Opt)
? Bot2.Mana =
Bot2.Pass
Bot1.Pass

