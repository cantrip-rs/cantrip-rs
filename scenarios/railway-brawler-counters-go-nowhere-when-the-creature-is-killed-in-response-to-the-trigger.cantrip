? Bot1.Graveyard = Memnite
Bot1.Pass
Bot2.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass

[Expect]
Stack.Count = 0
Bot1.Graveyard = Memnite
Bot2.Graveyard = Lightning Bolt
Bot1.Battlefield.Railway Brawler.Power = 5
Bot1.Battlefield.Railway Brawler.Toughness = 5
Bot1.Battlefield.Ornithopter.Power = 0
Bot1.Battlefield.Ornithopter.Toughness = 2
