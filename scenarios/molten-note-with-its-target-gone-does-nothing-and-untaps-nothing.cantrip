Bot1.Hand.Lightning Bolt.Cast(Hill Giant)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Graveyard = Hill Giant; Black Lotus
Bot1.Battlefield.Llanowar Elves.Tapped = true
Bot1.Graveyard = Molten Note; Lightning Bolt
