# Snow Villiers's power is the number of creatures Bot1 controls, herself included (CR 604.3, the ruling): with Ornithopter
# she is a 2/3, and Bot2's Ornithopter adds nothing. Memnite makes it 3. She attacks for exactly 3 with vigilance
# (CR 702.20b), so she stays untapped. Under Dress Down she
# loses the characteristic-defining ability too (CR 613.1f, 604.3): a 0/3, her printed */3 with * as 0 (CR 208.5).

[Bot1 Deck]
Black Lotus
Snow Villiers
Ornithopter
Memnite
Mox Sapphire
Dress Down
Plains x14

[Bot2 Deck]
Ornithopter
Island x19

[Actions]
Bot1.Hand.Plains.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Hand.Snow Villiers.Cast
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
? Bot1.Battlefield.Snow Villiers.Power = 2
? Bot1.Battlefield.Snow Villiers.Toughness = 3
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Snow Villiers.Power = 3
Bot1.Attack(Snow Villiers > Bot2)
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Plains.Activate
Bot1.Hand.Dress Down.Cast
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Life = 17
Bot1.Battlefield.Snow Villiers.Tapped = False
Bot1.Battlefield.Dress Down.Types = Enchantment
Bot1.Battlefield.Snow Villiers.Power = 0
Bot1.Battlefield.Snow Villiers.Toughness = 3
