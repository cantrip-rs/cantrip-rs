# Two Fishing Poles on the Memnite give it two instances of "{1}, {T}, Tap Fishing Pole: Put a bait counter on Fishing Pole"
# (CR 113.2c). In each, "Fishing Pole" means the Pole that gave it (CR 201.5a, the ruling): activating the second instance taps
# only the second Pole and puts the counter on it; the first stays untapped with none. When the Memnite untaps both Poles
# trigger, and only the second has bait to trade, so one Fish (CR 603.2, 701.26b).

[Bot1 Deck]
Memnite
Mox Jet
Mox Pearl
Mox Ruby
Plains
Fishing Pole
Fishing Pole
Plains x14

[Bot2 Deck]
Plains x20

[Actions]
Bot1.Hand.Memnite.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Plains.Play
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Fishing Pole.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Fishing Pole.Activate(Ability: Equip; Memnite)
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Plains.Activate
Bot1.Hand.Fishing Pole.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Fishing Pole#2.Activate(Ability: Equip; Memnite)
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Memnite.Activate(Ability: #2)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Fishing Pole#2.Counters.Bait = 1
? Bot1.Battlefield.Fishing Pole#2.Tapped = true
? Bot1.Battlefield.Fishing Pole#1.Counters.Bait = (absent)
? Bot1.Battlefield.Fishing Pole#1.Tapped = false
? Bot1.Battlefield.Fish Token = (absent)
[T5 Bot1.Main1]

[Expect]
Bot1.Battlefield.Fishing Pole#1.Counters.Bait = (absent)
Bot1.Battlefield.Fishing Pole#2.Counters.Bait = (absent)
Bot1.Battlefield.Fish Token.Token = true
Bot1.Battlefield.Fish Token#2 = (absent)
