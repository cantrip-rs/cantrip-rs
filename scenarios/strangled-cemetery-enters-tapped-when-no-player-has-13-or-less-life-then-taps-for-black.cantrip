# Strangled Cemetery: "This land enters tapped unless a player has 13 or less life." Both players start at 20 life, so it enters tapped
# (CR 614.1d), untaps on turn 3 and taps for {B} (the first color it prints: the pool check pins it); it makes no
# other color, nor colorless.

[Bot1 Deck]
Strangled Cemetery
Plains x19

[Bot2 Deck]
Plains x20

[Actions]
Bot1.Hand.Strangled Cemetery.Play
? Bot1.Battlefield.Strangled Cemetery.Tapped = true
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main1]
? Bot1.Battlefield.Strangled Cemetery.Tapped = false
! Bot1.Battlefield.Strangled Cemetery.Activate(Color: White)
! Bot1.Battlefield.Strangled Cemetery.Activate(Color: Blue)
! Bot1.Battlefield.Strangled Cemetery.Activate(Color: Red)
! Bot1.Battlefield.Strangled Cemetery.Activate(Color: Colorless)
Bot1.Battlefield.Strangled Cemetery.Activate(Color: Black)
? Bot1.Mana = {B}

[Expect]
Bot1.Life = 20
Bot2.Life = 20
Bot1.Battlefield.Strangled Cemetery.Tapped = true
