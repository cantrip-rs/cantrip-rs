Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot1.Hand.Narset's Reversal.Cast(Stack.Lightning Bolt)
Bot1.Pass
Bot1.Target()
Bot1.Pass
[T1 Bot1.Main2]

[Expect]
Bot2.Life = 17
Bot1.Life = 20
Bot1.Hand.Lightning Bolt.Colors = Red
Bot1.Graveyard = Narset's Reversal; Black Lotus
