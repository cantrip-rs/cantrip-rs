# Surveil 1 may leave the card on top: Bot1 keeps Lightning Bolt, so the graveyard stays empty and the Bolt is the next draw (turn 3).
# "{1}, {T}: Add one mana of any color": with no other mana the colored ability is refused (the Room's own {T} cannot also pay its
# {1}). On turn 3 an Island's {U} pays the {1} and the Room adds {R}: the pool is {R} alone and both lands are tapped.

[Bot1 Deck]
Surveillance Room
Island x6
Lightning Bolt
Island x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Surveillance Room.Play
Bot1.Arrange(Lightning Bolt | )
! Bot1.Battlefield.Surveillance Room.Activate(Ability: any color; Color: Red; Mana: short)
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Surveillance Room.Activate(Ability: any color; Color: Red)
? Bot1.Mana = {R}
[T3 Bot1.Main2]

[Expect]
Bot1.Graveyard.Count = 0
Bot1.Hand = Island; Island; Island; Island; Island; Lightning Bolt
Bot1.Battlefield.Surveillance Room.Tapped = true
Bot1.Battlefield.Island.Tapped = true
