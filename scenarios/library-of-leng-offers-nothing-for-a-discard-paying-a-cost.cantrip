Bot1.Hand.Steamcore Scholar.Cast
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot1.Modes(Discard an instant)
Bot1.Choose(Lightning Bolt)
! Bot1.Accept
? Bot1.Graveyard = Lightning Bolt; Black Lotus
Bot1.Battlefield.Psychic Frog.Activate(Ability: Discard)
Bot1.Choose(Island)
! Bot1.Accept
Bot1.Pass
Bot2.Pass
[T1 Bot1.Main2]

[Expect]
Bot1.Graveyard = Island; Lightning Bolt; Black Lotus
Bot1.Library.Count = 10
Bot1.Hand.Count = 0
Bot1.Battlefield.Psychic Frog.Counters.PlusOnePlusOne = 1
