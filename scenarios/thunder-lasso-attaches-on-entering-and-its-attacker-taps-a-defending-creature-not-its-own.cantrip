# Thunder Lasso ({2}{W}): "When this Equipment enters, attach it to target creature you control" (CR 701.3a): with Memnite and
# Ornithopter both there, Bot1 chooses Memnite, which becomes 2/2 (Ornithopter stays 0/2 and is not attached). "Whenever equipped
# creature attacks, tap target creature defending player controls" (CR 508.5): on turn 3 Memnite attacks, Bot1's own Ornithopter is
# refused as the target (positive control: Bot2's Ornithopter is chosen), Bot2's Memnite stays untapped, and the equipped Memnite
# deals 2.

[Bot1 Deck]
Mox Pearl
Mox Jet
Mox Ruby
Thunder Lasso
Memnite
Ornithopter
Island
Island x13

[Bot2 Deck]
Memnite
Ornithopter
Island x14

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Memnite.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Thunder Lasso.Cast
Bot1.Pass
Bot2.Pass
Bot1.Target(Memnite)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Thunder Lasso.AttachedTo = Memnite
? Bot1.Battlefield.Memnite.Power = 2
? Bot1.Battlefield.Memnite.Toughness = 2
? Bot1.Battlefield.Ornithopter.Toughness = 2
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Attack(Memnite > Bot2)
! Bot1.Target(Bot1.Battlefield.Ornithopter)
Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
[Bot1.Main2]

[Expect]
Bot2.Battlefield.Ornithopter.Tapped = true
Bot2.Battlefield.Memnite.Tapped = false
Bot1.Battlefield.Ornithopter.Tapped = false
Bot2.Life = 18
