# Clammy Prowler: "Whenever this creature attacks, another target attacking creature can't be blocked this turn."
# Bot1 attacks on turn 3 with Clammy Prowler, Memnite and Phyrexian Walker while Ornithopter stays home: the Prowler is not
# a candidate ("another") and Ornithopter is not attacking, so both are refused; Memnite is chosen. Bot2's Memnite may not
# block it (CR 509.1b) but blocks the Walker (the control). On turn 5 Memnite attacks alone and Bot2's Memnite blocks it:
# the effect lasted "this turn" only.

[Bot1 Deck]
Mox Sapphire
Mox Pearl
Mox Jet
Mox Ruby
Clammy Prowler
Memnite
Phyrexian Walker
Ornithopter
Island x10

[Bot2 Deck]
Memnite
Memnite
Island x15

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Clammy Prowler.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Phyrexian Walker.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Clammy Prowler > Bot2; Memnite > Bot2; Phyrexian Walker > Bot2)
! Bot1.Target(Clammy Prowler)
! Bot1.Target(Ornithopter)
Bot1.Target(Memnite)
! Bot2.Block(Memnite > Bot1.Battlefield.Memnite)
Bot2.Block(Memnite > Phyrexian Walker)
[T3 Bot1.Main2]
? Bot2.Life = 17
[T4 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
[T5 Bot1.DeclareAttackers]
Bot1.Attack(Memnite > Bot2)
Bot2.Block(Memnite > Bot1.Battlefield.Memnite)
[T5 Bot1.Main2]

[Expect]
Bot2.Life = 17
Bot1.Battlefield.Memnite = (absent)
