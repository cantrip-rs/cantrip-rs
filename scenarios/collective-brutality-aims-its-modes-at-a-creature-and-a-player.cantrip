# Collective Brutality on turn 3 with two modes, escalated once by discarding Demonic Tutor: -2/-2 at Bot2's Llanowar
# Elves and the drain at Bot2. Each target is aimed at by a different mode, so each carries its own clause.
#
# Handed over while the spell waits on the stack, for picturing the arrows from it: one to the Elves and one to Bot2,
# each labelled with what the spell will do there.

[Bot1 Deck]
Swamp
Swamp
Collective Brutality
Demonic Tutor
Swamp x10

[Bot2 Deck]
Forest
Llanowar Elves
Forest x12

[Actions]
Bot1.Hand.Swamp.Play
Bot2.Hand.Forest.Play
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Llanowar Elves.Cast
[T3 Bot1.Main1]
Bot1.Hand.Swamp.Play
Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Swamp#2.Activate
Bot1.Hand.Collective Brutality.Cast
Bot1.Modes(2; 3)
Bot1.Target(Llanowar Elves)
Bot1.Target(Bot2)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Demonic Tutor)
[Handover Bot1.Pass]

[Expect]
Turn = 3
Stack.Count = 1
Bot1.Graveyard = Demonic Tutor
Bot2.Battlefield = Forest; Llanowar Elves
Bot2.Life = 20
