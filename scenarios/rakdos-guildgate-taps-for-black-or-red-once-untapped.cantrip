# Rakdos Guildgate: once it has untapped it taps for {B} on one turn and {R} on the next (the color is chosen as the ability is
# activated, CR 605.1a), never for another color or for colorless.

[Bot1 Deck]
Rakdos Guildgate
Island x19

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Rakdos Guildgate.Play
[T3 Bot1.Main1]
! Bot1.Battlefield.Rakdos Guildgate.Activate(Color: White)
! Bot1.Battlefield.Rakdos Guildgate.Activate(Color: Colorless)
Bot1.Battlefield.Rakdos Guildgate.Activate(Color: Black)
? Bot1.Mana = {B}
[T5 Bot1.Main1]
Bot1.Battlefield.Rakdos Guildgate.Activate(Color: Red)
? Bot1.Mana = {R}

[Expect]
Bot1.Battlefield.Rakdos Guildgate.Tapped = true
