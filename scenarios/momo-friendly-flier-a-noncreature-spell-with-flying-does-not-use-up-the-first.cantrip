# "Creature spell with flying": Smuggler's Copter ({2}, an artifact with flying that is not a creature spell) is paid in full with Mox Jet and Mox
# Ruby and nothing floats; Faerie Mastermind is then still the first, paid with Mox Sapphire alone. Momo does not grow for the Copter: it is
# not a creature (Momo is 2/2 after Mastermind alone).

[Bot1 Deck]
Mox Pearl
Mox Jet
Mox Ruby
Mox Sapphire
Momo, Friendly Flier
Smuggler's Copter
Faerie Mastermind
Island x14

[Bot2 Deck]
Mountain x20

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Momo, Friendly Flier.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Smuggler's Copter.Cast
Bot1.Choose(Close mana window)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Momo, Friendly Flier.Power = 1
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Faerie Mastermind.Cast
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
[Bot1.Main2]

[Expect]
Bot1.Battlefield.Smuggler's Copter.Types = Artifact
Bot1.Battlefield.Faerie Mastermind.Types = Creature
Bot1.Battlefield.Momo, Friendly Flier.Power = 2
