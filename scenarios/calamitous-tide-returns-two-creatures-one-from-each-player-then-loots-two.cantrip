# Calamitous Tide {4}{U}{U}: "Return up to two target creatures to their owners' hands. Draw two cards, then discard a
# card." Bot1 targets its own Memnite and Bot2's Ornithopter: each goes to its OWNER's hand (CR 400.3) as one event, then Bot1
# draws Plains and Mountain and discards Forest (a card that was already in hand, drawn on turn 3). Black Lotus makes {U}{U}{U},
# the Sapphire, Ruby and Jet the other three.

[Bot1 Deck]
Black Lotus
Mox Sapphire
Mox Ruby
Mox Jet
Memnite
Calamitous Tide
Island
Forest
Plains
Mountain
Island x10

[Bot2 Deck]
Ornithopter
Island x20

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Memnite.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Calamitous Tide.Cast
Bot1.Target(Bot1.Battlefield.Memnite; Bot2.Battlefield.Ornithopter)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
Bot1.Choose(Forest)

[Expect]
Bot1.Hand = Memnite; Plains; Mountain
Bot2.Hand = Ornithopter; Island; Island; Island; Island; Island; Island; Island
Bot1.Battlefield = Island; Mox Sapphire; Mox Ruby; Mox Jet
Bot2.Battlefield.Count = 0
Bot1.Graveyard = Calamitous Tide; Forest; Black Lotus
