Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Immersturm Predator.Cast
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Immersturm Predator.Power = 3
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Battlefield.Island.Activate
Bot2.Hand.Brainstorm.Cast
Bot2.Pass
Bot1.Pass
Bot2.Choose(Island; Island)
? Bot2.Graveyard = Brainstorm
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Immersturm Predator > Bot2)
! Bot1.Target(Bot1.Battlefield.Immersturm Predator)
! Bot1.Target(Bot1.Battlefield.Mountain)
Bot1.Target(Bot2.Graveyard.Brainstorm)
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 16
Bot2.Graveyard = 
