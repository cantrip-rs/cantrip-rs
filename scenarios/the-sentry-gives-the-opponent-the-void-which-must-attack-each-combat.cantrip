Bot2.Battlefield.The Void.Colors = Black
Bot2.Battlefield.The Void.Subtypes = Horror; Villain
Bot2.Battlefield.The Void.Supertypes = Legendary
Bot2.Battlefield.The Void.Keywords = Flying; Indestructible
Bot2.Battlefield.The Void.Token = true
