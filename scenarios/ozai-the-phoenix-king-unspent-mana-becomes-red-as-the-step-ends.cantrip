# Ozai, the Phoenix King: "If you would lose unspent mana, that mana becomes red instead" (CR 106.4, 614.1a). Black Lotus's {U}{U}{U} is
# not lost when the main phase ends: it is {R}{R}{R} in the pool of the controller. Bot2, who has no Ozai, loses its {G} as usual.

[Bot1 Deck]
Mox Ruby x2
Mox Emerald
Black Lotus x3
Ozai, the Phoenix King
Mountain x16

[Bot2 Deck]
Mox Emerald x2
Mountain x20

[Actions]
Bot1.Hand.Mox Ruby#1.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Black Lotus#1.Cast
Bot1.Battlefield.Mox Ruby#1.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Black Lotus#1.Activate(Color: Black)
Bot1.Hand.Ozai, the Phoenix King.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Emerald#1.Cast
Bot2.Battlefield.Mox Emerald#1.Activate
? Bot2.Mana = {G}
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Black Lotus#2.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
? Bot1.Mana = {U}{U}{U}
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Mana = {R}{R}{R}
Bot2.Mana = 
