Bot1.Battlefield = Plains; Plains; Plains; Plains; Spirit Token; Spirit Token
Bot1.Graveyard = Wrath of God; Doomed Traveler; Doomed Traveler
Bot1.Battlefield.Spirit Token#1.Token = true
