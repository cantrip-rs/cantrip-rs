# Once the ability resolves, its shield lasts even if Samite Healer dies; one of Shock's two damage is prevented (CR 611.2a, 615.7).
[Bot1 Deck]
Samite Healer
Mox Pearl
Mox Ruby
Shock
Plains
Plains
Plains x15

[Bot2 Deck]
Mountain
Lightning Bolt
Mountain x20

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Plains.Play
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Plains.Activate
Bot1.Hand.Samite Healer.Cast
Bot1.Choose(Close mana window)
? Bot1.Mana =
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
[T3 Bot1.Main1]
Bot1.Battlefield.Samite Healer.Activate(Bot1)
Bot1.Pass
Bot2.Pass
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Samite Healer)
[T3 Bot1.Main2]
? Bot1.Graveyard = Samite Healer
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Shock.Cast(Bot1)
[T3 Bot1.End]

[Expect]
Bot1.Life = 19
Prevented = 1 Shock > Bot1 by Samite Healer
