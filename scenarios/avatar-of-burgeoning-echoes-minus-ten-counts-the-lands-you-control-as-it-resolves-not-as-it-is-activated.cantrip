# The granted -10 counts "each land you control" as it resolves (CR 608.2h), not when it is activated. Bot1's Jace token has 12
# loyalty on turn 3 (Avatar's landfall twice, Jace's Machinations 8) and Bot1 controls two Islands when it activates the -10 on
# the Avatar. In response Bot2 sacrifices its Strip Mine to destroy one of Bot1's Islands, so only one land is counted and the
# Avatar gets one +1/+1 counter, not two.

[Bot1 Deck]
Mox Emerald
Mox Sapphire
Avatar of Burgeoning Echoes
Island
Black Lotus
Jace's Machinations
Island
Island x20

[Bot2 Deck]
Strip Mine
Island x25

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Avatar of Burgeoning Echoes.Cast
Bot2.Pass
Bot1.Hand.Island.Play
Bot1.Pass
Bot2.Pass
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Jace's Machinations.Cast
Bot2.Pass
? Bot1.Battlefield.Jace Token.Counters.Loyalty = 10
[T2 Bot2.Main1]
Bot2.Hand.Strip Mine.Play
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Jace Token.Counters.Loyalty = 12
Bot1.Battlefield.Jace Token.Activate(Ability: Put a +1/+1 counter; Bot1.Battlefield.Avatar of Burgeoning Echoes)
Bot2.Battlefield.Strip Mine.Activate(Ability: Destroy target land; Bot1.Battlefield.Island#1)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield.Avatar of Burgeoning Echoes.Counters.PlusOnePlusOne = 1
Bot1.Battlefield.Jace Token.Counters.Loyalty = 2
Bot1.Graveyard = Island; Jace's Machinations; Black Lotus
Bot2.Graveyard = Strip Mine
Stack.Count = 0
