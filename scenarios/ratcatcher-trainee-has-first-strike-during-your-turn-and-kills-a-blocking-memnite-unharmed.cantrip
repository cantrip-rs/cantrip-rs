# "During your turn, this creature has first strike" (CR 702.7, 611.3a): on Bot1's turn the 2/1 Trainee attacks and Bot2's Memnite
# (1/1) blocks. First strike deals damage first, so the Memnite dies before it can deal its 1 damage and the Trainee takes none.

[Bot1 Deck]
Mox Ruby
Mox Jet
Ratcatcher Trainee
Mountain x17

[Bot2 Deck]
Memnite
Island x19

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Ratcatcher Trainee.Cast
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
[T3 Bot1.Main1]
? Bot1.Battlefield.Ratcatcher Trainee.Keywords = FirstStrike
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Ratcatcher Trainee > Bot2)
Bot2.Block(Memnite > Ratcatcher Trainee)
[T3 Bot1.Main2]

[Expect]
Bot2.Graveyard = Memnite
Bot1.Battlefield.Ratcatcher Trainee.Damage = 0
Bot2.Life = 20
