# Bot1 casts Hill Giant after combat on turn 3, so Surrak (5) and the Giant (3) are eight total power when Bot2's combat
# begins on turn 4. "On your turn" means it does not trigger then: nothing is on the stack and neither creature has haste.

[Bot1 Deck]
Black Lotus
Surrak, the Hunt Caller
Mox Ruby
Black Lotus
Hill Giant
Forest x15

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Surrak, the Hunt Caller.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Hill Giant.Cast
Bot1.Pass
Bot2.Pass
[T4 Bot2.BeginCombat]
? Stack.Count = 0

[Expect]
Stack.Count = 0
Bot1.Battlefield.Hill Giant.Keywords = (absent)
Bot1.Battlefield.Surrak, the Hunt Caller.Keywords = (absent)
