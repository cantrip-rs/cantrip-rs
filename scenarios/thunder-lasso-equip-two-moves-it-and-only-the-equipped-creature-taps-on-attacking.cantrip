# Thunder Lasso's Equip {2} (CR 702.6): with all three Moxen tapped on turn 1 it cannot be moved (Mana: short). On turn 3 Bot1
# moves it from Memnite (2/2 -> 1/1) to Ornithopter (0/2 -> 1/3) for exactly two (the pool is empty after, Mox Ruby still untapped).
# Both then attack: only the equipped creature triggers "tap target creature defending player controls" - Bot2's Memnite is tapped,
# its Ornithopter is not, though Memnite attacked as well; the Ornithopter deals 1 and the unequipped Memnite 1.

[Bot1 Deck]
Mox Pearl
Mox Jet
Mox Ruby
Thunder Lasso
Memnite
Ornithopter
Island
Island x13

[Bot2 Deck]
Memnite
Ornithopter
Island x14

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Memnite.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Thunder Lasso.Cast
Bot1.Pass
Bot2.Pass
Bot1.Target(Memnite)
Bot1.Pass
Bot2.Pass
! Bot1.Battlefield.Thunder Lasso.Activate(Ornithopter; Mana: short)
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Thunder Lasso.Activate(Ornithopter)
? Bot1.Mana =
? Bot1.Battlefield.Mox Ruby.Tapped = false
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Thunder Lasso.AttachedTo = Ornithopter
? Bot1.Battlefield.Memnite.Power = 1
? Bot1.Battlefield.Memnite.Toughness = 1
? Bot1.Battlefield.Ornithopter.Power = 1
? Bot1.Battlefield.Ornithopter.Toughness = 3
Bot1.Attack(Memnite > Bot2; Ornithopter > Bot2)
Bot1.Target(Bot2.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
[Bot1.Main2]

[Expect]
Bot2.Battlefield.Memnite.Tapped = true
Bot2.Battlefield.Ornithopter.Tapped = false
Bot2.Life = 18
