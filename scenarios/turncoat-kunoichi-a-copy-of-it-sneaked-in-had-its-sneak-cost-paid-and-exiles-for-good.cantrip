Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Ornithopter.Cast
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Elvish Mystic.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Hand.Plains.Play
Bot1.Attack(Ornithopter > Bot2)
[T3 Bot1.DeclareBlockers]
Bot1.Battlefield.Plains#1.Activate
Bot1.Battlefield.Plains#2.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Turncoat Kunoichi.Cast(Ability: Sneak)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Ornithopter)
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Choreographed Sparks.Cast
Bot1.Modes(2)
Bot1.Target(Stack.Turncoat Kunoichi)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Turncoat Kunoichi.Tapped = true
Bot1.Pass
Bot2.Pass
? Bot2.Exile.Elvish Mystic.Power = 1
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Count = 6
[T3 Bot1.End]
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Count = 5
[T4 Bot2.Main1]

[Expect]
Bot2.Exile.Elvish Mystic.Power = 1
Bot2.Battlefield = Forest
