# Sazacap's Brew with the gift promised (CR 702.174): Bot2 creates a tapped 1/1 blue Fish as the spell resolves, Bot1 (the target player) discards a card as the extra cost
# and draws exactly two, and its Ornithopter gets +2/+0 until end of turn (power 2, toughness still 2) - gone on the next turn. Bot2's own Ornithopter is refused as the creature, and so are two of Bot1's
# (Ornithopter and Memnite: the promise makes one target, CR 601.2c); the Memnite is not pumped.

[Bot1 Deck]
Mox Ruby
Mox Jet
Ornithopter
Memnite
Sazacap's Brew
Island x20

[Bot2 Deck]
Ornithopter
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Memnite.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
? Bot1.Hand.Count = 3
Bot1.Hand.Sazacap's Brew.Cast
Bot1.Accept
! Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Target(Bot1)
! Bot1.Target(Bot1.Battlefield.Ornithopter; Bot1.Battlefield.Memnite)
Bot1.Target(Bot1.Battlefield.Ornithopter)
Bot1.Choose(Island)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Ornithopter.Power = 2
? Bot1.Battlefield.Ornithopter.Toughness = 2
? Bot2.Battlefield.Fish Token.Tapped = true
? Bot2.Battlefield.Fish Token.Power = 1
? Bot1.Hand.Count = 3
? Bot1.Battlefield.Memnite.Power = 1
[T3 Bot1.Main1]
? Bot1.Battlefield.Ornithopter.Power = 0

[Expect]
Stack.Count = 0
Bot1.Graveyard = Sazacap's Brew; Island
Bot2.Battlefield = Fish Token; Ornithopter
Bot2.Hand.Count = 7
