# Trample (CR 702.19b): blocked by a Memnite (1/1), the Trufflesnout assigns 1 to it and the other 3 to Bot2, so it has dealt combat damage to a player
# and creates a Food token: Bot2 is at 17 and Memnite is dead.

[Bot1 Deck]
Black Lotus
Eager Trufflesnout
Island x18

[Bot2 Deck]
Memnite
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Hand.Eager Trufflesnout.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Eager Trufflesnout > Bot2)
Bot2.Block(Memnite > Eager Trufflesnout)
[T3 Bot1.CombatDamage]
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]

[Expect]
Stack.Count = 0
Bot2.Life = 17
Bot2.Graveyard = Memnite
Bot1.Battlefield.Food Token.Types = Artifact
