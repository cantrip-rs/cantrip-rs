# Ankh of Mishra deals 2 damage to each entering land's controller (CR 603.2).

[Bot1 Deck]
Mox Ruby
Mox Sapphire
Ankh of Mishra
Mox Emerald
Strip Mine
Island x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Strip Mine.Play
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Ankh of Mishra.Cast
Bot1.Choose(Close mana window)
? Bot1.Mana =
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot1.Battlefield.Strip Mine.Activate(Bot2.Battlefield.Island; Ability: Destroy)
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Pass

[Expect]
Bot1.Life = 18
Bot2.Life = 18
Bot2.Graveyard = Island
