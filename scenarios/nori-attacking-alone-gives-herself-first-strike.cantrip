# Nori, Teller of Tales attacks alone on turn 3: she is an attacking creature, the only one, so the target of "target attacking
# creature gains first strike until end of turn" is herself - nothing is asked - and Bot2's blocking Grizzly Bears (2/2) dies to
# her first-strike damage before it hurts her.

[Bot1 Deck]
Mox Pearl
Mox Ruby
Nori, Teller of Tales
Plains x17

[Bot2 Deck]
Mox Emerald
Grizzly Bears
Forest
Forest x10

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Nori, Teller of Tales.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Emerald.Cast
Bot2.Pass
Bot2.Hand.Forest.Play
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Grizzly Bears.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Attack(Nori, Teller of Tales > Bot2)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Nori, Teller of Tales.Keywords = FirstStrike
Bot2.Block(Grizzly Bears > Nori, Teller of Tales)
[T4 Bot2.Main1]
? Bot1.Battlefield.Nori, Teller of Tales.Keywords = (absent)

[Expect]
Bot2.Graveyard = Grizzly Bears
Bot1.Battlefield.Nori, Teller of Tales.Damage = 0
Bot2.Life = 20
