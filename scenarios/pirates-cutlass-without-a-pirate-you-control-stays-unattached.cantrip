# Pirate's Cutlass: "attach it to target Pirate you control". Bot1 controls only a Memnite (not a Pirate) and Bot2 controls a
# Fanatical Firebrand (a Pirate, but not Bot1's), so the enters trigger has no legal target and is removed from the stack
# (CR 603.3d): the Cutlass stays unattached and the Memnite is still 1/1.

[Bot1 Deck]
Mox Ruby
Mox Jet
Mox Emerald
Memnite
Pirate's Cutlass
Island x15

[Bot2 Deck]
Mox Ruby
Fanatical Firebrand
Island x18

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Fanatical Firebrand.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Pirate's Cutlass.Cast
Bot1.Pass
Bot2.Pass
? Stack.Count = 0

[Expect]
Bot1.Battlefield.Pirate's Cutlass.AttachedTo = (absent)
Bot2.Battlefield.Fanatical Firebrand.Power = 1
Bot1.Battlefield.Memnite.Power = 1
Bot1.Battlefield.Memnite.Toughness = 1
