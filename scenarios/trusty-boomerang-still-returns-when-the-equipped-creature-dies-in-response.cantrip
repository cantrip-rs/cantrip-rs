# CR 113.7a: an activated ability exists on the stack independently of its source. Bot1 activates the Boomerang's granted ability on
# the equipped Memnite; Bot2 kills the Memnite with Lightning Bolt in response. The ability still resolves - it taps Bot2's
# Ornithopter - and "Return Trusty Boomerang to its owner's hand" still finds the Equipment that gave it, which is the same object,
# unattached on the battlefield, so it returns to Bot1's hand.

[Bot1 Deck]
Memnite
Mox Jet
Mox Pearl
Mox Ruby
Trusty Boomerang
Plains x16

[Bot2 Deck]
Ornithopter
Mountain
Lightning Bolt
Plains x17

[Actions]
Bot1.Hand.Memnite.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Trusty Boomerang.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Trusty Boomerang.Activate(Ability: Equip; Memnite)
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Memnite.Activate(Ability: Tap target; Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Memnite)
Bot2.Pass
Bot1.Pass
? Bot1.Battlefield.Memnite = (absent)
? Stack.Count = 1
Bot2.Pass
Bot1.Pass

[Expect]
Stack.Count = 0
Bot2.Battlefield.Ornithopter.Tapped = true
Bot1.Battlefield.Trusty Boomerang = (absent)
Bot1.Hand.Trusty Boomerang.Colors.Count = 0
