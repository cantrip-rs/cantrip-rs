? Bot1.Battlefield.Charity Extractor.Subtypes = Human; Knight
? Bot1.Battlefield.Charity Extractor.Supertypes = (absent)
? Bot1.Battlefield.Charity Extractor.ProtectionFrom = (absent)
[T3 Bot1.Main1]
Bot1.Attack(Charity Extractor > Bot2)
[T3 Bot1.Main2]

