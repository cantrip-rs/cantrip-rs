Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Ancestor Dragon.Power = 5
? Bot1.Battlefield.Ancestor Dragon.Toughness = 6
? Bot1.Battlefield.Ancestor Dragon.Keywords = Flying
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Ancestor Dragon > Bot2; Memnite > Bot2; Ornithopter > Bot2)
? Stack.Count = 1
? Bot1.Life = 20
Bot1.Pass
Bot2.Pass
? Stack.Count = 0
? Bot1.Life = 23
[T3 Bot1.Main2]
? Bot2.Life = 14

[Expect]
Bot1.Life = 23
Bot2.Life = 14
