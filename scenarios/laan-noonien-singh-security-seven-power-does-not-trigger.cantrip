Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Centaur Courser.Cast
Bot1.Pass
Bot2.Pass
[T5 Bot1.Main1]
Bot1.Attack(La'An Noonien-Singh, Security; Centaur Courser > Bot2)
! Bot1.Target
Bot2.Block(Llanowar Elves > Centaur Courser)
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Life = 16
Bot2.Battlefield.Llanowar Elves = (absent)
Bot1.Battlefield.Centaur Courser.Damage = 1
Bot1.Battlefield.Centaur Courser.Toughness = 3
