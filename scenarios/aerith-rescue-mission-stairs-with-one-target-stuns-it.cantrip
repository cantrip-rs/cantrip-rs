# Aerith Rescue Mission, Take 59 Flights of Stairs with a single target: it is the one of them, so it taps and is stunned.

[Bot1 Deck]
Mox Pearl
Mox Jet
Mox Ruby
Mox Sapphire
Aerith Rescue Mission
Island x15

[Bot2 Deck]
Ornithopter x4
Island x16

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Sapphire.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter#1.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Ornithopter#1.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Ornithopter#1.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Aerith Rescue Mission.Cast
Bot1.Modes(Take 59 Flights of Stairs)
Bot1.Target(Ornithopter#1)
Bot1.Pass
Bot2.Pass
Bot1.Choose(Ornithopter#1)

[Expect]
Bot2.Battlefield.Ornithopter#1.Tapped = true
Bot2.Battlefield.Ornithopter#1.Counters.Stun = 1
Bot2.Battlefield.Ornithopter#2.Tapped = false
