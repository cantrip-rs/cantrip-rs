# Armored Griffin, a french vanilla creature: cast with Black Lotus mana, its characteristics as printed (power, toughness,
# keywords, colors, types, protection), then attacking Bot2, who has no creatures.
# Vigilance (CR 702.20b): attacking doesn't tap it.

[Bot1 Deck]
Black Lotus x2
Armored Griffin
Plains x21

[Bot2 Deck]
Island x24

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus#2.Activate(Color: White)
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Hand.Armored Griffin.Cast
Bot1.Pass
[T2 Bot2.End]
? Bot1.Battlefield.Armored Griffin.Power = 2
? Bot1.Battlefield.Armored Griffin.Toughness = 3
? Bot1.Battlefield.Armored Griffin.Keywords = Flying; Vigilance
? Bot1.Battlefield.Armored Griffin.Colors = White
? Bot1.Battlefield.Armored Griffin.Types = Creature
? Bot1.Battlefield.Armored Griffin.Subtypes = Griffin
? Bot1.Battlefield.Armored Griffin.Supertypes = (absent)
? Bot1.Battlefield.Armored Griffin.ProtectionFrom = (absent)
[T3 Bot1.Main1]
Bot1.Attack(Armored Griffin > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 18
Bot1.Battlefield.Armored Griffin.Tapped = false
