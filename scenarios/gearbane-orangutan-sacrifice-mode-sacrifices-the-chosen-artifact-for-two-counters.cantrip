# The second mode: "Sacrifice an artifact. If you do, put two +1/+1 counters on this creature." With a Memnite and Moxen to
# choose from Bot1 sacrifices the Memnite (the choice among several): the Orangutan becomes a 4/4, the Moxen stay, and Bot2's
# Ornithopter is not among the artifacts it may sacrifice, so it stays.

[Bot1 Deck]
Mox Ruby
Mox Pearl
Mox Jet
Gearbane Orangutan
Memnite
Plains x15

[Bot2 Deck]
Ornithopter
Island x19

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Hand.Memnite.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Gearbane Orangutan.Cast
Bot1.Pass
Bot2.Pass
Bot1.Modes(Sacrifice an artifact)
Bot1.Choose(Memnite)
Bot1.Pass
Bot2.Pass
? Bot1.Graveyard = Memnite
? Bot1.Battlefield.Gearbane Orangutan.Counters.PlusOnePlusOne = 2
? Bot1.Battlefield.Gearbane Orangutan.Power = 4
? Bot1.Battlefield.Gearbane Orangutan.Toughness = 4
? Bot2.Battlefield.Ornithopter.Power = 0

[Expect]
Bot1.Battlefield.Count = 4
