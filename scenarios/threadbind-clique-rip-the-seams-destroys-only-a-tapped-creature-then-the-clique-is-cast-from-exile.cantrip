Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Sapphire.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T4 Bot2.Main1]
Bot2.Attack(Ornithopter#1 > Bot1)
Bot2.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
! Bot1.Hand.Threadbind Clique.Cast(Bot2.Battlefield.Ornithopter#2; Ability: Rip the Seams)
Bot1.Hand.Threadbind Clique.Cast(Bot2.Battlefield.Ornithopter#1; Ability: Rip the Seams)
? Stack.Count = 1
Bot1.Pass
Bot2.Pass
? Bot2.Graveyard = Ornithopter
? Exile = Threadbind Clique
[T5 Bot1.Main1]
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Exile.Threadbind Clique.Cast
Bot1.Pass
Bot2.Pass

