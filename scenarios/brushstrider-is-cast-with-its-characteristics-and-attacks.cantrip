# Brushstrider, a french vanilla creature: cast with Black Lotus mana, its characteristics as printed (power, toughness,
# keywords, colors, types, protection), then attacking Bot2, who has no creatures.
# Vigilance (CR 702.20b): attacking doesn't tap it.

[Bot1 Deck]
Black Lotus
Brushstrider
Plains x22

[Bot2 Deck]
Island x24

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Hand.Brushstrider.Cast
Bot1.Pass
[T2 Bot2.End]
? Bot1.Battlefield.Brushstrider.Power = 3
? Bot1.Battlefield.Brushstrider.Toughness = 1
? Bot1.Battlefield.Brushstrider.Keywords = Vigilance
? Bot1.Battlefield.Brushstrider.Colors = Green
? Bot1.Battlefield.Brushstrider.Types = Creature
? Bot1.Battlefield.Brushstrider.Subtypes = Beast
? Bot1.Battlefield.Brushstrider.Supertypes = (absent)
? Bot1.Battlefield.Brushstrider.ProtectionFrom = (absent)
[T3 Bot1.Main1]
Bot1.Attack(Brushstrider > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 17
Bot1.Battlefield.Brushstrider.Tapped = false
