? Client.Bot1.Prompt.Title = Pyrrhic Strike: choose an additional cost to pay
? Client.Bot1.Prompt.Modes = Cast without blighting (choose one); Blight 2: put two -1/-1 counters on a creature you control (choose both)
Bot1.Modes(Blight 2)
? Client.Bot1.Prompt.Title = Pyrrhic Strike: choose both
? Client.Bot1.Prompt.Detail = 0 of 2 chosen
? Client.Bot1.Prompt.Modes = Destroy target artifact or enchantment.; Destroy target creature with mana value 3 or greater.
Bot1.Modes(1; 2)
Bot1.Target(Bot2.Battlefield.Sol Ring)
Bot1.Target(Hero of Bladehold)
? Client.Bot1.Prompt.Title = Pyrrhic Strike: choose a creature you control to blight (it gets -1/-1 counters)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Endurance)
