# Geralf, the Fleshwright is the third spell Bot1 casts on turn 1 (after two Moxen). The fourth spell, Memnite, on the same
# turn is not their first spell of the turn, so it makes a Zombie Rogue: spells cast before Geralf arrived count. Geralf's own
# cast made nothing (he was on the stack, not the battlefield).

[Bot1 Deck]
Island
Mox Sapphire
Mox Jet
Geralf, the Fleshwright
Memnite
Island x12

[Bot2 Deck]
Island x16

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Geralf, the Fleshwright.Cast
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield = Geralf, the Fleshwright; Island; Mox Jet; Mox Sapphire
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
[T1 Bot1.Main2]

[Expect]
Bot1.Battlefield = Geralf, the Fleshwright; Island; Memnite; Mox Jet; Mox Sapphire; Zombie Rogue Token
Bot1.Battlefield.Zombie Rogue Token.Power = 2
