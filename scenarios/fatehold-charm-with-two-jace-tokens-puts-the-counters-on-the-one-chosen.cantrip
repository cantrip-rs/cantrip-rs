# Browser
# Empower Jace with two Jace planeswalker tokens: "you'll choose one of those tokens to put the loyalty counters on" (the
# ruling). Bot1's first Fatehold Charm makes a Jace token with 2 loyalty on turn 1. Bot2 casts Jace, the Mind Sculptor on
# turn 2, and on turn 3 Bot1's Fractured Identity exiles it and gives Bot1 a token copy, which keeps the printed 3 loyalty:
# a second Jace planeswalker token. The second Fatehold Charm then asks which token gets the counters - a choice, not a
# target, worded as one ("choose a Jace planeswalker token to put 2 loyalty counters on", never "to keep"; one click on the
# token answers it) - and Bot1 picks the copy, which goes to 5 while the first token stays at 2.

[Bot1 Deck]
Tundra
Mox Sapphire
Fatehold Charm
Black Lotus
Mox Jet
Fractured Identity
Island
Fatehold Charm
Island x10

[Bot2 Deck]
Island
Black Lotus
Mox Sapphire
Jace, the Mind Sculptor
Island x3
Island x14

[Actions]
Bot1.Hand.Tundra.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Tundra.Activate(Ability: {W})
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Fatehold Charm.Cast
Bot1.Modes(Draw a card)
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Black Lotus.Cast
Bot2.Battlefield.Black Lotus.Activate(Color: Blue)
Bot2.Hand.Mox Sapphire.Cast
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.Jace, the Mind Sculptor.Cast
Bot1.Pass
[T3 Bot1.Main1]
? Bot1.Battlefield.Jace Token.Counters.Loyalty = 2
Bot1.Hand.Island.Play
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Fractured Identity.Cast(Bot2.Battlefield.Jace, the Mind Sculptor)
Bot2.Pass
? Bot1.Battlefield.Jace, the Mind Sculptor.Counters.Loyalty = 3
Bot1.Battlefield.Tundra.Activate(Ability: {W})
Bot1.Battlefield.Island.Activate
Bot1.Hand.Fatehold Charm.Cast
Bot1.Modes(Draw a card)
Bot2.Pass
? Client.Bot1.Prompt.Title = Fatehold Charm: choose a Jace planeswalker token to put 2 loyalty counters on
Bot1.Choose(Jace, the Mind Sculptor)
? Client.Bot1.Confirm =
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield.Jace, the Mind Sculptor.Counters.Loyalty = 5
Bot1.Battlefield.Jace, the Mind Sculptor.Token = true
Bot1.Battlefield.Jace Token.Counters.Loyalty = 2
Exile = Jace, the Mind Sculptor
