# The third tap adds the counter before the threshold check, so exactly three counters are removed and 2 damage hits both opponents.
# Beckett attacks Bot3, Bot2 as a player, then Bot2's planeswalker: combat damage lowers Wrenn to one loyalty, while Reckless Behavior damages players only (CR 120.3, 608.2c).

[Bot1 Deck]
Beckett Mariner, Impetuous Ensign
Mox Ruby
Mox Pearl
Mountain x20

[Bot2 Deck]
Mox Ruby
Taiga
Wrenn and Six
Island x20

[Bot3 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Beckett Mariner, Impetuous Ensign.Cast
Bot1.Pass
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Hand.Taiga.Play
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Taiga.Activate(Ability: Add {G})
Bot2.Hand.Wrenn and Six.Cast
Bot2.Pass
[T4 Bot1.DeclareAttackers]
Bot1.Attack(Beckett Mariner, Impetuous Ensign > Bot3)
[T4 Bot1.Main2]
[T7 Bot1.DeclareAttackers]
Bot1.Attack(Beckett Mariner, Impetuous Ensign > Bot2)
[T7 Bot1.Main2]
[T10 Bot1.DeclareAttackers]
Bot1.Attack(Beckett Mariner, Impetuous Ensign > Bot2.Battlefield.Wrenn and Six)
[T10 Bot1.Main2]

[Expect]
Bot1.Battlefield.Beckett Mariner, Impetuous Ensign.Keywords = FirstStrike
Bot1.Battlefield.Beckett Mariner, Impetuous Ensign.Counters.Promotion = (absent)
Bot2.Life = 16
Bot3.Life = 16
Bot2.Battlefield.Wrenn and Six.Counters.Loyalty = 1
