# Pulse Tracker triggers only when it attacks itself (CR 508.1m): Bot1 attacks with its Memnite and leaves the Tracker home, so Bot2 loses only the 1 life of Memnite's combat damage (19) and
# is not asked anything.

[Bot1 Deck]
Mox Jet
Pulse Tracker
Memnite
Island x5
Island x20

[Bot2 Deck]
Island x7
Island x20

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Pulse Tracker.Cast
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Attack(Memnite > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 19
