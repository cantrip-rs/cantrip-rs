Bot1.Hand.Mountain.Play
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Innocent Bystander.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Innocent Bystander)
Bot2.Pass
Bot1.Pass
? Stack.Count = 1
Bot2.Pass
Bot1.Pass

[Expect]
Bot1.Battlefield = Mountain; Mox Ruby; Clue Token
Bot1.Graveyard = Innocent Bystander
Bot2.Graveyard = Lightning Bolt
Stack.Count = 0
