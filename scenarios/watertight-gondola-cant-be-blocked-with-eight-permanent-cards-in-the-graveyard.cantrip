Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Overlord of the Balemurk.Cast(Ability: Impending)
[T5 Bot1.Main1]
? Bot1.Graveyard.Count = 10
Bot1.Battlefield.Waterlogged Hulk.Activate(Ability: Craft)
Bot1.Battlefield.Island#1.Activate
Bot1.Battlefield.Island#2.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Graveyard.Island)
[T7 Bot1.Main1]
Bot1.Battlefield.Watertight Gondola.Activate(Ability: Crew)
Bot1.Choose(Emry, Lurker of the Loch)
[T7 Bot1.DeclareAttackers]
Bot1.Attack(Watertight Gondola > Bot2; Bot1.Battlefield.Ornithopter > Bot2)
! Bot2.Block(Bot2.Battlefield.Ornithopter > Watertight Gondola)
Bot2.Block(Bot2.Battlefield.Ornithopter > Bot1.Battlefield.Ornithopter)
[T7 Bot1.Main2]

