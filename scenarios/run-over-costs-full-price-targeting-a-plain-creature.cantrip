# Run Over: Memnite is neither a Mount nor a Vehicle, so Run Over targeting it costs the full {1}{G}. With only the Mox Emerald's {G}
# it is not offered (the refusal); once the Mox Jet, drawn this turn, pays the {1} it is cast, and Bot1's Memnite deals 1 damage to Bot2's Memnite,
# which dies. Bot1's Memnite is not dealt damage back.

[Bot1 Deck]
Mox Emerald
Memnite
Run Over
Island x4
Mox Jet
Island x20

[Bot2 Deck]
Memnite
Island x20

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Emerald.Activate
! Bot1.Hand.Run Over.Cast(Mana: short)
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Run Over.Cast
Bot1.Target(Bot1.Battlefield.Memnite)
Bot1.Target(Bot2.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass

[Expect]
Stack.Count = 0
Bot2.Battlefield.Count = 0
Bot2.Graveyard = Memnite
Bot1.Battlefield.Memnite.Damage = 0
Bot1.Graveyard = Run Over
