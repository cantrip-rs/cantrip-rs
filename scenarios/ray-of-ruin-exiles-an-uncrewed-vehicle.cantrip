# Ray of Ruin: "Exile target creature, Vehicle, or nonbasic land." Bot2's Smuggler's Copter is a Vehicle that has not been crewed, so it
# is not a creature, and still a legal target (CR 301.7); Bot1 exiles it and keeps the scried Lightning Bolt on top.

[Bot1 Deck]
Black Lotus x2
Ray of Ruin
Swamp x4
Island
Lightning Bolt
Swamp x15

[Bot2 Deck]
Island
Sol Ring
Smuggler's Copter
Island x19

[Actions]
Bot1.Hand.Swamp.Play
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Battlefield.Island.Activate
Bot2.Hand.Sol Ring.Cast
Bot2.Pass
Bot1.Pass
Bot2.Battlefield.Sol Ring.Activate
Bot2.Hand.Smuggler's Copter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Black Lotus#2.Activate(Color: Black)
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
! Bot1.Hand.Ray of Ruin.Cast(Bot2.Battlefield.Sol Ring)
Bot1.Hand.Ray of Ruin.Cast(Bot2.Battlefield.Smuggler's Copter)
Bot1.Pass
Bot2.Pass
Bot1.Arrange(Lightning Bolt | )

[Expect]
Bot2.Exile.Smuggler's Copter.Colors.Count = 0
Bot2.Graveyard.Count = 0
Bot2.Battlefield.Sol Ring.Power = (absent)
Bot1.Library = Lightning Bolt; Swamp; Swamp; Swamp; Swamp; Swamp; Swamp; Swamp; Swamp; Swamp; Swamp; Swamp; Swamp; Swamp; Swamp; Swamp
