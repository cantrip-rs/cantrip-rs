# Casting after end of combat cannot create a trigger for the next turn's combat.
[Bot1 Deck]
Mox Jet
Steel Wall
Glyph of Doom
Swamp x20
[Bot2 Deck]
Memnite
Ornithopter
Island x20
[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Steel Wall.Cast
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot2.Hand.Ornithopter.Cast
[T4 Bot2.Attackers]
Bot2.Attack(Memnite; Ornithopter)
Bot1.Block(Steel Wall > Memnite)
[T4 Bot2.Main2]
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Glyph of Doom.Cast(Bot1.Battlefield.Steel Wall)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
[T6 Bot2.Attackers]
Bot2.Attack(Memnite)
Bot1.Block(Steel Wall > Memnite)
[T6 Bot2.Main2]
[Expect]
Bot2.Battlefield = Memnite; Ornithopter
Bot2.Graveyard.Count = 0
