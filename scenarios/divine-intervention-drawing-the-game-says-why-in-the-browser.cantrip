Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Divine Intervention.Cast
Bot1.Pass
[T3 Bot1.Main1]
? Bot1.Battlefield.Divine Intervention.Counters.Intervention = 1
[T5 Bot1.Upkeep]

[Expect]
Result = Draw
DrawReason = Effect
Turn = 5
Step = Upkeep
Bot1.Status = (absent)
Bot2.Status = (absent)
Client.Bot1.Over = true
Client.Bot1.Log.Has = The game is a draw: an effect says so (CR 104.4c).
