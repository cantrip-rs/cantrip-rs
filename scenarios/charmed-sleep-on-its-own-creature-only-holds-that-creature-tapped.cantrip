# Charmed Sleep on Bot1's own Ornithopter (its controller's untap step is the one skipped): the Ornithopter is tapped by the Aura and
# stays tapped through Bot1's turn-3 and turn-5 untap steps, while the unenchanted Memnite, which attacks on turn 3 and so
# is tapped, untaps normally on turn 5. The ban is the Aura's, on the enchanted creature alone.
# A Mox is no creature, so enchanting it is refused.

[Bot1 Deck]
Mox Sapphire
Mox Sapphire
Mox Ruby
Ornithopter
Memnite
Charmed Sleep
Island x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Memnite.Cast
! Bot1.Hand.Charmed Sleep.Cast(Bot1.Battlefield.Mox Ruby)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Charmed Sleep.Cast(Bot1.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Ornithopter.Tapped = true
[T3 Bot1.Main1]
? Bot1.Battlefield.Ornithopter.Tapped = true
? Bot1.Battlefield.Memnite.Tapped = false
Bot1.Attack(Memnite > Bot2)
[T5 Bot1.Main1]
? Bot1.Battlefield.Memnite.Tapped = false

[Expect]
Bot1.Battlefield.Ornithopter.Tapped = true
Bot1.Battlefield.Memnite.Tapped = false
Bot2.Life = 19
