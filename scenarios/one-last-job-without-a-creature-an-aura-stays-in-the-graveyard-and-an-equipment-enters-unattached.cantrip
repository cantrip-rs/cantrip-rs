# One Last Job's third mode (CR 303.4i, 301.5e) with no creature on Bot1's side of the battlefield. On turn 3 it targets Pacifism: no
# creature exists for it to enchant, so the Aura is not put onto the battlefield and stays in the graveyard (the mode does
# nothing; no question about a creature is asked). On turn 5 it targets Loxodon Warhammer: an Equipment enters the battlefield
# unattached, untapped, under Bot1's control. Each cast costs {2}{W} + {1} = four mana, paid by the four Moxen.

[Bot1 Deck]
Mox Pearl
Mox Sapphire
Mox Ruby
Mox Jet
Otherworldly Gaze
One Last Job
One Last Job
Pacifism
Loxodon Warhammer
Island x12

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Otherworldly Gaze.Cast
Bot1.Arrange(Island | Pacifism; Loxodon Warhammer)
[T3 Bot1.Main1]
Bot1.Hand.One Last Job.Cast
Bot1.Modes(3)
Bot1.Target(Pacifism)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
? Bot1.Mana =
! Bot1.Choose
Bot1.Pass
Bot2.Pass
? Bot1.Graveyard = One Last Job; Otherworldly Gaze; Loxodon Warhammer; Pacifism
? Bot1.Battlefield.Pacifism = (absent)
[T5 Bot1.Main1]
Bot1.Hand.One Last Job.Cast
Bot1.Modes(3)
Bot1.Target(Loxodon Warhammer)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
[Bot1.Main2]

[Expect]
Stack.Count = 0
Bot1.Graveyard = One Last Job; One Last Job; Otherworldly Gaze; Pacifism
Bot1.Battlefield.Loxodon Warhammer.AttachedTo = (absent)
Bot1.Battlefield.Loxodon Warhammer.Tapped = false
