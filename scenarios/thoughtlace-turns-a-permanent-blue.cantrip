# Thoughtlace makes a permanent blue, replacing its previous colors indefinitely (CR 611.2a).
[Bot1 Deck]
Thoughtlace
Mox Sapphire
Mox Ruby
Island x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Thoughtlace.Cast(Bot1.Battlefield.Mox Ruby)
Bot1.Choose(Close mana window)
? Bot1.Mana =
[T3 Bot1.Main1]

[Expect]
Bot1.Battlefield.Mox Ruby.Colors = Blue
