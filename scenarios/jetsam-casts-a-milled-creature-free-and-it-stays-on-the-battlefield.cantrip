# Jetsam: "If a spell cast this way would be put into a graveyard, exile it instead" (CR 614.1a, 608.2g) does not touch a spell that
# is not put into a graveyard. Bot2 mills Grizzly Bears and two Islands; Bot1 casts the Bears from Bot2's graveyard for nothing, they
# resolve onto Bot1's battlefield under Bot1's control and nothing is exiled. The milled Islands are lands, not spells: only the
# Bears are offered.

[Bot1 Deck]
Flotsam // Jetsam
Mox Pearl
Mox Ruby
Mox Emerald
Mox Sapphire
Mox Jet
Island
Island x14

[Bot2 Deck]
Island x7
Grizzly Bears
Island x12

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Flotsam // Jetsam.Cast(Ability: Jetsam)
Bot1.Pass
Bot2.Pass
Bot1.Choose(Grizzly Bears)
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield = Grizzly Bears; Island; Mox Emerald; Mox Jet; Mox Pearl; Mox Ruby; Mox Sapphire
Bot2.Graveyard.Count = 2
Exile.Count = 0
Stack.Count = 0
