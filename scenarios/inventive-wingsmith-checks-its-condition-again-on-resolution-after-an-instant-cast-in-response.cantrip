Bot1.Battlefield.Mox Pearl#2.Activate
Bot1.Battlefield.Mox Pearl#3.Activate
Bot1.Hand.Inventive Wingsmith.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.End]
? Stack.Count = 1
Bot1.Battlefield.Mox Pearl#4.Activate
Bot1.Hand.Swords to Plowshares.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
? Stack.Count = 0
[T5 Bot1.End]
? Stack.Count = 1
Bot1.Pass
Bot2.Pass

