# Drain Power may target its own caster (CR 115.1a; a creature is no player and is refused). Bot1's Island is tapped for mana
# by Drain Power's instruction, so Mana Flare's "Whenever a player taps a land for mana, that player adds one mana of any type
# that land produced" triggers (CR 106.12a, 605.4a): {U}{U}, lost and added back. Bot2's Island, not the target's, stays
# untapped. The Moxen paid for Drain Power, so none of their mana is in the pool.

[Bot1 Deck]
Black Lotus
Mox Sapphire
Mox Sapphire
Mana Flare
Drain Power
Ornithopter
Island
Island x10

[Bot2 Deck]
Island
Island
Island
Island
Island
Island
Island
Island x10

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Mana Flare.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
[T3 Bot1.Main1]
! Bot1.Hand.Drain Power.Cast(Bot1.Battlefield.Ornithopter)
Bot1.Battlefield.Mox Sapphire#1.Activate
Bot1.Battlefield.Mox Sapphire#2.Activate
Bot1.Hand.Drain Power.Cast(Bot1)
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Island.Activate
? Bot1.Mana = {U}{U}

[Expect]
Bot1.Battlefield.Island.Tapped = true
Bot2.Battlefield.Island.Tapped = false
Bot1.Graveyard = Drain Power; Black Lotus
