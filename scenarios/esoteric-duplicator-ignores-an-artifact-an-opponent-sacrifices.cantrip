# Esoteric Duplicator: "Whenever you sacrifice ...": Bot2 sacrificing its own Black Lotus does not trigger Bot1's Duplicator, so
# the stack stays empty and no token is made at Bot2's end step.

[Bot1 Deck]
Esoteric Duplicator
Mox Sapphire
Mox Jet
Mox Ruby
Island x17

[Bot2 Deck]
Black Lotus
Island x19

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Esoteric Duplicator.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Black Lotus.Cast
Bot2.Battlefield.Black Lotus.Activate(Color: Blue)
? Stack.Count = 0
[T2 Bot2.End]
? Stack.Count = 0

[Expect]
Bot2.Graveyard = Black Lotus
Bot1.Battlefield.Esoteric Duplicator.Token = (absent)
Bot1.Battlefield.Count = 4
Bot2.Battlefield.Count = 0
