Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Forest.Activate
Bot1.Choose(Elvish Mystic)
[T3 Bot1.Main1]
? Bot1.Hand = Mox Emerald; Llanowar Elves
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Llanowar Elves.Cast
? Stack.Count = 2
Bot1.Pass
Bot2.Pass
