Bot1.Hand.Plains.Play
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Explorer's Cache.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
! Bot1.Battlefield.Explorer's Cache.Activate(Bot1.Battlefield.Ornithopter)
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Explorer's Cache.Activate(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Explorer's Cache.Counters.PlusOnePlusOne = 1
? Bot2.Battlefield.Ornithopter.Counters.PlusOnePlusOne = 1
Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Wrath of God.Cast
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield.Ornithopter = (absent)
Bot2.Battlefield.Ornithopter = (absent)
Bot2.Graveyard = Ornithopter
Bot1.Battlefield.Explorer's Cache.Counters.PlusOnePlusOne = 1
Stack.Count = 0
