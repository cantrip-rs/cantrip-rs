Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Hill Giant.Cast
Bot1.Pass
Bot2.Pass
! Bot1.Battlefield.Deserter's Disciple.Activate(Ability: can't be blocked; Bot1.Battlefield.Deserter's Disciple)
! Bot1.Battlefield.Deserter's Disciple.Activate(Ability: can't be blocked; Bot2.Battlefield.Ornithopter)
! Bot1.Battlefield.Deserter's Disciple.Activate(Ability: can't be blocked; Bot1.Battlefield.Hill Giant)
Bot1.Battlefield.Deserter's Disciple.Activate(Ability: can't be blocked; Bot1.Battlefield.Runeclaw Bear)
? Bot1.Battlefield.Deserter's Disciple.Tapped = true
Bot1.Pass
Bot2.Pass
Bot1.Attack(Runeclaw Bear > Bot2)
! Bot2.Block(Ornithopter > Runeclaw Bear)
