# Browser
# Sleight of Mind changes the Circle's color word to red; the choice and its caption both use that word (CR 612.1).
[Bot1 Deck]
Mox Pearl
Mox Ruby
Mox Sapphire
Mox Jet
Circle of Protection: Blue
Sleight of Mind
Island x20
[Bot2 Deck]
Mox Ruby
Raging Goblin
Mox Sapphire
Fugitive Wizard
Island x20
[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Circle of Protection: Blue.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Sleight of Mind.Cast(Bot1.Battlefield.Circle of Protection: Blue)
Bot1.Pass
Bot2.Pass
Bot1.Colors(Blue)
Bot1.Colors(Red)
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Mox Sapphire.Cast
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Raging Goblin.Cast
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.Fugitive Wizard.Cast
[T2 Bot2.BeginCombat]
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Circle of Protection: Blue.Activate
Bot1.Pass
Bot2.Pass
? Client.Bot1.Prompt.Title = Circle of Protection: Blue: choose a red source of damage
! Bot1.Choose(Fugitive Wizard)
Bot1.Choose(Raging Goblin)
[T2 Bot2.DeclareAttackers]
Bot2.Attack(Raging Goblin > Bot1)
[T2 Bot2.Main2]
[Expect]
Bot1.Life = 20
