Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
! Bot1.Hand.Slickshot Lockpicker.Activate(Ability: Plot; Mana: short)
[T3 Bot1.Main1]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Slickshot Lockpicker.Activate(Ability: Plot)
? Bot1.Mana =
! Bot1.Exile.Slickshot Lockpicker.Cast
[T5 Bot1.Main1]
Bot1.Exile.Slickshot Lockpicker.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Graveyard.Lightning Bolt.Cast(Bot2)

[Expect]
Exile = Lightning Bolt
Bot2.Life = 14
Bot1.Battlefield.Slickshot Lockpicker.Power = 2
