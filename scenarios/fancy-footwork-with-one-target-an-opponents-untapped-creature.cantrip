# Fancy Footwork needs only one target (CR 115.1), and it may be an opponent's creature: Bot1 targets Bot2's Ornithopter alone,
# which is already untapped (the untap does nothing) and becomes a 2/4 until end of turn.

[Bot1 Deck]
Black Lotus
Fancy Footwork
Island x16

[Bot2 Deck]
Ornithopter
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Hand.Fancy Footwork.Cast
Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Battlefield.Ornithopter.Tapped = false
Bot2.Battlefield.Ornithopter.Power = 2
Bot2.Battlefield.Ornithopter.Toughness = 4
