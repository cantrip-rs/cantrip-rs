# Courier Hawk, a french vanilla creature: cast with Black Lotus mana, its characteristics as printed (power, toughness,
# keywords, colors, types, protection), then attacking Bot2, who has no creatures.
# Vigilance (CR 702.20b): attacking doesn't tap it.

[Bot1 Deck]
Black Lotus
Courier Hawk
Plains x22

[Bot2 Deck]
Island x24

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Hand.Courier Hawk.Cast
Bot1.Pass
[T2 Bot2.End]
? Bot1.Battlefield.Courier Hawk.Power = 1
? Bot1.Battlefield.Courier Hawk.Toughness = 2
? Bot1.Battlefield.Courier Hawk.Keywords = Flying; Vigilance
? Bot1.Battlefield.Courier Hawk.Colors = White
? Bot1.Battlefield.Courier Hawk.Types = Creature
? Bot1.Battlefield.Courier Hawk.Subtypes = Bird
? Bot1.Battlefield.Courier Hawk.Supertypes = (absent)
? Bot1.Battlefield.Courier Hawk.ProtectionFrom = (absent)
[T3 Bot1.Main1]
Bot1.Attack(Courier Hawk > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 19
Bot1.Battlefield.Courier Hawk.Tapped = false
