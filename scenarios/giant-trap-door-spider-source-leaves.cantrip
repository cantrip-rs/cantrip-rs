# If the Spider leaves in response, its ability still exiles the legal attacker (CR 113.7a, 608.2b).
[Bot1 Deck]
Giant Trap Door Spider
Mox Ruby
Mox Emerald
Mox Pearl
Forest x20

[Bot2 Deck]
Forest
Mox Emerald
Grizzly Bears
Ornithopter
Mox Ruby
Lightning Bolt
Forest x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Giant Trap Door Spider.Cast
? Bot1.Mana =
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Hand.Mox Emerald.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Ornithopter.Cast
Bot2.Battlefield.Forest.Activate
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Hand.Grizzly Bears.Cast
[T4 Bot2.DeclareAttackers]
Bot2.Attack(Grizzly Bears > Bot1; Ornithopter > Bot1)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
! Bot1.Battlefield.Giant Trap Door Spider.Activate(Bot2.Battlefield.Ornithopter)
Bot1.Battlefield.Giant Trap Door Spider.Activate(Bot2.Battlefield.Grizzly Bears)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
Bot1.Choose(Pay mana)
? Bot1.Mana =
? Bot1.Battlefield.Giant Trap Door Spider.Tapped = true
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Giant Trap Door Spider)
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Pass
[Expect]
Exile = Grizzly Bears
Bot1.Graveyard = Giant Trap Door Spider
Bot2.Battlefield.Ornithopter.Keywords = Flying
